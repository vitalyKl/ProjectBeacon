<Project>
  <PropertyGroup>
    <!-- Keep the NuGet/package version within its four-component numeric limit.
         The public application version is exposed through AssemblyInformationalVersion. -->
    <Version>0.7.5.4</Version>
    <InformationalVersion>0.7.5.4</InformationalVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' != 'ProjectBeacon.Domain' AND '$(MSBuildProjectName)' != 'ProjectBeacon.Domain.Tests' AND '$(MSBuildProjectName)' != 'ProjectBeacon.Infrastructure' AND '$(MSBuildProjectName)' != 'ProjectBeacon.Cli' AND '$(MSBuildProjectName)' != 'ProjectBeacon.Cli.Tests' AND '$(MSBuildProjectName)' != 'ProjectBeacon.Application' AND '$(MSBuildProjectName)' != 'ProjectBeacon.OpsAgent'">
    <PackageReference Include="Microsoft.EntityFrameworkCore" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" />
  </ItemGroup>
</Project>
