# Copy to secret.yaml (not committed) or create with:
# kubectl -n beacon create secret generic beacon-web \
#   --from-literal=POSTGRES_PASSWORD=... \
#   --from-literal=ConnectionStrings__Default='Host=postgres;Port=5432;Database=beacon;Username=beacon;Password=...' \
#   --from-literal=JWT__Secret=... \
#   --from-literal=BOOTSTRAP_ADMIN_TOKEN=...
apiVersion: v1
kind: Secret
metadata:
  name: beacon-web
  namespace: beacon
type: Opaque
stringData:
  POSTGRES_PASSWORD: change-me
  ConnectionStrings__Default: Host=postgres;Port=5432;Database=beacon;Username=beacon;Password=change-me
  JWT__Secret: change-me-must-be-at-least-32-characters-long
  BOOTSTRAP_ADMIN_TOKEN: change-me
