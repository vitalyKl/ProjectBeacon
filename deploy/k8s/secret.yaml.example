# Copy to secret.yaml (not committed) or create with:
# kubectl -n beacon create secret generic beacon-web \
#   --from-literal=POSTGRES_PASSWORD=... \
#   --from-literal=ConnectionStrings__Default='Host=postgres;Port=5432;Database=beacon;Username=beacon_app;Password=...' \
#   --from-literal=ConnectionStrings__Migration='Host=postgres;Port=5432;Database=beacon;Username=beacon;Password=...' \
#   --from-literal=JWT__Secret=... \
#   --from-literal=DATA_PROTECTION_KEY=... \
#   --from-literal=BOOTSTRAP_ADMIN_TOKEN=...
# The migrate Job needs ConnectionStrings__Migration (superuser) to apply schema changes and
# bootstrap the runtime role; Web/Worker authenticate with ConnectionStrings__Default (beacon_app).
# DATA_PROTECTION_LEGACY_KEY and DATA_PROTECTION_WRITE_V2 are rotation-phase additions, see README.
apiVersion: v1
kind: Secret
metadata:
  name: beacon-web
  namespace: beacon
type: Opaque
stringData:
  POSTGRES_PASSWORD: change-me
  ConnectionStrings__Default: Host=postgres;Port=5432;Database=beacon;Username=beacon_app;Password=change-me
  ConnectionStrings__Migration: Host=postgres;Port=5432;Database=beacon;Username=beacon;Password=change-me
  JWT__Secret: change-me-must-be-at-least-32-characters-long
  # Data-encryption key for stored secrets (v2 writes). Rotation: add DATA_PROTECTION_LEGACY_KEY
  # (the previous key), deploy, then set DATA_PROTECTION_WRITE_V2="true" and run the migrate Job
  # until remaining_v1 is 0. See the README rollout section.
  DATA_PROTECTION_KEY: change-me-must-be-at-least-32-characters-long
  # DATA_PROTECTION_LEGACY_KEY: previous-data-protection-key-during-rotation-only
  # DATA_PROTECTION_WRITE_V2: "false"
  BOOTSTRAP_ADMIN_TOKEN: change-me
