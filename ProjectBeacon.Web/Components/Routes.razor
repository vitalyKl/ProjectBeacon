@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.Extensions.Localization
@using MudBlazor
@using ProjectBeacon.Web.Resources
@using ProjectBeacon.Web.Shared
@inject IStringLocalizer<Web> L
@inject NavigationManager Navigation

<CascadingAuthenticationState>
    <Router AppAssembly="typeof(App).Assembly">
        <Found Context="routeData">
            <ErrorBoundary @key="Navigation.Uri">
                <ErrorContent>
                    <MudAlert Severity="Severity.Error">@L["AnErrorOccurred"]</MudAlert>
                    <MudButton Variant="Variant.Text" OnClick="@(() => Navigation.NavigateTo(Navigation.Uri, forceLoad: true))">
                        @L["Back"]
                    </MudButton>
                </ErrorContent>
                <ChildContent>
            <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(AuthLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated == true)
                    {
                        <RedirectTo "/" />
                    }
                    else
                    {
                        <RedirectToLogin />
                    }
                </NotAuthorized>
                <Authorizing>
                    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="mt-4" />
                </Authorizing>
            </AuthorizeRouteView>
                </ChildContent>
            </ErrorBoundary>
        </Found>
        <NotFound>
            <AuthorizeView>
                <Authorized>
                    <LayoutView Layout="typeof(MainLayout)">
                        <MudAlert Severity="Severity.Info">@L["PageNotFound"]</MudAlert>
                    </LayoutView>
                </Authorized>
                <NotAuthorized>
                    <LayoutView Layout="typeof(AuthLayout)">
                        <MudAlert Severity="Severity.Info">@L["PageNotFound"]</MudAlert>
                    </LayoutView>
                </NotAuthorized>
            </AuthorizeView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>
