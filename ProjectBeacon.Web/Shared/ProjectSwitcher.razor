@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Projects
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
@inject ListMyProjectsHandler MyProjects

<MudMenu AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Dense="true" Disabled="@(_projects.Count == 0)">
    <ActivatorContent>
        <button type="button"
                class="beacon-project-switcher @Class"
                aria-label="@L["SwitchProject"]"
                disabled="@(_projects.Count == 0)"
                @onclick="context.ToggleAsync">
            <span class="beacon-project-glyph">@Glyph</span>
            <span class="beacon-project-copy">
                <strong>@CurrentName</strong>
                <span>@L["Project"]</span>
            </span>
            <MudIcon Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" />
        </button>
    </ActivatorContent>
    <ChildContent>
        @foreach (var project in _projects)
        {
            <MudMenuItem OnClick="@(() => OnSelected(project.Id))">@project.Name</MudMenuItem>
        }
    </ChildContent>
</MudMenu>

@code {
    [Parameter] public string? Class { get; set; }

    private Guid? _selected;
    private List<ProjectSummaryDto> _projects = [];

    private string CurrentName =>
        _projects.FirstOrDefault(p => p.Id == _selected)?.Name
        ?? _projects.FirstOrDefault()?.Name
        ?? L["Project"].Value;

    private string Glyph
    {
        get
        {
            var name = CurrentName.Trim();
            return name.Length == 0 ? "?" : char.ToUpperInvariant(name[0]).ToString();
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true
            || !Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid))
            return;

        var isAdmin = bool.TryParse(user.FindFirst("isAdmin")?.Value, out var flag) && flag;
        var result = await MyProjects.HandleAsync(uid, isAdmin);
        if (!result.Success || result.Value is null)
            return;

        _projects = [.. result.Value.Projects.OrderBy(p => p.Name)];
        if (Guid.TryParse(user.FindFirst("project_id")?.Value, out var activeId)
            && _projects.Any(p => p.Id == activeId))
            _selected = activeId;
    }

    private void OnSelected(Guid projectId)
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri);
        if (string.IsNullOrWhiteSpace(path))
            path = "/dashboard";
        Navigation.NavigateTo($"/project/switch?projectId={projectId}&returnUrl={Uri.EscapeDataString(path)}", forceLoad: true);
    }
}
