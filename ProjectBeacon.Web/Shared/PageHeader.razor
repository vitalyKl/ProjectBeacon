<div class="beacon-page-header mb-4">
    <MudText Typo="Typo.h4">@Title</MudText>
    <div class="beacon-page-actions">
        @ChildContent
    </div>
</div>

@code {
    [Parameter] public string Title { get; set; } = string.Empty;
    [Parameter] public RenderFragment? ChildContent { get; set; }
}
