@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L

<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
    <MudText Typo="Typo.h6">@L["Pipeline"]</MudText>
    @if (Pipeline is { } pipeline && pipeline.Stage is not null && pipeline.Stage != TaskPipelineStage.None)
    {
        @if (pipeline.Stage == TaskPipelineStage.Closed)
        {
            <MudText Typo="Typo.body2" Class="mt-2">@L["PipelineClosed"]</MudText>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-2">@L["Sessions"]</MudText>
        @if (pipeline.Sessions.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mt-1">@L["NoSessionsYet"]</MudText>
        }
        @foreach (var session in pipeline.Sessions)
        {
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-1">
                <StatusChip Color="Color.Default" Label="@RoleLabel(session.Role)" />
                <StatusChip Color="@SessionStatusColor(session.Status)" Label="@SessionStatusLabel(session.Status)" />
                @if (session.LaunchedAt is not null)
                {
                    <MudText Typo="Typo.caption">@L["Launched"]: <LocalTime Value="session.LaunchedAt" Format="d" /></MudText>
                }
                @if (session.ClosedAt is not null)
                {
                    <MudText Typo="Typo.caption">@L["Closed"]: <LocalTime Value="session.ClosedAt" Format="d" /></MudText>
                }
                @if (session.Status is SessionStatus.Failed or SessionStatus.Closed)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => OnRetry.InvokeAsync(session))" Disabled="Busy">@L["RetrySession"]</MudButton>
                }
                @if (session.Status == SessionStatus.Ready)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OnLaunch.InvokeAsync(session))" Disabled="Busy || !CanLaunch(session)">@L["LaunchSession"]</MudButton>
                    @if (!CanLaunch(session))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@PreflightMessage(session.Role)</MudText>
                    }
                }
            </MudStack>
            @if (!string.IsNullOrEmpty(session.LaunchSpec))
            {
                <MudText Typo="Typo.caption" Class="beacon-ellipsis">@session.LaunchSpec</MudText>
            }
            @if (session.Role is PipelineRole.Planner or PipelineRole.Review)
            {
                <PipelineActivityPanel TaskId="pipeline.TaskId" Session="session" />
            }
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4">@L["Verdicts"]</MudText>
        @if (pipeline.Verdicts.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mt-1">@L["NoVerdictsYet"]</MudText>
        }
        @foreach (var verdict in pipeline.Verdicts)
        {
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-1">
                <StatusChip Color="@(verdict.Kind == ReviewVerdictKind.Approve ? Color.Success : Color.Warning)" Label="@(verdict.Kind == ReviewVerdictKind.Approve ? L["VerdictApprove"].Value : L["VerdictReopenSubtask"].Value)" />
                <MudText Typo="Typo.body2" Class="grow beacon-pre">@verdict.Note</MudText>
                <MudText Typo="Typo.caption"><LocalTime Value="verdict.CreatedAt" Format="d" /></MudText>
            </MudStack>
        }
    }
    else
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3 beacon-task-start-prompt">
            <MudText Typo="Typo.body2">@L["PipelineNotStarted"]</MudText>
            @if (!CanStartPlanner)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@PreflightMessage(PipelineRole.Planner)</MudAlert>
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PlayArrow"
                       OnClick="OnStart" Disabled="Busy || !CanStartPlanner" Class="mt-3">@L["StartPipeline"]</MudButton>
        </MudAlert>
    }
</MudPaper>

@code {
    [Parameter] public PipelineStateDto? Pipeline { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<PipelineSessionDto> OnLaunch { get; set; }
    [Parameter] public EventCallback<PipelineSessionDto> OnRetry { get; set; }
    [Parameter] public EventCallback OnStart { get; set; }

    private bool CanStartPlanner => Pipeline?.Preflight is { HasOnlineNativeWorkstation: true, PlannerModelConfigured: true };

    private bool CanLaunch(PipelineSessionDto session) => Pipeline?.Preflight is { HasOnlineNativeWorkstation: true } preflight && ModelConfigured(preflight, session.Role);

    private bool ModelConfigured(PipelinePreflightDto preflight, PipelineRole role) => role switch
    {
        PipelineRole.Planner => preflight.PlannerModelConfigured,
        PipelineRole.Actor => preflight.ActorModelConfigured,
        PipelineRole.Review => preflight.ReviewModelConfigured,
        _ => false
    };

    private string PreflightMessage(PipelineRole role) => Pipeline?.Preflight?.HasOnlineNativeWorkstation != true
        ? L["PipelinePreflightNoNativeWorkstation"].Value
        : L["PipelinePreflightNoRoleModel"].Value;

    private string SessionStatusLabel(SessionStatus status) => L[status.ToString()].Value;

    private Color SessionStatusColor(SessionStatus status) => status switch
    {
        SessionStatus.Active => Color.Info,
        SessionStatus.WaitingForUser => Color.Warning,
        SessionStatus.Closed => Color.Default,
        SessionStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private string RoleLabel(PipelineRole role) => role switch
    {
        PipelineRole.Planner => L["RoleBindingPlanner"].Value,
        PipelineRole.Actor => L["RoleBindingActor"].Value,
        PipelineRole.Review => L["Review"].Value,
        _ => role.ToString()
    };
}
