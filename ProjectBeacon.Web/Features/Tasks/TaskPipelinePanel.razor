@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L

<MudPaper Elevation="0" Outlined="true" Class="beacon-panel beacon-pipeline-timeline mt-3">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
        <MudText Typo="Typo.h6">@L["Pipeline"]</MudText>
        @if (Pipeline?.Stage is { } headerStage)
        {
            <StatusChip Color="Color.Info" Label="@StageLabel(headerStage)" />
        }
    </MudStack>
    @if (Pipeline is { } pipeline && pipeline.Stage is not null && pipeline.Stage != TaskPipelineStage.None)
    {
        @if (pipeline.Stage == TaskPipelineStage.Closed)
        {
            <MudText Typo="Typo.body2" Class="mt-2">@L["PipelineClosed"]</MudText>
        }

        <MudText Typo="Typo.subtitle2" Class="mt-2">@L["Sessions"]</MudText>
        @if (!pipeline.Sessions.Any(s => s.Role is PipelineRole.Planner or PipelineRole.Review))
        {
            <MudText Typo="Typo.caption" Class="mt-1">@L["NoSessionsYet"]</MudText>
        }
        @foreach (var session in pipeline.Sessions.Where(s => s.Role is PipelineRole.Planner or PipelineRole.Review))
        {
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-1">
                <StatusChip Color="Color.Default" Label="@RoleLabel(session.Role)" />
                <StatusChip Color="@SessionStatusColor(session.Status)" Label="@SessionStatusLabel(session.Status)" />
                <StatusChip Color="Color.Info" Label="@AgentModeLabel(session.AgentMode)" />
                @if (!string.IsNullOrWhiteSpace(session.ModelName))
                {
                    <MudText Typo="Typo.caption">@L["ExecutionProfileModel"]: @session.ModelName</MudText>
                }
                @if (session.LaunchedAt is not null)
                {
                    <MudText Typo="Typo.caption">@L["Launched"]: <LocalTime Value="session.LaunchedAt" Format="d" /></MudText>
                }
                @if (session.ClosedAt is not null)
                {
                    <MudText Typo="Typo.caption">@L["Closed"]: <LocalTime Value="session.ClosedAt" Format="d" /></MudText>
                }
                @if (CanRetry(session))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => OnRetry.InvokeAsync(session))"
                               Disabled="Busy || !CanRunRole(session.Role)">@L["RetrySession"]</MudButton>
                    @if (!CanRunRole(session.Role))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@PreflightMessage(session)</MudText>
                    }
                }
                @if (session.Status == SessionStatus.Ready && IsCurrentStage(session))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OnLaunch.InvokeAsync(session))" Disabled="Busy || !CanLaunch(session)">@L["LaunchSession"]</MudButton>
                    @if (!CanLaunch(session))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">@PreflightMessage(session)</MudText>
                    }
                }
                @if (session.Status is SessionStatus.Ready or SessionStatus.Active or SessionStatus.WaitingForUser)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error"
                               OnClick="@(() => OnCancel.InvokeAsync(session))" Disabled="Busy">@L["CancelWork"]</MudButton>
                }
            </MudStack>
            @if (!string.IsNullOrEmpty(session.LaunchSpec))
            {
                <MudText Typo="Typo.caption" Class="beacon-ellipsis" title="@session.LaunchSpec">@session.LaunchSpec</MudText>
            }
        }

        <MudText Typo="Typo.subtitle2" Class="mt-4">@L["Verdicts"]</MudText>
        @if (pipeline.Verdicts.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mt-1">@L["NoVerdictsYet"]</MudText>
        }
        @foreach (var verdict in pipeline.Verdicts)
        {
            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-1">
                <StatusChip Color="@(verdict.Kind == ReviewVerdictKind.Approve ? Color.Success : Color.Warning)" Label="@(verdict.Kind == ReviewVerdictKind.Approve ? L["VerdictApprove"].Value : L["VerdictReopenSubtask"].Value)" />
                <MudText Typo="Typo.caption"><LocalTime Value="verdict.CreatedAt" Format="d" /></MudText>
            </MudStack>
            @if (!string.IsNullOrWhiteSpace(verdict.Note))
            {
                <MarkdownView Text="@verdict.Note" MaxHeight="120" Class="mt-1" />
            }
        }

        <MudDivider Class="my-3" />
        <MudText Typo="Typo.subtitle2">@L["LandingAttemptTitle"]</MudText>
        @if (pipeline.LatestLandingAttempt is { } landing)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Wrap="Wrap.Wrap" Class="mt-2">
                <StatusChip Color="@LandingStatusColor(landing.Status)" Label="@LandingStatusLabel(landing.Status)" />
                <MudText Typo="Typo.caption">rev. @landing.GitPolicyRevision · <LocalTime Value="landing.UpdatedAt" Format="g" /></MudText>
            </MudStack>
            <MudGrid Spacing="1" Class="mt-1">
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["LandingSourceBranch"]</MudText>
                    <MudText Typo="Typo.body2">@landing.SourceBranch</MudText>
                    <MudText Typo="Typo.caption" Class="beacon-ellipsis" title="@landing.SourceSha">@landing.SourceSha</MudText>
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["LandingTargetBranch"]</MudText>
                    <MudText Typo="Typo.body2">@(landing.TargetBranch ?? "—")</MudText>
                    <MudText Typo="Typo.caption" Class="beacon-ellipsis" title="@landing.TargetHeadSha">@landing.TargetHeadSha</MudText>
                </MudItem>
                @if (!string.IsNullOrWhiteSpace(landing.CandidateTreeSha))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["LandingCandidateTree"]</MudText>
                        <MudText Typo="Typo.caption" Class="beacon-ellipsis" title="@landing.CandidateTreeSha">@landing.CandidateTreeSha</MudText>
                    </MudItem>
                }
                @if (!string.IsNullOrWhiteSpace(landing.MergeCommitSha))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["LandingMergeCommit"]</MudText>
                        <MudText Typo="Typo.caption" Class="beacon-ellipsis" title="@landing.MergeCommitSha">@landing.MergeCommitSha</MudText>
                    </MudItem>
                }
                @if (!string.IsNullOrWhiteSpace(landing.RevertCommitSha))
                {
                    <MudItem xs="12">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["LandingRevertCommit"]</MudText>
                        <MudText Typo="Typo.caption" Class="beacon-ellipsis" title="@landing.RevertCommitSha">@landing.RevertCommitSha</MudText>
                    </MudItem>
                }
            </MudGrid>
            @if (!string.IsNullOrWhiteSpace(landing.EscalationCode))
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    @LandingReasonLabel(landing.EscalationCode)
                </MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(landing.FailureCode))
            {
                <MudAlert Severity="@LandingFailureSeverity(landing.FailureCode)" Dense="true" Class="mt-2">
                    @LandingReasonLabel(landing.FailureCode)
                </MudAlert>
            }
            @if (landing.PostMergeCheckExitCode is { } exitCode)
            {
                <MudText Typo="Typo.caption" Class="mt-1">
                    @L["LandingPostMergeCheck"]: @(exitCode == 0 ? L["Passed"].Value : $"{L["Failed"].Value} ({exitCode})")
                </MudText>
            }
            @if (!string.IsNullOrWhiteSpace(landing.ConflictFilesJson))
            {
                <MudExpansionPanels Elevation="0" Class="mt-2">
                    <MudExpansionPanel Text="@L["LandingConflictFiles"]">
                        <MudText Typo="Typo.caption" Class="beacon-ellipsis">@landing.ConflictFilesJson</MudText>
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                @if (CanManageLanding
                    && (landing.Status == LandingAttemptStatus.Previewed
                        || landing.Status == LandingAttemptStatus.ExecutePending
                            && landing.EscalationCode == "ManualExecuteRetryRequired"))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Success"
                               Disabled="Busy" OnClick="@(() => OnExecuteLanding.InvokeAsync(landing))">
                        @L["ExecuteLanding"]
                    </MudButton>
                }
                @if (CanManageLanding
                    && ((landing.Status is LandingAttemptStatus.Landed
                            or LandingAttemptStatus.LandedUnverified
                            or LandingAttemptStatus.RevertFailed)
                        || (landing.Status == LandingAttemptStatus.RevertPending
                            && landing.EscalationCode == "RevertDispatchUnavailable")))
                {
                    <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error"
                               Disabled="Busy" OnClick="@(() => OnRevertLanding.InvokeAsync(landing))">
                        @L["RevertLanding"]
                    </MudButton>
                }
            </MudStack>
        }
        @if (CanManageLanding && pipeline.Stage == TaskPipelineStage.Approved && CanRequestPreview(pipeline.LatestLandingAttempt))
        {
            <MudTextField T="string" @bind-Value="_landingRationale" Label="@L["LandingRationale"]"
                          Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                          Class="mt-2" />
            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                       Disabled="Busy || string.IsNullOrWhiteSpace(_landingRationale)"
                       OnClick="@(() => OnRequestLanding.InvokeAsync(_landingRationale.Trim()))">
                @L["PreviewLanding"]
            </MudButton>
        }
    }
</MudPaper>

@code {
    [Parameter] public PipelineStateDto? Pipeline { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<PipelineSessionDto> OnLaunch { get; set; }
    [Parameter] public EventCallback<PipelineSessionDto> OnRetry { get; set; }
    [Parameter] public EventCallback<PipelineSessionDto> OnCancel { get; set; }
    [Parameter] public bool CanManageLanding { get; set; }
    [Parameter] public EventCallback<string> OnRequestLanding { get; set; }
    [Parameter] public EventCallback<LandingAttemptDto> OnExecuteLanding { get; set; }
    [Parameter] public EventCallback<LandingAttemptDto> OnRevertLanding { get; set; }
    private string _landingRationale = "Approved task branch ready for landing.";
    private readonly Dictionary<string, string> _unknownReasonMessages = new(StringComparer.Ordinal);

    private string UnknownReasonMessage(string code, string resourceKey, string operation, object? context = null)
    {
        var cacheKey = $"{System.Globalization.CultureInfo.CurrentUICulture.Name}:{Pipeline?.TaskId}:{resourceKey}:{operation}:{code}";
        if (_unknownReasonMessages.TryGetValue(cacheKey, out var message))
            return message;

        message = Notifications.FormatUnknownReasonCode(code, resourceKey, operation, context);
        if (_unknownReasonMessages.Count >= 32)
            _unknownReasonMessages.Clear();
        _unknownReasonMessages[cacheKey] = message;
        return message;
    }

    private bool CanRequestPreview(LandingAttemptDto? attempt) => attempt is null
        || attempt.Status is LandingAttemptStatus.Failed or LandingAttemptStatus.Conflicted or LandingAttemptStatus.Reverted;

    private string LandingStatusLabel(LandingAttemptStatus status) => L["LandingStatus" + status].Value;

    private string LandingReasonLabel(string code)
    {
        var resourceKey = code switch
        {
            "ManualExecuteRetryRequired" => "LandingReasonManualExecuteRetryRequired",
            "ManualExecutionRequired" => "LandingReasonManualExecutionRequired",
            "RevertDispatchUnavailable" => "LandingReasonRevertDispatchUnavailable",
            "IntegrationBranchNotAvailable" => "LandingReasonIntegrationBranchNotAvailable",
            "InvalidGitPolicySnapshot" => "LandingReasonInvalidGitPolicySnapshot",
            "ProjectUnavailable" => "LandingReasonProjectUnavailable",
            "PostMergeCheckFailed" => "LandingReasonPostMergeCheckFailed",
            "GitPolicyChangedSincePreview" => "LandingReasonGitPolicyChangedSincePreview",
            "TaskNotApprovedForExecute" => "LandingReasonTaskApprovalRequired",
            "AutomaticLandingNotAllowed" => "LandingReasonManualActionRequired",
            _ when code.StartsWith("GitHubMergeQueued", StringComparison.Ordinal) => "LandingReasonGitHubMergeQueued",
            "GitHubAsyncMergeFailed" => "LandingReasonGitHubAsyncMergeFailed",
            _ => ResolveLandingReasonCategory(code)
        };

        if (resourceKey is null)
            return UnknownReasonMessage(code, "LandingReasonUnknown", "display Git landing reason");

        var localized = L[resourceKey];
        return localized.ResourceNotFound
            ? UnknownReasonMessage(code, "LandingReasonUnknown", "display Git landing reason")
            : localized.Value;
    }

    private static string? ResolveLandingReasonCategory(string code)
    {
        if (code is "ProjectRuntimeUnavailable" or "TaskWorkspaceUnavailable" or "LandingWorkstationUnavailable" or "WorkspaceModeRequiresTaskBranches")
            return "LandingReasonWorkspaceUnavailable";
        if (code is "ProjectIdentityMismatch" or "InvalidTargetBranch")
            return "LandingReasonGitConfigurationInvalid";
        if (code.StartsWith("Task", StringComparison.Ordinal))
            return "LandingReasonTaskWorktreeChanged";
        if (code.StartsWith("Review", StringComparison.Ordinal) || code is "ExecutePreviewEvidenceMissing" or "CandidateNoLongerValid")
            return "LandingReasonReviewEvidenceChanged";
        if (code.Contains("Protected", StringComparison.Ordinal) || code.Contains("OutsideProject", StringComparison.Ordinal)
            || code.Contains("Symlink", StringComparison.Ordinal) || code.Contains("Submodule", StringComparison.Ordinal)
            || code.Contains("TooLarge", StringComparison.Ordinal) || code.Contains("ModifiedFiles", StringComparison.Ordinal))
            return "LandingReasonProtectedChangesDetected";
        if (code.StartsWith("PostMerge", StringComparison.Ordinal) || code is "PostMergeEvidenceInvalid" or "PostMergeVerificationFailed" or "TargetWorktreeUpdateFailed")
            return "LandingReasonPostMergeVerificationFailed";
        if (code.StartsWith("Revert", StringComparison.Ordinal) || code.StartsWith("GitRevert", StringComparison.Ordinal)
            || code is "TargetAdvancedBeyondLanding" or "TargetChangedBeforeRevertUpdate" or "TargetBranchUnavailableForRevertRecovery" or "TargetCheckoutChangedBeforeRevert")
            return "LandingReasonRevertFailed";
        if (code.StartsWith("Candidate", StringComparison.Ordinal) || code.StartsWith("MergeTree", StringComparison.Ordinal)
            || code.StartsWith("LandingCommit", StringComparison.Ordinal) || code is "UnexpectedMergeTreeOutput")
            return "LandingReasonCandidateBuildFailed";
        if (code.Contains("Marker", StringComparison.Ordinal) || code.Contains("Recovery", StringComparison.Ordinal)
            || code.Contains("CompletionUnknown", StringComparison.Ordinal) || code.StartsWith("Invalid", StringComparison.Ordinal)
            || code.StartsWith("Unexpected", StringComparison.Ordinal)
            || code is "UnknownGitLandResult" or "GitLandCommandFailed" or "GitLandOperationFailed")
            return "LandingReasonLandingRecoveryFailed";
        if (code.Contains("Enqueue", StringComparison.Ordinal) || code.Contains("Workstation", StringComparison.Ordinal))
            return "LandingReasonCommandQueueFailed";
        if (code is "LandingCommitNotOnTargetBranch" or "TargetBranchChangedSincePreview")
            return "LandingReasonTargetBranchChanged";
        if (code.StartsWith("Target", StringComparison.Ordinal) || code.StartsWith("LocalTarget", StringComparison.Ordinal))
            return "LandingReasonTargetBranchChanged";
        if (code.Contains("Workspace", StringComparison.Ordinal) || code.Contains("Worktree", StringComparison.Ordinal))
            return "LandingReasonWorkspaceUnavailable";
        if (code.Contains("Git", StringComparison.Ordinal) || code.Contains("Remote", StringComparison.Ordinal)
            || code.Contains("Branch", StringComparison.Ordinal) || code.Contains("MergeDriver", StringComparison.Ordinal))
            return "LandingReasonGitConfigurationInvalid";
        if (code.Contains("Manual", StringComparison.Ordinal))
            return "LandingReasonManualActionRequired";
        return null;
    }

    private static Severity LandingFailureSeverity(string code) =>
        code.StartsWith("GitHubMergeQueued", StringComparison.Ordinal)
            ? Severity.Info
            : string.Equals(code, "CommandCompletionUnknown", StringComparison.Ordinal)
                ? Severity.Warning
                : Severity.Error;

    private Color LandingStatusColor(LandingAttemptStatus status) => status switch
    {
        LandingAttemptStatus.Previewed or LandingAttemptStatus.Landed or LandingAttemptStatus.Reverted => Color.Success,
        LandingAttemptStatus.Conflicted or LandingAttemptStatus.Failed or LandingAttemptStatus.LandedUnverified
            or LandingAttemptStatus.RevertFailed or LandingAttemptStatus.RevertedUnverified => Color.Error,
        LandingAttemptStatus.PreviewPending or LandingAttemptStatus.ExecutePending or LandingAttemptStatus.RevertPending => Color.Warning,
        _ => Color.Default
    };

    private bool CanLaunch(PipelineSessionDto session) => session.CanLaunch;

    private bool IsCurrentStage(PipelineSessionDto session) => session.Role switch
    {
        PipelineRole.Planner => Pipeline?.Stage is TaskPipelineStage.Planning or TaskPipelineStage.Executing,
        PipelineRole.Review => Pipeline?.Stage == TaskPipelineStage.Reviewing,
        _ => false
    };

    private bool CanRetry(PipelineSessionDto session) =>
        (session.Status is SessionStatus.Failed or SessionStatus.Closed)
        && (session.Role switch
        {
            PipelineRole.Planner => Pipeline?.Stage is TaskPipelineStage.Planning or TaskPipelineStage.Executing,
            PipelineRole.Review => Pipeline?.Stage == TaskPipelineStage.Reviewing,
            _ => false
        });

    private bool CanRunRole(PipelineRole role)
    {
        var preflight = Pipeline?.Preflight;
        if (preflight?.HasOnlineNativeWorkstation != true) return false;
        return role switch
        {
            PipelineRole.Planner => preflight.PlannerModelConfigured,
            PipelineRole.Actor => preflight.ActorModelConfigured,
            PipelineRole.Review => preflight.ReviewModelConfigured,
            _ => false
        };
    }

    private string PreflightMessage(PipelineSessionDto session)
    {
        if (session.LaunchBlockedReason is { } reason)
        {
            var localized = L[reason];
            return localized.ResourceNotFound
                ? UnknownReasonMessage(reason, "PipelinePreflightReasonUnknown", "read pipeline launch preflight", new { TaskId = Pipeline?.TaskId })
                : localized.Value;
        }

        if (Pipeline?.Preflight?.PipelineWorkstationBlockedReason is { } workstationReason)
        {
            var localized = L[workstationReason];
            return localized.ResourceNotFound
                ? UnknownReasonMessage(workstationReason, "PipelinePreflightReasonUnknown", "read task workstation preflight", new { TaskId = Pipeline?.TaskId })
                : localized.Value;
        }

        return Pipeline?.Preflight?.HasNativeWorkstation != true
                ? L["PipelinePreflightNoNativeWorkstation"].Value
                : Pipeline.Preflight.HasOnlineNativeWorkstation != true
                    ? L["PipelineNativeWorkstationOffline"].Value
                    : L["PipelinePreflightNoRoleModel"].Value;
    }

    private string StageLabel(TaskPipelineStage stage) => stage switch
    {
        TaskPipelineStage.Planning => L["StagePlanning"].Value,
        TaskPipelineStage.Executing => L["StageExecuting"].Value,
        TaskPipelineStage.ReopenedForRevision => L["StageReopenedForRevision"].Value,
        TaskPipelineStage.Reviewing => L["StageReviewing"].Value,
        TaskPipelineStage.Approved => L["StageApproved"].Value,
        TaskPipelineStage.Closed => L["Closed"].Value,
        TaskPipelineStage.Cancelled => L["StageCancelled"].Value,
        _ => L["PipelineNotStarted"].Value
    };

    private string SessionStatusLabel(SessionStatus status) => L[status.ToString()].Value;

    private string AgentModeLabel(string? mode) =>
        L[string.Equals(mode, "Plan", StringComparison.OrdinalIgnoreCase) ? "ExecutionProfilePlan" : "ExecutionProfileAct"].Value;

    private Color SessionStatusColor(SessionStatus status) => status switch
    {
        SessionStatus.Active => Color.Info,
        SessionStatus.WaitingForUser => Color.Warning,
        SessionStatus.Closed => Color.Default,
        SessionStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private string RoleLabel(PipelineRole role) => role switch
    {
        PipelineRole.Planner => L["RoleBindingPlanner"].Value,
        PipelineRole.Actor => L["RoleBindingActor"].Value,
        PipelineRole.Review => L["Review"].Value,
        _ => role.ToString()
    };
}
