@using ProjectBeacon.Application.Tasks
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L

<MudPaper Elevation="0" Outlined="false" Class="beacon-card beacon-task-subtask pa-3 mt-2">
    <div class="beacon-task-subtask-head">
        <MudText Typo="Typo.body2">@Subtask.Instructions</MudText>
        <StatusChip Color="@StatusColor" Label="@StatusLabel" />
    </div>
    @if (!string.IsNullOrWhiteSpace(Subtask.Summary))
    {
        <MudText Typo="Typo.body2" Class="mt-1">@Subtask.Summary</MudText>
    }
    @if (!string.IsNullOrWhiteSpace(Subtask.DiffRef))
    {
        <MudText Typo="Typo.caption" Class="beacon-ellipsis">@Subtask.DiffRef</MudText>
    }
    @foreach (var session in Sessions)
    {
        <PipelineActivityPanel TaskId="TaskId" Session="session" />
    }
</MudPaper>

@code {
    [Parameter, EditorRequired] public Guid TaskId { get; set; }
    [Parameter, EditorRequired] public SubtaskDto Subtask { get; set; } = default!;
    [Parameter] public IReadOnlyList<PipelineSessionDto> Sessions { get; set; } = [];

    private string StatusLabel => Subtask.Status == SubtaskStatus.Done
        ? L["SubtaskReported"].Value
        : L[Subtask.Status.ToString()].Value;

    private Color StatusColor => Subtask.Status switch
    {
        SubtaskStatus.Done => Color.Success,
        SubtaskStatus.InProgress => Color.Info,
        SubtaskStatus.Failed => Color.Error,
        _ => Color.Default
    };
}
