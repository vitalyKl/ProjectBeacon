@using System.Security.Cryptography
@using System.Text
@using System.Text.Json
@using System.Text.Json.Nodes
@using ProjectBeacon.Application.Chat
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Features.Chat
@using ProjectBeacon.Domain.Common
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L

<MudExpansionPanels Elevation="0" Class="beacon-pipeline-activity">
    <MudExpansionPanel Expanded="@(Session.Status == SessionStatus.WaitingForUser || IsLive)" Dense="true">
        <TitleContent>
            <div class="beacon-pipeline-activity-title">
                <span class="beacon-pipeline-activity-role">@RoleLabel</span>
                <StatusChip Color="@StatusColor" Label="@StatusLabel" />
                @if (IsWorking)
                {
                    <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Info" />
                }
                <span class="beacon-pipeline-activity-summary">@ActivityLabel</span>
                @if (Session.LastActivityAt is not null)
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@LastActivityLabel</MudText>
                }
            </div>
        </TitleContent>
        <ChildContent>
            @if (!string.IsNullOrWhiteSpace(Session.FailureReason))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Variant="Variant.Outlined" Class="mb-2">@Session.FailureReason</MudAlert>
            }
            @if (!string.IsNullOrWhiteSpace(ActivityLabel))
            {
                <MudText Typo="Typo.body2" Class="beacon-pipeline-activity-current">@ActivityLabel</MudText>
            }
            @if (Parts.Count == 0 && Forms.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["PipelineActivityStarting"]</MudText>
            }
            @foreach (var part in Parts)
            {
                <ChatPartView Part="part" PipelineTaskId="TaskId" PipelineSessionId="Session.Id" />
            }
            @foreach (var form in Forms)
            {
                <ChatPartView Part="form" PipelineTaskId="TaskId" PipelineSessionId="Session.Id" />
            }
        </ChildContent>
    </MudExpansionPanel>
</MudExpansionPanels>

@code {
    [Parameter, EditorRequired] public Guid TaskId { get; set; }
    [Parameter, EditorRequired] public PipelineSessionDto Session { get; set; } = default!;

    private string RoleLabel => Session.Role switch
    {
        PipelineRole.Planner => L["RoleBindingPlanner"].Value,
        PipelineRole.Actor => L["RoleBindingActor"].Value,
        PipelineRole.Review => L["Review"].Value,
        _ => Session.Role.ToString()
    };

    private string _state = string.Empty;
    private string _activity = string.Empty;
    private List<ChatPartDto> Parts { get; set; } = [];
    private List<ChatPartDto> Forms { get; set; } = [];
    private string SnapshotKey { get; set; } = string.Empty;

    private string LastActivityLabel => Session.LastActivityAt is not { } lastActivity
        ? string.Empty
        : (DateTime.UtcNow - lastActivity) < TimeSpan.FromMinutes(1)
            ? string.Format(L["PipelineUpdatedSecondsAgo"].Value, Math.Max(0, (int)(DateTime.UtcNow - lastActivity).TotalSeconds))
            : string.Format(L["PipelineUpdatedMinutesAgo"].Value, Math.Max(1, (int)(DateTime.UtcNow - lastActivity).TotalMinutes));

    private string TimeAgo(DateTime timestamp)
    {
        var elapsed = DateTime.UtcNow - timestamp;
        if (elapsed < TimeSpan.FromMinutes(1))
        {
            var seconds = Math.Max(0, (int)elapsed.TotalSeconds);
            return seconds == 0 ? L["PipelineJustNow"].Value : $"{seconds} {L["PipelineSecondsShort"].Value}";
        }
        if (elapsed < TimeSpan.FromHours(1))
            return $"{(int)elapsed.TotalMinutes} {L["PipelineMinutesShort"].Value}";
        return $"{(int)elapsed.TotalHours} {L["PipelineHoursShort"].Value}";
    }

    private bool HasRecentSignal => Session.LastActivityAt is { } lastActivity
        && DateTime.UtcNow - lastActivity <= TimeSpan.FromSeconds(30);
    private bool IsLive => Session.Status == SessionStatus.WaitingForUser
        || (Session.Status == SessionStatus.Active && !Session.IsQueued && HasRecentSignal && _state is not ("completed" or "failed"));
    private bool IsWorking => Session.Status == SessionStatus.Active && !Session.IsQueued && HasRecentSignal
        && _state is not ("completed" or "failed" or "waiting-for-user");
    private string ActivityLabel => Session.IsQueued
        ? L["PipelineQueued"].Value
        : !string.IsNullOrWhiteSpace(Session.FailureReason)
            ? Session.FailureReason
            : Session.Status == SessionStatus.Active && !HasRecentSignal
            ? L["PipelineNoRecentSignal"].Value
            : !string.IsNullOrWhiteSpace(_activity)
                ? _activity
        : _state switch
        {
            "waiting-for-user" => L["PipelineWaitingForUser"].Value,
            "completed" => L["PipelineActivityCompleted"].Value,
            "failed" => L["PipelineActivityFailed"].Value,
            _ => Session.Status == SessionStatus.Ready
                ? L["PipelineActivityReady"].Value
                : L["PipelineActivityWorking"].Value
        };

    private string StatusLabel => Session.IsQueued
        ? L["PipelineQueued"].Value
        : Session.Status switch
    {
        SessionStatus.WaitingForUser => L["WaitingForUser"].Value,
        SessionStatus.Active when _state == "completed" => L["PipelineActivityCompleted"].Value,
        SessionStatus.Active when !HasRecentSignal => L["PipelineNoRecentSignal"].Value,
        SessionStatus.Active when _state == "failed" => L["PipelineActivityFailed"].Value,
        _ => L[Session.Status.ToString()].Value
    };

    private Color StatusColor => Session.IsQueued
        ? Color.Warning
        : Session.Status switch
    {
        SessionStatus.Active when !HasRecentSignal => Color.Warning,
        SessionStatus.Active when _state == "failed" => Color.Error,
        SessionStatus.Active when _state == "completed" => Color.Success,
        SessionStatus.Active => Color.Info,
        SessionStatus.WaitingForUser => Color.Warning,
        SessionStatus.Failed => Color.Error,
        SessionStatus.Closed => Color.Success,
        _ => Color.Default
    };

    protected override void OnParametersSet()
    {
        var body = Session.ActivityJson ?? "{}";
        if (body == SnapshotKey)
            return;
        SnapshotKey = body;
        Parts = [];
        Forms = [];
        _state = string.Empty;
        _activity = string.Empty;
        try
        {
            var snapshot = PipelineActivityV1.Parse(body);
            _state = snapshot.State ?? string.Empty;
            _activity = snapshot.Activity ?? string.Empty;
            var sort = 0;
            foreach (var part in snapshot.Parts)
            {
                var kind = part.Kind ?? "text";
                var role = part.Role ?? "assistant";
                var externalId = part.ExternalId ?? $"{sort}:{kind}";
                Parts.Add(new ChatPartDto(
                    StableId(Session.Id, externalId),
                    Session.Id,
                    role,
                    kind,
                    part.Body ?? string.Empty,
                    externalId,
                    sort++,
                    Session.LaunchedAt ?? DateTime.UtcNow,
                    part.Tool,
                    part.ToolStatus,
                    part.ToolInput,
                    part.ToolResult,
                    part.DurationMs,
                    part.Complete));
            }

            foreach (var form in snapshot.Forms)
            {
                if (string.IsNullOrWhiteSpace(form.Id))
                    continue;
                var fieldsJson = form.Fields is { ValueKind: JsonValueKind.Array } fields
                    ? fields.GetRawText()
                    : "[]";
                var bodyNode = new JsonObject
                {
                    ["id"] = form.Id,
                    ["title"] = form.Title,
                    ["description"] = form.Metadata,
                    ["fields"] = JsonNode.Parse(fieldsJson)
                };
                if (form.Answer is { ValueKind: JsonValueKind.Object } answer)
                    bodyNode["answer"] = JsonNode.Parse(answer.GetRawText());
                Forms.Add(new ChatPartDto(
                    StableId(Session.Id, "form:" + form.Id),
                    Session.Id,
                    "assistant",
                    "question",
                    bodyNode.ToJsonString(),
                    "form:" + form.Id,
                    Parts.Count + Forms.Count,
                    Session.LaunchedAt ?? DateTime.UtcNow,
                    Complete: true));
            }
        }
        catch (JsonException)
        {
            _state = string.Empty;
            _activity = string.Empty;
        }
    }

    private static string? ReadString(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object
        && element.TryGetProperty(property, out var value)
        && value.ValueKind == JsonValueKind.String
            ? value.GetString()
            : null;

    private static int? ReadInt(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object
        && element.TryGetProperty(property, out var value)
        && value.ValueKind == JsonValueKind.Number
        && value.TryGetInt32(out var number)
            ? number
            : null;

    private static bool ReadBool(JsonElement element, string property) =>
        element.ValueKind == JsonValueKind.Object
        && element.TryGetProperty(property, out var value)
        && value.ValueKind == JsonValueKind.True;

    private static Guid StableId(Guid sessionId, string value)
    {
        var bytes = SHA256.HashData(Encoding.UTF8.GetBytes(sessionId.ToString("N") + ":" + value));
        return new Guid(bytes.AsSpan(0, 16));
    }
}
