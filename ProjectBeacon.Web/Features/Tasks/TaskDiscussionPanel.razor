@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Tasks
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject AddCommentHandler AddComment
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar

<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
    <MudText Typo="Typo.h6">@L["Comments"]</MudText>
    @if (Task is null || Task.Comments.Count == 0)
    {
        <MudText Typo="Typo.caption" Class="mt-2">@L["NoCommentsYet"]</MudText>
    }
    else
    {
        @foreach (var comment in Task.Comments.OrderBy(c => c.CreatedAt))
        {
            <MudText Typo="Typo.body2" Class="mt-2">@comment.Content</MudText>
            <MudText Typo="Typo.caption">@comment.CreatedAt.ToShortDateString()</MudText>
        }
    }
    <MudTextField @bind-Value="_draft" Label="@L["WriteAComment"]" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
    <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="Save">@L["AddComment"]</MudButton>
</MudPaper>

@code {
    [Parameter] public TaskItemDto? Task { get; set; }
    [Parameter] public EventCallback OnSaved { get; set; }

    private string _draft = string.Empty;

    private async Task Save()
    {
        if (Task is null || string.IsNullOrWhiteSpace(_draft))
            return;
        var actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        var result = await AddComment.HandleAsync(new AddCommentCommand(new AddCommentRequest(Task.Id, _draft.Trim()), actor));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _draft = string.Empty;
        await OnSaved.InvokeAsync();
        Snackbar.Add(L["Saved"].Value, Severity.Success);
    }
}
