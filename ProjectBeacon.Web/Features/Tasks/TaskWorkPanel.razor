@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L

@if (Phases.Count > 0 || Pipeline is { Subtasks.Count: > 0 })
{
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel beacon-task-work-panel">
        @if (Phases.Count > 0)
        {
            <div class="beacon-phase-strip">
                @foreach (var phase in Phases)
                {
                    <button type="button"
                            class="beacon-phase-tick @(OpenPhaseId == phase.Id ? "is-open" : "")"
                            aria-label="@($"{phase.Title} {phase.Status}")"
                            aria-expanded="@(OpenPhaseId == phase.Id)"
                            @onclick="() => OnToggle.InvokeAsync(phase.Id)">
                        <span class="beacon-phase-mark @phase.Status.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                        <span>@(string.IsNullOrEmpty(phase.Key) ? phase.Title : L["Phase_" + phase.Key].Value)</span>
                    </button>
                }
            </div>

            @if (Phases.FirstOrDefault(p => p.Id == OpenPhaseId) is { } open)
            {
                <div class="beacon-task-phase-content">
                    <MudText Typo="Typo.body2">@open.Instruction</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["PhaseModel"]: @ModelName(open.ModelBackendId)</MudText>
                    @foreach (var sub in PhaseSubtasks(open.Id))
                    {
                        <TaskSubtaskCard TaskId="Pipeline!.TaskId" Subtask="sub" Sessions="SessionsFor(sub.Id)" Busy="Busy" Preflight="Preflight"
                                         OnStartActorSession="OnStartActorSession" OnReportResult="OnReportResult" OnFailSubtask="OnFailSubtask" OnLaunchSession="OnLaunchSession" OnRetrySession="OnRetrySession" />
                    }
                </div>
            }

            @if (Pipeline is { } pipeline && pipeline.Subtasks.Any(s => s.TaskPhaseId is null))
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">@L["UnassignedSubtasks"]</MudText>
                @foreach (var sub in pipeline.Subtasks.Where(s => s.TaskPhaseId is null))
                {
                    <TaskSubtaskCard TaskId="pipeline.TaskId" Subtask="sub" Sessions="SessionsFor(sub.Id)" Busy="Busy" Preflight="Preflight"
                                         OnStartActorSession="OnStartActorSession" OnReportResult="OnReportResult" OnFailSubtask="OnFailSubtask" OnLaunchSession="OnLaunchSession" OnRetrySession="OnRetrySession" />
                }
            }
        }
        else if (Pipeline is { } pipeline)
        {
            @foreach (var sub in pipeline.Subtasks)
            {
                <TaskSubtaskCard TaskId="pipeline.TaskId" Subtask="sub" Sessions="SessionsFor(sub.Id)" Busy="Busy" Preflight="Preflight"
                                 OnStartActorSession="OnStartActorSession" OnReportResult="OnReportResult"
                                 OnFailSubtask="OnFailSubtask" OnLaunchSession="OnLaunchSession" OnRetrySession="OnRetrySession" />
            }
        }
    </MudPaper>
}

@code {
    [Parameter] public IReadOnlyList<TaskPhaseDto> Phases { get; set; } = [];
    [Parameter] public Guid? OpenPhaseId { get; set; }
    [Parameter] public PipelineStateDto? Pipeline { get; set; }
    [Parameter] public EventCallback<Guid> OnToggle { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public PipelinePreflightDto? Preflight { get; set; }
    [Parameter] public EventCallback<SubtaskDto> OnStartActorSession { get; set; }
    [Parameter] public EventCallback<SubtaskDto> OnReportResult { get; set; }
    [Parameter] public EventCallback<SubtaskDto> OnFailSubtask { get; set; }
    [Parameter] public EventCallback<PipelineSessionDto> OnLaunchSession { get; set; }
    [Parameter] public EventCallback<PipelineSessionDto> OnRetrySession { get; set; }

    private IEnumerable<SubtaskDto> PhaseSubtasks(Guid phaseId) =>
        Pipeline?.Subtasks.Where(s => s.TaskPhaseId == phaseId) ?? [];

    private IReadOnlyList<PipelineSessionDto> SessionsFor(Guid subtaskId) =>
        Pipeline?.Sessions.Where(s => s.SubtaskId == subtaskId).ToList() ?? [];

    private string ModelName(Guid? id) =>
        id is null ? L["Unbound"].Value : L["PhaseModel"].Value;
}
