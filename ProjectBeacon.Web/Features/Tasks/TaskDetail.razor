    private async Task<bool> ConfirmActionAsync(string title, string message, bool destructive = false)
    {
        var parameters = new DialogParameters
        {
            { nameof(TaskActionConfirmDialog.Message), message },
            { nameof(TaskActionConfirmDialog.ConfirmText), destructive ? L["Delete"].Value : L["Confirm"].Value },
            { nameof(TaskActionConfirmDialog.CancelText), L["Cancel"].Value },
            { nameof(TaskActionConfirmDialog.Destructive), destructive }
        };
        var reference = await Dialogs.ShowAsync(typeof(TaskActionConfirmDialog), title, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await reference.Result;
        return result?.Data is true;
    }

