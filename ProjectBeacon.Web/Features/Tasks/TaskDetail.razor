        if (_busy || _pipeline is null) return;
        if (!await ConfirmActionAsync(L["CancelPipeline"].Value, L["CancelPipelineConfirm"].Value))
            return;

        _busy = true;
        try
        {
            var result = await CancelPipeline.HandleAsync(
                new CancelPipelineCommand(new CancelPipelineRequest(TaskId), _actorContext));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["PipelineCancelled"].Value, Severity.Info);
            await Reload();
            await ReloadPipeline();
            await ReloadSteps();
        }
        finally
        {
            _busy = false;
        }
    }

