@page "/task/{taskId:guid}"
@layout MainLayout
@attribute [Authorize]
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Context
@using ProjectBeacon.Application.Milestones
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Theme
@using Microsoft.AspNetCore.Components.Authorization
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetTaskHandler GetTask
@inject ListLabelsHandler ListLabels
@inject ListProjectMilestonesHandler ListMilestones
@inject CompileBriefHandler CompileBrief
@inject AddCommentHandler AddComment
@inject AddReviewNotesHandler AddReviewNotes
@inject GetPipelineHandler GetPipeline
@inject StartPipelineHandler StartPipeline
@inject StartActorSessionHandler StartActorSession
@inject LaunchSessionHandler LaunchSession
@inject StartReviewHandler StartReview
@inject ListTaskStepsHandler ListSteps
@inject ListTaskPhasesHandler ListPhases
@inject AddTaskStepHandler AddStep
@inject ToggleTaskStepHandler ToggleStep
@inject DeleteTaskStepHandler DeleteStep
@inject ChangeTaskStatusHandler ChangeStatus
@inject IDialogService Dialogs
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@L["TaskDetail"]</PageTitle>



@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_task is null)
{
    <MudAlert Severity="Severity.Info">@L["TaskNotFound"]</MudAlert>
}
else
{
    <header class="beacon-task-hero">
        <div>
            <div class="beacon-task-kicker">
                <span class="beacon-state @HeroStateClass">@HeroStateLabel</span>
                <StatusChip Color="@ChipPalette.ForPriority(_task.Priority)" Label="@ChromeLabels.Priority(L, _task.Priority)" />
                <span class="beacon-ops-sub">@ChromeLabels.Type(L, _task.Type)</span>
            </div>
            <div class="beacon-task-title">@_task.Title</div>
            @if (!string.IsNullOrEmpty(_task.Description))
            {
                <p class="beacon-task-goal"><strong>@L["Goal"]</strong>@_task.Description</p>
            }
        </div>
        <div class="beacon-page-actions">
            @if (_pipeline is null || _pipeline.Stage is null || _pipeline.Stage == TaskPipelineStage.None)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnStartPipeline" Disabled="_busy">@L["StartPipeline"]</MudButton>
            }
            else
            {
                @switch (_pipeline.Stage)
                {
                    case TaskPipelineStage.Planning:
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.CreateSubtask))" Disabled="_busy">@L["CreateSubtask"]</MudButton>
                        break;
                    case TaskPipelineStage.Executing:
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnStartReview" Disabled="_busy">@L["StartReview"]</MudButton>
                        break;
                    case TaskPipelineStage.Reviewing:
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ReviewApprove))" Disabled="_busy">@L["Approve"]</MudButton>
                        break;
                    case TaskPipelineStage.Approved:
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ConfirmClose))" Disabled="_busy">@L["ConfirmClose"]</MudButton>
                        break;
                }
            }
        </div>
    </header>
    @if (_pipeline?.Stage is { } railStage && railStage != TaskPipelineStage.None)
    {
        <section class="beacon-task-strip">
            <PbPipelineRail Labels="@StageLabels" CurrentIndex="@StageIndex(railStage)" Warning="@(railStage == TaskPipelineStage.ReopenedForRevision)" />
            <div class="beacon-relation">
                <div>
                    <small>@L["Status"]</small>
                    <strong>@ChromeLabels.Status(L, _task.Status)</strong>
                </div>
                <div>
                    <small>@L["Pipeline"]</small>
                    <strong>@PipelineStageLabel(railStage)</strong>
                </div>
                <div>
                    <small>@L["Sessions"]</small>
                    <strong>@_pipeline.Sessions.Count</strong>
                </div>
                <div>
                    <small>@L["TaskSteps"]</small>
                    <strong>@_steps.Count(s => s.IsDone)/@_steps.Count</strong>
                </div>
            </div>
        </section>
    }
    <div class="beacon-task-grid">
        <div class="beacon-task-main">
            <section class="beacon-panel beacon-surface-operational">
                <header class="beacon-ops-head">
                    <div class="beacon-ops-title">@L["Sessions"]</div>
                </header>
                @if (_pipeline is not { Sessions.Count: > 0 })
                {
                    <p class="beacon-ops-empty">@L["NoSessionsYet"]</p>
                }
                else
                {
                    @foreach (var session in _pipeline.Sessions.TakeLast(6))
                    {
                        <div class="beacon-activity-row">
                            <span class="beacon-state @SessionStateClass(session.Status)">@SessionStatusLabel(session.Status)</span>
                            <span>@RoleLabel(session.Role)</span>
                            <time>@(session.LaunchedAt?.ToLocalTime().ToString("g") ?? session.ClosedAt?.ToLocalTime().ToString("g"))</time>
                        </div>
                    }
                }
                @if (_pipeline?.Stage is TaskPipelineStage.Executing or TaskPipelineStage.ReopenedForRevision)
                {
                    <header class="beacon-ops-head">
                        <div class="beacon-ops-title">@L["Subtasks"]</div>
                    </header>
                    @if (_pipeline.Subtasks.Count == 0)
                    {
                        <p class="beacon-ops-empty">@L["NoSubtasksYet"]</p>
                    }
                    @foreach (var subtask in _pipeline.Subtasks)
                    {
                        <div class="beacon-subtask">
                            <MudText Typo="Typo.body2" Class="beacon-pre">@subtask.Instructions</MudText>
                            <div class="beacon-task-kicker">
                                <span class="beacon-state @SubtaskStateClass(subtask.Status)">@SubtaskStatusLabel(subtask.Status)</span>
                                @if (subtask.ReopenCount > 0)
                                {
                                    <span class="beacon-ops-sub">@L["Reopens"]: @subtask.ReopenCount</span>
                                }
                            </div>
                            @if (subtask.DiffRef is not null)
                            {
                                <MudText Typo="Typo.body2">@L["DiffRef"]: @subtask.DiffRef</MudText>
                            }
                            @if (subtask.Summary is not null)
                            {
                                <MudText Typo="Typo.body2">@L["Summary"]: @subtask.Summary</MudText>
                            }
                            <div class="beacon-page-actions mt-2">
                                @if (subtask.Status is SubtaskStatus.Pending or SubtaskStatus.InProgress)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OnStartActorSession(subtask))" Disabled="_busy">@L["StartActorSession"]</MudButton>
                                }
                                @if (subtask.Status == SubtaskStatus.InProgress)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ReportResult, subtask))" Disabled="_busy">@L["ReportResult"]</MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.FailSubtask, subtask))" Disabled="_busy">@L["FailSubtask"]</MudButton>
                                }
                            </div>
                        </div>
                    }
                }
            </section>
        </div>
        <aside class="beacon-task-aside">
            <div class="beacon-next-action @NextTone">
                <strong>@L["NextStep"]</strong>
                <span>@NextStepText</span>
                @if (_pipeline?.Stage == TaskPipelineStage.Reviewing)
                {
                    <span>@L["ReviewSeparate"]</span>
                }
            </div>
            <section class="beacon-panel beacon-surface-section">
                <div class="beacon-ops-pad">
                    @if (_pipeline?.Stage == TaskPipelineStage.Executing)
                    {
                        <MudButton Variant="Variant.Outlined" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.CreateSubtask))" Disabled="_busy">@L["CreateSubtask"]</MudButton>
                    }
                    @if (_pipeline?.Stage == TaskPipelineStage.Reviewing)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ReviewReopen))" Disabled="_busy">@L["ReopenSubtask"]</MudButton>
                    }
                    @if (_isAdmin && _pipeline?.Stage is TaskPipelineStage.ReopenedForRevision or TaskPipelineStage.Approved)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ForceClose))" Disabled="_busy">@L["ForceClose"]</MudButton>
                    }
                    <MudButton Variant="Variant.Text" OnClick="EditTask">@L["Edit"]</MudButton>
                    <MudSelect T="TaskItemStatus"
                        Value="_status"
                        ValueChanged="OnStatusChanged"
                        Label="@L["Status"]"
                        Variant="Variant.Outlined"
                        Margin="Margin.Dense"
                        Dense="true"
                        Disabled="_busy"
                        Class="mt-3">
                        @foreach (var status in StatusOptions)
                        {
                            <MudSelectItem Value="status">@ChromeLabels.Status(L, status)</MudSelectItem>
                        }
                    </MudSelect>
                    @if (_task.Status == "InProgress" && _task.SubStage.HasValue)
                    {
                        <MudProgressLinear Value="@(SubStageToPercent(_task.SubStage.Value))" Color="Color.Default" Class="mt-3 beacon-track" />
                        <MudText Typo="Typo.body2" Class="mt-1">@ChromeLabels.SubStage(L, _task.SubStage)</MudText>
                    }
                    @if (_task.Status == "Done" && _task.CompletedAt.HasValue)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2">@L["Done"] @_task.CompletedAt.Value.ToShortDateString()</MudText>
                    }
                </div>
            </section>
            <section class="beacon-panel beacon-surface-section">
                <header class="beacon-ops-head">
                    <div class="beacon-ops-title">@L["TaskSteps"]</div>
                </header>
                <div class="beacon-ops-pad">
                    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
                        <MudTextField @bind-Value="_stepTitle" Label="@L["StepTitle"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnAddStep" Disabled="_busy || string.IsNullOrWhiteSpace(_stepTitle)">@L["AddStep"]</MudButton>
                    </MudStack>
                    @if (_steps.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2">@L["NoStepsYet"]</MudText>
                    }
                    @foreach (var step in _steps)
                    {
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                            <MudCheckBox T="bool" Value="step.IsDone" ValueChanged="done => OnToggleStep(step, done)" Dense="true" />
                            <MudText Typo="Typo.body2" Class="grow" Style="@(step.IsDone ? "text-decoration:line-through" : null)">@step.Title</MudText>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => OnDeleteStep(step)">@L["Delete"]</MudButton>
                        </MudStack>
                    }
                </div>
            </section>
            <section class="beacon-panel beacon-surface-section">
                <header class="beacon-ops-head">
                    <div class="beacon-ops-title">@L["ReviewNotes"]</div>
                </header>
                <div class="beacon-ops-pad">
                    @if (!string.IsNullOrEmpty(_task.ReviewNotes))
                    {
                        <MudText Typo="Typo.body2" Class="beacon-pre">@_task.ReviewNotes</MudText>
                    }
                    <MudTextField @bind-Value="_reviewDraft" Label="@L["ReviewNotes"]" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                    <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="SaveReview">@L["Save"]</MudButton>
                </div>
            </section>
        </aside>
    </div>
    <MudTabs Rounded="true" ApplyEffectsToContainer="false" Class="mt-4 beacon-task-tabs">
    <MudTabPanel Text="@L["Work"]">

    @if (_phases.Count > 0)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
            <div class="beacon-phase-strip">
                @foreach (var phase in _phases)
                {
                    <button type="button" class="beacon-phase-tick @(_openPhaseId == phase.Id ? "is-open" : "")" aria-label="@($"{phase.Title} {phase.Status}")" @onclick="() => TogglePhase(phase.Id)">
                        <span class="beacon-phase-mark @phase.Status.ToString().ToLowerInvariant()" aria-hidden="true"></span>
                        <span>@(string.IsNullOrEmpty(phase.Key) ? phase.Title : L["Phase_" + phase.Key].Value)</span>
                    </button>
                }
            </div>
            @if (_phases.FirstOrDefault(p => p.Id == _openPhaseId) is { } open)
            {
                <MudText Typo="Typo.body2" Class="mt-3">@open.Instruction</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["PhaseModel"]: @(ModelName(open.ModelBackendId))</MudText>
                @foreach (var sub in PhaseSubtasks(open.Id))
                {
                    <MudPaper Elevation="0" Outlined="false" Class="beacon-card pa-3 mt-2">
                        <MudText Typo="Typo.body2">@sub.Instructions</MudText>
                        <MudText Typo="Typo.caption">@SubtaskStatusLabel(sub.Status)</MudText>
                        @if (!string.IsNullOrWhiteSpace(sub.Summary))
                        {
                            <MudText Typo="Typo.body2" Class="mt-1">@sub.Summary</MudText>
                        }
                        @if (!string.IsNullOrWhiteSpace(sub.DiffRef))
                        {
                            <MudText Typo="Typo.caption" Class="beacon-ellipsis">@sub.DiffRef</MudText>
                        }
                    </MudPaper>
                }
            }
        </MudPaper>
    }

    </MudTabPanel>
    <MudTabPanel Text="@L["Pipeline"]">

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
        <MudText Typo="Typo.h6">@L["Pipeline"]</MudText>
        @if (_pipeline is { } pipeline && pipeline.Stage is not null && pipeline.Stage != TaskPipelineStage.None)
        {
            @if (pipeline.Stage == TaskPipelineStage.Closed)
            {
                <MudText Typo="Typo.body2" Class="mt-2">@L["PipelineClosed"]</MudText>
            }

            <MudText Typo="Typo.subtitle2" Class="mt-2">@L["Sessions"]</MudText>
            @if (pipeline.Sessions.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mt-1">@L["NoSessionsYet"]</MudText>
            }
            @foreach (var session in pipeline.Sessions)
            {
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-1">
                    <StatusChip Color="Color.Default" Label="@RoleLabel(session.Role)" />
                    <StatusChip Color="@SessionStatusColor(session.Status)" Label="@SessionStatusLabel(session.Status)" />
                    @if (session.LaunchedAt is not null)
                    {
                        <MudText Typo="Typo.caption">@L["Launched"]: @session.LaunchedAt.Value.ToShortDateString()</MudText>
                    }
                    @if (session.ClosedAt is not null)
                    {
                        <MudText Typo="Typo.caption">@L["Closed"]: @session.ClosedAt.Value.ToShortDateString()</MudText>
                    }
                      @if (session.Status == SessionStatus.Ready)
                      {
                          <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OnLaunchSession(session))" Disabled="_busy">@L["LaunchSession"]</MudButton>
                          <MudText Typo="Typo.caption">@L["LaunchSessionHint"]</MudText>
                      }
                </MudStack>
                @if (!string.IsNullOrEmpty(session.LaunchSpec))
                {
                    <MudText Typo="Typo.caption" Class="beacon-ellipsis">@session.LaunchSpec</MudText>
                }
            }

            <MudText Typo="Typo.subtitle2" Class="mt-4">@L["Verdicts"]</MudText>
            @if (pipeline.Verdicts.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mt-1">@L["NoVerdictsYet"]</MudText>
            }
            @foreach (var verdict in pipeline.Verdicts)
            {
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-1">
                    <StatusChip Color="@(verdict.Kind == ReviewVerdictKind.Approve ? Color.Success : Color.Warning)" Label="@(verdict.Kind == ReviewVerdictKind.Approve ? L["VerdictApprove"].Value : L["VerdictReopenSubtask"].Value)" />
                    <MudText Typo="Typo.body2" Class="grow beacon-pre">@verdict.Note</MudText>
                    <MudText Typo="Typo.caption">@verdict.CreatedAt.ToShortDateString()</MudText>
                </MudStack>
            }
        }
        else
        {
            <MudText Typo="Typo.caption" Class="mt-2">@L["PipelineNotStarted"]</MudText>
        }
    </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="@L["Discussion"]">

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
        <MudText Typo="Typo.h6">@L["Comments"]</MudText>
        @if (_task.Comments.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mt-2">@L["NoCommentsYet"]</MudText>
        }
        @foreach (var comment in _task.Comments.OrderBy(c => c.CreatedAt))
        {
            <MudText Typo="Typo.body2" Class="mt-2">@comment.Content</MudText>
            <MudText Typo="Typo.caption">@comment.CreatedAt.ToShortDateString()</MudText>
        }
        <MudTextField @bind-Value="_commentDraft" Label="@L["WriteAComment"]" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="SaveComment">@L["AddComment"]</MudButton>
    </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="@L["Context"]">

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">@L["CompiledBrief"]</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Compile" Disabled="_compiling">
                @L["CompileBrief"]
            </MudButton>
        </MudStack>
        <div class="beacon-budget mt-2">
            <div class="beacon-budget-label">
                <span class="mud-typography mud-typography-caption">@L["TokenBudget"]</span>
                <span class="mud-typography mud-typography-caption">@_briefTokens / @_briefBudget</span>
            </div>
            <MudProgressLinear Value="@TokenBudgetMeter.Percent(_briefTokens, _briefBudget)" Color="@(_briefOverflow ? Color.Warning : Color.Default)" Class="mt-1 beacon-track" />
            @if (_briefOverflow)
            {
                <MudText Typo="Typo.caption" Class="mt-1">@L["BudgetOverflow"]</MudText>
            }
        </div>
        @if (!string.IsNullOrEmpty(_briefError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_briefError</MudAlert>
        }
        @if (!string.IsNullOrEmpty(_briefMarkdown))
        {
            <MudText Typo="Typo.body2" Class="mt-4 beacon-pre">@_briefMarkdown</MudText>
        }
    </MudPaper>
    </MudTabPanel>
    </MudTabs>
}

@code {
    private static readonly string[] StageChips = { "StagePlanning", "StageExecuting", "StageReviewing", "StageApproved", "Closed" };
    private string[] StageLabels => StageChips.Select((key, i) =>
        _pipeline?.Stage == TaskPipelineStage.ReopenedForRevision && i == 1
            ? L["StageReopenedForRevision"].Value
            : L[key].Value).ToArray();
    private static readonly TaskItemStatus[] StatusOptions = Enum.GetValues<TaskItemStatus>();

    [Parameter] public Guid TaskId { get; set; }
    private TaskItemDto? _task;
    private TaskItemStatus _status = TaskItemStatus.Todo;
    private bool _loading = true;
    private PipelineStateDto? _pipeline;
    private bool _busy;
    private bool _isAdmin;
    private string? _userId;
    private string? _briefMarkdown;
    private string? _briefError;
    private int _briefTokens;
    private int _briefBudget = 8000;
    private bool _briefOverflow;
    private bool _compiling;
    private string _commentDraft = string.Empty;
    private string _reviewDraft = string.Empty;
    private List<LabelDto> _labels = [];
    private List<MilestoneDto> _milestones = [];
    private List<TaskStepDto> _steps = [];
    private List<TaskPhaseDto> _phases = [];
    private Guid? _openPhaseId;
    private string _stepTitle = string.Empty;

    private string HeroStateClass => _pipeline?.Stage switch
    {
        TaskPipelineStage.Reviewing or TaskPipelineStage.ReopenedForRevision => "is-warning",
        TaskPipelineStage.Approved or TaskPipelineStage.Closed => "is-success",
        TaskPipelineStage.Executing or TaskPipelineStage.Planning => "is-info",
        _ => _task?.Status switch
        {
            "Done" => "is-success",
            "InProgress" => "is-info",
            _ => ""
        }
    };

    private string HeroStateLabel =>
        _pipeline?.Stage is { } stage && stage != TaskPipelineStage.None
            ? PipelineStageLabel(stage)
            : _task is null ? string.Empty : ChromeLabels.Status(L, _task.Status);

    private static string SessionStateClass(SessionStatus status) => status switch
    {
        SessionStatus.Active => "is-info",
        SessionStatus.Failed => "is-danger",
        SessionStatus.Closed => "is-success",
        _ => ""
    };

    private static string SubtaskStateClass(SubtaskStatus status) => status switch
    {
        SubtaskStatus.InProgress => "is-info",
        SubtaskStatus.Done => "is-success",
        SubtaskStatus.Failed => "is-danger",
        _ => ""
    };

    private string NextTone => _pipeline?.Stage switch
    {
        TaskPipelineStage.Reviewing or TaskPipelineStage.ReopenedForRevision => "is-warning",
        TaskPipelineStage.Approved or TaskPipelineStage.Closed => "is-success",
        TaskPipelineStage.Executing => "is-info",
        _ => ""
    };

    private string NextStepText
    {
        get
        {
            if (_pipeline is null || _pipeline.Stage is null || _pipeline.Stage == TaskPipelineStage.None)
                return L["NextStepTodo"].Value;
            return _pipeline.Stage switch
            {
                TaskPipelineStage.Planning => L["NextStepCreateSubtask"].Value,
                TaskPipelineStage.Executing => L["NextStepCreateSubtask"].Value,
                TaskPipelineStage.Reviewing => L["Approve"].Value,
                TaskPipelineStage.Approved => L["ConfirmClose"].Value,
                _ => L["NextStepTodo"].Value
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _isAdmin = bool.TryParse(auth.User.FindFirst("isAdmin")?.Value, out var adminFlag) && adminFlag;
        await Reload();
        _loading = false;
        if (_task is not null)
        {
            await ReloadPipeline();
            await ReloadSteps();
            await Compile();
        }
    }

    private async Task Reload()
    {
        var result = await GetTask.HandleAsync(new GetTaskCommand(new GetTaskRequest(TaskId)));
        _task = result.Success ? result.Value : null;
        _status = Enum.TryParse<TaskItemStatus>(_task?.Status, out var parsedStatus) ? parsedStatus : TaskItemStatus.Todo;
        _reviewDraft = _task?.ReviewNotes ?? string.Empty;
        if (_task is not null)
        {
            var labels = await ListLabels.HandleAsync(new ListLabelsRequest(_task.ProjectId));
            _labels = labels.Success ? labels.Value!.ToList() : [];
            var milestones = await ListMilestones.HandleAsync(new ListProjectMilestonesCommand(new ListProjectMilestonesRequest(_task.ProjectId)));
            _milestones = milestones.Success ? milestones.Value!.ToList() : [];
        }
    }

    private async Task OnStatusChanged(TaskItemStatus status)
    {
        if (_task is null || _busy) return;
        var previous = _status;
        _status = status;
        _busy = true;
        try
        {
            var result = await ChangeStatus.HandleAsync(new ChangeTaskStatusCommand(
                new ChangeTaskStatusRequest(_task.Id, status, _task.ProjectId)));
            if (!result.Success)
            {
                _status = previous;
                Snackbar.Add(result.Error ?? L["StatusChangeFailed"].Value, Severity.Error);
                return;
            }
            await Reload();
            Snackbar.Add(string.Format(L["TaskMoved"].Value, ChromeLabels.Status(L, status)), Severity.Info);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EditTask()
    {
        if (_task is null) return;
        var parameters = new DialogParameters
        {
            { nameof(TaskDialog.ProjectId), _task.ProjectId },
            { nameof(TaskDialog.Task), _task },
            { nameof(TaskDialog.Labels), _labels },
            { nameof(TaskDialog.Milestones), _milestones }
        };
        var reference = await Dialogs.ShowAsync(typeof(TaskDialog), L["EditTask"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await reference.Result;
        if (result?.Data is TaskItemDto)
        {
            Snackbar.Add(L["Saved"].Value, Severity.Success);
            await Reload();
        }
    }

    private async Task ReloadPipeline()
    {
        var result = await GetPipeline.HandleAsync(new GetPipelineCommand(new GetPipelineRequest(TaskId)));
        _pipeline = result.Success ? result.Value : null;
    }

    private async Task ReloadSteps()
    {
        var result = await ListSteps.HandleAsync(new ListTaskStepsCommand(new ListTaskStepsRequest(TaskId)));
        _steps = result.Success ? result.Value!.ToList() : [];
        var phases = await ListPhases.HandleAsync(new ListTaskPhasesCommand(TaskId));
        _phases = phases.Success ? phases.Value!.ToList() : [];
        _openPhaseId ??= _phases.FirstOrDefault(p => p.Status == TaskPhaseStatus.Active)?.Id ?? _phases.FirstOrDefault()?.Id;
    }

    private void TogglePhase(Guid id) => _openPhaseId = _openPhaseId == id ? null : id;

    private IEnumerable<SubtaskDto> PhaseSubtasks(Guid phaseId) =>
        _pipeline?.Subtasks.Where(s => s.TaskPhaseId == phaseId) ?? [];

    private string ModelName(Guid? id) =>
        id is null ? L["Unbound"].Value : L["PhaseModel"].Value;

    private async Task OnAddStep()
    {
        if (_busy || string.IsNullOrWhiteSpace(_stepTitle))
            return;
        _busy = true;
        try
        {
            var result = await AddStep.HandleAsync(new AddTaskStepCommand(new AddTaskStepRequest(TaskId, _stepTitle)));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _stepTitle = string.Empty;
            await ReloadSteps();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnToggleStep(TaskStepDto step, bool done)
    {
        var result = await ToggleStep.HandleAsync(new ToggleTaskStepCommand(new ToggleTaskStepRequest(step.Id, done)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        await ReloadSteps();
    }

    private async Task OnDeleteStep(TaskStepDto step)
    {
        var result = await DeleteStep.HandleAsync(new DeleteTaskStepCommand(new DeleteTaskStepRequest(step.Id)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        await ReloadSteps();
    }

    private static int StageIndex(TaskPipelineStage? stage) => stage switch
    {
        TaskPipelineStage.Planning => 0,
        TaskPipelineStage.Executing or TaskPipelineStage.ReopenedForRevision => 1,
        TaskPipelineStage.Reviewing => 2,
        TaskPipelineStage.Approved => 3,
        TaskPipelineStage.Closed => 4,
        _ => -1
    };

