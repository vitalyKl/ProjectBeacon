            var result = await StartPipeline.HandleAsync(new StartPipelineCommand(new StartPipelineRequest(TaskId)));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            var launch = await LaunchSession.HandleAsync(
                new LaunchSessionCommand(new LaunchSessionRequest(result.Value!.Id)));
            if (!launch.Success)
                Snackbar.Add(launch.Error ?? L["Error"].Value, Severity.Error);
            else
                Snackbar.Add(L["PipelineStarted"].Value, Severity.Success);
            await Reload();
            await ReloadPipeline();
        }
        finally
        {
            _busy = false;
        }
