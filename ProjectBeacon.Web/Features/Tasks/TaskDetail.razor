    };

    private int SubStageToPercent(TaskSubStage stage) => stage switch
    {
        TaskSubStage.RequirementGathering => 10,
        TaskSubStage.Estimation => 20,
        TaskSubStage.IntermediateResult => 40,
        TaskSubStage.Review => 60,
        TaskSubStage.Corrections => 75,
        TaskSubStage.ReviewCorrections => 90,
        TaskSubStage.Complete => 100,
        _ => 0
    };
