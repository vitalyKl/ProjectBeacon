@using ProjectBeacon.Web.Features.Chat
@page "/task/{taskId:guid}"
@implements IDisposable
@layout MainLayout
@attribute [Authorize]
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Milestones
@using ProjectBeacon.Application.Proposals
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Theme
@using Microsoft.AspNetCore.Components.Authorization
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetTaskHandler GetTask
@inject ListLabelsHandler ListLabels
@inject ListProjectMilestonesHandler ListMilestones
@inject GetPipelineHandler GetPipeline
@inject ListProposalsHandler ListProposals
@inject WorkspaceIndexHandler WorkspaceIndex
@inject WorkspaceReadHandler WorkspaceRead
@inject WorkspaceWriteHandler WorkspaceWrite
@inject StartPipelineHandler StartPipeline
@inject StartActorSessionHandler StartActorSession
@inject LaunchSessionHandler LaunchSession
@inject RetryPipelineSessionHandler RetrySession
@inject CancelPipelineSessionHandler CancelPipelineSession
@inject CancelSubtaskHandler CancelSubtask
@inject CancelPipelineHandler CancelPipeline
@inject RestartPipelineHandler RestartPipeline
@inject DeleteTaskHandler DeleteTask
@inject StartReviewHandler StartReview
@inject ListTaskStepsHandler ListSteps
@inject ListTaskPhasesHandler ListPhases
@inject AddTaskStepHandler AddStep
@inject ToggleTaskStepHandler ToggleStep
@inject DeleteTaskStepHandler DeleteStep
@inject ChangeTaskStatusHandler ChangeStatus
@inject IDialogService Dialogs
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@L["TaskDetail"]</PageTitle>



@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_task is null)
{
    <MudAlert Severity="Severity.Info">@L["TaskNotFound"]</MudAlert>
}
else
{
    <header class="beacon-task-hero">
        <div>
            <div class="beacon-task-kicker">
                <span class="beacon-state @HeroStateClass">@HeroStateLabel</span>
                <StatusChip Color="@ChipPalette.ForPriority(_task.Priority)" Label="@ChromeLabels.Priority(L, _task.Priority)" />
                <span class="beacon-ops-sub">@ChromeLabels.Type(L, _task.Type)</span>
            </div>
            <div class="beacon-task-title" title="@_task.Title">@_task.Title</div>
            @if (!string.IsNullOrEmpty(_task.Description))
            {
                <div class="beacon-task-goal">
                    <strong>@L["Goal"]</strong>
                    <MarkdownView Text="@_task.Description" />
                </div>
            }
        </div>
        <div class="beacon-page-actions">
            @if (_pipeline is null || _pipeline.Stage is null || _pipeline.Stage == TaskPipelineStage.None)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Large"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="OnStartPipeline" Disabled="_busy || !CanStartPlanner">@L["StartPipeline"]</MudButton>
                <MudText Typo="Typo.caption" Class="beacon-pipeline-start-hint">@L["PipelineStartHint"]</MudText>
                @if (!CanStartPlanner)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">@PlannerPreflightMessage</MudAlert>
                }
            }
            else
            {
                @switch (_pipeline.Stage)
                {
                    case TaskPipelineStage.Executing:
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnStartReview" Disabled="_busy || !CanStartReview">@L["StartReview"]</MudButton>
                        @if (!CanStartReview)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">@ReviewPreflightMessage</MudText>
                        }
                        break;
                    case TaskPipelineStage.Reviewing:
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ReviewApprove))" Disabled="_busy">@L["Approve"]</MudButton>
                        break;
                    case TaskPipelineStage.Approved:
                        <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ConfirmClose))" Disabled="_busy">@L["ConfirmClose"]</MudButton>
                        break;
                }
                <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
                    @if (_pipeline.Stage is not (TaskPipelineStage.Cancelled or TaskPipelineStage.Closed))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="OnCancelPipeline" Disabled="_busy">
                            @L["CancelPipeline"]
                        </MudButton>
                    }
                    @if (_task.Status != "Done" && _pipeline.Stage is not (TaskPipelineStage.Cancelled or TaskPipelineStage.Closed))
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="OnRestartPipeline" Disabled="_busy">
                            @L["RestartPipeline"]
                        </MudButton>
                    }
                </MudStack>
            }
        </div>
    </header>
    <div class="beacon-task-grid">
        <main class="beacon-task-main">
            <section class="beacon-task-workflow">
                <header class="beacon-task-workflow-head">
                    <MudText Typo="Typo.h6">@L["Work"]</MudText>
                    @if (_pipeline?.Sessions.Any(x => x.Status == SessionStatus.WaitingForUser) == true)
                    {
                        <StatusChip Color="Color.Warning" Label="@L["WaitingForUser"]" />
                    }
                </header>
                @if (_pipeline is { } activityPipeline && activityPipeline.Sessions.Any(s =>
                    (s.Role is PipelineRole.Planner or PipelineRole.Review)
                    && (s.Status is SessionStatus.Ready or SessionStatus.Active or SessionStatus.WaitingForUser or SessionStatus.Failed)))
                {
                    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-3">
                        <MudText Typo="Typo.subtitle1">@L["TaskCurrentActivity"]</MudText>
                        @foreach (var session in activityPipeline.Sessions
                            .Where(s => (s.Role is PipelineRole.Planner or PipelineRole.Review)
                                && (s.Status is SessionStatus.Ready or SessionStatus.Active or SessionStatus.WaitingForUser or SessionStatus.Failed))
                            .OrderByDescending(s => s.LastActivityAt ?? s.LaunchedAt))
                        {
                            <PipelineActivityPanel TaskId="TaskId" Session="session" />
                            @if (session.Status == SessionStatus.Failed)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => OnRetrySession(session))" Disabled="_busy">@L["RetrySession"]</MudButton>
                            }
                        }
                    </MudPaper>
                }
                <TaskWorkPanel Phases="_phases" OpenPhaseId="_openPhaseId" Pipeline="_pipeline" OnToggle="TogglePhase"
                              Busy="_busy" Preflight="_pipeline?.Preflight" OnStartActorSession="OnStartActorSession"
                              OnReportResult="@(subtask => OpenPipelineDialog(PipelineDialogMode.ReportResult, subtask))"
                              OnFailSubtask="@(subtask => OpenPipelineDialog(PipelineDialogMode.FailSubtask, subtask))"
                              OnCancelSubtask="OnCancelSubtask"
                              OnLaunchSession="OnLaunchSession" OnRetrySession="OnRetrySession" />
                @if (_pipeline?.Stage is not null && _pipeline.Stage != TaskPipelineStage.None)
                {
                    <TaskPipelinePanel Pipeline="_pipeline" Busy="_busy" OnLaunch="OnLaunchSession" OnRetry="OnRetrySession" OnCancel="OnCancelPipelineSession" />
                }
            </section>
        </main>
        <aside class="beacon-task-aside">
    
                <section class="beacon-panel beacon-surface-section">
                    <div class="beacon-ops-pad">
                        @if (_pipeline?.Stage is TaskPipelineStage.Planning or TaskPipelineStage.Executing)
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.CreateSubtask))" Disabled="_busy">@L["CreateSubtask"]</MudButton>
                        }
                        @if (_pipeline?.Stage == TaskPipelineStage.Reviewing)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ReviewReopen))" Disabled="_busy">@L["ReopenSubtask"]</MudButton>
                        }
                        @if (_isAdmin && _pipeline?.Stage is TaskPipelineStage.ReopenedForRevision or TaskPipelineStage.Approved)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ForceClose))" Disabled="_busy">@L["ForceClose"]</MudButton>
                        }
                        <MudDivider Class="my-1" />
                        <MudButton Variant="Variant.Text" OnClick="EditTask">@L["Edit"]</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="OnDeleteTask" Disabled="_busy">@L["DeleteTask"]</MudButton>
                        <MudSelect T="TaskItemStatus"
                            Value="_status"
                            ValueChanged="OnStatusChanged"
                            Label="@L["Status"]"
                            Variant="Variant.Outlined"
                            Margin="Margin.Dense"
                            Dense="true"
                            Disabled="_busy"
                            Class="mt-3">
                            @foreach (var status in StatusOptions)
                            {
                                <MudSelectItem Value="status">@ChromeLabels.Status(L, status)</MudSelectItem>
                            }
                        </MudSelect>
                        @if (_task.Status == "Done" && _task.CompletedAt.HasValue)
                        {
                            <MudText Typo="Typo.body2" Class="mt-2">@L["Done"] <LocalTime Value="_task.CompletedAt" Format="d" /></MudText>
                        }
                    </div>
                </section>
                <section class="beacon-panel beacon-surface-section">
                    <header class="beacon-ops-head">
                        <div class="beacon-ops-title">@L["TaskSteps"]</div>
                    </header>
                    <div class="beacon-ops-pad">
                        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2">
                            <MudTextField @bind-Value="_stepTitle" Label="@L["StepTitle"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnAddStep" Disabled="_busy || string.IsNullOrWhiteSpace(_stepTitle)">@L["AddStep"]</MudButton>
                        </MudStack>
                        @if (_steps.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Class="mt-2">@L["NoStepsYet"]</MudText>
                        }
                        @foreach (var step in _steps)
                        {
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                                <MudCheckBox T="bool" Value="step.IsDone" ValueChanged="done => OnToggleStep(step, done)" Dense="true" aria-label="@step.Title" />
                                <MudText Typo="Typo.body2" Class="@StepTitleClass(step.IsDone)">@step.Title</MudText>
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => OnDeleteStep(step)">@L["Delete"]</MudButton>
                            </MudStack>
                        }
                    </div>
                </section>
                <TaskReviewNotesPanel Task="_task" OnSaved="Reload" />
        </aside>
    </div>
    <MudTabs Rounded="true" ApplyEffectsToContainer="false" Class="mt-4 beacon-task-tabs">
    <MudTabPanel Text="@L["Discussion"]">
        <TaskDiscussionPanel Task="_task" OnSaved="Reload" />
        <TaskAttachmentsPanel Task="_task" />
    </MudTabPanel>
    <MudTabPanel Text="@L["Context"]">
        <TaskContextPanel Task="_task" />
    </MudTabPanel>
    <MudTabPanel Text="@($"{L["TaskProposals"]} ({_taskProposals.Count})")">
        <MudStack Spacing="2" Class="pa-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">@L["TaskProposalsHint"]</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="ReloadTaskProposals" Disabled="_busy">
                    @L["Refresh"]
                </MudButton>
            </MudStack>
            @if (_taskProposals.Count == 0)
            {
                <EmptyState>@L["NoTaskProposals"]</EmptyState>
            }
            @foreach (var proposal in _taskProposals)
            {
                <MudPaper @key="proposal.Id" Elevation="0" Outlined="true" Class="pa-3">
                    <MudStack Spacing="1">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                            <MudText Typo="Typo.subtitle2">@proposal.TargetKind</MudText>
                            <StatusChip Color="@TaskProposalColor(proposal.Status)" Label="@TaskProposalStatus(proposal.Status)" />
                            <MudSpacer />
                            <MudText Typo="Typo.caption">rev. @proposal.BaseRevision</MudText>
                        </MudStack>
                        <MarkdownView Text="@proposal.RationaleMarkdown" />
                        @if (proposal.Status == ProposalStatus.Conflicted)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">
                                @L["ProposalConflict"]: @proposal.ConflictReason
                            </MudAlert>
                        }
                        @if (proposal.Status == ProposalStatus.Accepted)
                        {
                            <MudText Typo="Typo.caption">@L["AppliedRevision"]: @(proposal.AppliedRevision?.ToString() ?? "—")</MudText>
                        }
                    </MudStack>
                </MudPaper>
            }
            <MudButton Href="/inbox" Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Inbox">
                @L["OpenProposalInbox"]
            </MudButton>
        </MudStack>
    </MudTabPanel>
    <MudTabPanel Text="@L["TaskWorkspace"]">
        <MudStack Spacing="3" Class="pa-2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.body2">@L["TaskWorkspaceHelp"]</MudText>
                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Refresh"
                           OnClick="ReloadWorkspace" Disabled="_busy">@L["Refresh"]</MudButton>
            </MudStack>
            <MudGrid Spacing="3">
                <MudItem xs="12" md="4">
                    <MudText Typo="Typo.subtitle2">@L["WorkspaceSections"] (@_workspaceSections.Count)</MudText>
                    @if (_workspaceSections.Count == 0)
                    {
                        <MudText Typo="Typo.body2" Class="mt-2">@L["WorkspaceEmpty"]</MudText>
                    }
                    @foreach (var section in _workspaceSections)
                    {
                        <MudButton FullWidth="true" Variant="@(_selectedWorkspace?.Key == section.Key ? Variant.Filled : Variant.Text)"
                                   Color="@(_selectedWorkspace?.Key == section.Key ? Color.Primary : Color.Default)"
                                   Class="justify-start mt-1" OnClick="@(() => OnReadWorkspaceSection(section.Key))">
                            <MudStack Spacing="0" AlignItems="AlignItems.Start" Class="text-left">
                                <MudText Typo="Typo.body2">@section.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@section.Key · @section.Kind · r@section.Revision</MudText>
                                <MudText Typo="Typo.caption">@section.Abstract</MudText>
                            </MudStack>
                        </MudButton>
                    }
                </MudItem>
                <MudItem xs="12" md="8">
                    @if (_selectedWorkspace is not null)
                    {
                        <MudStack Spacing="1">
                            <MudText Typo="Typo.subtitle1">@_selectedWorkspace.Title</MudText>
                            <MudText Typo="Typo.caption">@_selectedWorkspace.Key · @_selectedWorkspace.Kind · @_selectedWorkspace.AuthorRole · <LocalTime Value="_selectedWorkspace.UpdatedAt" Format="g" /></MudText>
                            <MudText Typo="Typo.body2">@_selectedWorkspace.Abstract</MudText>
                            <MarkdownView Text="@_selectedWorkspace.Content" MaxHeight="520" />
                        </MudStack>
                    }
                    else
                    {
                        <MudText Typo="Typo.body2">@L["WorkspaceSelectHint"]</MudText>
                    }
                </MudItem>
            </MudGrid>
            <MudExpansionPanels>
                <MudExpansionPanel Text="@L["AddWorkspaceNote"]">
                    <MudStack Spacing="2">
                        <MudTextField T="string" @bind-Value="_workspaceKey" Label="@L["WorkspaceKey"]" Variant="Variant.Outlined" />
                        <MudTextField T="string" @bind-Value="_workspaceTitle" Label="@L["Title"]" Variant="Variant.Outlined" />
                        <MudTextField T="string" @bind-Value="_workspaceAbstract" Label="@L["WorkspaceAbstract"]" Variant="Variant.Outlined" />
                        <MarkdownEditor @bind-Value="_workspaceContent" Label="@L["Content"]" Lines="6" />
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnCreateWorkspaceNote"
                                   Disabled="_busy || string.IsNullOrWhiteSpace(_workspaceKey) || string.IsNullOrWhiteSpace(_workspaceTitle) || string.IsNullOrWhiteSpace(_workspaceAbstract) || string.IsNullOrWhiteSpace(_workspaceContent)">
                            @L["Create"]
                        </MudButton>
                    </MudStack>
                </MudExpansionPanel>
            </MudExpansionPanels>
        </MudStack>
    </MudTabPanel>
    </MudTabs>
}

@code {
    private static readonly TaskItemStatus[] StatusOptions = Enum.GetValues<TaskItemStatus>();

    [Parameter] public Guid TaskId { get; set; }
    private TaskItemDto? _task;
    private TaskItemStatus _status = TaskItemStatus.Todo;
    private bool _loading = true;
    private CancellationTokenSource? _pipelinePoll;
    private PipelineStateDto? _pipeline;
    private bool _busy;
    private bool _isAdmin;
    private ActorContext _actorContext = ActorContext.Anonymous;
    private List<ProposalDto> _taskProposals = [];
    private List<TaskWorkspaceSectionSummaryDto> _workspaceSections = [];
    private TaskWorkspaceSectionDto? _selectedWorkspace;
    private string _workspaceKey = "notes/human-input";
    private string _workspaceTitle = string.Empty;
    private string _workspaceAbstract = string.Empty;
    private string _workspaceContent = string.Empty;
    private bool CanStartPlanner => _pipeline?.CanStart == true;
    private bool CanStartReview => _pipeline?.Preflight is { HasOnlineNativeWorkstation: true, ReviewModelConfigured: true };
    private string ReviewPreflightMessage => _pipeline?.Preflight?.HasNativeWorkstation != true
        ? L["PipelinePreflightNoNativeWorkstation"].Value
        : _pipeline.Preflight.HasOnlineNativeWorkstation != true
            ? L["PipelineNativeWorkstationOffline"].Value
            : L["PipelinePreflightNoRoleModel"].Value;
    private string PlannerPreflightMessage => string.IsNullOrWhiteSpace(_pipeline?.StartBlockedReason)
        ? L["PipelinePreflightNoPlannerModel"].Value
        : L[_pipeline.StartBlockedReason].Value;
    private string? _userId;

    private List<LabelDto> _labels = [];
    private List<MilestoneDto> _milestones = [];
    private List<TaskStepDto> _steps = [];
    private List<TaskPhaseDto> _phases = [];
    private Guid? _openPhaseId;
    private string _stepTitle = string.Empty;

    private bool HasStaleActiveSession => _pipeline?.Sessions.Any(session =>
        session.Status == SessionStatus.Active
        && (session.LastActivityAt is not { } lastActivity || DateTime.UtcNow - lastActivity > TimeSpan.FromSeconds(30))) == true;

    private string HeroStateClass => _pipeline?.Sessions.Any(x => x.Status == SessionStatus.WaitingForUser) == true || HasStaleActiveSession
        ? "is-warning"
        : _pipeline?.Stage switch
    {
        TaskPipelineStage.Reviewing or TaskPipelineStage.ReopenedForRevision => "is-warning",
        TaskPipelineStage.Approved or TaskPipelineStage.Closed => "is-success",
        TaskPipelineStage.Executing or TaskPipelineStage.Planning => "is-info",
        _ => _task?.Status switch
        {
            "Done" => "is-success",
            "InProgress" => "is-info",
            _ => ""
        }
    };

    private string HeroStateLabel
    {
        get
        {
            if (_pipeline?.Sessions.Any(s => s.Status == SessionStatus.WaitingForUser) == true)
                return L["WaitingForUser"].Value;

            var current = _pipeline?.Sessions
                .Where(s => s.Status is SessionStatus.Active or SessionStatus.Ready or SessionStatus.Failed)
                .OrderByDescending(s => s.LastActivityAt ?? s.LaunchedAt)
                .FirstOrDefault();
            if (current is not null)
            {
                var role = SessionRoleLabel(current.Role);
                if (current.Status == SessionStatus.Ready)
                    return $"{role} · {L["PipelineActivityReady"].Value}";
                if (current.Status == SessionStatus.Failed)
                    return $"{role} · {L["PipelineActivityFailed"].Value}";
                if (current.LastActivityAt is not { } lastActivity || DateTime.UtcNow - lastActivity > TimeSpan.FromSeconds(30))
                    return $"{role} · {L["PipelineNoRecentSignal"].Value}";

                var age = DateTime.UtcNow - lastActivity;
                var updated = age < TimeSpan.FromMinutes(1)
                    ? string.Format(L["PipelineUpdatedSecondsAgo"].Value, Math.Max(0, (int)age.TotalSeconds))
                    : string.Format(L["PipelineUpdatedMinutesAgo"].Value, Math.Max(1, (int)age.TotalMinutes));
                return $"{role} · {updated}";
            }

            return _pipeline?.Stage is { } stage && stage != TaskPipelineStage.None
                ? PipelineStageLabel(stage)
                : _task is null ? string.Empty : ChromeLabels.Status(L, _task.Status);
        }
    }

    private string SessionRoleLabel(PipelineRole role) => role switch
    {
        PipelineRole.Planner => L["RoleBindingPlanner"].Value,
        PipelineRole.Actor => L["RoleBindingActor"].Value,
        PipelineRole.Review => L["Review"].Value,
        _ => role.ToString()
    };

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _actorContext = ActorContextFactory.FromPrincipal(auth.User);
        _isAdmin = bool.TryParse(auth.User.FindFirst("isAdmin")?.Value, out var adminFlag) && adminFlag;
        await Reload();
        _loading = false;
        if (_task is not null)
        {
            await ReloadPipeline();
            await ReloadSteps();
            await ReloadWorkspace();
        }
        _pipelinePoll = new CancellationTokenSource();
        _ = PollPipelineAsync(_pipelinePoll.Token);
    }

    private async Task PollPipelineAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(4), ct);
                if (_pipeline?.Stage is null or TaskPipelineStage.None or TaskPipelineStage.Closed or TaskPipelineStage.Cancelled)
                    continue;
                try
                {
                    await ReloadPipeline();
                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException) when (ct.IsCancellationRequested)
                {
                    throw;
                }
                catch (Exception ex)
                {
                    // Keep the live activity loop alive after a transient read failure.
                    Console.Error.WriteLine($"Task pipeline refresh failed: {ex.Message}");
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    public void Dispose()
    {
        _pipelinePoll?.Cancel();
        _pipelinePoll?.Dispose();
    }

    private async Task Reload()
    {
        var result = await GetTask.HandleAsync(new GetTaskCommand(new GetTaskRequest(TaskId)));
        _task = result.Success ? result.Value : null;
        _status = Enum.TryParse<TaskItemStatus>(_task?.Status, out var parsedStatus) ? parsedStatus : TaskItemStatus.Todo;
        if (_task is not null)
        {
            var labels = await ListLabels.HandleAsync(new ListLabelsRequest(_task.ProjectId));
            _labels = labels.Success ? labels.Value!.ToList() : [];
            var milestones = await ListMilestones.HandleAsync(new ListProjectMilestonesCommand(new ListProjectMilestonesRequest(_task.ProjectId)));
            _milestones = milestones.Success ? milestones.Value!.ToList() : [];
            await ReloadTaskProposals();
        }
    }

    private async Task ReloadTaskProposals()
    {
        if (_task is null || !_actorContext.IsHuman)
        {
            _taskProposals = [];
            return;
        }

        var proposals = await ListProposals.HandleAsync(
            new ListProposalsQuery(_task.ProjectId, TaskId: TaskId, Limit: 100),
            _actorContext);
        _taskProposals = proposals.Success ? proposals.Value!.ToList() : [];
    }

    private string TaskProposalStatus(ProposalStatus status) => status switch
    {
        ProposalStatus.Pending => L["Pending"].Value,
        ProposalStatus.Conflicted => L["Conflicted"].Value,
        _ => L[status.ToString()].Value
    };

    private static Color TaskProposalColor(ProposalStatus status) => status switch
    {
        ProposalStatus.Pending => Color.Warning,
        ProposalStatus.Conflicted => Color.Error,
        ProposalStatus.Accepted => Color.Success,
        _ => Color.Default
    };

    private async Task OnStatusChanged(TaskItemStatus status)
    {
        if (_task is null || _busy) return;
        var previous = _status;
        _status = status;
        _busy = true;
        try
        {
            var result = await ChangeStatus.HandleAsync(new ChangeTaskStatusCommand(
                new ChangeTaskStatusRequest(_task.Id, status, _task.ProjectId)));
            if (!result.Success)
            {
                _status = previous;
                Snackbar.Add(result.Error ?? L["StatusChangeFailed"].Value, Severity.Error);
                return;
            }
            await Reload();
            Snackbar.Add(string.Format(L["TaskMoved"].Value, ChromeLabels.Status(L, status)), Severity.Info);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EditTask()
    {
        if (_task is null) return;
        var parameters = new DialogParameters
        {
            { nameof(TaskDialog.ProjectId), _task.ProjectId },
            { nameof(TaskDialog.Task), _task },
            { nameof(TaskDialog.Labels), _labels },
            { nameof(TaskDialog.Milestones), _milestones }
        };
        var reference = await Dialogs.ShowAsync(typeof(TaskDialog), L["EditTask"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await reference.Result;
        if (result?.Data is TaskItemDto)
        {
            Snackbar.Add(L["Saved"].Value, Severity.Success);
            await Reload();
        }
    }

    private async Task ReloadPipeline()
    {
        var result = await GetPipeline.HandleAsync(new GetPipelineCommand(new GetPipelineRequest(TaskId)));
        _pipeline = result.Success ? result.Value : null;
    }

    private async Task ReloadWorkspace()
    {
        if (_task is null)
            return;
        var result = await WorkspaceIndex.HandleAsync(new WorkspaceIndexQuery(
            new WorkspaceIndexRequest(TaskId, Limit: 100)));
        _workspaceSections = result.Success ? result.Value!.ToList() : [];
        if (_selectedWorkspace is not null
            && _workspaceSections.Any(section => section.Key == _selectedWorkspace.Key))
            await OnReadWorkspaceSection(_selectedWorkspace.Key);
        else if (_selectedWorkspace is not null)
            _selectedWorkspace = null;

        if (_workspaceKey == "notes/human-input"
            && _workspaceSections.Any(section => section.Key == _workspaceKey))
            SetNextHumanWorkspaceKey();
    }

    private void SetNextHumanWorkspaceKey()
    {
        var noteNumber = 0;
        var key = "notes/human-input";
        while (_workspaceSections.Any(section => section.Key == key))
        {
            noteNumber++;
            key = $"notes/human-input-{noteNumber}";
        }
        _workspaceKey = key;
    }

    private async Task OnReadWorkspaceSection(string key)
    {
        var result = await WorkspaceRead.HandleAsync(new WorkspaceReadQuery(
            new WorkspaceReadRequest(TaskId, key, Offset: 0, Limit: 8000)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _selectedWorkspace = result.Value;
    }

    private async Task OnCreateWorkspaceNote()
    {
        if (_busy || _task is null)
            return;
        if (_actorContext.UserId is null || !_actorContext.IsHuman)
        {
            Snackbar.Add(L["WorkspaceHumanIdentityRequired"].Value, Severity.Error);
            return;
        }

        _busy = true;
        try
        {
            var result = await WorkspaceWrite.HandleAsync(new WorkspaceWriteCommand(
                new WorkspaceWriteRequest(TaskId, _workspaceKey, _workspaceTitle,
                    _workspaceAbstract, _workspaceContent, "create"), _actorContext));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _workspaceTitle = string.Empty;
            _workspaceAbstract = string.Empty;
            _workspaceContent = string.Empty;
            await ReloadWorkspace();
            SetNextHumanWorkspaceKey();
            await OnReadWorkspaceSection(result.Value!.Key);
            Snackbar.Add(L["WorkspaceNoteCreated"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadSteps()
    {
        var result = await ListSteps.HandleAsync(new ListTaskStepsCommand(new ListTaskStepsRequest(TaskId)));
        _steps = result.Success ? result.Value!.ToList() : [];
        var phases = await ListPhases.HandleAsync(new ListTaskPhasesCommand(TaskId));
        _phases = phases.Success ? phases.Value!.ToList() : [];
        _openPhaseId ??= _phases.FirstOrDefault(p => p.Status == TaskPhaseStatus.Active)?.Id ?? _phases.FirstOrDefault()?.Id;
    }

    private void TogglePhase(Guid id) => _openPhaseId = _openPhaseId == id ? null : id;

