@page "/task/{taskId:guid}"
@layout MainLayout
@attribute [Authorize]
@using ProjectBeacon.Application.Context
@using ProjectBeacon.Application.Milestones
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Theme
@using Microsoft.AspNetCore.Components.Authorization
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetTaskHandler GetTask
@inject ListLabelsHandler ListLabels
@inject ListProjectMilestonesHandler ListMilestones
@inject CompileBriefHandler CompileBrief
@inject AddCommentHandler AddComment
@inject AddReviewNotesHandler AddReviewNotes
@inject GetPipelineHandler GetPipeline
@inject StartPipelineHandler StartPipeline
@inject StartActorSessionHandler StartActorSession
@inject LaunchSessionHandler LaunchSession
@inject StartReviewHandler StartReview
@inject ListTaskStepsHandler ListSteps
@inject AddTaskStepHandler AddStep
@inject ToggleTaskStepHandler ToggleStep
@inject DeleteTaskStepHandler DeleteStep
@inject ChangeTaskStatusHandler ChangeStatus
@inject IDialogService Dialogs
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar
@inject NavigationManager Navigation

<PageTitle>@L["TaskDetail"]</PageTitle>

<PageHeader Title="@(_task?.Title ?? L["TaskDetail"].Value)">
    @if (_task is not null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="EditTask">@L["Edit"]</MudButton>
    }
    <MudButton Variant="Variant.Outlined" OnClick="@(() => Navigation.NavigateTo("/board"))">
        @L["BackToBoard"]
    </MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_task is null)
{
    <MudAlert Severity="Severity.Info">@L["TaskNotFound"]</MudAlert>
}
else
{
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel">
        @if (!string.IsNullOrEmpty(_task.Description))
        {
            <MudText Typo="Typo.body1">@_task.Description</MudText>
        }
        <MudStack Row="true" Spacing="2" Class="mt-4">
            <MudSelect T="TaskItemStatus"
                Value="_status"
                ValueChanged="OnStatusChanged"
                Label="@L["Status"]"
                Variant="Variant.Outlined"
                Margin="Margin.Dense"
                Dense="true"
                Disabled="_busy"
                Style="min-width:180px">
                @foreach (var status in StatusOptions)
                {
                    <MudSelectItem Value="status">@ChromeLabels.Status(L, status)</MudSelectItem>
                }
            </MudSelect>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ChipPalette.ForPriority(_task.Priority)">
                @L["Priority"]: @ChromeLabels.Priority(L, _task.Priority)
            </MudChip>
            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ChipPalette.ForType(_task.Type)">
                @L["Type"]: @ChromeLabels.Type(L, _task.Type)
            </MudChip>
        </MudStack>
        @if (_task.Status == "InProgress" && _task.SubStage.HasValue)
        {
            <MudProgressLinear Value="@(SubStageToPercent(_task.SubStage.Value))" Color="Color.Default" Class="mt-4 beacon-track" />
            <MudText Typo="Typo.caption" Class="mt-1">@ChromeLabels.SubStage(L, _task.SubStage)</MudText>
        }
        @if (_task.Status == "Done" && _task.CompletedAt.HasValue)
        {
            <MudText Typo="Typo.caption" Class="mt-2">@L["Done"] @_task.CompletedAt.Value.ToShortDateString()</MudText>
        }
        <MudText Typo="Typo.caption" Class="mt-2">@L["CreatedAt"] @_task.CreatedAt.ToShortDateString()</MudText>
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">@NextStepText</MudAlert>
        @if (!string.IsNullOrEmpty(_task.ReviewNotes))
        {
            <MudText Typo="Typo.subtitle2" Class="mt-4">@L["ReviewNotes"]</MudText>
            <MudText Typo="Typo.body2" Class="beacon-pre">@_task.ReviewNotes</MudText>
        }
        <MudTextField @bind-Value="_reviewDraft" Label="@L["ReviewNotes"]" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="SaveReview">@L["Save"]</MudButton>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
        <MudText Typo="Typo.h6">@L["TaskSteps"]</MudText>
        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mt-2">
            <MudTextField @bind-Value="_stepTitle" Label="@L["StepTitle"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="OnAddStep" Disabled="_busy || string.IsNullOrWhiteSpace(_stepTitle)">@L["AddStep"]</MudButton>
        </MudStack>
        @if (_steps.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mt-2">@L["NoStepsYet"]</MudText>
        }
        @foreach (var step in _steps)
        {
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="mt-2">
                <MudCheckBox T="bool" Value="step.IsDone" ValueChanged="done => OnToggleStep(step, done)" Dense="true" />
                <MudText Typo="Typo.body2" Class="grow" Style="@(step.IsDone ? "text-decoration:line-through" : null)">@step.Title</MudText>
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => OnDeleteStep(step)">@L["Delete"]</MudButton>
            </MudStack>
        }
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
        <MudText Typo="Typo.h6">@L["Pipeline"]</MudText>
        @if (_pipeline is { } pipeline && pipeline.Stage is not null && pipeline.Stage != TaskPipelineStage.None)
        {
            <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-2">
                @for (var i = 0; i < StageChips.Length; i++)
                {
                    var current = pipeline.Stage;
                    var label = current == TaskPipelineStage.ReopenedForRevision && i == 1
                        ? L["StageReopenedForRevision"].Value
                        : L[StageChips[i]].Value;
                    var color = i < StageIndex(current)
                        ? Color.Success
                        : (i == StageIndex(current)
                            ? (current == TaskPipelineStage.ReopenedForRevision ? Color.Warning : Color.Primary)
                            : Color.Default);
                    var variant = i <= StageIndex(current) ? Variant.Filled : Variant.Outlined;
                    <MudChip T="string" Size="Size.Small" Color="@color" Variant="@variant">@label</MudChip>
                    @if (i < StageChips.Length - 1)
                    {
                        <MudText Typo="Typo.caption" Class="mx-1">→</MudText>
                    }
                }
            </MudStack>

            <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-3">
                @switch (pipeline.Stage)
                {
                    case TaskPipelineStage.Planning:
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.CreateSubtask))" Disabled="_busy">@L["CreateSubtask"]</MudButton>
                        break;
                    case TaskPipelineStage.Executing:
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.CreateSubtask))" Disabled="_busy">@L["CreateSubtask"]</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary" OnClick="OnStartReview" Disabled="_busy">@L["StartReview"]</MudButton>
                        break;
                    case TaskPipelineStage.ReopenedForRevision:
                        @if (_isAdmin)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ForceClose))" Disabled="_busy">@L["ForceClose"]</MudButton>
                        }
                        break;
                    case TaskPipelineStage.Reviewing:
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ReviewApprove))" Disabled="_busy">@L["Approve"]</MudButton>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ReviewReopen))" Disabled="_busy">@L["ReopenSubtask"]</MudButton>
                        break;
                    case TaskPipelineStage.Approved:
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ConfirmClose))" Disabled="_busy">@L["ConfirmClose"]</MudButton>
                        @if (_isAdmin)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ForceClose))" Disabled="_busy">@L["ForceClose"]</MudButton>
                        }
                        break;
                    case TaskPipelineStage.Closed:
                        <MudText Typo="Typo.caption">@L["PipelineClosed"]</MudText>
                        break;
                }
            </MudStack>

            @if (pipeline.Stage is TaskPipelineStage.Executing or TaskPipelineStage.ReopenedForRevision)
            {
                <MudText Typo="Typo.subtitle2" Class="mt-4">@L["Subtasks"]</MudText>
                @if (pipeline.Subtasks.Count == 0)
                {
                    <MudText Typo="Typo.caption" Class="mt-1">@L["NoSubtasksYet"]</MudText>
                }
                @foreach (var subtask in pipeline.Subtasks)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 mb-2">
                        <MudText Typo="Typo.body2" Class="beacon-pre">@subtask.Instructions</MudText>
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-2">
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@SubtaskStatusColor(subtask.Status)">@SubtaskStatusLabel(subtask.Status)</MudChip>
                            @if (subtask.ReopenCount > 0)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Warning">@L["Reopens"]: @subtask.ReopenCount</MudChip>
                            }
                        </MudStack>
                        @if (subtask.DiffRef is not null)
                        {
                            <MudText Typo="Typo.caption" Class="mt-2">@L["DiffRef"]: @subtask.DiffRef</MudText>
                        }
                        @if (subtask.Summary is not null)
                        {
                            <MudText Typo="Typo.caption">@L["Summary"]: @subtask.Summary</MudText>
                        }
                        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-2">
                            @if (subtask.Status is SubtaskStatus.Pending or SubtaskStatus.InProgress)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OnStartActorSession(subtask))" Disabled="_busy">@L["StartActorSession"]</MudButton>
                            }
                            @if (subtask.Status == SubtaskStatus.InProgress)
                            {
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.ReportResult, subtask))" Disabled="_busy">@L["ReportResult"]</MudButton>
                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => OpenPipelineDialog(PipelineDialogMode.FailSubtask, subtask))" Disabled="_busy">@L["FailSubtask"]</MudButton>
                            }
                        </MudStack>
                    </MudPaper>
                }
            }

            <MudText Typo="Typo.subtitle2" Class="mt-4">@L["Sessions"]</MudText>
            @if (pipeline.Sessions.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mt-1">@L["NoSessionsYet"]</MudText>
            }
            @foreach (var session in pipeline.Sessions)
            {
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-1">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled">@RoleLabel(session.Role)</MudChip>
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@SessionStatusColor(session.Status)">@SessionStatusLabel(session.Status)</MudChip>
                    @if (session.LaunchedAt is not null)
                    {
                        <MudText Typo="Typo.caption">@L["Launched"]: @session.LaunchedAt.Value.ToShortDateString()</MudText>
                    }
                    @if (session.ClosedAt is not null)
                    {
                        <MudText Typo="Typo.caption">@L["Closed"]: @session.ClosedAt.Value.ToShortDateString()</MudText>
                    }
                      @if (session.Status == SessionStatus.Ready)
                      {
                          <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => OnLaunchSession(session))" Disabled="_busy">@L["LaunchSession"]</MudButton>
                          <MudText Typo="Typo.caption">@L["LaunchSessionHint"]</MudText>
                      }
                </MudStack>
                @if (!string.IsNullOrEmpty(session.LaunchSpec))
                {
                    <MudText Typo="Typo.caption" Class="beacon-ellipsis">@session.LaunchSpec</MudText>
                }
            }

            <MudText Typo="Typo.subtitle2" Class="mt-4">@L["Verdicts"]</MudText>
            @if (pipeline.Verdicts.Count == 0)
            {
                <MudText Typo="Typo.caption" Class="mt-1">@L["NoVerdictsYet"]</MudText>
            }
            @foreach (var verdict in pipeline.Verdicts)
            {
                <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-1">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@(verdict.Kind == ReviewVerdictKind.Approve ? Color.Success : Color.Warning)">
                        @(verdict.Kind == ReviewVerdictKind.Approve ? L["VerdictApprove"].Value : L["VerdictReopenSubtask"].Value)
                    </MudChip>
                    <MudText Typo="Typo.body2" Class="grow beacon-pre">@verdict.Note</MudText>
                    <MudText Typo="Typo.caption">@verdict.CreatedAt.ToShortDateString()</MudText>
                </MudStack>
            }
        }
        else
        {
            <MudText Typo="Typo.caption" Class="mt-2">@L["PipelineNotStarted"]</MudText>
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2" OnClick="OnStartPipeline" Disabled="_busy">@L["StartPipeline"]</MudButton>
        }
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
        <MudText Typo="Typo.h6">@L["Comments"]</MudText>
        @if (_task.Comments.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mt-2">@L["NoCommentsYet"]</MudText>
        }
        @foreach (var comment in _task.Comments.OrderBy(c => c.CreatedAt))
        {
            <MudText Typo="Typo.body2" Class="mt-2">@comment.Content</MudText>
            <MudText Typo="Typo.caption">@comment.CreatedAt.ToShortDateString()</MudText>
        }
        <MudTextField @bind-Value="_commentDraft" Label="@L["WriteAComment"]" Lines="2" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="SaveComment">@L["AddComment"]</MudButton>
    </MudPaper>

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <MudText Typo="Typo.h6">@L["CompiledBrief"]</MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Compile" Disabled="_compiling">
                @L["CompileBrief"]
            </MudButton>
        </MudStack>
        <MudText Typo="Typo.caption" Class="mt-2">@L["TokenBudget"]: @_briefTokens / @_briefBudget</MudText>
        <MudProgressLinear Value="@TokenBudgetMeter.Percent(_briefTokens, _briefBudget)" Color="Color.Default" Class="mt-1 beacon-track" />
        @if (!string.IsNullOrEmpty(_briefError))
        {
            <MudAlert Severity="Severity.Error" Class="mt-2">@_briefError</MudAlert>
        }
        @if (!string.IsNullOrEmpty(_briefMarkdown))
        {
            <MudText Typo="Typo.body2" Class="mt-4 beacon-pre">@_briefMarkdown</MudText>
        }
    </MudPaper>
}

@code {
    private static readonly string[] StageChips = { "StagePlanning", "StageExecuting", "StageReviewing", "StageApproved", "Closed" };
    private static readonly TaskItemStatus[] StatusOptions = Enum.GetValues<TaskItemStatus>();

    [Parameter] public Guid TaskId { get; set; }
    private TaskItemDto? _task;
    private TaskItemStatus _status = TaskItemStatus.Todo;
    private bool _loading = true;
    private PipelineStateDto? _pipeline;
    private bool _busy;
    private bool _isAdmin;
    private string? _userId;
    private string? _briefMarkdown;
    private string? _briefError;
    private int _briefTokens;
    private int _briefBudget = 8000;
    private bool _compiling;
    private string _commentDraft = string.Empty;
    private string _reviewDraft = string.Empty;
    private List<LabelDto> _labels = [];
    private List<MilestoneDto> _milestones = [];
    private List<TaskStepDto> _steps = [];
    private string _stepTitle = string.Empty;

    private string NextStepText
    {
        get
        {
            if (_pipeline is null || _pipeline.Stage is null || _pipeline.Stage == TaskPipelineStage.None)
                return L["NextStepTodo"].Value;
            return _pipeline.Stage switch
            {
                TaskPipelineStage.Planning => L["NextStepCreateSubtask"].Value,
                TaskPipelineStage.Executing => L["NextStepCreateSubtask"].Value,
                TaskPipelineStage.Reviewing => L["Approve"].Value,
                TaskPipelineStage.Approved => L["ConfirmClose"].Value,
                _ => L["NextStepTodo"].Value
            };
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var auth = await Auth.GetAuthenticationStateAsync();
        _userId = auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        _isAdmin = bool.TryParse(auth.User.FindFirst("isAdmin")?.Value, out var adminFlag) && adminFlag;
        await Reload();
        _loading = false;
        if (_task is not null)
        {
            await ReloadPipeline();
            await ReloadSteps();
            await Compile();
        }
    }

    private async Task Reload()
    {
        var result = await GetTask.HandleAsync(new GetTaskCommand(new GetTaskRequest(TaskId)));
        _task = result.Success ? result.Value : null;
        _status = Enum.TryParse<TaskItemStatus>(_task?.Status, out var parsedStatus) ? parsedStatus : TaskItemStatus.Todo;
        _reviewDraft = _task?.ReviewNotes ?? string.Empty;
        if (_task is not null)
        {
            var labels = await ListLabels.HandleAsync(new ListLabelsRequest(_task.ProjectId));
            _labels = labels.Success ? labels.Value!.ToList() : [];
            var milestones = await ListMilestones.HandleAsync(new ListProjectMilestonesCommand(new ListProjectMilestonesRequest(_task.ProjectId)));
            _milestones = milestones.Success ? milestones.Value!.ToList() : [];
        }
    }

    private async Task OnStatusChanged(TaskItemStatus status)
    {
        if (_task is null || _busy) return;
        var previous = _status;
        _status = status;
        _busy = true;
        try
        {
            var result = await ChangeStatus.HandleAsync(new ChangeTaskStatusCommand(
                new ChangeTaskStatusRequest(_task.Id, status, _task.ProjectId)));
            if (!result.Success)
            {
                _status = previous;
                Snackbar.Add(result.Error ?? L["StatusChangeFailed"].Value, Severity.Error);
                return;
            }
            await Reload();
            Snackbar.Add(string.Format(L["TaskMoved"].Value, ChromeLabels.Status(L, status)), Severity.Info);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task EditTask()
    {
        if (_task is null) return;
        var parameters = new DialogParameters
        {
            { nameof(TaskDialog.ProjectId), _task.ProjectId },
            { nameof(TaskDialog.Task), _task },
            { nameof(TaskDialog.Labels), _labels },
            { nameof(TaskDialog.Milestones), _milestones }
        };
        var reference = await Dialogs.ShowAsync(typeof(TaskDialog), L["EditTask"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await reference.Result;
        if (result?.Data is TaskItemDto)
        {
            Snackbar.Add(L["Saved"].Value, Severity.Success);
            await Reload();
        }
    }

    private async Task ReloadPipeline()
    {
        var result = await GetPipeline.HandleAsync(new GetPipelineCommand(new GetPipelineRequest(TaskId)));
        _pipeline = result.Success ? result.Value : null;
    }

    private async Task ReloadSteps()
    {
        var result = await ListSteps.HandleAsync(new ListTaskStepsCommand(new ListTaskStepsRequest(TaskId)));
        _steps = result.Success ? result.Value!.ToList() : [];
    }

    private async Task OnAddStep()
    {
        if (_busy || string.IsNullOrWhiteSpace(_stepTitle))
            return;
        _busy = true;
        try
        {
            var result = await AddStep.HandleAsync(new AddTaskStepCommand(new AddTaskStepRequest(TaskId, _stepTitle)));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _stepTitle = string.Empty;
            await ReloadSteps();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnToggleStep(TaskStepDto step, bool done)
    {
        var result = await ToggleStep.HandleAsync(new ToggleTaskStepCommand(new ToggleTaskStepRequest(step.Id, done)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        await ReloadSteps();
    }

    private async Task OnDeleteStep(TaskStepDto step)
    {
        var result = await DeleteStep.HandleAsync(new DeleteTaskStepCommand(new DeleteTaskStepRequest(step.Id)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        await ReloadSteps();
    }

    private static int StageIndex(TaskPipelineStage? stage) => stage switch
    {
        TaskPipelineStage.Planning => 0,
        TaskPipelineStage.Executing or TaskPipelineStage.ReopenedForRevision => 1,
        TaskPipelineStage.Reviewing => 2,
        TaskPipelineStage.Approved => 3,
        TaskPipelineStage.Closed => 4,
        _ => -1
    };

    private async Task OnStartPipeline()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await StartPipeline.HandleAsync(new StartPipelineCommand(new StartPipelineRequest(TaskId)));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["PipelineStarted"].Value, Severity.Success);
            await Reload();
            await ReloadPipeline();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnStartActorSession(SubtaskDto subtask)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await StartActorSession.HandleAsync(new StartActorSessionCommand(new StartActorSessionRequest(TaskId, subtask.Id)));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["SessionStarted"].Value, Severity.Success);
            await ReloadPipeline();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnLaunchSession(PipelineSessionDto session)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await LaunchSession.HandleAsync(new LaunchSessionCommand(new LaunchSessionRequest(session.Id)));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["SessionLaunched"].Value, Severity.Success);
            await ReloadPipeline();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task OnStartReview()
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var result = await StartReview.HandleAsync(new StartReviewCommand(new StartReviewRequest(TaskId)));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["ReviewStarted"].Value, Severity.Success);
            await Reload();
            await ReloadPipeline();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task SaveComment()
    {
        if (_task is null || string.IsNullOrWhiteSpace(_commentDraft))
            return;
        var auth = await Auth.GetAuthenticationStateAsync();
        Guid.TryParse(auth.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value, out var userId);
        var result = await AddComment.HandleAsync(new AddCommentCommand(new AddCommentRequest(_task.Id, _commentDraft.Trim(), userId)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _commentDraft = string.Empty;
        await Reload();
        Snackbar.Add(L["Saved"].Value, Severity.Success);
    }

    private async Task SaveReview()
    {
        if (_task is null || string.IsNullOrWhiteSpace(_reviewDraft))
            return;
        var result = await AddReviewNotes.HandleAsync(new AddReviewNotesCommand(new AddReviewNotesRequest(_task.Id, _reviewDraft.Trim())));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        await Reload();
        Snackbar.Add(L["Saved"].Value, Severity.Success);
    }

    private async Task Compile()
    {
        if (_task is null) return;
        _compiling = true;
        _briefError = null;
        try
        {
            var result = await CompileBrief.HandleAsync(new CompileBriefCommand(new CompileBriefRequest(
                _task.ProjectId, null, null, _task.Id, _briefBudget, false, false, false)));
            if (!result.Success)
            {
                _briefError = result.Error;
                return;
            }
            _briefMarkdown = result.Value.BriefMarkdown;
            _briefTokens = result.Value.TokenEstimate;
        }
        finally
        {
            _compiling = false;
        }
    }

    private IReadOnlyList<SubtaskDto> ReopenableSubtasks =>
        _pipeline?.Subtasks.Where(s => s.Status is SubtaskStatus.Done or SubtaskStatus.Failed).ToList()
        ?? new List<SubtaskDto>();

    private async Task OpenPipelineDialog(PipelineDialogMode mode, SubtaskDto? subtask = null)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var parameters = new DialogParameters
            {
                { nameof(PipelineDialog.Params), new PipelineDialogParams(mode, TaskId, subtask, ReopenableSubtasks, _userId) }
            };
            var reference = await Dialogs.ShowAsync(typeof(PipelineDialog), DialogTitle(mode), parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
            var result = await reference.Result;
            if (result?.Data is true)
            {
                await ReloadPipeline();
                await Reload();
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private string DialogTitle(PipelineDialogMode mode) => mode switch
    {
        PipelineDialogMode.CreateSubtask => L["CreateSubtask"].Value,
        PipelineDialogMode.ReportResult => L["ReportResult"].Value,
        PipelineDialogMode.FailSubtask => L["FailSubtask"].Value,
        PipelineDialogMode.ReviewApprove => L["Approve"].Value,
        PipelineDialogMode.ReviewReopen => L["ReopenSubtask"].Value,
        PipelineDialogMode.ConfirmClose => L["ConfirmClose"].Value,
        PipelineDialogMode.ForceClose => L["ForceClose"].Value,
        _ => L["Pipeline"].Value
    };

    private string SubtaskStatusLabel(SubtaskStatus status) => L[status.ToString()].Value;

    private Color SubtaskStatusColor(SubtaskStatus status) => status switch
    {
        SubtaskStatus.Done => Color.Success,
        SubtaskStatus.InProgress => Color.Info,
        SubtaskStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private string SessionStatusLabel(SessionStatus status) => L[status.ToString()].Value;

    private Color SessionStatusColor(SessionStatus status) => status switch
    {
        SessionStatus.Active => Color.Info,
        SessionStatus.Closed => Color.Success,
        SessionStatus.Failed => Color.Error,
        _ => Color.Default
    };

    private string RoleLabel(PipelineRole role) => role switch
    {
        PipelineRole.Planner => L["RoleBindingPlanner"].Value,
        PipelineRole.Actor => L["RoleBindingActor"].Value,
        PipelineRole.Review => L["Review"].Value,
        _ => role.ToString()
    };

    private int SubStageToPercent(TaskSubStage stage) => stage switch
    {
        TaskSubStage.RequirementGathering => 10,
        TaskSubStage.Estimation => 20,
        TaskSubStage.IntermediateResult => 40,
        TaskSubStage.Review => 60,
        TaskSubStage.Corrections => 75,
        TaskSubStage.ReviewCorrections => 90,
        TaskSubStage.Complete => 100,
        _ => 0
    };
}
