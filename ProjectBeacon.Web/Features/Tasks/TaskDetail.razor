    private async Task SaveComment()
    {
        if (_task is null || string.IsNullOrWhiteSpace(_commentDraft))
            return;
        var actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        var result = await AddComment.HandleAsync(new AddCommentCommand(new AddCommentRequest(_task.Id, _commentDraft.Trim()), actor));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _commentDraft = string.Empty;
        await Reload();
        Snackbar.Add(L["Saved"].Value, Severity.Success);
    }

    private async Task SaveReview()
    {
        if (_task is null || string.IsNullOrWhiteSpace(_reviewDraft))
            return;
        var result = await AddReviewNotes.HandleAsync(new AddReviewNotesCommand(new AddReviewNotesRequest(_task.Id, _reviewDraft.Trim())));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        await Reload();
        Snackbar.Add(L["Saved"].Value, Severity.Success);
    }

    private async Task Compile()
    {
        if (_task is null) return;
        _compiling = true;
        _briefError = null;
        try
        {
            var result = await CompileBrief.HandleAsync(new CompileBriefCommand(new CompileBriefRequest(
                _task.ProjectId, null, null, _task.Id, _briefBudget, false, false, false)));
            if (!result.Success)
            {
                _briefError = result.Error;
                return;
            }
            _briefMarkdown = result.Value!.BriefMarkdown;
            _briefTokens = result.Value.TokenEstimate;
            _briefOverflow = result.Value.BudgetOverflow;
        }
        finally
        {
            _compiling = false;
        }
    }

    private IReadOnlyList<SubtaskDto> ReopenableSubtasks =>
        _pipeline?.Subtasks.Where(s => s.Status is SubtaskStatus.Done or SubtaskStatus.Failed).ToList()
        ?? new List<SubtaskDto>();

    private async Task OpenPipelineDialog(PipelineDialogMode mode, SubtaskDto? subtask = null)
    {
        if (_busy) return;
        _busy = true;
        try
        {
            var parameters = new DialogParameters
            {
                { nameof(PipelineDialog.Params), new PipelineDialogParams(mode, TaskId, subtask, ReopenableSubtasks, _userId) }
            };
            var reference = await Dialogs.ShowAsync(typeof(PipelineDialog), DialogTitle(mode), parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
            var result = await reference.Result;
            if (result?.Data is true)
            {
                await ReloadPipeline();
                await Reload();
            }
        }
        finally
        {
            _busy = false;
        }
    }

