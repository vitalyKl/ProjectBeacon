@using Microsoft.AspNetCore.Components.Forms
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Infrastructure.Attachments
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject IAttachmentService Attachments
@inject AuthenticationStateProvider Auth
@inject ISnackbar Snackbar
@inject IJSRuntime JS

<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
        <MudText Typo="Typo.h6">@L["TaskAttachmentsTitle"]</MudText>
        <MudButton Variant="Variant.Text" Size="Size.Small" OnClick="Reload" Disabled="@_busy">@L["TaskAttachmentsRefresh"]</MudButton>
    </MudStack>
    <div class="d-flex flex-wrap align-center gap-2 mt-2">
        <InputFile OnChange="Upload" multiple disabled="@_busy" />
        <MudText Typo="Typo.caption">@L["TaskAttachmentsLimit"]</MudText>
    </div>
    @if (_busy) { <MudProgressLinear Indeterminate="true" Class="mt-2" /> }
    @if (_items.Count == 0 && !_busy) { <MudText Typo="Typo.caption" Class="mt-2">@L["TaskAttachmentsEmpty"]</MudText> }
    <div class="d-flex flex-column gap-3 mt-3">
        @foreach (var item in _items)
        {
            <div class="d-flex flex-column gap-1">
                @if (item.DataUrl is not null)
                {
                    <img src="@item.DataUrl" alt="@item.Metadata.FileName"
                         style="max-width: min(100%, 520px); max-height: 360px; object-fit: contain;" />
                }
                <div class="d-flex flex-wrap align-center gap-2">
                    <MudButton Variant="Variant.Text" Size="Size.Small"
                               Disabled="@_busy" OnClick="@(() => OpenAttachment(item))">
                        @item.Metadata.FileName
                    </MudButton>
                    <MudText Typo="Typo.caption">@FormatSize(item.Metadata.Length)</MudText>
                    <MudText Typo="Typo.caption">· @item.Metadata.CreatedByType</MudText>
                    <MudText Typo="Typo.caption">· <LocalTime Value="item.Metadata.CreatedAt" Format="g" /></MudText>
                    @if (item.DataUrl is not null)
                    {
                        <MudText Typo="Typo.caption">@L["TaskAttachmentsPreviewOpen"]</MudText>
                    }
                </div>
            </div>
        }
    </div>
</MudPaper>

@code {
    [Parameter, EditorRequired] public TaskItemDto Task { get; set; } = null!;
    private readonly List<AttachmentView> _items = [];
    private bool _busy;
    private Guid _loadedTaskId;

    protected override async Task OnParametersSetAsync()
    {
        if (Task is not null && _loadedTaskId != Task.Id)
            await Reload();
    }

    private async Task Reload()
    {
        if (Task is null || _busy) return;
        _busy = true;
        try
        {
            _items.Clear();
            // The list endpoint returns metadata only. Payload bytes are fetched only
            // after the user explicitly opens an attachment.
            var metadata = await Attachments.ListTaskAsync(Task.ProjectId, Task.Id);
            _items.AddRange(metadata.Select(item => new AttachmentView(item)));
            _loadedTaskId = Task.Id;
        }
        catch (Exception ex) { Snackbar.Add(string.Format(L["TaskAttachmentsLoadFailed"].Value, ex.Message), Severity.Error); }
        finally { _busy = false; }
    }

    private async Task OpenAttachment(AttachmentView item)
    {
        if (Task is null || _busy) return;
        _busy = true;
        try
        {
            var loaded = await Attachments.ReadTaskAsync(Task.ProjectId, Task.Id, item.Metadata.Id);
            if (loaded is null) return;

            var (details, bytes) = loaded.Value;
            if (IsPreviewableImage(details.ContentType))
            {
                // The service re-checks image signatures. A row's stored MIME value
                // alone is never sufficient to create a browser data URL.
                item.DataUrl = item.DataUrl is null
                    ? $"data:{details.ContentType};base64,{Convert.ToBase64String(bytes)}"
                    : null;
            }
            else
            {
                await JS.InvokeVoidAsync(
                    "beaconAttachments.download",
                    details.FileName,
                    details.ContentType,
                    Convert.ToBase64String(bytes));
            }
        }
        catch (Exception ex) { Snackbar.Add(string.Format(L["TaskAttachmentsLoadFailed"].Value, ex.Message), Severity.Error); }
        finally { _busy = false; }
    }

    private async Task Upload(InputFileChangeEventArgs args)
    {
        if (Task is null || _busy) return;
        _busy = true;
        try
        {
            var actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
            foreach (var file in args.GetMultipleFiles(20))
            {
                if (file.Size is <= 0 or > DatabaseAttachmentService.MaxFileLength)
                {
                    Snackbar.Add(string.Format(L["TaskAttachmentsFileTooLarge"].Value, file.Name), Severity.Warning);
                    continue;
                }
                await using var stream = file.OpenReadStream(DatabaseAttachmentService.MaxFileLength);
                await Attachments.UploadTaskAsync(Task.ProjectId, Task.Id, actor, stream, file.Name, file.ContentType, file.Size);
            }
            Snackbar.Add(L["TaskAttachmentsUploaded"].Value, Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(string.Format(L["TaskAttachmentsUploadFailed"].Value, ex.Message), Severity.Error); }
        finally { _busy = false; }
        await Reload();
    }

    private static bool IsPreviewableImage(string contentType) =>
        contentType is "image/png" or "image/jpeg" or "image/gif" or "image/webp";

    private static string FormatSize(long bytes) =>
        bytes < 1024 * 1024 ? $"{bytes / 1024d:0.#} KB" : $"{bytes / (1024d * 1024d):0.##} MB";

    private sealed class AttachmentView(TaskAttachmentDto metadata)
    {
        public TaskAttachmentDto Metadata { get; } = metadata;
        public string? DataUrl { get; set; }
    }
}
