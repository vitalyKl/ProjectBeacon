@using System.Text.Json
@page "/roadmap"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Context
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Application.Milestones
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Application.Releases
@using ProjectBeacon.Application.Persistence
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject ListProjectMilestonesHandler ListMilestones
@inject ListDeletedContentTargetsHandler ListDeletedContentTargets
@inject ListContentVersionsHandler ContentVersions
@inject RestoreContentVersionHandler RestoreContentVersion
@inject ListProjectTasksHandler ListTasks
@inject CreateMilestoneHandler CreateMilestoneHandler
@inject UpdateMilestoneHandler UpdateMilestoneHandler
@inject DeleteMilestoneHandler DeleteMilestoneHandler
@inject CloseMilestoneHandler CloseMilestoneHandler
@inject ReopenMilestoneHandler ReopenMilestoneHandler
@inject GetProjectVersionPolicyHandler GetVersionPolicy
@inject ListProjectReleasesHandler ListProjectReleases
@inject CreateReleaseHandler CreateReleaseHandler
@inject CreateHotfixTaskHandler CreateHotfixTaskHandler
@inject PrepareReleaseHandler PrepareRelease
@inject VerifyReleaseLandingHandler VerifyReleaseLanding
@inject PublishReleaseHandler PublishRelease
@inject UpdateReleaseHandler UpdateReleaseHandler
@inject SetReleaseStatusHandler SetReleaseStatus
@inject DeleteReleaseHandler DeleteReleaseHandler
@inject SetMilestoneReleaseHandler SetMilestoneRelease
@inject ProjectBeacon.Application.Authorization.IAuthorizationService Authorization
@inject IBeaconDbFactory DbFactory
@inject IDialogService Dialogs

<PageTitle>@L["Roadmap"]</PageTitle>
<PageHeader Title="@L["Roadmap"]">
    @if (_releaseManagementEnabled && _canManageReleases)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@ShowCreateReleaseForm">@L["NewRelease"]</MudButton>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ShowCreateForm">@L["NewMilestone"]</MudButton>
</PageHeader>

@if (_loading)
{
    <LoadingState />
}
else if (_projectLoadErrorMessage is not null)
{
    <ErrorState Message="@_projectLoadErrorMessage" />
}
else if (_project is null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
}
    else if (ShowEmptyState)
{
    <EmptyState>@L["NoMilestones"]</EmptyState>
}
else
{
    @if (_loadErrorMessage is not null)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">@_loadErrorMessage</MudAlert>
    }
    @if (_releaseManagementEnabled)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">@L["ProjectReleases"]</MudText>
                <MudText Typo="Typo.caption">@_releases.Count @L["Releases"]</MudText>
            </MudStack>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mt-2">@L["ReleaseManagementIntroduction"]</MudText>
            @if (_showCreateReleaseForm && _canManageReleases)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle1">@L["NewRelease"]</MudText>
                <MudTextField @bind-Value="_releaseName" Label="@L["ReleaseName"]" Required="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MarkdownEditor @bind-Value="_releaseDescription" Label="@L["Description"]" Lines="2" />
                <MudTextField @bind-Value="_releaseTargetVersion" Label="@L["ReleaseTargetVersion"]"
                              HelperText="@L["ReleaseTargetVersionHelp"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_releaseTargetBranch" Label="@L["ReleaseTargetBranch"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudNumericField T="int" @bind-Value="_releaseOrder" Label="@L["Order"]"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_releaseBusy" OnClick="CreateRelease">@L["Create"]</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="@_releaseBusy" OnClick="HideCreateReleaseForm">@L["Cancel"]</MudButton>
                </MudStack>
            }
            @if (_editingReleaseId is not null && _canManageReleases)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle1">@L["Edit"] · @_releaseName</MudText>
                <MudTextField @bind-Value="_releaseName" Label="@L["ReleaseName"]" Required="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MarkdownEditor @bind-Value="_releaseDescription" Label="@L["Description"]" Lines="2" />
                <MudTextField @bind-Value="_releaseTargetVersion" Label="@L["ReleaseTargetVersion"]"
                              HelperText="@L["ReleaseTargetVersionHelp"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_releaseTargetBranch" Label="@L["ReleaseTargetBranch"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudNumericField T="int" @bind-Value="_releaseOrder" Label="@L["Order"]"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_releaseBusy" OnClick="SaveRelease">@L["Save"]</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="@_releaseBusy" OnClick="CancelEditRelease">@L["Cancel"]</MudButton>
                </MudStack>
            }
            @if (_releaseLoadErrorMessage is not null)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-3">@_releaseLoadErrorMessage</MudAlert>
            }
            @if (_releases.Count == 0 && _releaseLoadErrorMessage is null)
            {
                <MudText Typo="Typo.body2" Class="mt-3">@L["NoReleases"]</MudText>
            }
            else if (_releases.Count > 0)
            {
                <MudGrid Class="mt-2">
                    @foreach (var release in _releases.OrderBy(item => item.Order))
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.subtitle1">@release.Name</MudText>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(release.Status == ReleaseStatus.Published ? Color.Success : Color.Default)">
                                        @L[$"ReleaseStatus{release.Status}"]
                                    </MudChip>
                                </MudStack>
                                @if (!string.IsNullOrWhiteSpace(release.Description))
                                {
                                    <MarkdownView Text="@release.Description" MaxHeight="90" Class="mt-1" />
                                }
                                <MudText Typo="Typo.caption" Class="mt-2">@L["ReleaseTargetVersion"]: @(release.TargetVersion ?? "—")</MudText>
                                <MudText Typo="Typo.caption">@L["ReleaseTargetBranch"]: @release.TargetBranch</MudText>
                                <MudText Typo="Typo.caption">@L["Milestones"]: @release.MilestoneCount</MudText>
                                @if (release.Status == ReleaseStatus.Published
                                    && release.PublicationStatus == ReleasePublicationStatus.Published
                                    && release.PublicationTagPushed)
                                {
                                    <MudDivider Class="my-2" />
                                    <MudText Typo="Typo.subtitle2">@L["HotfixSourceRelease"]</MudText>
                                    <MudText Typo="Typo.caption">@L["HotfixDeployedVersion"]: @(release.DeployedVersion ?? "—")</MudText>
                                    <MudText Typo="Typo.caption" Style="overflow-wrap:anywhere">@L["HotfixDeployedSha"]: @(release.DeployedCommitSha ?? "—")</MudText>
                                    @if (!string.IsNullOrWhiteSpace(release.DeploymentWorkflowRunUrl))
                                    {
                                        <MudLink Href="@release.DeploymentWorkflowRunUrl" Target="_blank">
                                            @L["HotfixDeploymentRun"]
                                        </MudLink>
                                    }
                                    @if (_canManageReleases)
                                    {
                                        @if (_hotfixReleaseId == release.Id)
                                        {
                                            <MudStack Spacing="2" Class="mt-2">
                                                <MudText Typo="Typo.subtitle2">@L["CreateHotfixTask"]</MudText>
                                                <MudTextField T="string" @bind-Value="_hotfixTitle"
                                                              Label="@L["HotfixTaskTitle"]" Required="true"
                                                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                <MarkdownEditor @bind-Value="_hotfixDescription"
                                                                Label="@L["HotfixTaskDescription"]" Lines="3" />
                                                <MudStack Row="true" Spacing="2">
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                                                               Disabled="@_releaseBusy" OnClick="CreateHotfixTask">
                                                        @L["CreateHotfixTask"]
                                                    </MudButton>
                                                    <MudButton Variant="Variant.Text" Disabled="@_releaseBusy"
                                                               OnClick="CancelCreateHotfixTask">@L["Cancel"]</MudButton>
                                                </MudStack>
                                            </MudStack>
                                        }
                                        else
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined"
                                                       Color="Color.Warning" Disabled="@_releaseBusy"
                                                       OnClick="() => ShowCreateHotfixTask(release)">
                                                @L["CreateHotfixTask"]
                                            </MudButton>
                                        }
                                    }
                                }
                                @if (_canManageReleases)
                                {
                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                                        @if (release.Status is ReleaseStatus.Planned or ReleaseStatus.InProgress)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="@_releaseBusy"
                                                       OnClick="() => StartEditRelease(release)">@L["Edit"]</MudButton>
                                        }
                                        @if (release.Status == ReleaseStatus.Planned)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@_releaseBusy"
                                                       OnClick="() => ChangeReleaseStatus(release, ReleaseStatus.InProgress)">@L["ReleaseStart"]</MudButton>
                                        }
                                        @if (release.Status == ReleaseStatus.InProgress)
                                        {
                                            @if (release.PreparationStatus is ReleasePreparationStatus.NotStarted or ReleasePreparationStatus.Failed)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                           Disabled="@_releaseBusy" OnClick="() => PrepareReleaseAsync(release)">
                                                    @L["PrepareReleaseCandidate"]
                                                </MudButton>
                                            }
                                            else if (release.PreparationStatus is ReleasePreparationStatus.Prepared or ReleasePreparationStatus.VerifyFailed)
                                            {
                                                @if (GetPreparationPullRequestUrl(release.PreparationResultJson) is { } pullRequestUrl)
                                                {
                                                    <MudLink Href="@pullRequestUrl" Target="_blank">@L["ReleasePreparationPullRequest"]</MudLink>
                                                }
                                                <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                                           Disabled="@_releaseBusy" OnClick="() => VerifyReleaseLandingAsync(release)">
                                                    @L["VerifyReleaseLanding"]
                                                </MudButton>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                    @L["ReleasePreparationInProgress"]
                                                </MudText>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(release.PreparationError))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Warning">@release.PreparationError</MudText>
                                            }
                                        }
                                        @if (release.Status == ReleaseStatus.Candidate)
                                        {
                                            @if (release.PublicationStatus == ReleasePublicationStatus.Queued)
                                            {
                                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["ReleasePublicationQueued"]</MudText>
                                            }
                                            else if (release.PublicationStatus != ReleasePublicationStatus.Published)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                                           Disabled="@_releaseBusy" OnClick="() => PublishReleaseAsync(release)">
                                                    @L["PublishRelease"]
                                                </MudButton>
                                            }
                                            @if (release.PublicationTagPushed)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Warning">@L["ReleaseTagAlreadyPushed"]</MudText>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(release.PublicationError))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Warning">@release.PublicationError</MudText>
                                            }
                                            @if (release.PublicationStatus is ReleasePublicationStatus.NotStarted or ReleasePublicationStatus.FailedBeforeTag)
                                            {
                                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="@_releaseBusy"
                                                           OnClick="() => ChangeReleaseStatus(release, ReleaseStatus.Cancelled)">@L["CancelRelease"]</MudButton>
                                            }
                                        }
                                        @if (release.Status is ReleaseStatus.Planned or ReleaseStatus.InProgress)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="@_releaseBusy"
                                                       OnClick="() => ChangeReleaseStatus(release, ReleaseStatus.Cancelled)">@L["CancelRelease"]</MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="@_releaseBusy"
                                                       OnClick="() => DeleteRelease(release)">@L["Delete"]</MudButton>
                                        }
                                    </MudStack>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>
        @if (_tasks.Any(task =>
            task.HotfixSourceReleaseId is not null || task.ForwardPortOfTaskId is not null))
        {
            <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-3">
                <MudText Typo="Typo.subtitle1">@L["HotfixTasks"]</MudText>
                @foreach (var task in _tasks
                    .Where(task => task.HotfixSourceReleaseId is not null || task.ForwardPortOfTaskId is not null)
                    .OrderByDescending(task => task.CreatedAt))
                {
                    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="py-1">
                        <MudText Typo="Typo.body2">@task.Title</MudText>
                        @if (task.HotfixSourceReleaseId is { } sourceReleaseId)
                        {
                            <MudText Typo="Typo.caption">@L["HotfixSourceRelease"]: @(_releases.FirstOrDefault(item => item.Id == sourceReleaseId)?.Name ?? task.HotfixDeployedSha ?? "—")</MudText>
                        }
                        else if (task.ForwardPortOfTaskId is { } sourceTaskId)
                        {
                            <MudText Typo="Typo.caption">@L["ForwardPortOfHotfix"]: @(_tasks.FirstOrDefault(item => item.Id == sourceTaskId)?.Title ?? sourceTaskId.ToString("N"))</MudText>
                        }
                    </MudStack>
                }
            </MudPaper>
        }
    }

    @if (_showCreateForm)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
            <MudText Typo="Typo.h6">@L["CreateMilestone"]</MudText>
            <MudTextField @bind-Value="_editName" Label="@L["MilestoneName"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MarkdownEditor @bind-Value="_editDescription" Label="@L["Description"]" Lines="3" Class="mt-2 mb-2" />
            <MudTextField @bind-Value="_newOrder" Label="@L["Order"]" InputType="InputType.Number" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateMilestone">@L["Create"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@HideCreateForm">@L["Cancel"]</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_editingId is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
            <MudText Typo="Typo.h6">@L["UpdateMilestone"]</MudText>
            <MudTextField @bind-Value="_editName" Label="@L["MilestoneName"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MarkdownEditor @bind-Value="_editDescription" Label="@L["Description"]" Lines="3" Class="mt-2 mb-2" />
            <MudTextField @bind-Value="_editOrder" Label="@L["Order"]" InputType="InputType.Number" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveMilestone">@L["Save"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@CancelEdit">@L["Cancel"]</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_milestones.Count > 0)
    {
        <MudGrid Class="mt-4">
        @foreach (var milestone in _milestones.OrderBy(m => m.Order))
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 h-100">
                    <MudText Typo="Typo.h6">@milestone.Name</MudText>
                    @if (_releaseManagementEnabled && _canManageReleases)
                    {
                        <MudSelect T="Guid?" Value="@milestone.ReleaseId"
                                   ValueChanged="@(releaseId => SetMilestoneReleaseAsync(milestone, releaseId))"
                                   Label="@L["MilestoneRelease"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Dense="true" Disabled="@_releaseBusy" Class="mt-2">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["NoRelease"]</MudSelectItem>
                            @foreach (var release in _releases.Where(item => item.Status is not (ReleaseStatus.Published or ReleaseStatus.Cancelled)))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)release.Id)">@release.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else if (_releaseManagementEnabled && milestone.ReleaseId is not null)
                    {
                        <MudText Typo="Typo.caption">@L["MilestoneRelease"]: @(_releases.FirstOrDefault(item => item.Id == milestone.ReleaseId)?.Name ?? "—")</MudText>
                    }
                    @if (!string.IsNullOrEmpty(milestone.Description))
                    {
                        <MarkdownView Text="@milestone.Description" MaxHeight="120" Class="mt-2" />
                    }
                    <MudText Typo="Typo.caption" Class="mt-2">
                        @L["TaskCount"]: @_tasks.Count(task => task.MilestoneId == milestone.Id)
                        · @_tasks.Count(task => task.MilestoneId == milestone.Id && task.Status == "Done")/@_tasks.Count(task => task.MilestoneId == milestone.Id) @L["Done"]
                    </MudText>
                    <MudProgressLinear Value="@(_tasks.Count(task => task.MilestoneId == milestone.Id) == 0 ? 0 :
                        _tasks.Count(task => task.MilestoneId == milestone.Id && task.Status == "Done") * 100d /
                        _tasks.Count(task => task.MilestoneId == milestone.Id))" Color="Color.Default" Class="mt-1 beacon-track" />
                    @foreach (var task in _tasks.Where(task => task.MilestoneId == milestone.Id).Take(3))
                    {
                        <MudText Typo="Typo.body2" Class="mt-1 beacon-ellipsis" title="@task.Title">@task.Title</MudText>
                    }
                    @if (_tasks.Count(task => task.MilestoneId == milestone.Id) > 3)
                    {
                        <MudText Typo="Typo.caption">
                            @string.Format(L["MoreTasks"].Value, _tasks.Count(task => task.MilestoneId == milestone.Id) - 3)
                        </MudText>
                    }
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1"
                               data-testid="@($"open-milestone-{milestone.Id:D}")"
                               OnClick="() => OpenMilestone(milestone)">@L["Open"]</MudButton>
                    @if (milestone.ClosedAt is not null)
                    {
                        var orphans = MilestoneOrphanLint.OpenTaskCount(
                            milestone.ClosedAt, milestone.Id,
                            _tasks.Select(t => (t.MilestoneId, t.Status)));
                        if (orphans > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                @string.Format(L["OrphanWarning"].Value, orphans)
                            </MudAlert>
                        }
                    }
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-3">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => StartEditMilestone(milestone)">@L["Edit"]</MudButton>
                        @if (milestone.ClosedAt is null)
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="() => CloseMilestone(milestone)">@L["CloseMilestone"]</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="() => ReopenMilestone(milestone)">@L["ReopenMilestone"]</MudButton>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteMilestone(milestone)">@L["Delete"]</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
        </MudGrid>
    }

    @if (_deletedMilestones.Count > 0)
    {
        <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-4">
            <MudExpansionPanel Text="@($"{L["DeletedContent"]} ({_deletedMilestones.Count})")">
                @foreach (var deleted in _deletedMilestones)
                {
                    <MudPaper @key="deleted.TargetId" Elevation="0" Outlined="true" Class="pa-3 mb-2">
                        <MudText Typo="Typo.subtitle1">@deleted.Title</MudText>
                        <MudText Typo="Typo.caption">
                            @L["Deleted"] · rev. @deleted.DeletedRevision · <LocalTime Value="deleted.DeletedAt" Format="g" />
                        </MudText>
                        <MarkdownView Text="@MilestoneSnapshotDescription(deleted.SourceContentJson)" MaxHeight="100" />
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   Disabled="_busy" OnClick="() => RestoreDeletedMilestone(deleted)">
                            @L["RestoreRevision"]
                        </MudButton>
                    </MudPaper>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    <MudDialog @bind-Visible="_detailOpen" Options="_dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">@_open?.Name</MudText>
        </TitleContent>
        <DialogContent>
            @if (_open is not null)
            {
                var openTasks = _tasks.Where(t => t.MilestoneId == _open.Id).ToList();
                @if (!string.IsNullOrEmpty(_open.Description))
                {
                    <MarkdownView Text="@_open.Description" MaxHeight="320" />
                }
                @if (openTasks.Count == 0)
                {
                    <EmptyState>@L["NoTasks"]</EmptyState>
                }
                else
                {
                    @foreach (var task in openTasks)
                    {
                        <MudButton Variant="Variant.Text" Class="mt-1" Href="@($"/task/{task.Id}")">@task.Title</MudButton>
                    }
                }
                <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                    <MudExpansionPanel Text="@($"{L["ContentHistory"]} ({_milestoneHistory.Count})")">
                        @if (_milestoneHistoryErrorMessage is not null)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true">@_milestoneHistoryErrorMessage</MudAlert>
                        }
                        @if (_milestoneHistory.Count == 0 && _milestoneHistoryErrorMessage is null)
                        {
                            <MudText Typo="Typo.caption">@L["NoHistory"]</MudText>
                        }
                        @foreach (var version in _milestoneHistory)
                        {
                            <MudPaper @key="version.Id" Elevation="0" Outlined="true" Class="pa-2 mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.subtitle2">rev. @version.Revision</MudText>
                                    <MudSpacer />
                                    <LocalTime Value="version.At" Format="g" />
                                </MudStack>
                                <MarkdownView Text="@MilestoneHistoryMarkdown(version.ContentJson)" MaxHeight="140" />
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           data-testid="@($"restore-milestone-revision-{version.Revision}")"
                                           Disabled="_busy || version.Revision == _open.Revision"
                                           OnClick="() => RestoreMilestoneVersion(version)">
                                    @L["RestoreRevision"]
                                </MudButton>
                            </MudPaper>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </DialogContent>
    </MudDialog>
}

@code {
    private List<MilestoneDto> _milestones = [];
    private List<DeletedContentTargetDto> _deletedMilestones = [];
    private List<TaskItemDto> _tasks = [];
    private ProjectDto? _project;
    private ActorContext _actor = ActorContext.Anonymous;
    private bool _loading = true;
    private bool _busy;
    private string? _projectLoadErrorMessage;
    private string? _loadErrorMessage;
    private string? _releaseLoadErrorMessage;

    private bool ShowEmptyState => ShouldShowEmptyState(
        _milestones.Count,
        _deletedMilestones.Count,
        _showCreateForm,
        _releaseManagementEnabled,
        _releases.Count,
