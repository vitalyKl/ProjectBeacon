    private async Task PublishReleaseAsync(ReleaseDto release)
    {
        if (_project is null || !_canManageReleases || _releaseBusy
            || release.Status != ReleaseStatus.Candidate
            || release.PublicationStatus is ReleasePublicationStatus.Queued or ReleasePublicationStatus.Published)
            return;

        var policy = await GetVersionPolicy.HandleAsync(_project.Id, _actor);
        var tagName = policy.Success && policy.Value is not null && !string.IsNullOrWhiteSpace(release.TargetVersion)
            ? policy.Value.TagPattern.Replace("{version}", release.TargetVersion, StringComparison.Ordinal)
            : release.TargetVersion ?? string.Empty;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["PublishReleaseConfirmTitle"].Value,
            string.Format(
                L["PublishReleaseConfirmMessage"].Value,
                release.Name,
                release.TargetVersion ?? "—",
                tagName,
                release.TargetBranch),
            yesText: L["PublishRelease"].Value,
            cancelText: L["Cancel"].Value);
        if (confirmed != true)
            return;

        _releaseBusy = true;
        try
        {
            var result = await PublishRelease.HandleAsync(new PublishReleaseCommand(
                _project.Id, release.Id, release.Revision, release.PublicationRevision, _actor));
            if (!result.Success)
            {
                Notifications.Failure(result, L["Roadmap"].Value, L["PublishRelease"].Value);
                await Reload();
                return;
            }
            Notifications.Add(L["ReleasePublicationQueued"].Value, Severity.Success);
            await Reload();
        }
        finally
        {
            _releaseBusy = false;
        }
    }

    private static string? GetPreparationPullRequestUrl(string? resultJson)
    {
        if (string.IsNullOrWhiteSpace(resultJson))
            return null;
        try
        {
            using var document = JsonDocument.Parse(resultJson);
            if (!document.RootElement.TryGetProperty("pullRequestUrl", out var property)
                || property.ValueKind != JsonValueKind.String)
                return null;
            var value = property.GetString();
            return Uri.TryCreate(value, UriKind.Absolute, out var uri)
                && uri.Scheme == Uri.UriSchemeHttps
                && uri.Host.Equals("github.com", StringComparison.OrdinalIgnoreCase)
                && System.Text.RegularExpressions.Regex.IsMatch(
                    uri.AbsolutePath, @"^/[^/]+/[^/]+/pull/[1-9][0-9]*$", System.Text.RegularExpressions.RegexOptions.CultureInvariant)
                    ? uri.AbsoluteUri
                    : null;
        }
        catch (JsonException)
        {
            return null;
        }
    }

