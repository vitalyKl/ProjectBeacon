@page "/roadmap"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Context
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Application.Milestones
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject ListProjectMilestonesHandler ListMilestones
@inject ListDeletedContentTargetsHandler ListDeletedContentTargets
@inject ListContentVersionsHandler ContentVersions
@inject RestoreContentVersionHandler RestoreContentVersion
@inject ListProjectTasksHandler ListTasks
@inject CreateMilestoneHandler CreateMilestoneHandler
@inject UpdateMilestoneHandler UpdateMilestoneHandler
@inject DeleteMilestoneHandler DeleteMilestoneHandler
@inject CloseMilestoneHandler CloseMilestoneHandler
@inject ReopenMilestoneHandler ReopenMilestoneHandler
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<PageTitle>@L["Roadmap"]</PageTitle>
<PageHeader Title="@L["Roadmap"]">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ShowCreateForm">@L["NewMilestone"]</MudButton>
</PageHeader>

@if (_loading)
{
    <LoadingState />
}
else if (_project is null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
}
    else if (_milestones.Count == 0 && _deletedMilestones.Count == 0 && !_showCreateForm)
{
    <EmptyState>@L["NoMilestones"]</EmptyState>
}
else
{
    @if (_showCreateForm)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
            <MudText Typo="Typo.h6">@L["CreateMilestone"]</MudText>
            <MudTextField @bind-Value="_editName" Label="@L["MilestoneName"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MarkdownEditor @bind-Value="_editDescription" Label="@L["Description"]" Lines="3" Class="mt-2 mb-2" />
            <MudTextField @bind-Value="_newOrder" Label="@L["Order"]" InputType="InputType.Number" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateMilestone">@L["Create"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@HideCreateForm">@L["Cancel"]</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_editingId is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
            <MudText Typo="Typo.h6">@L["UpdateMilestone"]</MudText>
            <MudTextField @bind-Value="_editName" Label="@L["MilestoneName"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MarkdownEditor @bind-Value="_editDescription" Label="@L["Description"]" Lines="3" Class="mt-2 mb-2" />
            <MudTextField @bind-Value="_editOrder" Label="@L["Order"]" InputType="InputType.Number" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveMilestone">@L["Save"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@CancelEdit">@L["Cancel"]</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_milestones.Count > 0)
    {
        <MudGrid Class="mt-4">
        @foreach (var milestone in _milestones.OrderBy(m => m.Order))
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 h-100">
                    <MudText Typo="Typo.h6">@milestone.Name</MudText>
                    @if (!string.IsNullOrEmpty(milestone.Description))
                    {
                        <MarkdownView Text="@milestone.Description" MaxHeight="120" Class="mt-2" />
                    }
                    @{
                        var milestoneTasks = _tasks.Where(t => t.MilestoneId == milestone.Id).ToList();
                        var done = milestoneTasks.Count(t => t.Status == "Done");
                    }
                    <MudText Typo="Typo.caption" Class="mt-2">
                        @L["TaskCount"]: @milestoneTasks.Count · @done/@milestoneTasks.Count @L["Done"]
                    </MudText>
                    <MudProgressLinear Value="@(milestoneTasks.Count == 0 ? 0 : done * 100d / milestoneTasks.Count)" Color="Color.Default" Class="mt-1 beacon-track" />
                    @foreach (var task in milestoneTasks.Take(3))
                    {
                        <MudText Typo="Typo.body2" Class="mt-1 beacon-ellipsis" title="@task.Title">@task.Title</MudText>
                    }
                    @if (milestoneTasks.Count > 3)
                    {
                        <MudText Typo="Typo.caption">@string.Format(L["MoreTasks"].Value, milestoneTasks.Count - 3)</MudText>
                    }
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1"
                               data-testid="@($"open-milestone-{milestone.Id:D}")"
                               OnClick="() => OpenMilestone(milestone)">@L["Open"]</MudButton>
                    @if (milestone.ClosedAt is not null)
                    {
                        var orphans = MilestoneOrphanLint.OpenTaskCount(
                            milestone.ClosedAt, milestone.Id,
                            _tasks.Select(t => (t.MilestoneId, t.Status)));
                        if (orphans > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                @string.Format(L["OrphanWarning"].Value, orphans)
                            </MudAlert>
                        }
                    }
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-3">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => StartEditMilestone(milestone)">@L["Edit"]</MudButton>
                        @if (milestone.ClosedAt is null)
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="() => CloseMilestone(milestone)">@L["CloseMilestone"]</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="() => ReopenMilestone(milestone)">@L["ReopenMilestone"]</MudButton>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteMilestone(milestone)">@L["Delete"]</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
        </MudGrid>
    }

    @if (_deletedMilestones.Count > 0)
    {
        <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-4">
            <MudExpansionPanel Text="@($"{L["DeletedContent"]} ({_deletedMilestones.Count})")">
                @foreach (var deleted in _deletedMilestones)
                {
                    <MudPaper @key="deleted.TargetId" Elevation="0" Outlined="true" Class="pa-3 mb-2">
                        <MudText Typo="Typo.subtitle1">@deleted.Title</MudText>
                        <MudText Typo="Typo.caption">
                            @L["Deleted"] · rev. @deleted.DeletedRevision · <LocalTime Value="deleted.DeletedAt" Format="g" />
                        </MudText>
                        <MarkdownView Text="@MilestoneSnapshotDescription(deleted.SourceContentJson)" MaxHeight="100" />
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   Disabled="_busy" OnClick="() => RestoreDeletedMilestone(deleted)">
                            @L["RestoreRevision"]
                        </MudButton>
                    </MudPaper>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    <MudDialog @bind-Visible="_detailOpen" Options="_dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">@_open?.Name</MudText>
        </TitleContent>
        <DialogContent>
            @if (_open is not null)
            {
                var openTasks = _tasks.Where(t => t.MilestoneId == _open.Id).ToList();
                @if (!string.IsNullOrEmpty(_open.Description))
                {
                    <MarkdownView Text="@_open.Description" MaxHeight="320" />
                }
                @if (openTasks.Count == 0)
                {
                    <EmptyState>@L["NoTasks"]</EmptyState>
                }
                else
                {
                    @foreach (var task in openTasks)
                    {
                        <MudButton Variant="Variant.Text" Class="mt-1" Href="@($"/task/{task.Id}")">@task.Title</MudButton>
                    }
                }
                <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                    <MudExpansionPanel Text="@($"{L["ContentHistory"]} ({_milestoneHistory.Count})")">
                        @if (_milestoneHistory.Count == 0)
                        {
                            <MudText Typo="Typo.caption">@L["NoHistory"]</MudText>
                        }
                        @foreach (var version in _milestoneHistory)
                        {
                            <MudPaper @key="version.Id" Elevation="0" Outlined="true" Class="pa-2 mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.subtitle2">rev. @version.Revision</MudText>
                                    <MudSpacer />
                                    <LocalTime Value="version.At" Format="g" />
                                </MudStack>
                                <MarkdownView Text="@MilestoneHistoryMarkdown(version.ContentJson)" MaxHeight="140" />
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           data-testid="@($"restore-milestone-revision-{version.Revision}")"
                                           Disabled="_busy || version.Revision == _open.Revision"
                                           OnClick="() => RestoreMilestoneVersion(version)">
                                    @L["RestoreRevision"]
                                </MudButton>
                            </MudPaper>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </DialogContent>
    </MudDialog>
}

@code {
    private List<MilestoneDto> _milestones = [];
    private List<DeletedContentTargetDto> _deletedMilestones = [];
    private List<TaskItemDto> _tasks = [];
    private ProjectDto? _project;
    private ActorContext _actor = ActorContext.Anonymous;
    private bool _loading = true;
    private bool _busy;
    private bool _showCreateForm;
    private Guid? _editingId;
    private MilestoneDto? _open;
    private List<ContentVersionDto> _milestoneHistory = [];
    private bool _detailOpen;
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
    private string? _editName;
    private string? _editDescription;
    private int _editOrder;
    private int _newOrder;
    private int? _editRevision;

    protected override async Task OnInitializedAsync()
    {
        _actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        var current = await CurrentProject.HandleAsync(_actor);
        _project = current.Value;
        await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        if (_project is null)
        {
            _milestones = [];
            _tasks = [];
            return;
        }

        var milestones = await ListMilestones.HandleAsync(new ListProjectMilestonesCommand(
            new ListProjectMilestonesRequest(_project.Id), _actor));
        _milestones = milestones.Success ? milestones.Value!.ToList() : [];
        var deleted = await ListDeletedContentTargets.HandleAsync(_project.Id, _actor);
        _deletedMilestones = deleted.Success
            ? deleted.Value!.Where(item => item.TargetKind == ContentTargetKind.Milestone).ToList()
            : [];
        if (!deleted.Success)
            Snackbar.Add(deleted.Error ?? L["Error"].Value, Severity.Warning);
        var tasks = await ListTasks.HandleAsync(new ListProjectTasksCommand(new ListProjectTasksRequest(_project.Id)));
        _tasks = tasks.Success ? tasks.Value!.ToList() : [];
    }

    private void ShowCreateForm()
    {
        _newOrder = _milestones.Count + 1;
        _showCreateForm = true;
        _editingId = null;
        _editRevision = null;
    }

    private void HideCreateForm() => _showCreateForm = false;

    private async Task RestoreDeletedMilestone(DeletedContentTargetDto deleted)
    {
        if (_project is null || _busy)
            return;

        _busy = true;
        try
        {
            var restored = await RestoreContentVersion.HandleAsync(new RestoreContentVersionCommand(
                _project.Id,
                deleted.SourceVersionId,
                deleted.DeletedRevision,
                _actor,
                ContentTargetKind.Milestone,
                deleted.TargetId));
            if (!restored.Success)
            {
                Snackbar.Add(restored.Error ?? L["Error"].Value, Severity.Error);
                return;
            }

            await Reload();
            Snackbar.Add(L["RestoredRevision"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string MilestoneSnapshotDescription(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            if (document.RootElement.TryGetProperty("description", out var description)
                && description.ValueKind == System.Text.Json.JsonValueKind.String)
                return description.GetString() ?? string.Empty;
        }
        catch (System.Text.Json.JsonException)
        {
            // The title/id remains visible; a damaged snapshot cannot be previewed.
        }

        return string.Empty;
    }

    private async Task CreateMilestone()
    {
        if (_project is null)
        {
            Snackbar.Add(L["NoProjectAvailable"].Value, Severity.Error);
            return;
        }

        var created = await CreateMilestoneHandler.HandleAsync(new CreateMilestoneCommand(new CreateMilestoneRequest(
            string.IsNullOrWhiteSpace(_editName) ? L["Milestone"].Value : _editName,
            _editDescription,
            _project.Id,
            _newOrder), _actor));
        if (!created.Success)
        {
            Snackbar.Add(created.Error ?? L["Error"].Value, Severity.Error);
            return;
        }

        _showCreateForm = false;
        _editName = _editDescription = null;
        Snackbar.Add(L["MilestoneCreated"].Value, Severity.Success);
        await Reload();
    }

    private void StartEditMilestone(MilestoneDto milestone)
    {
        _editingId = milestone.Id;
        _editName = milestone.Name;
        _editDescription = milestone.Description;
        _editOrder = milestone.Order;
        _editRevision = milestone.Revision;
        _showCreateForm = false;
    }

    private async Task SaveMilestone()
    {
        if (_editingId is null) return;
        var updated = await UpdateMilestoneHandler.HandleAsync(new UpdateMilestoneCommand(new UpdateMilestoneRequest(
            _editingId.Value, _editName, _editDescription, _editOrder, _editRevision, _project?.Id), _actor));
        if (!updated.Success)
        {
            Snackbar.Add(updated.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _editingId = null;
        _editRevision = null;
        Snackbar.Add(L["MilestoneUpdated"].Value, Severity.Success);
        await Reload();
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editRevision = null;
    }

    private async Task OpenMilestone(MilestoneDto milestone)
    {
        _open = milestone;
        _detailOpen = true;
        await ReloadMilestoneHistory(milestone.Id);
    }

    private async Task ReloadMilestoneHistory(Guid milestoneId)
    {
        if (_project is null)
        {
            _milestoneHistory = [];
            return;
        }

        var history = await ContentVersions.HandleAsync(
            _project.Id, ContentTargetKind.Milestone, milestoneId, _actor, 50);
        _milestoneHistory = history.Success ? history.Value!.ToList() : [];
        if (!history.Success)
            Snackbar.Add(history.Error ?? L["Error"].Value, Severity.Warning);
    }

    private async Task RestoreMilestoneVersion(ContentVersionDto version)
    {
        if (_project is null || _open is null || _busy)
            return;

        var milestoneId = _open.Id;
        _busy = true;
        try
        {
            var restored = await RestoreContentVersion.HandleAsync(new RestoreContentVersionCommand(
                _project.Id,
                version.Id,
                _open.Revision,
                _actor,
                ContentTargetKind.Milestone,
                milestoneId));
            if (!restored.Success)
            {
                Snackbar.Add(restored.Error ?? L["Error"].Value, Severity.Error);
                return;
            }

            await Reload();
            _open = _milestones.FirstOrDefault(item => item.Id == milestoneId);
            if (_open is not null)
                await ReloadMilestoneHistory(milestoneId);
            Snackbar.Add(L["RestoredRevision"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string MilestoneHistoryMarkdown(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            var root = document.RootElement;
            var name = root.TryGetProperty("name", out var nameValue)
                ? nameValue.GetString() ?? string.Empty
                : string.Empty;
            var description = root.TryGetProperty("description", out var descriptionValue)
                && descriptionValue.ValueKind == System.Text.Json.JsonValueKind.String
                    ? descriptionValue.GetString() ?? string.Empty
                    : string.Empty;
            var order = root.TryGetProperty("order", out var orderValue)
                ? orderValue.GetInt32().ToString(System.Globalization.CultureInfo.InvariantCulture)
                : "—";
            var closed = root.TryGetProperty("closedAt", out var closedValue)
                && closedValue.ValueKind != System.Text.Json.JsonValueKind.Null;
            return $"**{name}** · order {order}" +
                (closed ? Environment.NewLine + Environment.NewLine + "Closed" : string.Empty) +
                (string.IsNullOrWhiteSpace(description)
                    ? string.Empty
                    : Environment.NewLine + Environment.NewLine + description);
        }
        catch (System.Text.Json.JsonException)
        {
            return string.Empty;
        }
    }

    private async Task CloseMilestone(MilestoneDto milestone)
    {
        var result = await CloseMilestoneHandler.HandleAsync(new CloseMilestoneCommand(
            new CloseMilestoneRequest(milestone.Id, milestone.ProjectId), _actor));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private async Task ReopenMilestone(MilestoneDto milestone)
    {
        var result = await ReopenMilestoneHandler.HandleAsync(new ReopenMilestoneCommand(
            new ReopenMilestoneRequest(milestone.Id, milestone.ProjectId), _actor));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private async Task DeleteMilestone(MilestoneDto milestone)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, L["DeleteMilestoneConfirm"].Value,
            yesText: L["Delete"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true)
            return;
        var result = await DeleteMilestoneHandler.HandleAsync(new DeleteMilestoneCommand(new DeleteMilestoneRequest(milestone.Id), _actor));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["MilestoneDeleted"].Value, Severity.Success);
        await Reload();
    }
}
