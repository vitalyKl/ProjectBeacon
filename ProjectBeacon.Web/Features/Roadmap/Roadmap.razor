@page "/roadmap"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Context
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Application.Milestones
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Application.Releases
@using ProjectBeacon.Application.Persistence
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject ListProjectMilestonesHandler ListMilestones
@inject ListDeletedContentTargetsHandler ListDeletedContentTargets
@inject ListContentVersionsHandler ContentVersions
@inject RestoreContentVersionHandler RestoreContentVersion
@inject ListProjectTasksHandler ListTasks
@inject CreateMilestoneHandler CreateMilestoneHandler
@inject UpdateMilestoneHandler UpdateMilestoneHandler
@inject DeleteMilestoneHandler DeleteMilestoneHandler
@inject CloseMilestoneHandler CloseMilestoneHandler
@inject ReopenMilestoneHandler ReopenMilestoneHandler
@inject GetProjectVersionPolicyHandler GetVersionPolicy
@inject ListProjectReleasesHandler ListProjectReleases
@inject CreateReleaseHandler CreateReleaseHandler
@inject SetReleaseStatusHandler SetReleaseStatus
@inject DeleteReleaseHandler DeleteReleaseHandler
@inject SetMilestoneReleaseHandler SetMilestoneRelease
@inject ProjectBeacon.Application.Authorization.IAuthorizationService Authorization
@inject IBeaconDbFactory DbFactory
@inject IDialogService Dialogs

<PageTitle>@L["Roadmap"]</PageTitle>
<PageHeader Title="@L["Roadmap"]">
    @if (_releaseManagementEnabled && _canManageReleases)
    {
        <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@ShowCreateReleaseForm">@L["NewRelease"]</MudButton>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@ShowCreateForm">@L["NewMilestone"]</MudButton>
</PageHeader>

@if (_loading)
{
    <LoadingState />
}
else if (_project is null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
}
    else if (_milestones.Count == 0 && _deletedMilestones.Count == 0 && !_showCreateForm
        && (!_releaseManagementEnabled || _releases.Count == 0) && !_showCreateReleaseForm)
{
    <EmptyState>@L["NoMilestones"]</EmptyState>
}
else
{
    @if (_releaseManagementEnabled)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                <MudText Typo="Typo.h6">@L["ProjectReleases"]</MudText>
                <MudText Typo="Typo.caption">@_releases.Count @L["Releases"]</MudText>
            </MudStack>
            @if (_showCreateReleaseForm && _canManageReleases)
            {
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle1">@L["NewRelease"]</MudText>
                <MudTextField @bind-Value="_releaseName" Label="@L["ReleaseName"]" Required="true"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MarkdownEditor @bind-Value="_releaseDescription" Label="@L["Description"]" Lines="2" />
                <MudTextField @bind-Value="_releaseTargetVersion" Label="@L["ReleaseTargetVersion"]"
                              HelperText="@L["ReleaseTargetVersionHelp"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_releaseTargetBranch" Label="@L["ReleaseTargetBranch"]"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudNumericField T="int" @bind-Value="_releaseOrder" Label="@L["Order"]"
                                 Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Disabled="@_releaseBusy" OnClick="CreateRelease">@L["Create"]</MudButton>
                    <MudButton Variant="Variant.Text" Disabled="@_releaseBusy" OnClick="HideCreateReleaseForm">@L["Cancel"]</MudButton>
                </MudStack>
            }
            @if (_releases.Count == 0)
            {
                <MudText Typo="Typo.body2" Class="mt-3">@L["NoReleases"]</MudText>
            }
            else
            {
                <MudGrid Class="mt-2">
                    @foreach (var release in _releases.OrderBy(item => item.Order))
                    {
                        <MudItem xs="12" md="6">
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                                    <MudText Typo="Typo.subtitle1">@release.Name</MudText>
                                    <MudChip T="string" Size="Size.Small"
                                             Color="@(release.Status == ReleaseStatus.Published ? Color.Success : Color.Default)">
                                        @L[$"ReleaseStatus{release.Status}"]
                                    </MudChip>
                                </MudStack>
                                @if (!string.IsNullOrWhiteSpace(release.Description))
                                {
                                    <MarkdownView Text="@release.Description" MaxHeight="90" Class="mt-1" />
                                }
                                <MudText Typo="Typo.caption" Class="mt-2">@L["ReleaseTargetVersion"]: @(release.TargetVersion ?? "—")</MudText>
                                <MudText Typo="Typo.caption">@L["ReleaseTargetBranch"]: @release.TargetBranch</MudText>
                                <MudText Typo="Typo.caption">@L["Milestones"]: @release.MilestoneCount</MudText>
                                @if (_canManageReleases)
                                {
                                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-2">
                                        @if (release.Status == ReleaseStatus.Planned)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Disabled="@_releaseBusy"
                                                       OnClick="() => ChangeReleaseStatus(release, ReleaseStatus.InProgress)">@L["ReleaseStart"]</MudButton>
                                        }
                                        @if (release.Status == ReleaseStatus.InProgress)
                                        {
                                            <MudText Typo="Typo.caption" Class="mud-text-secondary">
                                                @L["ReleaseCandidateViaPrepare"]
                                            </MudText>
                                        }
                                        @if (release.Status == ReleaseStatus.Candidate)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="@_releaseBusy"
                                                       OnClick="() => ChangeReleaseStatus(release, ReleaseStatus.Cancelled)">@L["CancelRelease"]</MudButton>
                                        }
                                        @if (release.Status is ReleaseStatus.Planned or ReleaseStatus.InProgress)
                                        {
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="@_releaseBusy"
                                                       OnClick="() => ChangeReleaseStatus(release, ReleaseStatus.Cancelled)">@L["CancelRelease"]</MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" Disabled="@_releaseBusy"
                                                       OnClick="() => DeleteRelease(release)">@L["Delete"]</MudButton>
                                        }
                                    </MudStack>
                                }
                            </MudPaper>
                        </MudItem>
                    }
                </MudGrid>
            }
        </MudPaper>
    }

    @if (_showCreateForm)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
            <MudText Typo="Typo.h6">@L["CreateMilestone"]</MudText>
            <MudTextField @bind-Value="_editName" Label="@L["MilestoneName"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MarkdownEditor @bind-Value="_editDescription" Label="@L["Description"]" Lines="3" Class="mt-2 mb-2" />
            <MudTextField @bind-Value="_newOrder" Label="@L["Order"]" InputType="InputType.Number" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateMilestone">@L["Create"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@HideCreateForm">@L["Cancel"]</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_editingId is not null)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
            <MudText Typo="Typo.h6">@L["UpdateMilestone"]</MudText>
            <MudTextField @bind-Value="_editName" Label="@L["MilestoneName"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MarkdownEditor @bind-Value="_editDescription" Label="@L["Description"]" Lines="3" Class="mt-2 mb-2" />
            <MudTextField @bind-Value="_editOrder" Label="@L["Order"]" InputType="InputType.Number" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2 mb-2" />
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveMilestone">@L["Save"]</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@CancelEdit">@L["Cancel"]</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_milestones.Count > 0)
    {
        <MudGrid Class="mt-4">
        @foreach (var milestone in _milestones.OrderBy(m => m.Order))
        {
            <MudItem xs="12" sm="6" md="4">
                <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 h-100">
                    <MudText Typo="Typo.h6">@milestone.Name</MudText>
                    @if (_releaseManagementEnabled && _canManageReleases)
                    {
                        <MudSelect T="Guid?" Value="@milestone.ReleaseId"
                                   ValueChanged="@(releaseId => SetMilestoneReleaseAsync(milestone, releaseId))"
                                   Label="@L["MilestoneRelease"]" Variant="Variant.Outlined" Margin="Margin.Dense"
                                   Dense="true" Disabled="@_releaseBusy" Class="mt-2">
                            <MudSelectItem T="Guid?" Value="@((Guid?)null)">@L["NoRelease"]</MudSelectItem>
                            @foreach (var release in _releases.Where(item => item.Status is not (ReleaseStatus.Published or ReleaseStatus.Cancelled)))
                            {
                                <MudSelectItem T="Guid?" Value="@((Guid?)release.Id)">@release.Name</MudSelectItem>
                            }
                        </MudSelect>
                    }
                    else if (_releaseManagementEnabled && milestone.ReleaseId is not null)
                    {
                        <MudText Typo="Typo.caption">@L["MilestoneRelease"]: @(_releases.FirstOrDefault(item => item.Id == milestone.ReleaseId)?.Name ?? "—")</MudText>
                    }
                    @if (!string.IsNullOrEmpty(milestone.Description))
                    {
                        <MarkdownView Text="@milestone.Description" MaxHeight="120" Class="mt-2" />
                    }
                    @{
                        var milestoneTasks = _tasks.Where(t => t.MilestoneId == milestone.Id).ToList();
                        var done = milestoneTasks.Count(t => t.Status == "Done");
                    }
                    <MudText Typo="Typo.caption" Class="mt-2">
                        @L["TaskCount"]: @milestoneTasks.Count · @done/@milestoneTasks.Count @L["Done"]
                    </MudText>
                    <MudProgressLinear Value="@(milestoneTasks.Count == 0 ? 0 : done * 100d / milestoneTasks.Count)" Color="Color.Default" Class="mt-1 beacon-track" />
                    @foreach (var task in milestoneTasks.Take(3))
                    {
                        <MudText Typo="Typo.body2" Class="mt-1 beacon-ellipsis" title="@task.Title">@task.Title</MudText>
                    }
                    @if (milestoneTasks.Count > 3)
                    {
                        <MudText Typo="Typo.caption">@string.Format(L["MoreTasks"].Value, milestoneTasks.Count - 3)</MudText>
                    }
                    <MudButton Variant="Variant.Text" Size="Size.Small" Class="mt-1"
                               data-testid="@($"open-milestone-{milestone.Id:D}")"
                               OnClick="() => OpenMilestone(milestone)">@L["Open"]</MudButton>
                    @if (milestone.ClosedAt is not null)
                    {
                        var orphans = MilestoneOrphanLint.OpenTaskCount(
                            milestone.ClosedAt, milestone.Id,
                            _tasks.Select(t => (t.MilestoneId, t.Status)));
                        if (orphans > 0)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                                @string.Format(L["OrphanWarning"].Value, orphans)
                            </MudAlert>
                        }
                    }
                    <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mt-3">
                        <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => StartEditMilestone(milestone)">@L["Edit"]</MudButton>
                        @if (milestone.ClosedAt is null)
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="() => CloseMilestone(milestone)">@L["CloseMilestone"]</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" OnClick="() => ReopenMilestone(milestone)">@L["ReopenMilestone"]</MudButton>
                        }
                        <MudButton Variant="Variant.Text" Color="Color.Error" OnClick="() => DeleteMilestone(milestone)">@L["Delete"]</MudButton>
                    </MudStack>
                </MudPaper>
            </MudItem>
        }
        </MudGrid>
    }

    @if (_deletedMilestones.Count > 0)
    {
        <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-4">
            <MudExpansionPanel Text="@($"{L["DeletedContent"]} ({_deletedMilestones.Count})")">
                @foreach (var deleted in _deletedMilestones)
                {
                    <MudPaper @key="deleted.TargetId" Elevation="0" Outlined="true" Class="pa-3 mb-2">
                        <MudText Typo="Typo.subtitle1">@deleted.Title</MudText>
                        <MudText Typo="Typo.caption">
                            @L["Deleted"] · rev. @deleted.DeletedRevision · <LocalTime Value="deleted.DeletedAt" Format="g" />
                        </MudText>
                        <MarkdownView Text="@MilestoneSnapshotDescription(deleted.SourceContentJson)" MaxHeight="100" />
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                   Disabled="_busy" OnClick="() => RestoreDeletedMilestone(deleted)">
                            @L["RestoreRevision"]
                        </MudButton>
                    </MudPaper>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>
    }

    <MudDialog @bind-Visible="_detailOpen" Options="_dialogOptions">
        <TitleContent>
            <MudText Typo="Typo.h6">@_open?.Name</MudText>
        </TitleContent>
        <DialogContent>
            @if (_open is not null)
            {
                var openTasks = _tasks.Where(t => t.MilestoneId == _open.Id).ToList();
                @if (!string.IsNullOrEmpty(_open.Description))
                {
                    <MarkdownView Text="@_open.Description" MaxHeight="320" />
                }
                @if (openTasks.Count == 0)
                {
                    <EmptyState>@L["NoTasks"]</EmptyState>
                }
                else
                {
                    @foreach (var task in openTasks)
                    {
                        <MudButton Variant="Variant.Text" Class="mt-1" Href="@($"/task/{task.Id}")">@task.Title</MudButton>
                    }
                }
                <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                    <MudExpansionPanel Text="@($"{L["ContentHistory"]} ({_milestoneHistory.Count})")">
                        @if (_milestoneHistory.Count == 0)
                        {
                            <MudText Typo="Typo.caption">@L["NoHistory"]</MudText>
                        }
                        @foreach (var version in _milestoneHistory)
                        {
                            <MudPaper @key="version.Id" Elevation="0" Outlined="true" Class="pa-2 mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.subtitle2">rev. @version.Revision</MudText>
                                    <MudSpacer />
                                    <LocalTime Value="version.At" Format="g" />
                                </MudStack>
                                <MarkdownView Text="@MilestoneHistoryMarkdown(version.ContentJson)" MaxHeight="140" />
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           data-testid="@($"restore-milestone-revision-{version.Revision}")"
                                           Disabled="_busy || version.Revision == _open.Revision"
                                           OnClick="() => RestoreMilestoneVersion(version)">
                                    @L["RestoreRevision"]
                                </MudButton>
                            </MudPaper>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </DialogContent>
    </MudDialog>
}

@code {
    private List<MilestoneDto> _milestones = [];
    private List<DeletedContentTargetDto> _deletedMilestones = [];
    private List<TaskItemDto> _tasks = [];
    private ProjectDto? _project;
    private ActorContext _actor = ActorContext.Anonymous;
    private bool _loading = true;
    private bool _busy;
    private bool _showCreateForm;
    private Guid? _editingId;
    private MilestoneDto? _open;
    private List<ContentVersionDto> _milestoneHistory = [];
    private bool _detailOpen;
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
    private string? _editName;
    private string? _editDescription;
    private int _editOrder;
    private int _newOrder;
    private int? _editRevision;
    private List<ReleaseDto> _releases = [];
    private bool _releaseManagementEnabled;
    private bool _canManageReleases;
    private bool _showCreateReleaseForm;
    private bool _releaseBusy;
    private string _releaseName = string.Empty;
    private string? _releaseDescription;
    private string? _releaseTargetVersion;
    private string _releaseTargetBranch = "main";
    private int _releaseOrder = 1;

    protected override async Task OnInitializedAsync()
    {
        _actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        var current = await CurrentProject.HandleAsync(_actor);
        _project = current.Value;
        if (_project is not null)
        {
            var policy = await GetVersionPolicy.HandleAsync(_project.Id, _actor);
            _releaseManagementEnabled = policy.Success && policy.Value?.ReleaseManagementEnabled == true;
            await using var db = DbFactory.CreateDbContext();
            var permission = await Authorization.CanAsync(
                db, _actor, ResourceType.Project, AuthAction.Administer, projectId: _project.Id);
            _canManageReleases = permission.Success;
        }
        await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        if (_project is null)
        {
            _milestones = [];
            _tasks = [];
            return;
        }

        var milestones = await ListMilestones.HandleAsync(new ListProjectMilestonesCommand(
            new ListProjectMilestonesRequest(_project.Id), _actor));
        if (!milestones.Success)
            Notifications.Failure(milestones, L["Roadmap"].Value, L["Load"].Value);
        _milestones = milestones.Success ? milestones.Value!.ToList() : [];
        var deleted = await ListDeletedContentTargets.HandleAsync(_project.Id, _actor);
        _deletedMilestones = deleted.Success
            ? deleted.Value!.Where(item => item.TargetKind == ContentTargetKind.Milestone).ToList()
            : [];
        if (!deleted.Success)
            Notifications.Add(Notifications.FormatFailure(deleted, L["Roadmap"].Value, L["Delete"].Value), Severity.Warning);
        var tasks = await ListTasks.HandleAsync(new ListProjectTasksCommand(new ListProjectTasksRequest(_project.Id)));
        if (!tasks.Success)
            Notifications.Failure(tasks, L["Roadmap"].Value, L["Load"].Value);
        _tasks = tasks.Success ? tasks.Value!.ToList() : [];

        if (_releaseManagementEnabled)
        {
            var releases = await ListProjectReleases.HandleAsync(new ListProjectReleasesCommand(
                new ListProjectReleasesRequest(_project.Id), _actor));
            _releases = releases.Success ? releases.Value!.ToList() : [];
            if (!releases.Success)
                Notifications.Failure(releases, L["Roadmap"].Value, L["Load"].Value);
        }
        else
            _releases = [];
    }

    private void ShowCreateReleaseForm()
    {
        _releaseName = string.Empty;
        _releaseDescription = null;
        _releaseTargetVersion = null;
        _releaseTargetBranch = "main";
        _releaseOrder = _releases.Count + 1;
        _showCreateReleaseForm = true;
        _showCreateForm = false;
        _editingId = null;
    }

    private void HideCreateReleaseForm() => _showCreateReleaseForm = false;

    private async Task CreateRelease()
    {
        if (_project is null || !_canManageReleases || _releaseBusy)
            return;
        _releaseBusy = true;
        try
        {
            var result = await CreateReleaseHandler.HandleAsync(new CreateReleaseCommand(
                _project.Id,
                new CreateReleaseRequest(_releaseName, _releaseDescription, _releaseTargetVersion,
                    _releaseTargetBranch, _releaseOrder),
                _actor));
            if (!result.Success)
            {
                Notifications.Failure(result, L["Roadmap"].Value, L["Create"].Value);
                return;
            }
            _showCreateReleaseForm = false;
            Notifications.Add(L["ReleaseCreated"].Value, Severity.Success);
            await Reload();
        }
        finally
        {
            _releaseBusy = false;
        }
    }

    private async Task ChangeReleaseStatus(ReleaseDto release, ReleaseStatus status)
    {
        if (_project is null || !_canManageReleases || _releaseBusy)
            return;
        _releaseBusy = true;
        try
        {
            var result = await SetReleaseStatus.HandleAsync(new SetReleaseStatusCommand(
                new SetReleaseStatusRequest(release.Id, _project.Id, status, release.Revision), _actor));
            if (!result.Success)
            {
                Notifications.Failure(result, L["Roadmap"].Value, L["Save"].Value);
                return;
            }
            await Reload();
        }
        finally
        {
            _releaseBusy = false;
        }
    }

    private async Task DeleteRelease(ReleaseDto release)
    {
        if (_project is null || !_canManageReleases || _releaseBusy)
            return;
        _releaseBusy = true;
        try
        {
            var result = await DeleteReleaseHandler.HandleAsync(new DeleteReleaseCommand(
                new DeleteReleaseRequest(release.Id, _project.Id), _actor));
            if (!result.Success)
            {
                Notifications.Failure(result, L["Roadmap"].Value, L["Delete"].Value);
                return;
            }
            Notifications.Add(L["ReleaseDeleted"].Value, Severity.Success);
            await Reload();
        }
        finally
        {
            _releaseBusy = false;
        }
    }

    private async Task SetMilestoneReleaseAsync(MilestoneDto milestone, Guid? releaseId)
    {
        if (_project is null || !_canManageReleases || _releaseBusy || milestone.ReleaseId == releaseId)
            return;
        _releaseBusy = true;
        try
        {
            var result = await SetMilestoneRelease.HandleAsync(new SetMilestoneReleaseCommand(
                new SetMilestoneReleaseRequest(milestone.Id, _project.Id, releaseId, milestone.Revision), _actor));
            if (!result.Success)
            {
                Notifications.Failure(result, L["Roadmap"].Value, L["Save"].Value);
                await Reload();
                return;
            }
            await Reload();
        }
        finally
        {
            _releaseBusy = false;
        }
    }

    private void ShowCreateForm()
    {
        _newOrder = _milestones.Count + 1;
        _showCreateForm = true;
        _editingId = null;
        _editRevision = null;
    }

    private void HideCreateForm() => _showCreateForm = false;

    private async Task RestoreDeletedMilestone(DeletedContentTargetDto deleted)
    {
        if (_project is null || _busy)
            return;

        _busy = true;
        try
        {
            var restored = await RestoreContentVersion.HandleAsync(new RestoreContentVersionCommand(
                _project.Id,
                deleted.SourceVersionId,
                deleted.DeletedRevision,
                _actor,
                ContentTargetKind.Milestone,
                deleted.TargetId));
            if (!restored.Success)
            {
                Notifications.Failure(restored, L["Roadmap"].Value, L["Restore"].Value);
                return;
            }

            await Reload();
            Notifications.Add(L["RestoredRevision"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string MilestoneSnapshotDescription(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            if (document.RootElement.TryGetProperty("description", out var description)
                && description.ValueKind == System.Text.Json.JsonValueKind.String)
                return description.GetString() ?? string.Empty;
        }
        catch (System.Text.Json.JsonException)
        {
            // The title/id remains visible; a damaged snapshot cannot be previewed.
        }

        return string.Empty;
    }

    private async Task CreateMilestone()
    {
        if (_project is null)
        {
            Notifications.Failure(L["NoProjectAvailable"].Value, L["Roadmap"].Value, ErrorCodes.ValidationFailed, L["Create"].Value);
            return;
        }

        var created = await CreateMilestoneHandler.HandleAsync(new CreateMilestoneCommand(new CreateMilestoneRequest(
            string.IsNullOrWhiteSpace(_editName) ? L["Milestone"].Value : _editName,
            _editDescription,
            _project.Id,
            _newOrder), _actor));
        if (!created.Success)
        {
            Notifications.Failure(created, L["Roadmap"].Value, L["Create"].Value);
            return;
        }

        _showCreateForm = false;
        _editName = _editDescription = null;
        Notifications.Add(L["MilestoneCreated"].Value, Severity.Success);
        await Reload();
    }

    private void StartEditMilestone(MilestoneDto milestone)
    {
        _editingId = milestone.Id;
        _editName = milestone.Name;
        _editDescription = milestone.Description;
        _editOrder = milestone.Order;
        _editRevision = milestone.Revision;
        _showCreateForm = false;
    }

    private async Task SaveMilestone()
    {
        if (_editingId is null) return;
        var updated = await UpdateMilestoneHandler.HandleAsync(new UpdateMilestoneCommand(new UpdateMilestoneRequest(
            _editingId.Value, _editName, _editDescription, _editOrder, _editRevision, _project?.Id), _actor));
        if (!updated.Success)
        {
            Notifications.Failure(updated, L["Roadmap"].Value, L["Update"].Value);
            return;
        }
        _editingId = null;
        _editRevision = null;
        Notifications.Add(L["MilestoneUpdated"].Value, Severity.Success);
        await Reload();
    }

    private void CancelEdit()
    {
        _editingId = null;
        _editRevision = null;
    }

    private async Task OpenMilestone(MilestoneDto milestone)
    {
        _open = milestone;
        _detailOpen = true;
        await ReloadMilestoneHistory(milestone.Id);
    }

    private async Task ReloadMilestoneHistory(Guid milestoneId)
    {
        if (_project is null)
        {
            _milestoneHistory = [];
            return;
        }

        var history = await ContentVersions.HandleAsync(
            _project.Id, ContentTargetKind.Milestone, milestoneId, _actor, 50);
        _milestoneHistory = history.Success ? history.Value!.ToList() : [];
        if (!history.Success)
            Notifications.Add(Notifications.FormatFailure(history, L["Roadmap"].Value, L["Load"].Value), Severity.Warning);
    }

    private async Task RestoreMilestoneVersion(ContentVersionDto version)
    {
        if (_project is null || _open is null || _busy)
            return;

        var milestoneId = _open.Id;
        _busy = true;
        try
        {
            var restored = await RestoreContentVersion.HandleAsync(new RestoreContentVersionCommand(
                _project.Id,
                version.Id,
                _open.Revision,
                _actor,
                ContentTargetKind.Milestone,
                milestoneId));
            if (!restored.Success)
            {
                Notifications.Failure(restored, L["Roadmap"].Value, L["Restore"].Value);
                return;
            }

            await Reload();
            _open = _milestones.FirstOrDefault(item => item.Id == milestoneId);
            if (_open is not null)
                await ReloadMilestoneHistory(milestoneId);
            Notifications.Add(L["RestoredRevision"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string MilestoneHistoryMarkdown(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            var root = document.RootElement;
            var name = root.TryGetProperty("name", out var nameValue)
                ? nameValue.GetString() ?? string.Empty
                : string.Empty;
            var description = root.TryGetProperty("description", out var descriptionValue)
                && descriptionValue.ValueKind == System.Text.Json.JsonValueKind.String
                    ? descriptionValue.GetString() ?? string.Empty
                    : string.Empty;
            var order = root.TryGetProperty("order", out var orderValue)
                ? orderValue.GetInt32().ToString(System.Globalization.CultureInfo.InvariantCulture)
                : "—";
            var closed = root.TryGetProperty("closedAt", out var closedValue)
                && closedValue.ValueKind != System.Text.Json.JsonValueKind.Null;
            return $"**{name}** · order {order}" +
                (closed ? Environment.NewLine + Environment.NewLine + "Closed" : string.Empty) +
                (string.IsNullOrWhiteSpace(description)
                    ? string.Empty
                    : Environment.NewLine + Environment.NewLine + description);
        }
        catch (System.Text.Json.JsonException)
        {
            return string.Empty;
        }
    }

