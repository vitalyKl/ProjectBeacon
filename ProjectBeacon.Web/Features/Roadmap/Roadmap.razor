    protected override async Task OnInitializedAsync()
    {
        _actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        var current = await CurrentProject.HandleAsync(_actor);
        if (!current.Success)
        {
            _projectLoadErrorMessage = Notifications.FormatFailure(current, L["Projects"].Value, L["Load"].Value);
            _loading = false;
            return;
        }

        _project = current.Value;
        if (_project is not null)
        {
            var policy = await GetVersionPolicy.HandleAsync(_project.Id, _actor);
            _releaseManagementEnabled = policy.Success && policy.Value?.ReleaseManagementEnabled == true;
            await using var db = DbFactory.CreateDbContext();
            var permission = await Authorization.CanAsync(
                db, _actor, ResourceType.Project, AuthAction.Administer, projectId: _project.Id);
            _canManageReleases = permission.Success;
        }
        await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        if (_project is null)
        {
            _milestones = [];
            _tasks = [];
            return;
        }

        var loadErrors = new List<string>();

        var milestones = await ListMilestones.HandleAsync(new ListProjectMilestonesCommand(
            new ListProjectMilestonesRequest(_project.Id), _actor));
        if (milestones.Success)
            _milestones = milestones.Value!.ToList();
        else
            loadErrors.Add(Notifications.FormatFailure(milestones, L["Roadmap"].Value, L["Load"].Value));

        var deleted = await ListDeletedContentTargets.HandleAsync(_project.Id, _actor);
        if (deleted.Success)
            _deletedMilestones = deleted.Value!.Where(item => item.TargetKind == ContentTargetKind.Milestone).ToList();
        else
            loadErrors.Add(Notifications.FormatFailure(deleted, L["Roadmap"].Value, L["Load"].Value));

        var tasks = await ListTasks.HandleAsync(new ListProjectTasksCommand(new ListProjectTasksRequest(_project.Id)));
        if (tasks.Success)
            _tasks = tasks.Value!.ToList();
        else
            loadErrors.Add(Notifications.FormatFailure(tasks, L["Roadmap"].Value, L["Load"].Value));

        if (_releaseManagementEnabled)
        {
            var releases = await ListProjectReleases.HandleAsync(new ListProjectReleasesCommand(
                new ListProjectReleasesRequest(_project.Id), _actor));
            if (releases.Success)
            {
                _releases = releases.Value!.ToList();
                _releaseLoadErrorMessage = null;
            }
            else
                _releaseLoadErrorMessage = Notifications.FormatFailure(releases, L["Roadmap"].Value, L["Load"].Value);
        }
        else
        {
            _releases = [];
            _releaseLoadErrorMessage = null;
        }

        _loadErrorMessage = loadErrors.Count == 0 ? null : string.Join(Environment.NewLine, loadErrors);
    }

    private void ShowCreateHotfixTask(ReleaseDto release)
    {
        if (!_canManageReleases || _releaseBusy
            || release.Status != ReleaseStatus.Published
            || release.PublicationStatus != ReleasePublicationStatus.Published
            || !release.PublicationTagPushed
            || string.IsNullOrWhiteSpace(release.DeployedCommitSha))
            return;

        _hotfixReleaseId = release.Id;
        _hotfixRequestId = Guid.NewGuid();
        _hotfixTitle = $"Hotfix for {release.Name}";
        _hotfixDescription =
            $"Production fix for deployed version {release.DeployedVersion ?? release.TargetVersion ?? "unknown"}.\n\n" +
            $"Deployed commit: {release.DeployedCommitSha}\n" +
            $"Production branch: {release.TargetBranch}";
    }

