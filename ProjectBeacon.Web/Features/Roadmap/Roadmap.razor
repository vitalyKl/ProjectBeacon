        _loadErrorMessage is not null,
        _releaseLoadErrorMessage is not null);

    internal static bool ShouldShowEmptyState(
        int milestoneCount,
        int deletedMilestoneCount,
        bool showCreateForm,
        bool releaseManagementEnabled,
        int releaseCount,
        bool showCreateReleaseForm,
        bool hasRoadmapLoadError,
        bool hasReleaseLoadError) =>
        milestoneCount == 0
        && deletedMilestoneCount == 0
        && !showCreateForm
        && (!releaseManagementEnabled || releaseCount == 0)
        && !showCreateReleaseForm
        && !hasRoadmapLoadError
        && !hasReleaseLoadError;
