@page "/board"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Milestones
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Features.Tasks
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject ListProjectTasksHandler ListTasks
@inject ListLabelsHandler ListLabels
@inject ListProjectMilestonesHandler ListMilestones
@inject ChangeTaskStatusHandler ChangeStatus
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>@L["Board"]</PageTitle>
<PageHeader Title="@L["Board"]">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateTask">@L["NewTask"]</MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_error)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
    }
    else if (_project is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
    }
    else
    {
        @if (_labelsLoadErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_labelsLoadErrorMessage</MudAlert>
        }
        @if (_milestonesLoadErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_milestonesLoadErrorMessage</MudAlert>
        }
        <MudButtonGroup Variant="Variant.Outlined" Class="beacon-board-filter mb-3">
            @foreach (var column in MobileColumns)
            {
                var selected = _mobileColumn == column;
                <MudButton Variant="@(selected ? Variant.Filled : Variant.Text)" Color="Color.Primary" OnClick="@(() => _mobileColumn = column)">
                    @ChromeLabels.Status(L, column)
                </MudButton>
            }
        </MudButtonGroup>
        <MudDropContainer @ref="_container"
            T="TaskItemDto"
            Items="_allTasks"
            ItemsSelector="@((task, zoneId) => task.Status == GetStatusFromZone(zoneId))"
            ItemDropped="OnItemDropped"
            Class="@($"kanban-board kanban-show-{_mobileColumn.ToLowerInvariant()}")">
        <ChildContent>
            <MudPaper Class="kanban-column kanban-column-todo" Elevation="0" Outlined="true">
                <MudDropZone Identifier="Todo" T="TaskItemDto" Class="kanban-zone">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="kanban-header mb-2">
                        <span class="beacon-column-dot"></span>
                        <MudText Typo="Typo.subtitle1">@L["Todo"]</MudText>
                        <b class="kanban-count">@_todoCount</b>
                    </MudStack>
                </MudDropZone>
            </MudPaper>

            <MudPaper Class="kanban-column kanban-column-inprogress" Elevation="0" Outlined="true">
                <MudDropZone Identifier="InProgress" T="TaskItemDto" Class="kanban-zone">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="kanban-header mb-2">
                        <span class="beacon-column-dot is-progress"></span>
                        <MudText Typo="Typo.subtitle1">@L["InProgress"]</MudText>
                        <b class="kanban-count">@_inProgressCount</b>
                    </MudStack>
                </MudDropZone>
            </MudPaper>

            <MudPaper Class="kanban-column kanban-column-done" Elevation="0" Outlined="true">
                <MudDropZone Identifier="Done" T="TaskItemDto" Class="kanban-zone">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="kanban-header mb-2">
                        <span class="beacon-column-dot is-done"></span>
                        <MudText Typo="Typo.subtitle1">@L["Done"]</MudText>
                        <b class="kanban-count">@_doneCount</b>
                    </MudStack>
                </MudDropZone>
            </MudPaper>
        </ChildContent>
        <ItemRenderer>
            <TaskCard Task="context" OnMove="status => MoveTask(context, status)" />
        </ItemRenderer>
    </MudDropContainer>
}

@code {
    private static readonly string[] MobileColumns = ["Todo", "InProgress", "Done"];
    private string _mobileColumn = "Todo";
    private List<TaskItemDto> _allTasks = [];
    private List<LabelDto> _labels = [];
    private List<MilestoneDto> _milestones = [];
    private ProjectDto? _project;
    private ActorContext _actorContext = ActorContext.Anonymous;
    private MudDropContainer<TaskItemDto>? _container;
    private bool _loading = true;
    private bool _error;
    private string? _errorMessage;
    private string? _labelsLoadErrorMessage;
    private string? _milestonesLoadErrorMessage;
    private int _todoCount => _allTasks.Count(t => t.Status == "Todo");
    private int _inProgressCount => _allTasks.Count(t => t.Status == "InProgress");
    private int _doneCount => _allTasks.Count(t => t.Status == "Done");

    protected override async Task OnInitializedAsync()
    {
        _actorContext = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        var current = await CurrentProject.HandleAsync(_actorContext);
        if (!current.Success)
        {
            _error = true;
            _errorMessage = Notifications.FormatFailure(current, L["Board"].Value, L["Load"].Value);
            _loading = false;
            return;
        }

        if (!current.Success)
        {
            _error = true;
            _errorMessage = Notifications.FormatFailure(current, L["Projects"].Value, L["Load"].Value);
        }
        else
        {
            _project = current.Value;
            await ReloadTasks();
        }
        _loading = false;
    }

    private string GetStatusFromZone(string zoneId) => zoneId switch
    {
        "Todo" => "Todo",
        "InProgress" => "InProgress",
        "Done" => "Done",
        _ => "Todo"
    };

    private static TaskItemStatus ParseStatus(string zoneId) => zoneId switch
    {
        "InProgress" => TaskItemStatus.InProgress,
        "Done" => TaskItemStatus.Done,
        _ => TaskItemStatus.Todo
    };

    private async Task OnItemDropped(MudItemDropInfo<TaskItemDto> dropInfo)
    {
        if (dropInfo.Item is null) return;
        var next = GetStatusFromZone(dropInfo.DropzoneIdentifier);
        _allTasks = _allTasks
            .Select(t => t.Id == dropInfo.Item.Id ? t with { Status = next } : t)
            .ToList();
        _container?.Refresh();

        var result = await ChangeStatus.HandleAsync(new ChangeTaskStatusCommand(
            new ChangeTaskStatusRequest(dropInfo.Item.Id, ParseStatus(dropInfo.DropzoneIdentifier))));
        if (!result.Success)
        {
            Notifications.Add(Notifications.FormatFailure(result, L["Board"].Value, L["ChangeStatus"].Value), Severity.Warning);
            await ReloadTasks();
            return;
        }

        await ReloadTasks();
        Notifications.Add(string.Format(L["TaskMoved"].Value, ChromeLabels.Status(L, ParseStatus(dropInfo.DropzoneIdentifier))), Severity.Info);
    }

    private async Task MoveTask(TaskItemDto task, TaskItemStatus status)
    {
        var next = status.ToString();
        if (task.Status == next)
            return;

        _allTasks = _allTasks
            .Select(t => t.Id == task.Id ? t with { Status = next } : t)
            .ToList();
        _container?.Refresh();

        var result = await ChangeStatus.HandleAsync(new ChangeTaskStatusCommand(
            new ChangeTaskStatusRequest(task.Id, status)));
        if (!result.Success)
        {
            Notifications.Add(Notifications.FormatFailure(result, L["Board"].Value, L["ChangeStatus"].Value), Severity.Warning);
            await ReloadTasks();
            return;
        }

        await ReloadTasks();
        Notifications.Add(string.Format(L["TaskMoved"].Value, ChromeLabels.Status(L, status)), Severity.Info);
    }

    private async Task ReloadTasks()
    {
        if (_project is null)
        {
            _container?.Refresh();
            return;
        }

        var listed = await ListTasks.HandleAsync(new ListProjectTasksCommand(new ListProjectTasksRequest(_project.Id)));
        if (!listed.Success)
        {
            _error = true;
            _errorMessage = Notifications.FormatFailure(listed, L["Board"].Value, L["Load"].Value);
            _container?.Refresh();
            return;
        }

        _error = false;
        _allTasks = listed.Value!.ToList();

        var labels = await ListLabels.HandleAsync(new ListLabelsRequest(_project.Id));
        if (labels.Success)
        {
            _labels = labels.Value!.ToList();
            _labelsLoadErrorMessage = null;
        }
        else
        {
            _labelsLoadErrorMessage = Notifications.FormatFailure(labels, L["Projects"].Value, L["Load"].Value);
        }

        if (!labels.Success)
            Notifications.Warning(Notifications.FormatFailure(
                labels, L["Board"].Value, L["Load"].Value,
                new { ProjectId = _project.Id, Resource = "labels" }));

        var milestones = await ListMilestones.HandleAsync(new ListProjectMilestonesCommand(new ListProjectMilestonesRequest(_project.Id), _actorContext));
        if (milestones.Success)
        {
            _milestones = milestones.Value!.ToList();
            _milestonesLoadErrorMessage = null;
        }
        else
        {
            _milestonesLoadErrorMessage = Notifications.FormatFailure(milestones, L["Roadmap"].Value, L["Load"].Value);
        }
        if (!milestones.Success)
            Notifications.Warning(Notifications.FormatFailure(
                milestones, L["Board"].Value, L["Load"].Value,
                new { ProjectId = _project.Id, Resource = "milestones" }));
        _container?.Refresh();
    }

    private async Task CreateTask()
    {
        if (_project is null)
        {
            Notifications.Failure(L["NoProjectAvailable"].Value, L["Board"].Value, ErrorCodes.ValidationFailed, L["Create"].Value);
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(TaskDialog.ProjectId), _project.Id },
            { nameof(TaskDialog.Labels), _labels },
            { nameof(TaskDialog.Milestones), _milestones }
        };
        var reference = await Dialogs.ShowAsync(typeof(TaskDialog), L["NewTask"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await reference.Result;
        if (result?.Data is TaskItemDto created)
            Navigation.NavigateTo($"/task/{created.Id}");
    }
}
