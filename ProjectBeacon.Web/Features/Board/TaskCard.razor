@namespace ProjectBeacon.Web.Features.Board

@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation

<MudPaper Class="mb-2 beacon-card beacon-board-card beacon-card-interactive" Elevation="0" Outlined="true">
    <div class="beacon-card-title-row">
        <MudText Typo="Typo.subtitle2" Class="beacon-card-title" tabindex="0" @onclick="Open" @onkeydown="OnTitleKey">@Task.Title</MudText>
        <span class="beacon-status-dot"></span>
    </div>
    @if (!string.IsNullOrEmpty(Task.Description))
    {
        <MudText Typo="Typo.body2" Class="text-truncate mt-1">@Task.Description</MudText>
    }
    @if (Task.Status == "InProgress" && Task.SubStage.HasValue)
    {
        <MudProgressLinear Value="@(SubStageToPercent(Task.SubStage.Value))" Color="Color.Default" Class="mt-2 beacon-track" />
    }
    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" Class="mt-2">
        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ChipPalette.ForStatus(Task.Status)">
            @ChromeLabels.Status(L, Task.Status)
        </MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ChipPalette.ForPriority(Task.Priority)">
            @ChromeLabels.Priority(L, Task.Priority)
        </MudChip>
        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ChipPalette.ForType(Task.Type)">
            @ChromeLabels.Type(L, Task.Type)
        </MudChip>
    </MudStack>
</MudPaper>

@code {
    [Parameter] public TaskItemDto Task { get; set; } = null!;

    private void Open() => Navigation.NavigateTo($"/task/{Task.Id}");

    private void OnTitleKey(KeyboardEventArgs e)
    {
        if (e.Key is "Enter" or " ")
            Open();
    }

    private int SubStageToPercent(TaskSubStage stage) => stage switch
    {
        TaskSubStage.RequirementGathering => 10,
        TaskSubStage.Estimation => 20,
        TaskSubStage.IntermediateResult => 40,
        TaskSubStage.Review => 60,
        TaskSubStage.Corrections => 75,
        TaskSubStage.ReviewCorrections => 90,
        TaskSubStage.Complete => 100,
        _ => 0
    };
}
