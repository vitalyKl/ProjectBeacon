@page "/context"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Web.Features.Chat
@using Microsoft.AspNetCore.Components.Web
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Context
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject UpsertContextNodeHandler Upsert
@inject ListContextNodesHandler ListNodes
@inject CompileBriefHandler CompileBrief
@inject ListContextRevisionsHandler ListRevisions
@inject ListContentVersionsHandler ContentVersions
@inject ListDeletedContentTargetsHandler ListDeletedContentTargets
@inject RestoreContentVersionHandler RestoreContentVersion
@inject ExportAgentsMdHandler ExportAgents
@inject CreateConstraintHandler CreateConstraint
@inject ListConstraintsHandler ListConstraints
@inject ActivateConstraintHandler ActivateConstraintHandler
@inject RejectConstraintHandler RejectConstraintHandler
@inject ISnackbar Snackbar

<PageTitle>@L["Context"]</PageTitle>
<PageHeader Title="@L["Context"]">
    @if (_project is not null)
    {
        <MudButton Variant="Variant.Outlined" OnClick="Compile">@L["CompileBrief"]</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Export">@L["ExportAgentsMd"]</MudButton>
    }
</PageHeader>

@if (_project is null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
}
else
{
    <MudText Typo="Typo.caption" Class="mb-4">@_project.Name</MudText>
    @if (_loading)
    {
        <LoadingState />
    }
    <ErrorState Message="@_error" />

    <div class="beacon-split-3">
        <div>
            <MudText Typo="Typo.h6" Class="mb-3">@L["Sections"]</MudText>
            @if (_nodes.Count == 0)
            {
                <EmptyState>@L["NoSectionsYet"]</EmptyState>
            }
            else
            {
                <MudPaper Elevation="0" Outlined="true" Class="beacon-card">
                    <MudList T="string" Dense="true">
                        @foreach (var node in _nodes)
                        {
                            <MudListItem T="string">
                                <div>
                                    <div role="button" tabindex="0" class="beacon-section-row" @onclick="() => LoadSection(node)" @onkeydown="e => OnSectionKey(e, node)">
                                        @ChromeLabels.Section(L, node.SectionId) — @node.Title
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(node.BodyMarkdown))
                                    {
                                        <div class="beacon-section-preview">
                                            <MarkdownView Text="@node.BodyMarkdown" MaxHeight="120" />
                                        </div>
                                    }
                                </div>
                            </MudListItem>
                        }
                    </MudList>
                </MudPaper>
            }

            @if (_deletedSections.Count > 0)
            {
                <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                    <MudExpansionPanel Text="@($"{L["DeletedContent"]} ({_deletedSections.Count})")">
                        @foreach (var deleted in _deletedSections)
                        {
                            <MudPaper @key="deleted.TargetId" Elevation="0" Outlined="true" Class="pa-2 mb-2">
                                <MudText Typo="Typo.subtitle2">@deleted.Title</MudText>
                                <MudText Typo="Typo.caption">
                                    @L["Deleted"] · rev. @deleted.DeletedRevision · <LocalTime Value="deleted.DeletedAt" Format="g" />
                                </MudText>
                                <MarkdownView Text="@ContextSnapshotMarkdown(deleted.SourceContentJson)" MaxHeight="100" />
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           Disabled="_busy" OnClick="() => RestoreDeletedSection(deleted)">
                                    @L["RestoreRevision"]
                                </MudButton>
                            </MudPaper>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </div>
        <div>
            <MudPaper Elevation="0" Outlined="true" Class="beacon-panel">
                <MudTextField @bind-Value="_title" Label="@L["Title"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="string" @bind-Value="_sectionId" Label="@L["Section"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
                    <MudSelectItem Value="@("goals")">@L["SectionGoals"]</MudSelectItem>
                    <MudSelectItem Value="@("non_goals")">@L["SectionNonGoals"]</MudSelectItem>
                    <MudSelectItem Value="@("security")">@L["SectionSecurity"]</MudSelectItem>
                    <MudSelectItem Value="@("definition_of_done")">@L["SectionDefinitionOfDone"]</MudSelectItem>
                    <MudSelectItem Value="@("architecture")">@L["SectionArchitecture"]</MudSelectItem>
                    <MudSelectItem Value="@("conventions")">@L["SectionConventions"]</MudSelectItem>
                </MudSelect>
                <MarkdownEditor @bind-Value="_body" Label="@L["Content"]" Lines="8" Class="mt-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" Disabled="_busy" OnClick="Save">@L["Save"]</MudButton>
            </MudPaper>
            @if (_selectedNode is not null)
            {
                <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                    <MudExpansionPanel Text="@($"{L["ContentHistory"]} ({_sectionHistory.Count})")">
                        @if (_sectionHistory.Count == 0)
                        {
                            <MudText Typo="Typo.caption">@L["NoHistory"]</MudText>
                        }
                        @foreach (var version in _sectionHistory)
                        {
                            <MudPaper @key="version.Id" Elevation="0" Outlined="true" Class="pa-2 mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                                    <MudText Typo="Typo.subtitle2">rev. @version.Revision</MudText>
                                    <MudText Typo="Typo.caption"><LocalTime Value="version.At" Format="g" /></MudText>
                                    <MudSpacer />
                                    <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy || version.Revision == _selectedNode.Revision"
                                               OnClick="() => RestoreSectionVersion(version)">@L["RestoreRevision"]</MudButton>
                                </MudStack>
                                <MudText Typo="Typo.caption">@version.ChangedByType · @version.ChangedById</MudText>
                                <MarkdownView Text="@ContextSnapshotMarkdown(version.ContentJson)" MaxHeight="120" />
                            </MudPaper>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
        </div>
        <div>
            <MudPaper Elevation="0" Outlined="true" Class="beacon-panel">
                <MudText Typo="Typo.caption">@L["ServerCompileNoTree"]</MudText>
                <div class="beacon-budget mt-2">
                    <div class="beacon-budget-label">
                        <span class="mud-typography mud-typography-caption">@L["TokenBudget"]</span>
                        <span class="mud-typography mud-typography-caption">@_tokens / @_budget</span>
                    </div>
                    <MudProgressLinear Value="@TokenBudgetMeter.Percent(_tokens, _budget)" Color="@(_overflow ? Color.Warning : Color.Default)" Class="mt-1 beacon-track" />
                </div>
                @if (!string.IsNullOrEmpty(_revisionId))
                {
                    <MudText Typo="Typo.caption" Class="mt-2">@L["Revision"]: @_revisionId</MudText>
                    <MudText Typo="Typo.caption">@L["CompiledHash"]: @_compiledHash</MudText>
                    @if (_overflow)
                    {
                        <MudText Typo="Typo.caption">@L["BudgetOverflow"]</MudText>
                    }
                    @if (!string.IsNullOrEmpty(_dropped))
                    {
                        <MudText Typo="Typo.caption">@L["DroppedSections"]: @_dropped</MudText>
                    }
                }
                @if (!string.IsNullOrEmpty(_preview))
                {
                    <div class="mt-4"><MarkdownView Text="@_preview" /></div>
                }
                @foreach (var revision in _revisions.Take(5))
                {
                    <MudText Typo="Typo.caption" Class="mt-1"><LocalTime Value="revision.CreatedAt" Format="u" /> · @revision.TokenEstimate · @ShortHash(revision.CompiledHash)</MudText>
                }
            </MudPaper>
        </div>
    </div>

    <MudText Typo="Typo.h6" Class="mt-6 mb-3">@L["Constraints"]</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel">
        <MarkdownEditor @bind-Value="_constraintBody" Label="@L["ConstraintBody"]" Lines="3" />
        <MudSelect T="ConstraintKind" @bind-Value="_constraintKind" Label="@L["Kind"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
            <MudSelectItem Value="ConstraintKind.Must">@L["KindMust"]</MudSelectItem>
            <MudSelectItem Value="ConstraintKind.MustNot">@L["KindMustNot"]</MudSelectItem>
            <MudSelectItem Value="ConstraintKind.Security">@L["KindSecurity"]</MudSelectItem>
            <MudSelectItem Value="ConstraintKind.Compliance">@L["KindCompliance"]</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="AddConstraint">@L["Create"]</MudButton>
        <MudList T="string" Dense="true" Class="mt-2">
            @foreach (var c in _constraints)
            {
                <MudListItem T="string">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                        <StatusChip Color="Color.Default" Label="@L["Kind" + c.Kind]" />
                        <StatusChip Color="@ChipPalette.ForConstraintStatus(c.Status)" Label="@ChromeLabels.Constraint(L, c.Status)" />
                        <div class="grow beacon-table-cell-clamp"><MarkdownView Text="@c.Body" Inline="true" /></div>
                        <MudButton Size="Size.Small" Variant="Variant.Text" Disabled="_busy"
                                   OnClick="() => LoadConstraintHistory(c)">@L["ContentHistory"]</MudButton>
                        @if (c.Status == ConstraintStatus.Proposed)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ActivateConstraint(c)">@L["Activate"]</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => RejectConstraint(c)">@L["Reject"]</MudButton>
                        }
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    </MudPaper>

    @if (_selectedConstraint is not null)
    {
        <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
            <MudExpansionPanel Text="@($"{L["ContentHistory"]}: {_selectedConstraint.Body}")">
                @if (_constraintHistory.Count == 0)
                {
                    <MudText Typo="Typo.caption">@L["NoHistory"]</MudText>
                }
                @foreach (var version in _constraintHistory)
                {
                    <MudPaper @key="version.Id" Elevation="0" Outlined="true" Class="pa-2 mb-2">
                        <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                            <MudText Typo="Typo.subtitle2">rev. @version.Revision</MudText>
                            <MudText Typo="Typo.caption"><LocalTime Value="version.At" Format="g" /></MudText>
                            <MudSpacer />
                            <MudButton Size="Size.Small" Variant="Variant.Text"
                                       Disabled="_busy || version.Revision == _selectedConstraint.Revision"
                                       OnClick="() => RestoreConstraintVersion(version)">@L["RestoreRevision"]</MudButton>
                        </MudStack>
                        <MudText Typo="Typo.caption">@version.ChangedByType · @version.ChangedById</MudText>
                        <MarkdownView Text="@ConstraintSnapshotMarkdown(version.ContentJson)" MaxHeight="120" />
                    </MudPaper>
                }
            </MudExpansionPanel>
        </MudExpansionPanels>
    }
}

@code {
    private ProjectDto? _project;
    private ActorContext _actor = ActorContext.Anonymous;
    private List<ContextSectionDto> _nodes = [];
    private List<DeletedContentTargetDto> _deletedSections = [];
    private string _title = string.Empty;
    private string _sectionId = "goals";
    private string _body = string.Empty;
    private int? _sectionRevision;
    private ContextSectionDto? _selectedNode;
    private List<ContentVersionDto> _sectionHistory = [];
    private string? _preview;
    private int _tokens;
    private string? _revisionId;
    private string? _compiledHash;
    private bool _overflow;
    private string? _dropped;
    private bool _loading = true;
    private bool _busy;
    private string? _error;
    private int _budget = 8000;
    private List<ContextRevisionDto> _revisions = [];
    private List<ConstraintDto> _constraints = [];
    private ConstraintDto? _selectedConstraint;
    private List<ContentVersionDto> _constraintHistory = [];
    private string _constraintBody = string.Empty;
    private ConstraintKind _constraintKind = ConstraintKind.Must;

    protected override async Task OnInitializedAsync()
    {
        _actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        var current = await CurrentProject.HandleAsync(_actor);
        _project = current.Value;
        if (_project is not null)
            await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        if (_project is null) return;
        var nodes = await ListNodes.HandleAsync(new ListContextNodesCommand(new ListContextNodesRequest(_project.Id)));
        _nodes = nodes.Success ? nodes.Value!.ToList() : [];
        if (!nodes.Success)
            _error = nodes.Error;
        var deleted = await ListDeletedContentTargets.HandleAsync(_project.Id, _actor);
        _deletedSections = deleted.Success
            ? deleted.Value!.Where(item => item.TargetKind == ContentTargetKind.ContextSection).ToList()
            : [];
        if (!deleted.Success)
            Snackbar.Add(deleted.Error ?? L["Error"].Value, Severity.Warning);
        var selectedConstraintId = _selectedConstraint?.Id;
        var constraints = await ListConstraints.HandleAsync(_project.Id);
        _constraints = constraints.Success ? constraints.Value!.ToList() : [];
        if (selectedConstraintId is { } constraintId)
        {
            _selectedConstraint = _constraints.FirstOrDefault(item => item.Id == constraintId);
            if (_selectedConstraint is null)
            {
                _constraintHistory = [];
            }
            else
            {
                var history = await ContentVersions.HandleAsync(
                    _project.Id, ContentTargetKind.Constraint, constraintId, 50);
                _constraintHistory = history.Success ? history.Value!.ToList() : [];
            }
        }
        var revisions = await ListRevisions.HandleAsync();
        _revisions = revisions.Success ? revisions.Value!.ToList() : [];
    }

    private async Task OnSectionKey(KeyboardEventArgs e, ContextSectionDto node)
    {
        if (e.Key is "Enter" or " ")
            await LoadSection(node);
    }

    private static string ShortHash(string hash) => hash.Length > 12 ? hash[..12] : hash;

    private async Task Save()
    {
        if (_project is null) return;
        _busy = true;
        var result = await Upsert.HandleAsync(new UpsertContextNodeCommand(new UpsertContextNodeRequest(
            _project.Id, _title, _body, _sectionId, ContextScopeType.Project,
            null, null, null, null, ContextSource.Native, null, _sectionRevision), _actor));
        _busy = false;
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _sectionRevision = result.Value!.Revision;
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
        var savedNode = _nodes.FirstOrDefault(node => node.Id == result.Value.Id);
        if (savedNode is not null)
            await LoadSection(savedNode);
    }

    private async Task LoadSection(ContextSectionDto node)
    {
        _selectedNode = node;
        _title = node.Title;
        _sectionId = node.SectionId;
        _body = node.BodyMarkdown;
        _sectionRevision = node.Revision;
        if (_project is null)
        {
            _sectionHistory = [];
            return;
        }

        var history = await ContentVersions.HandleAsync(
            _project.Id, ContentTargetKind.ContextSection, node.Id, 50);
        _sectionHistory = history.Success ? history.Value!.ToList() : [];
        if (!history.Success)
            Snackbar.Add(history.Error ?? L["Error"].Value, Severity.Warning);
    }

    private async Task RestoreDeletedSection(DeletedContentTargetDto deleted)
    {
        if (_project is null || _busy)
            return;

        _busy = true;
        try
        {
            var restored = await RestoreContentVersion.HandleAsync(new RestoreContentVersionCommand(
                _project.Id,
                deleted.SourceVersionId,
                deleted.DeletedRevision,
                _actor,
                ContentTargetKind.ContextSection,
                deleted.TargetId));
            if (!restored.Success)
            {
                Snackbar.Add(restored.Error ?? L["Error"].Value, Severity.Error);
                return;
            }

            await Reload();
            var restoredNode = _nodes.FirstOrDefault(node => node.Id == deleted.TargetId);
            if (restoredNode is not null)
                await LoadSection(restoredNode);
            Snackbar.Add(L["RestoredRevision"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RestoreSectionVersion(ContentVersionDto version)
    {
        if (_project is null || _selectedNode is null || _sectionRevision is null)
            return;

        _busy = true;
        try
        {
            var restored = await RestoreContentVersion.HandleAsync(new RestoreContentVersionCommand(
                _project.Id, version.Id, _sectionRevision.Value, _actor,
                ContentTargetKind.ContextSection, _selectedNode.Id));
            if (!restored.Success)
            {
                Snackbar.Add(restored.Error ?? L["Error"].Value, Severity.Error);
                return;
            }

            await Reload();
            var selected = _nodes.FirstOrDefault(node => node.Id == _selectedNode.Id);
            if (selected is not null)
                await LoadSection(selected);
            Snackbar.Add(L["RestoredRevision"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ContextSnapshotMarkdown(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            var root = document.RootElement;
            var title = root.TryGetProperty("title", out var titleValue) && titleValue.ValueKind == System.Text.Json.JsonValueKind.String
                ? titleValue.GetString()
                : null;
            var body = root.TryGetProperty("bodyMarkdown", out var bodyValue) && bodyValue.ValueKind == System.Text.Json.JsonValueKind.String
                ? bodyValue.GetString()
                : null;
            return string.Join(Environment.NewLine + Environment.NewLine,
                new[] { title, body }.Where(value => !string.IsNullOrWhiteSpace(value)));
        }
        catch (System.Text.Json.JsonException)
        {
            return string.Empty;
        }
    }

    private async Task Compile()
    {
        if (_project is null) return;
        _busy = true;
        var result = await CompileBrief.HandleAsync(new CompileBriefCommand(new CompileBriefRequest(
            _project.Id, null, null, null, _budget, false, false, false)));
        _busy = false;
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _preview = result.Value!.BriefMarkdown;
        _tokens = result.Value.TokenEstimate;
        _revisionId = result.Value.RevisionId;
        _compiledHash = result.Value.CompiledHash.Length > 12
            ? result.Value.CompiledHash[..12]
            : result.Value.CompiledHash;
        _overflow = result.Value.BudgetOverflow;
        _dropped = result.Value.DroppedSections.Count == 0
            ? null
            : string.Join(", ", result.Value.DroppedSections.Select(id => ChromeLabels.Section(L, id)));
        _busy = false;
        await Reload();
    }

    private async Task Export()
    {
        if (_project is null) return;
        var result = await ExportAgents.HandleAsync(new ExportAgentsMdCommand(new ExportAgentsMdRequest(_project.Id, null, null)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _preview = result.Value;
        Snackbar.Add(L["Saved"].Value, Severity.Success);
    }

    private async Task LoadConstraintHistory(ConstraintDto constraint)
    {
        if (_project is null)
            return;

        _selectedConstraint = constraint;
        var history = await ContentVersions.HandleAsync(
            _project.Id, ContentTargetKind.Constraint, constraint.Id, 50);
        _constraintHistory = history.Success ? history.Value!.ToList() : [];
        if (!history.Success)
            Snackbar.Add(history.Error ?? L["Error"].Value, Severity.Warning);
    }

    private async Task RestoreConstraintVersion(ContentVersionDto version)
    {
        if (_project is null || _selectedConstraint is null || _busy)
            return;

        var constraintId = _selectedConstraint.Id;
        _busy = true;
        try
        {
            var restored = await RestoreContentVersion.HandleAsync(new RestoreContentVersionCommand(
                _project.Id,
                version.Id,
                _selectedConstraint.Revision,
                _actor,
                ContentTargetKind.Constraint,
                constraintId));
            if (!restored.Success)
            {
                Snackbar.Add(restored.Error ?? L["Error"].Value, Severity.Error);
                return;
            }

            await Reload();
            Snackbar.Add(L["RestoredRevision"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ConstraintSnapshotMarkdown(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            var root = document.RootElement;
            var fields = new[] { "body", "scopePath", "kind", "status" };
            return string.Join(
                Environment.NewLine + Environment.NewLine,
                fields.Select(field =>
                    root.TryGetProperty(field, out var value)
                        ? $"{field}: {value.ToString()}"
                        : null)
                    .Where(value => !string.IsNullOrWhiteSpace(value)));
        }
        catch (System.Text.Json.JsonException)
        {
            return string.Empty;
        }
    }

    private async Task AddConstraint()
    {
        if (_project is null || string.IsNullOrWhiteSpace(_constraintBody))
            return;
        var result = await CreateConstraint.HandleAsync(new CreateConstraintRequest(_project.Id, _constraintBody.Trim(), _constraintKind, _actor));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _constraintBody = string.Empty;
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private async Task ActivateConstraint(ConstraintDto constraint)
    {
        var result = await ActivateConstraintHandler.HandleAsync(constraint.Id, _actor);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private async Task RejectConstraint(ConstraintDto constraint)
    {
        var result = await RejectConstraintHandler.HandleAsync(constraint.Id, _actor);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }
}

