@page "/context"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Context
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject UpsertContextNodeHandler Upsert
@inject ListContextNodesHandler ListNodes
@inject CompileBriefHandler CompileBrief
@inject ExportAgentsMdHandler ExportAgents
@inject CreateConstraintHandler CreateConstraint
@inject ListConstraintsHandler ListConstraints
@inject ActivateConstraintHandler ActivateConstraintHandler
@inject RejectConstraintHandler RejectConstraintHandler
@inject ISnackbar Snackbar

<PageTitle>@L["Context"]</PageTitle>
<PageHeader Title="@L["Context"]">
    @if (_project is not null)
    {
        <MudButton Variant="Variant.Outlined" OnClick="Compile">@L["CompileBrief"]</MudButton>
        <MudButton Variant="Variant.Outlined" OnClick="Export">@L["ExportAgentsMd"]</MudButton>
    }
</PageHeader>

@if (_project is null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
}
else
{
    <MudText Typo="Typo.caption" Class="mb-4">@_project.Name</MudText>

    <MudGrid>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="beacon-panel">
                <MudTextField @bind-Value="_title" Label="@L["Title"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="string" @bind-Value="_sectionId" Label="@L["Section"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
                    <MudSelectItem Value="@("goals")">@L["SectionGoals"]</MudSelectItem>
                    <MudSelectItem Value="@("non_goals")">@L["SectionNonGoals"]</MudSelectItem>
                    <MudSelectItem Value="@("security")">@L["SectionSecurity"]</MudSelectItem>
                    <MudSelectItem Value="@("definition_of_done")">@L["SectionDefinitionOfDone"]</MudSelectItem>
                    <MudSelectItem Value="@("architecture")">@L["SectionArchitecture"]</MudSelectItem>
                    <MudSelectItem Value="@("conventions")">@L["SectionConventions"]</MudSelectItem>
                </MudSelect>
                <MudTextField @bind-Value="_body" Label="@L["Content"]" Lines="8" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="Save">@L["Save"]</MudButton>
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="beacon-panel">
                <MudText Typo="Typo.caption">@L["TokenBudget"]: @_tokens / 8000</MudText>
                <MudProgressLinear Value="@TokenBudgetMeter.Percent(_tokens, 8000)" Color="Color.Default" Class="mt-1 beacon-track" />
                @if (!string.IsNullOrEmpty(_preview))
                {
                    <MudText Typo="Typo.body2" Class="mt-4 beacon-pre">@_preview</MudText>
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudText Typo="Typo.h6" Class="mt-6 mb-3">@L["Sections"]</MudText>
    @if (_nodes.Count == 0)
    {
        <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["NoSectionsYet"]</MudText>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-card">
            <MudList T="string" Dense="true">
                @foreach (var node in _nodes)
                {
                    <MudListItem T="string" OnClick="() => LoadSection(node)">@ChromeLabels.Section(L, node.SectionId) — @node.Title</MudListItem>
                }
            </MudList>
        </MudPaper>
    }

    <MudText Typo="Typo.h6" Class="mt-6 mb-3">@L["Constraints"]</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel">
        <MudTextField @bind-Value="_constraintBody" Label="@L["ConstraintBody"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudSelect T="ConstraintKind" @bind-Value="_constraintKind" Label="@L["Kind"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
            <MudSelectItem Value="ConstraintKind.Must">@L["KindMust"]</MudSelectItem>
            <MudSelectItem Value="ConstraintKind.MustNot">@L["KindMustNot"]</MudSelectItem>
            <MudSelectItem Value="ConstraintKind.Security">@L["KindSecurity"]</MudSelectItem>
            <MudSelectItem Value="ConstraintKind.Compliance">@L["KindCompliance"]</MudSelectItem>
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="AddConstraint">@L["Create"]</MudButton>
        <MudList T="string" Dense="true" Class="mt-2">
            @foreach (var c in _constraints)
            {
                <MudListItem T="string">
                    <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled">@L["Kind" + c.Kind]</MudChip>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ChipPalette.ForConstraintStatus(c.Status)">@ChromeLabels.Constraint(L, c.Status)</MudChip>
                        <MudText Typo="Typo.body2" Class="grow">@c.Body</MudText>
                        @if (c.Status == ConstraintStatus.Proposed)
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => ActivateConstraint(c)">@L["Activate"]</MudButton>
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => RejectConstraint(c)">@L["Reject"]</MudButton>
                        }
                    </MudStack>
                </MudListItem>
            }
        </MudList>
    </MudPaper>
}

@code {
    private ProjectDto? _project;
    private List<ContextSectionDto> _nodes = [];
    private string _title = string.Empty;
    private string _sectionId = "goals";
    private string _body = string.Empty;
    private string? _preview;
    private int _tokens;
    private List<ConstraintDto> _constraints = [];
    private string _constraintBody = string.Empty;
    private ConstraintKind _constraintKind = ConstraintKind.Must;

    protected override async Task OnInitializedAsync()
    {
        var current = await CurrentProject.HandleAsync((await Auth.GetAuthenticationStateAsync()).User);
        _project = current.Value;
        if (_project is not null)
            await Reload();
    }

    private async Task Reload()
    {
        if (_project is null) return;
        var nodes = await ListNodes.HandleAsync(new ListContextNodesCommand(new ListContextNodesRequest(_project.Id)));
        _nodes = nodes.Success ? nodes.Value!.ToList() : [];
        var constraints = await ListConstraints.HandleAsync(_project.Id);
        _constraints = constraints.Success ? constraints.Value!.ToList() : [];
    }

    private async Task Save()
    {
        if (_project is null) return;
        var result = await Upsert.HandleAsync(new UpsertContextNodeCommand(new UpsertContextNodeRequest(
            _project.Id, _title, _body, _sectionId, ContextScopeType.Project,
            null, null, null, null, ContextSource.Native, null)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private void LoadSection(ContextSectionDto node)
    {
        _title = node.Title;
        _sectionId = node.SectionId;
        _body = node.BodyMarkdown;
    }

    private async Task Compile()
    {
        if (_project is null) return;
        var result = await CompileBrief.HandleAsync(new CompileBriefCommand(new CompileBriefRequest(
            _project.Id, null, null, null, 8000, false, false, false)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _preview = result.Value.BriefMarkdown;
        _tokens = result.Value.TokenEstimate;
    }

    private async Task Export()
    {
        if (_project is null) return;
        var result = await ExportAgents.HandleAsync(new ExportAgentsMdCommand(new ExportAgentsMdRequest(_project.Id, null, null)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _preview = result.Value;
        Snackbar.Add(L["Saved"].Value, Severity.Success);
    }

    private async Task AddConstraint()
    {
        if (_project is null || string.IsNullOrWhiteSpace(_constraintBody))
            return;
        var result = await CreateConstraint.HandleAsync(new CreateConstraintRequest(_project.Id, _constraintBody.Trim(), _constraintKind));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _constraintBody = string.Empty;
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private async Task ActivateConstraint(ConstraintDto constraint)
    {
        var result = await ActivateConstraintHandler.HandleAsync(constraint.Id);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private async Task RejectConstraint(ConstraintDto constraint)
    {
        var result = await RejectConstraintHandler.HandleAsync(constraint.Id);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }
}
