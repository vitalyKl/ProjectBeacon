@page "/backlog"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Milestones
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Features.Tasks
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject ListProjectTasksHandler ListTasks
@inject ListLabelsHandler ListLabels
@inject ListProjectMilestonesHandler ListMilestones
@inject DeleteTaskHandler DeleteTaskHandler
@inject ISnackbar Snackbar
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>@L["Backlog"]</PageTitle>
<PageHeader Title="@L["Backlog"]">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateTask">@L["NewTask"]</MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_error)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@L["AnErrorOccurred"]</MudAlert>
    }
    else if (_project is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
    }
    else if (_tasks.Count == 0)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">@L["NoTasks"]</MudAlert>
}
else
{
    <MudTable Items="_tasks" Hover="true" Dense="true" Class="mt-4">
        <HeaderContent>
            <MudTh>@L["Title"]</MudTh>
            <MudTh>@L["Status"]</MudTh>
            <MudTh>@L["Priority"]</MudTh>
            <MudTh>@L["Type"]</MudTh>
            <MudTh>@L["SubStage"]</MudTh>
            <MudTh>@L["CreatedAt"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["Title"]">
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => NavigateToTask(context.Id)">@context.Title</MudButton>
            </MudTd>
            <MudTd DataLabel="@L["Status"]">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ChipPalette.ForStatus(context.Status)">
                    @ChromeLabels.Status(L, context.Status)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["Priority"]">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ChipPalette.ForPriority(context.Priority)">
                    @ChromeLabels.Priority(L, context.Priority)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["Type"]">
                <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ChipPalette.ForType(context.Type)">
                    @ChromeLabels.Type(L, context.Type)
                </MudChip>
            </MudTd>
            <MudTd DataLabel="@L["SubStage"]">
                @(context.Status == "InProgress" ? ChromeLabels.SubStage(L, context.SubStage) : "-")
            </MudTd>
            <MudTd DataLabel="@L["CreatedAt"]">@context.CreatedAt.ToShortDateString()</MudTd>
            <MudTd>
                <MudIconButton
                    Icon="@Icons.Material.Filled.Delete"
                    Size="Size.Small"
                    Color="Color.Error"
                    OnClick="() => DeleteTask(context.Id)"
                    title="@L["DeleteTask"].Value"
                    aria-label="@L["DeleteTask"].Value" />
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@code {
    private List<TaskItemDto> _tasks = [];
    private List<LabelDto> _labels = [];
    private List<MilestoneDto> _milestones = [];
    private ProjectDto? _project;
    private bool _loading = true;
    private bool _error;

    protected override async Task OnInitializedAsync()
    {
        var current = await CurrentProject.HandleAsync((await Auth.GetAuthenticationStateAsync()).User);
        _project = current.Value;
        await LoadTasks();
        _loading = false;
    }

    private async Task LoadTasks()
    {
        if (_project is null)
        {
            _tasks = [];
            return;
        }

        var listed = await ListTasks.HandleAsync(new ListProjectTasksCommand(new ListProjectTasksRequest(_project.Id)));
        if (!listed.Success)
        {
            _error = true;
            _tasks = [];
            return;
        }

        _error = false;
        _tasks = listed.Value!.ToList();
        var labels = await ListLabels.HandleAsync(new ListLabelsRequest(_project.Id));
        _labels = labels.Success ? labels.Value!.ToList() : [];
        var milestones = await ListMilestones.HandleAsync(new ListProjectMilestonesCommand(new ListProjectMilestonesRequest(_project.Id)));
        _milestones = milestones.Success ? milestones.Value!.ToList() : [];
    }

    private void NavigateToTask(Guid taskId) => Navigation.NavigateTo($"/task/{taskId}");

    private async Task CreateTask()
    {
        if (_project is null)
        {
            Snackbar.Add(L["NoProjectAvailable"].Value, Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(TaskDialog.ProjectId), _project.Id },
            { nameof(TaskDialog.Labels), _labels },
            { nameof(TaskDialog.Milestones), _milestones }
        };
        var reference = await Dialogs.ShowAsync(typeof(TaskDialog), L["NewTask"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await reference.Result;
        if (result?.Data is TaskItemDto)
        {
            Snackbar.Add(L["TaskCreated"].Value, Severity.Success);
            await LoadTasks();
        }
    }

    private async Task DeleteTask(Guid taskId)
    {
        var deleted = await DeleteTaskHandler.HandleAsync(new DeleteTaskCommand(new DeleteTaskRequest(taskId)));
        if (!deleted.Success)
        {
            Snackbar.Add(deleted.Error ?? L["Error"].Value, Severity.Error);
            return;
        }

        Snackbar.Add(L["TaskDeleted"].Value, Severity.Success);
        await LoadTasks();
    }
}
