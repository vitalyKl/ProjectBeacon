@page "/backlog"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Milestones
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Features.Tasks
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject ListProjectTasksHandler ListTasks
@inject ListLabelsHandler ListLabels
@inject ListProjectMilestonesHandler ListMilestones
@inject DeleteTaskHandler DeleteTaskHandler
@inject NavigationManager Navigation
@inject IDialogService Dialogs

<PageTitle>@L["Backlog"]</PageTitle>
<PageHeader Title="@L["Backlog"]">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateTask">@L["NewTask"]</MudButton>
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_error)
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_errorMessage</MudAlert>
    }
    else if (_project is null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
    }
    else
    {
        @if (_labelsLoadErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_labelsLoadErrorMessage</MudAlert>
        }
        @if (_milestonesLoadErrorMessage is not null)
        {
            <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">@_milestonesLoadErrorMessage</MudAlert>
        }
        @if (_tasks.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Class="mt-4">@L["NoTasks"]</MudAlert>
        }
        else
        {
            <MudTable Items="_tasks" Hover="true" Dense="true" Breakpoint="Breakpoint.Sm" Class="mt-4">
        <HeaderContent>
            <MudTh>@L["Title"]</MudTh>
            <MudTh>@L["Status"]</MudTh>
            <MudTh>@L["Priority"]</MudTh>
            <MudTh>@L["Type"]</MudTh>
            <MudTh>@L["SubStage"]</MudTh>
            <MudTh>@L["CreatedAt"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["Title"]">
                <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="() => NavigateToTask(context.Id)" title="@context.Title">@context.Title</MudButton>
            </MudTd>
            <MudTd DataLabel="@L["Status"]">
                <StatusChip Color="@ChipPalette.ForStatus(context.Status)" Label="@ChromeLabels.Status(L, context.Status)" />
            </MudTd>
            <MudTd DataLabel="@L["Priority"]">
                <StatusChip Color="@ChipPalette.ForPriority(context.Priority)" Label="@ChromeLabels.Priority(L, context.Priority)" />
            </MudTd>
            <MudTd DataLabel="@L["Type"]">
                <StatusChip Color="@ChipPalette.ForType(context.Type)" Label="@ChromeLabels.Type(L, context.Type)" />
            </MudTd>
            <MudTd DataLabel="@L["SubStage"]">
                @(context.Status == "InProgress" ? ChromeLabels.SubStage(L, context.SubStage) : "-")
            </MudTd>
            <MudTd DataLabel="@L["CreatedAt"]"><LocalTime Value="context.CreatedAt" Format="d" /></MudTd>
            <MudTd>
                <MudIconButton
                    Icon="@Icons.Material.Filled.Delete"
                    Size="Size.Small"
                    Color="Color.Error"
                    OnClick="() => DeleteTask(context.Id)"
                    title="@L["DeleteTask"].Value"
                    aria-label="@L["DeleteTask"].Value" />
            </MudTd>
        </RowTemplate>
            </MudTable>
        }
    }
}

@code {
    private List<TaskItemDto> _tasks = [];
    private List<LabelDto> _labels = [];
    private List<MilestoneDto> _milestones = [];
    private ProjectDto? _project;
    private ActorContext _actorContext = ActorContext.Anonymous;
    private bool _loading = true;
    private bool _error;
    private string? _errorMessage;
    private string? _labelsLoadErrorMessage;
    private string? _milestonesLoadErrorMessage;

    protected override async Task OnInitializedAsync()
    {
        _actorContext = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        var current = await CurrentProject.HandleAsync(_actorContext);
        if (!current.Success)
        {
            _error = true;
            _errorMessage = Notifications.FormatFailure(current, L["Backlog"].Value, L["Load"].Value);
            _loading = false;
            return;
        }

        _project = current.Value;
        await LoadTasks();
        _loading = false;
    }

    private async Task LoadTasks()
    {
        if (_project is null)
        {
            return;
        }

        var listed = await ListTasks.HandleAsync(new ListProjectTasksCommand(new ListProjectTasksRequest(_project.Id)));
        if (!listed.Success)
        {
            _error = true;
            _errorMessage = Notifications.FormatFailure(listed, L["Backlog"].Value, L["Load"].Value);
            _tasks = [];
            return;
        }

        _error = false;
        _tasks = listed.Value!.ToList();

        var labels = await ListLabels.HandleAsync(new ListLabelsRequest(_project.Id));
        if (labels.Success)
        {
            _labels = labels.Value!.ToList();
            _labelsLoadErrorMessage = null;
        }
        else
        {
            _labelsLoadErrorMessage = Notifications.FormatFailure(labels, L["Projects"].Value, L["Load"].Value);
        }

        var milestones = await ListMilestones.HandleAsync(new ListProjectMilestonesCommand(new ListProjectMilestonesRequest(_project.Id), _actorContext));
        if (milestones.Success)
        {
            _milestones = milestones.Value!.ToList();
            _milestonesLoadErrorMessage = null;
        }
        else
        {
            _milestonesLoadErrorMessage = Notifications.FormatFailure(milestones, L["Roadmap"].Value, L["Load"].Value);
        }
    }

    private void NavigateToTask(Guid taskId) => Navigation.NavigateTo($"/task/{taskId}");

    private async Task CreateTask()
    {
        if (_project is null)
        {
            Notifications.Failure(L["NoProjectAvailable"].Value, L["Backlog"].Value, ErrorCodes.ValidationFailed, L["Create"].Value);
            return;
        }

        var parameters = new DialogParameters
        {
            { nameof(TaskDialog.ProjectId), _project.Id },
            { nameof(TaskDialog.Labels), _labels },
            { nameof(TaskDialog.Milestones), _milestones }
        };
        var reference = await Dialogs.ShowAsync(typeof(TaskDialog), L["NewTask"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await reference.Result;
        if (result?.Data is TaskItemDto)
        {
            Notifications.Add(L["TaskCreated"].Value, Severity.Success);
            await LoadTasks();
        }
    }

    private async Task DeleteTask(Guid taskId)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, L["DeleteTaskConfirm"].Value,
            yesText: L["Delete"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true)
            return;
        var deleted = await DeleteTaskHandler.HandleAsync(new DeleteTaskCommand(new DeleteTaskRequest(taskId)));
        if (!deleted.Success)
        {
            Notifications.Failure(deleted, L["Backlog"].Value, L["Delete"].Value);
            return;
        }

        Notifications.Add(L["TaskDeleted"].Value, Severity.Success);
        await LoadTasks();
    }
}
