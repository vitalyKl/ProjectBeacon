@page "/"
@layout LandingLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Auth
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<PageTitle>@L["ProjectBeacon"]</PageTitle>

<div class="landing-page">
    <section class="landing-hero" aria-labelledby="landing-title">
        <div class="landing-hero-copy">
            <div class="landing-eyebrow"><span class="landing-eyebrow-mark"></span>@L["LandingEyebrow"]</div>
            <MudText Typo="Typo.h2" Class="landing-title" id="landing-title">@L["LandingHeroTitle"]</MudText>
            <MudText Typo="Typo.body1" Class="landing-lead">@L["LandingHeroLead"]</MudText>
            <div class="landing-hero-actions">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" EndIcon="@Icons.Material.Filled.ArrowForward">@L["Login"]</MudButton>
                @if (!_inviteOnly)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Href="/register">@L["Register"]</MudButton>
                }
                <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/bootstrap">@L["Bootstrap"]</MudButton>
            </div>
            <div class="landing-hero-footnote">
                <MudIcon Icon="@Icons.Material.Outlined.Devices" Size="Size.Small" />
                <span>@L["LandingHeroFootnote"]</span>
            </div>
        </div>

        <div class="landing-product-visual" aria-label="@L["LandingVisualTitle"]">
            <div class="landing-visual-glow"></div>
            <div class="landing-window">
                <div class="landing-window-bar">
                    <div class="landing-window-dots"><i></i><i></i><i></i></div>
                    <span>PROJECTBEACON</span>
                    <span class="landing-window-status"><i></i>@L["LandingOnline"]</span>
                </div>
                <div class="landing-window-body">
                    <aside class="landing-window-sidebar">
                        <div class="landing-window-brand"><span class="landing-brand-symbol"></span> beacon</div>
                        <div class="landing-window-nav active"><span>◫</span>@L["Dashboard"]</div>
                        <div class="landing-window-nav"><span>▤</span>@L["Board"]</div>
                        <div class="landing-window-nav"><span>⌘</span>@L["Agents"]</div>
                        <div class="landing-window-nav"><span>▧</span>@L["Workstations"]</div>
                        <div class="landing-window-nav"><span>◈</span>@L["Context"]</div>
                        <div class="landing-window-sidebar-foot"><i></i>@L["LandingLocalRuntime"]</div>
                    </aside>
                    <div class="landing-window-content">
                        <div class="landing-window-heading">
                            <div><span>@L["LandingWorkspaceLabel"]</span><strong>ProjectBeacon</strong></div>
                            <div class="landing-avatar">PB</div>
                        </div>
                        <div class="landing-window-metrics">
                            <div><span>@L["Agents"]</span><strong>02</strong><small>@L["LandingPreviewReady"]</small></div>
                            <div><span>@L["Workstations"]</span><strong>01</strong><small>@L["LandingPreviewConnected"]</small></div>
                            <div><span>@L["LandingActiveTasks"]</span><strong>04</strong><small>@L["LandingPreviewInProgress"]</small></div>
                        </div>
                        <div class="landing-window-section-head"><strong>@L["LandingWorkInProgress"]</strong><span>@L["Board"]</span></div>
                        <div class="landing-window-task">
                            <span class="landing-task-dot"></span><div><strong>@L["LandingMockTodo"]</strong><small>@L["LandingTaskContext"]</small></div><span class="landing-task-state">@L["Todo"]</span>
                        </div>
                        <div class="landing-window-task">
                            <span class="landing-task-dot is-active"></span><div><strong>@L["LandingMockDoing"]</strong><small>@L["LandingTaskAgent"]</small></div><span class="landing-task-state is-active">@L["InProgress"]</span>
                        </div>
                        <div class="landing-window-runtime">
                            <div class="landing-runtime-icon"><MudIcon Icon="@Icons.Material.Filled.Hub" /></div>
                            <div><strong>@L["LandingRuntimeTitle"]</strong><small>@L["LandingRuntimeDescription"]</small></div>
                            <span class="landing-runtime-live"></span>
                        </div>
                    </div>
                </div>
            </div>
            <div class="landing-visual-caption"><span></span>@L["LandingVisualCaption"]</div>
        </div>
    </section>

    <section class="landing-proof-strip" aria-label="@L["LandingPrinciplesTitle"]">
        <div><MudIcon Icon="@Icons.Material.Outlined.Computer" /><span>@L["LandingPrincipleLocal"]</span></div>
        <div><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /><span>@L["LandingPrincipleMulti"]</span></div>
        <div><MudIcon Icon="@Icons.Material.Outlined.Security" /><span>@L["LandingPrincipleControl"]</span></div>
        <div><MudIcon Icon="@Icons.Material.Outlined.Extension" /><span>@L["LandingPrincipleOpen"]</span></div>
    </section>

    <section class="landing-section landing-intro" id="why">
        <div class="landing-section-heading">
            <span class="landing-section-kicker">01 / @L["LandingProblemTitle"]</span>
            <MudText Typo="Typo.h3">@L["LandingProblemTitle"]</MudText>
        </div>
        <MudText Typo="Typo.body1" Class="landing-section-lead">@L["LandingProblemBody"]</MudText>
    </section>

    <section class="landing-section" id="capabilities">
        <div class="landing-section-heading">
            <span class="landing-section-kicker">02 / @L["LandingFeaturesTitle"]</span>
            <MudText Typo="Typo.h3">@L["LandingFeaturesTitle"]</MudText>
            <MudText Typo="Typo.body1" Class="landing-section-subtitle">@L["LandingFeaturesLead"]</MudText>
        </div>
        <div class="landing-feature-grid">
            <article class="landing-feature-card feature-context">
                <div class="landing-feature-icon"><MudIcon Icon="@Icons.Material.Outlined.Subject" /></div>
                <MudText Typo="Typo.h6">@L["Context"]</MudText>
                <MudText Typo="Typo.body2">@L["LandingFeatureContext"]</MudText>
                <span class="landing-feature-index">01</span>
            </article>
            <article class="landing-feature-card feature-agents">
                <div class="landing-feature-icon"><MudIcon Icon="@Icons.Material.Outlined.Hub" /></div>
                <MudText Typo="Typo.h6">@L["Agents"]</MudText>
                <MudText Typo="Typo.body2">@L["LandingFeatureAgents"]</MudText>
                <span class="landing-feature-index">02</span>
            </article>
            <article class="landing-feature-card feature-workstations">
                <div class="landing-feature-icon"><MudIcon Icon="@Icons.Material.Outlined.Devices" /></div>
                <MudText Typo="Typo.h6">@L["Workstations"]</MudText>
                <MudText Typo="Typo.body2">@L["LandingFeatureDevices"]</MudText>
                <span class="landing-feature-index">03</span>
            </article>
            <article class="landing-feature-card feature-pipeline">
                <div class="landing-feature-icon"><MudIcon Icon="@Icons.Material.Outlined.AccountTree" /></div>
                <MudText Typo="Typo.h6">@L["LandingPipelineTitle"]</MudText>
                <MudText Typo="Typo.body2">@L["LandingFeaturePipeline"]</MudText>
                <span class="landing-feature-index">04</span>
            </article>
            <article class="landing-feature-card feature-projects">
                <div class="landing-feature-icon"><MudIcon Icon="@Icons.Material.Outlined.ViewKanban" /></div>
                <MudText Typo="Typo.h6">@L["Board"]</MudText>
                <MudText Typo="Typo.body2">@L["LandingFeatureBoard"]</MudText>
                <span class="landing-feature-index">05</span>
            </article>
            <article class="landing-feature-card feature-tools">
                <div class="landing-feature-icon"><MudIcon Icon="@Icons.Material.Outlined.Extension" /></div>
                <MudText Typo="Typo.h6">@L["LandingFeatureMcpTitle"]</MudText>
                <MudText Typo="Typo.body2">@L["LandingFeatureMcp"]</MudText>
                <span class="landing-feature-index">06</span>
            </article>
        </div>
    </section>

    <section class="landing-section landing-flow-section" id="workflow">
        <div class="landing-section-heading">
            <span class="landing-section-kicker">03 / @L["LandingHowTitle"]</span>
            <MudText Typo="Typo.h3">@L["LandingHowTitle"]</MudText>
            <MudText Typo="Typo.body1" Class="landing-section-subtitle">@L["LandingHowLead"]</MudText>
        </div>
        <div class="landing-flow-grid">
            <article class="landing-flow-card"><span>01</span><MudText Typo="Typo.h6">@L["LandingFlow1Title"]</MudText><MudText Typo="Typo.body2">@L["LandingHow1"]</MudText></article>
            <article class="landing-flow-card"><span>02</span><MudText Typo="Typo.h6">@L["LandingFlow2Title"]</MudText><MudText Typo="Typo.body2">@L["LandingHow2"]</MudText></article>
            <article class="landing-flow-card"><span>03</span><MudText Typo="Typo.h6">@L["LandingFlow3Title"]</MudText><MudText Typo="Typo.body2">@L["LandingHow3"]</MudText></article>
        </div>
    </section>

    <section class="landing-section landing-architecture">
        <div class="landing-architecture-copy">
            <span class="landing-section-kicker">04 / @L["LandingArchitectureTitle"]</span>
            <MudText Typo="Typo.h3">@L["LandingArchitectureTitle"]</MudText>
            <MudText Typo="Typo.body1">@L["LandingArchitectureBody"]</MudText>
        </div>
        <div class="landing-architecture-diagram">
            <div class="landing-architecture-node">
                <MudIcon Icon="@Icons.Material.Outlined.CloudQueue" />
                <div><strong>@L["LandingArchitectureControl"]</strong><small>@L["LandingArchitectureControlBody"]</small></div>
            </div>
            <div class="landing-architecture-connector"><span></span><small>HTTPS</small><span></span></div>
            <div class="landing-architecture-node">
                <MudIcon Icon="@Icons.Material.Outlined.Computer" />
                <div><strong>@L["LandingArchitectureWorkstation"]</strong><small>@L["LandingArchitectureWorkstationBody"]</small></div>
            </div>
            <div class="landing-architecture-connector"><span></span><small>LOCAL</small><span></span></div>
            <div class="landing-architecture-node is-runtime">
                <MudIcon Icon="@Icons.Material.Outlined.Memory" />
                <div><strong>@L["LandingArchitectureRuntime"]</strong><small>@L["LandingArchitectureRuntimeBody"]</small></div>
            </div>
        </div>
    </section>

    <section class="landing-section landing-faq-section" id="questions">
        <div class="landing-section-heading">
            <span class="landing-section-kicker">05 / @L["LandingFaqTitle"]</span>
            <MudText Typo="Typo.h3">@L["LandingFaqTitle"]</MudText>
        </div>
        <MudExpansionPanels Elevation="0" Class="landing-faq">
            <MudExpansionPanel Text="@L["LandingFaq1Q"]"><MudText Typo="Typo.body2">@L["LandingFaq1A"]</MudText></MudExpansionPanel>
            <MudExpansionPanel Text="@L["LandingFaq2Q"]"><MudText Typo="Typo.body2">@L["LandingFaq2A"]</MudText></MudExpansionPanel>
            <MudExpansionPanel Text="@L["LandingFaq3Q"]"><MudText Typo="Typo.body2">@L["LandingFaq3A"]</MudText></MudExpansionPanel>
            <MudExpansionPanel Text="@L["LandingFaq4Q"]"><MudText Typo="Typo.body2">@L["LandingFaq4A"]</MudText></MudExpansionPanel>
            <MudExpansionPanel Text="@L["LandingFaq5Q"]"><MudText Typo="Typo.body2">@L["LandingFaq5A"]</MudText></MudExpansionPanel>
        </MudExpansionPanels>
    </section>

    <section class="landing-final-cta">
        <div>
            <span class="landing-section-kicker">@L["LandingCtaEyebrow"]</span>
            <MudText Typo="Typo.h3">@L["LandingCtaTitle"]</MudText>
            <MudText Typo="Typo.body1">@L["LandingCtaBody"]</MudText>
        </div>
        <div class="landing-hero-actions">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/login" EndIcon="@Icons.Material.Filled.ArrowForward">@L["Login"]</MudButton>
            @if (!_inviteOnly)
            {
                <MudButton Variant="Variant.Outlined" Color="Color.Inherit" Href="/register">@L["Register"]</MudButton>
            }
            <MudButton Variant="Variant.Text" Color="Color.Inherit" Href="/bootstrap">@L["Bootstrap"]</MudButton>
        </div>
    </section>
</div>

@code {
    private bool _inviteOnly;

    protected override async Task OnInitializedAsync()
    {
        _inviteOnly = LocalAuthOptions.InviteOnly(Config);
        var state = await Auth.GetAuthenticationStateAsync();
        if (state.User.Identity?.IsAuthenticated == true)
            Navigation.NavigateTo("/dashboard");
    }
}
