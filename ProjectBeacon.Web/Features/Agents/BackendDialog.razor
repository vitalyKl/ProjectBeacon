@using System.Text.Json
@using ProjectBeacon.Application.Agents
@using ProjectBeacon.Application.Devices
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject UpsertLocalModelBackendHandler SaveBackend
@inject EnqueueCommandHandler EnqueueCommand
@inject GetCommandHandler GetCommand
@inject ISnackbar Snackbar

<MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["HowToAddModel"]</MudText>
<MudSelect T="ModelBackendType" Value="_type" ValueChanged="OnTypeChanged" Label="@L["Type"]" Variant="Variant.Outlined" Margin="Margin.Dense">
    <MudSelectItem Value="ModelBackendType.LlamaCpp">@L["BackendLlamaCpp"]</MudSelectItem>
    <MudSelectItem Value="ModelBackendType.FreeToken">@L["BackendFreeToken"]</MudSelectItem>
    <MudSelectItem Value="ModelBackendType.OpenAiCompatible">@L["BackendOpenAiCompatible"]</MudSelectItem>
</MudSelect>
<MudTextField @bind-Value="_name" Label="@L["ModelName"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
<MudTextField @bind-Value="_launchCommand" Label="@L["LaunchCommand"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" HelperText="@LaunchHint" />
@if (_type == ModelBackendType.LlamaCpp)
{
    @if (DeviceId is null)
    {
        <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">@L["NeedProjectFolderForGguf"]</MudAlert>
    }
    <MudButton Variant="Variant.Outlined" Size="Size.Small" Class="mt-2" OnClick="ScanGguf" Disabled="_saving || DeviceId is null">@L["PickGguf"]</MudButton>
    @if (_ggufs.Count > 0)
    {
        <MudSelect T="string" Value="_gguf" ValueChanged="OnGgufChanged" Label="@L["PickGguf"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
            @foreach (var file in _ggufs)
            {
                <MudSelectItem Value="@file.Path">@file.Name</MudSelectItem>
            }
        </MudSelect>
    }
}
<MudNumericField T="int" @bind-Value="_contextSize" Label="@L["ContextSize"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" Min="0" />
<MudNumericField T="int" @bind-Value="_ttl" Label="@L["Ttl"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" Min="0" />
<MudSwitch @bind-Value="_concurrent" Label="@L["LoadWithOthers"]" Color="Color.Primary" Class="mt-3" />
<MudText Typo="Typo.caption" Class="mud-text-secondary">@L["LoadWithOthersHint"]</MudText>
<MudTextField @bind-Value="_extraFlags" Label="@L["ExtraFlags"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
<MudStack Row="true" Justify="Justify.FlexEnd" Spacing="2" Class="mt-4">
    <MudButton Variant="Variant.Text" OnClick="Cancel">@L["Cancel"]</MudButton>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Save" Disabled="_saving">@L["Save"]</MudButton>
</MudStack>

@code {
    [CascadingParameter] private IMudDialogInstance? Dialog { get; set; }
    [Parameter] public LocalModelBackendDto? Backend { get; set; }
    [Parameter] public Guid? DeviceId { get; set; }
    [Parameter] public Guid UserId { get; set; }

    private string _name = string.Empty;
    private ModelBackendType _type = ModelBackendType.LlamaCpp;
    private string _launchCommand = string.Empty;
    private int _contextSize = 4096;
    private int _ttl = 300;
    private bool _concurrent;
    private string _extraFlags = string.Empty;
    private bool _saving;
    private string? _gguf;
    private List<GgufFile> _ggufs = [];

    protected override void OnInitialized()
    {
        if (Backend is { } backend)
        {
            _name = backend.Name;
            _type = backend.BackendType;
            _launchCommand = backend.LaunchCommand;
            _contextSize = backend.ContextSize;
            _ttl = backend.Ttl;
            _concurrent = backend.Concurrent;
            _extraFlags = string.Join(", ", backend.ExtraFlags);
        }
    }

    private string LaunchHint => _type == ModelBackendType.LlamaCpp ? L["PickGgufFirst"].Value : L["LaunchCommandHint"].Value;

    private void Cancel() => Dialog?.Cancel();

    private void OnTypeChanged(ModelBackendType type) => _type = type;

    private void OnGgufChanged(string path)
    {
        _gguf = path;
        _launchCommand = $"llama-server -m \"{path}\" --port ${{PORT}}";
        if (string.IsNullOrWhiteSpace(_name))
            _name = System.IO.Path.GetFileNameWithoutExtension(path);
    }

    private async Task ScanGguf()
    {
        if (DeviceId is not { } deviceId || UserId == Guid.Empty) return;
        _saving = true;
        try
        {
            var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
                new EnqueueCommandRequest(deviceId, UserId, WorkstationCommandKind.ScanGguf, "{}", null)));
            if (!queued.Success)
            {
                Snackbar.Add(queued.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            WorkstationCommandDto? finished = null;
            for (var i = 0; i < 40; i++)
            {
                var got = await GetCommand.HandleAsync(new GetCommandCommand(new GetCommandRequest(queued.Value!.Id, UserId)));
                if (!got.Success) break;
                if (got.Value!.Status is WorkstationCommandStatus.Succeeded or WorkstationCommandStatus.Failed)
                {
                    finished = got.Value;
                    break;
                }
                await Task.Delay(500);
            }
            if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded || string.IsNullOrEmpty(finished.ResultJson))
            {
                Snackbar.Add(finished?.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            using var doc = JsonDocument.Parse(finished.ResultJson);
            _ggufs = [];
            if (doc.RootElement.TryGetProperty("files", out var files) && files.ValueKind == JsonValueKind.Array)
            {
                foreach (var file in files.EnumerateArray())
                {
                    var name = file.GetProperty("name").GetString() ?? "";
                    var path = file.GetProperty("path").GetString() ?? "";
                    if (path.Length > 0)
                        _ggufs.Add(new GgufFile(name, path));
                }
            }
            if (_ggufs.Count == 0)
                Snackbar.Add(L["NoGgufFiles"].Value, Severity.Info);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Save()
    {
        if (_saving) return;
        if (string.IsNullOrWhiteSpace(_launchCommand))
        {
            Snackbar.Add(_type == ModelBackendType.LlamaCpp ? L["PickGgufFirst"].Value : L["LaunchCommandRequired"].Value, Severity.Warning);
            return;
        }
        if (_type == ModelBackendType.LlamaCpp && !_launchCommand.Contains("${PORT}", StringComparison.Ordinal)
            && !_launchCommand.Contains("--port", StringComparison.OrdinalIgnoreCase))
            _launchCommand = _launchCommand.TrimEnd() + " --port ${PORT}";
        _saving = true;
        try
        {
            var flags = _extraFlags
                .Split(',', StringSplitOptions.RemoveEmptyEntries | StringSplitOptions.TrimEntries)
                .ToList();
            var result = await SaveBackend.HandleAsync(new UpsertLocalModelBackendCommand(new UpsertLocalModelBackendRequest(
                Backend?.Id, _name, _type, _launchCommand, _contextSize, _ttl,
                flags.Count > 0 ? flags : null, _concurrent)));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Dialog?.Close(result.Value);
        }
        finally
        {
            _saving = false;
        }
    }

    private sealed record GgufFile(string Name, string Path);
}
