@page "/settings/agents"
@layout MainLayout
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json.Nodes
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Agents
@using ProjectBeacon.Application.Devices
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Infrastructure.LlamaSwap
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject AuthenticationStateProvider Auth
@inject GetCurrentProjectHandler CurrentProject
@inject GetModelRegistryHandler GetRegistry
@inject SaveAgentTemplateHandler SaveTemplate
@inject DeleteAgentTemplateHandler DeleteTemplate
@inject DeleteLocalModelBackendHandler DeleteBackend
@inject SetRoleBindingHandler SetBinding
@inject RemoveRoleBindingHandler RemoveBinding
@inject GetProxyStatusHandler GetStatus
@inject ReloadProxyHandler ReloadProxy
@inject UnloadProxyHandler UnloadProxy
@inject ListRuntimesHandler ListRuntimes
@inject ApplyAgentConfigHandler ApplyAgentConfig
@inject EnqueueCommandHandler EnqueueCommand
@inject GetCommandHandler GetCommand
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>@L["Agents"]</PageTitle>
<PageHeader Title="@L["Agents"]" />
@if (_userId == Guid.Empty)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">@L["NoProjectAvailable"]</MudText>
}
else
{
    <MudTabs Rounded="true" ApplyEffectsToContainer="false" Class="mt-2">
    <MudTabPanel Text="@L["Overview"]">
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["ScopeUserLevel"] · @L["ScopeAccountHint"]</MudText>
        <MudText Typo="Typo.subtitle1" Class="mb-3">@L["Overview"]</MudText>
        <MudText Typo="Typo.body2">@string.Format(L["ModelsCount"].Value, _backends.Count)</MudText>
        <MudText Typo="Typo.body2">@L["AgentTemplates"]: @(string.IsNullOrWhiteSpace(_templateName) ? L["None"].Value : _templateName) · @ModeLabel</MudText>
        @if (_mode == AgentRunMode.Solo)
        {
            <MudText Typo="Typo.body2">@L["SoloModel"]: @BackendName(_solo)</MudText>
        }
        else
        {
            <MudText Typo="Typo.body2">@L["RoleBindingPlanner"]: @BackendName(_planner)</MudText>
            <MudText Typo="Typo.body2">@L["RoleBindingActor"]: @BackendName(_actor)</MudText>
            <MudText Typo="Typo.body2">@L["RoleBindingReview"]: @BackendName(_review)</MudText>
        }
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-4 mb-2">@L["ScopeContextual"] · @L["ScopeWorkstationHint"]</MudText>
        <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap" AlignItems="AlignItems.Center" Class="mt-2">
            <StatusChip Color="@ChipPalette.ForRuntime(RuntimeState)" Label="@RuntimeLabel" />
            <MudText Typo="Typo.caption">@L["RuntimeDevice"]: @(SelectedRuntime?.DeviceName ?? L["None"].Value)</MudText>
            <MudText Typo="Typo.caption">@L["CurrentModel"]: @(_status?.LoadedModel ?? L["None"].Value)</MudText>
        </MudStack>
    </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="@L["AgentTemplates"]">
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["ScopeUserLevel"] · @L["AgentTemplatesLead"]</MudText>
        <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mb-3">
            <MudSelect T="Guid?" Value="_templateId" ValueChanged="SelectTemplate" Label="@L["AgentTemplates"]" Variant="Variant.Outlined" Margin="Margin.Dense" Clearable="true" Class="flex-grow-1">
                @foreach (var template in _templates)
                {
                    <MudSelectItem Value="@((Guid?)template.Id)">@template.Name</MudSelectItem>
                }
            </MudSelect>
            <MudButton Variant="Variant.Outlined" OnClick="NewTemplate">@L["AgentTemplateNew"]</MudButton>
        </MudStack>
        @if (_templates.Count == 0 && _templateId is null && string.IsNullOrWhiteSpace(_templateName))
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">@L["NoTemplateSelected"]</MudAlert>
        }
        <MudTextField @bind-Value="_templateName" Label="@L["AgentTemplateName"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudSelect T="AgentRunMode" @bind-Value="_mode" Label="@L["AgentMode"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3">
            <MudSelectItem Value="AgentRunMode.Solo">@L["AgentModeSolo"]</MudSelectItem>
            <MudSelectItem Value="AgentRunMode.Pipeline">@L["AgentModePipeline"]</MudSelectItem>
        </MudSelect>
        @if (_mode == AgentRunMode.Solo)
        {
            <MudSelect T="Guid?" @bind-Value="_solo" Label="@L["SoloModel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" Clearable="true">
                @foreach (var backend in _backends)
                {
                    <MudSelectItem Value="@((Guid?)backend.Id)">@backend.Name</MudSelectItem>
                }
            </MudSelect>
        }
        else
        {
            <MudSelect T="Guid?" @bind-Value="_planner" Label="@L["RoleBindingPlanner"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" Clearable="true">
                @foreach (var backend in _backends)
                {
                    <MudSelectItem Value="@((Guid?)backend.Id)">@backend.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid?" @bind-Value="_actor" Label="@L["RoleBindingActor"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" Clearable="true">
                @foreach (var backend in _backends)
                {
                    <MudSelectItem Value="@((Guid?)backend.Id)">@backend.Name</MudSelectItem>
                }
            </MudSelect>
            <MudSelect T="Guid?" @bind-Value="_review" Label="@L["RoleBindingReview"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" Clearable="true">
                @foreach (var backend in _backends)
                {
                    <MudSelectItem Value="@((Guid?)backend.Id)">@backend.Name</MudSelectItem>
                }
            </MudSelect>
        }
        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveCurrentTemplate" Disabled="_busy || string.IsNullOrWhiteSpace(_templateName)">@L["Save"]</MudButton>
            <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="DeleteCurrentTemplate" Disabled="_busy || _templateId is null">@L["Delete"]</MudButton>
        </MudStack>
    </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="@L["ModelRegistry"]">
        <AgentModelTable Backends="_backends" HasProject="_project is not null" HasRuntime="_runtimes.Count > 0" OnAdd="AddModel" OnEdit="EditModel" OnDelete="DeleteModel" />
    </MudTabPanel>
    <MudTabPanel Text="@L["TaskKinds"]">

    <TaskKindEditor UserId="_userId" Backends="_backends" />
    </MudTabPanel>
    <MudTabPanel Text="@L["ApplyOnDevice"]">

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["ScopeContextual"] · @L["ScopeProjectHint"]</MudText>
        <MudText Typo="Typo.subtitle1" Class="mb-3">@L["ApplyOnDevice"]</MudText>
        <MudSelect T="Guid?" @bind-Value="_runtimeDeviceId" Label="@L["RuntimeDevice"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
            @foreach (var runtime in _runtimes)
            {
                <MudSelectItem Value="@((Guid?)runtime.DeviceId)">@runtime.DeviceName (@runtime.LocalRoot)</MudSelectItem>
            }
        </MudSelect>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="ApplyOnDevice" Disabled="_busy || _runtimeDeviceId is null">
            @L["ApplyOnDevice"]
        </MudButton>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@L["ModelSaveHint"]</MudText>
        <CommandLifecycle State="@_lifecycleState" Label="@_lifecycle" Detail="@_lifecycleDetail" />
    </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="@L["McpServers"]">

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["ScopeContextual"]</MudText>
        <MudText Typo="Typo.subtitle1" Class="mb-3">@L["McpServers"]</MudText>
        <MudCheckBox T="bool" Value="true" Disabled="true" Label="beacon" />
        <MudCheckBox @bind-Value="_mcpContext7" Label="context7" />
        <MudCheckBox @bind-Value="_mcpSerena" Label="serena" />
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Class="mt-2">
            <MudTextField @bind-Value="_customName" Label="@L["ModelName"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudSelect T="string" @bind-Value="_customType" Label="@L["Type"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@("local")">@L["McpLocal"]</MudSelectItem>
                <MudSelectItem Value="@("remote")">@L["McpRemote"]</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_customCommand" Label="@(_customType == "remote" ? L["McpUrl"].Value : L["McpCommand"].Value)" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Outlined" OnClick="AddCustomMcp">@L["Create"]</MudButton>
        </MudStack>
        @if (_customMcps.Count > 0)
        {
            <MudList T="string" Dense="true" Class="mt-2">
                @foreach (var server in _customMcps)
                {
                    <MudListItem T="string">
                        @server.Name (@server.Type)
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveCustomMcp(server)">@L["Delete"]</MudButton>
                    </MudListItem>
                }
            </MudList>
        }
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="ApplyMcp" Disabled="_busy || _runtimeDeviceId is null">
            @L["ApplyOnDevice"]
        </MudButton>
        <CommandLifecycle State="@_lifecycleState" Label="@_lifecycle" Detail="@_lifecycleDetail" />
    </MudPaper>
    </MudTabPanel>
    <MudTabPanel Text="@L["RuntimeDiagnostics"]">

    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["ScopeContextual"] · @L["ScopeWorkstationHint"]</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.subtitle1">@L["RuntimeDiagnostics"]</MudText>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="RefreshStatus" Disabled="_busy || !CanRefresh">@(RuntimeState == "Offline" ? L["Connect"].Value : L["Refresh"].Value)</MudButton>
                @if (CanReload)
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" OnClick="Reload" Disabled="_busy">@(RuntimeState == "Failed" ? L["Retry"].Value : L["Reload"].Value)</MudButton>
                }
                @if (CanUnload || RuntimeState == "Busy")
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Error" OnClick="Unload" Disabled="@UnloadDisabled">@L["Unload"]</MudButton>
                }

            </MudStack>
        </MudStack>
        @if (_status is null && _runtimePhase is null)
        {
            <MudText Typo="Typo.body2">@L["Loading"]</MudText>
        }
        else
        {
            <StatusChip Color="@ChipPalette.ForRuntime(RuntimeState)" Label="@RuntimeLabel" />
            <MudText Typo="Typo.body2" Class="mt-2">@RuntimeExplanation</MudText>
            @if (!string.IsNullOrWhiteSpace(_status?.DeviceName))
            {
                <MudText Typo="Typo.body2">@L["RuntimeDevice"]: @_status.DeviceName</MudText>
            }
            @if (!string.IsNullOrWhiteSpace(_status?.LoadedModel))
            {
                <MudText Typo="Typo.body2">@L["CurrentModel"]: @_status.LoadedModel</MudText>
            }
            @if (_status is not null)
            {
                <HostLoadView Status="_status" />
                <MudText Typo="Typo.body2" Class="mt-2">@L["Memory"]: @(_status.Memory ?? "-")</MudText>
                <MudText Typo="Typo.body2">@L["LastSwap"]: @(_status.LastSwap?.ToLocalTime().ToString("g") ?? "-")</MudText>
            }
        }
    </MudPaper>
    </MudTabPanel>
    </MudTabs>
}

@code {
    private ProjectDto? _project;
    private List<LocalModelBackendDto> _backends = [];
    private List<AgentTemplateDto> _templates = [];
    private Guid? _templateId;
    private string _templateName = string.Empty;
    private Guid? _planner;
    private Guid? _actor;
    private Guid? _review;
    private LlamaSwapStatusDto? _status;
    private bool _busy;
    private Guid _userId;
    private AgentRunMode _mode = AgentRunMode.Solo;
    private Guid? _solo;
    private Guid? _runtimeDeviceId;
    private List<ProjectRuntimeDto> _runtimes = [];
    private string? _runtimePhase;
    private bool _mcpContext7;
    private bool _mcpSerena;
    private string _customName = string.Empty;
    private string _customType = "local";
    private string _customCommand = string.Empty;
    private List<CustomMcpServer> _customMcps = [];
    private string? _lifecycle;
    private string? _lifecycleDetail;
    private string? _lifecycleState;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            _userId = id;
        var current = await CurrentProject.HandleAsync(ActorContextFactory.FromPrincipal(user));
        _project = current.Value;
        await ReloadAsync();
    }

    private async Task ReloadAsync()
    {
        _backends = [];
        _templates = [];
        _status = null;
        _runtimes = [];
        if (_userId == Guid.Empty) return;
        if (_project is not null)
        {
            var runtimes = await ListRuntimes.HandleAsync(new ListRuntimesCommand(new ListRuntimesRequest(_project.Id, _userId)));
            if (runtimes.Success)
            {
                _runtimes = runtimes.Value!.ToList();
                _runtimeDeviceId ??= _runtimes.FirstOrDefault(r => r.DeviceOnline)?.DeviceId ?? _runtimes.FirstOrDefault()?.DeviceId;
            }
        }
        var registry = await GetRegistry.HandleAsync(new GetModelRegistryCommand(_userId));
        if (registry.Success)
        {
            var value = registry.Value!;
            _backends = value.Backends.ToList();
            _templates = value.Templates.ToList();
            var selected = _templates.FirstOrDefault(t => t.Id == _templateId) ?? _templates.FirstOrDefault();
            if (selected is not null)
                CopyTemplate(selected);
        }
        else
        {
            Snackbar.Add(registry.Error ?? L["Error"].Value, Severity.Error);
        }
        var status = await GetStatus.HandleAsync(new GetProxyStatusCommand());
        if (status.Success)
            _status = status.Value;
    }

    private async Task AddModel()
    {
        var parameters = new DialogParameters
        {
            { nameof(BackendDialog.DeviceId), _runtimeDeviceId },
            { nameof(BackendDialog.UserId), _userId }
        };
        var reference = await Dialogs.ShowAsync(
            typeof(BackendDialog), L["ModelsAdd"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = (await reference.Result)!;
        if (result.Data is LocalModelBackendDto)
        {
            Snackbar.Add(L["ModelSaved"].Value, Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task EditModel(LocalModelBackendDto backend)
    {
        var parameters = new DialogParameters
        {
            { nameof(BackendDialog.Backend), backend },
            { nameof(BackendDialog.DeviceId), _runtimeDeviceId },
            { nameof(BackendDialog.UserId), _userId }
        };
        var reference = await Dialogs.ShowAsync(
            typeof(BackendDialog), L["ModelsEdit"].Value, parameters,
            new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = (await reference.Result)!;
        if (result.Data is LocalModelBackendDto)
        {
            Snackbar.Add(L["ModelSaved"].Value, Severity.Success);
            await ReloadAsync();
        }
    }

    private async Task DeleteModel(LocalModelBackendDto backend)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, L["DeleteModelConfirm"].Value,
            yesText: L["Delete"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true) return;
        var deleted = await DeleteBackend.HandleAsync(new DeleteLocalModelBackendCommand(new DeleteLocalModelBackendRequest(backend.Id, _userId)));
        if (!deleted.Success)
        {
            Snackbar.Add(deleted.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["ModelDeleted"].Value, Severity.Success);
        await ReloadAsync();
    }

    private Guid? BindingFor(PipelineRole role) => role switch
    {
        PipelineRole.Planner => _planner,
        PipelineRole.Actor => _actor,
        _ => _review
    };

    private void SetBindingLocal(PipelineRole role, Guid? value)
    {
        switch (role)
        {
            case PipelineRole.Planner:
                _planner = value;
                break;
            case PipelineRole.Actor:
                _actor = value;
                break;
            default:
                _review = value;
                break;
        }
    }

    private async Task BindingChanged(PipelineRole role, Guid? backendId)
    {
        if (_project is null) return;
        var previous = BindingFor(role);
        SetBindingLocal(role, backendId);
        if (backendId == previous || _busy) return;
        _busy = true;
        try
        {
            bool ok;
            string? error = null;
            if (backendId is { } id)
            {
                var set = await SetBinding.HandleAsync(new SetRoleBindingCommand(new SetRoleBindingRequest(role, id)));
                ok = set.Success;
                error = set.Error;
            }
            else
            {
                var removed = await RemoveBinding.HandleAsync(new RemoveRoleBindingCommand(new RemoveRoleBindingRequest(role)));
                ok = removed.Success;
                error = removed.Error;
            }
            if (!ok)
            {
                Snackbar.Add(error ?? L["Error"].Value, Severity.Error);
                SetBindingLocal(role, previous);
                StateHasChanged();
                return;
            }
            Snackbar.Add(backendId is null ? L["BindingRemoved"].Value : L["BindingSaved"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
            StateHasChanged();
        }
    }

    private Task OnPlannerBindingChanged(Guid? value)
    {
        _planner = value;
        return Task.CompletedTask;
    }

    private Task OnActorBindingChanged(Guid? value)
    {
        _actor = value;
        return Task.CompletedTask;
    }

    private Task OnReviewBindingChanged(Guid? value)
    {
        _review = value;
        return Task.CompletedTask;
    }

    private Task SelectTemplate(Guid? id)
    {
        _templateId = id;
        var selected = _templates.FirstOrDefault(t => t.Id == id);
        if (selected is null)
        {
            _templateName = string.Empty;
            _mode = AgentRunMode.Solo;
            _solo = _planner = _actor = _review = null;
            return Task.CompletedTask;
        }
        CopyTemplate(selected);
        return Task.CompletedTask;
    }

    private void CopyTemplate(AgentTemplateDto template)
    {
        _templateId = template.Id;
        _templateName = template.Name;
        _mode = template.Mode;
        _solo = template.SoloBackendId;
        _planner = template.PlannerBackendId;
        _actor = template.ActorBackendId;
        _review = template.ReviewBackendId;
    }

    private async Task SaveCurrentTemplate()
    {
        if (_userId == Guid.Empty || _busy) return;
        _busy = true;
        try
        {
            var saved = await SaveTemplate.HandleAsync(new SaveAgentTemplateCommand(new SaveAgentTemplateRequest(
                _templateId, _userId, _templateName, _mode, _solo, _planner, _actor, _review)));
            if (!saved.Success)
            {
                Snackbar.Add(saved.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _templateId = saved.Value!.Id;
            Snackbar.Add(L["TemplateSaved"].Value, Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task DeleteCurrentTemplate()
    {
        if (_templateId is not { } id || _userId == Guid.Empty) return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, L["DeleteTemplateConfirm"].Value,
            yesText: L["Delete"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true) return;
        var deleted = await DeleteTemplate.HandleAsync(new DeleteAgentTemplateCommand(new DeleteAgentTemplateRequest(id, _userId)));
        if (!deleted.Success)
        {
            Snackbar.Add(deleted.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _templateId = null;
        _templateName = string.Empty;
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await ReloadAsync();
    }

    private string RuntimeState => _runtimePhase ?? RuntimeHealth.From(_status);

    private string RuntimeLabel => RuntimeState switch
    {
        "Starting" => L["RuntimeStarting"].Value,
        "Ready" => L["RuntimeReady"].Value,
        "Busy" => L["RuntimeBusy"].Value,
        "Degraded" => L["RuntimeDegraded"].Value,
        "Stopping" => L["RuntimeStopping"].Value,
        "Failed" => L["RuntimeFailed"].Value,
        _ => L["RuntimeOffline"].Value
    };

    private string RuntimeExplanation => RuntimeState switch
    {
        "Ready" => L["RuntimeReadyHint"].Value,
        "Failed" => _status?.Error ?? L["RuntimeFailedHint"].Value,
        "Degraded" => _status?.Error ?? L["RuntimeDegradedHint"].Value,
        "Busy" => L["RuntimeBusyHint"].Value,
        "Starting" => L["RuntimeStartingHint"].Value,
        "Stopping" => L["RuntimeStoppingHint"].Value,
        _ => L["RuntimeOfflineHint"].Value
    };

    private bool CanRefresh => RuntimeState is not "Starting" and not "Stopping" and not "Busy";
    private bool CanReload => RuntimeState is "Ready" or "Failed" or "Degraded";
    private bool CanUnload => RuntimeState == "Ready" && !string.IsNullOrWhiteSpace(_status?.LoadedModel);
    private bool UnloadDisabled => _busy || RuntimeState == "Busy";

    private async Task RefreshStatus()
    {
        var status = await GetStatus.HandleAsync(new GetProxyStatusCommand());
        if (status.Success)
            _status = status.Value;
    }

    private async Task Reload()
    {
        _runtimePhase = "Starting";
        _busy = true;
        try
        {
            var result = await ReloadProxy.HandleAsync(new ReloadProxyCommand());
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                if (result.Value is not null)
                    _status = result.Value;
                return;
            }
            _status = result.Value;
            Snackbar.Add(L["ProxyReloaded"].Value, Severity.Success);
        }
        finally
        {
            _runtimePhase = null;
            _busy = false;
        }
    }

    private async Task Unload()
    {
        _runtimePhase = "Stopping";
        _busy = true;
        try
        {
            var result = await UnloadProxy.HandleAsync(new UnloadProxyCommand());
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                if (result.Value is not null)
                    _status = result.Value;
                return;
            }
            _status = result.Value;
            Snackbar.Add(L["ProxyUnloaded"].Value, Severity.Success);
        }
        finally
        {
            _runtimePhase = null;
            _busy = false;
        }
    }

    private void AddCustomMcp()
    {
        if (string.IsNullOrWhiteSpace(_customName)) return;
        _customMcps.Add(new CustomMcpServer(_customName.Trim(), _customType,
            _customType == "local" ? _customCommand : null,
            _customType == "remote" ? _customCommand : null));
        _customName = string.Empty;
        _customCommand = string.Empty;
    }

    private void RemoveCustomMcp(CustomMcpServer server) => _customMcps.Remove(server);

    private async Task ApplyMcp()
    {
        if (_project is null || _runtimeDeviceId is not { } deviceId || _userId == Guid.Empty) return;
        var runtime = _runtimes.FirstOrDefault(r => r.DeviceId == deviceId);
        if (runtime is null) return;
        _busy = true;
        try
        {
            var mcp = McpCatalog.Build(runtime.LocalRoot, _mcpContext7, _mcpSerena, _customMcps);
            var payload = new JsonObject
            {
                ["path"] = ".",
                ["mcpReplace"] = true,
                ["mcp"] = mcp
            };
            SetLifecycle(WorkstationCommandStatus.Pending, null);
            var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
                new EnqueueCommandRequest(deviceId, _userId, WorkstationCommandKind.ApplyOpencode, payload.ToJsonString(), _project.Id)));
            if (!queued.Success)
            {
                SetLifecycle(WorkstationCommandStatus.Failed, queued.Error);
                Snackbar.Add(queued.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            var finished = await WaitAsync(queued.Value!.Id);
            if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded)
            {
                Snackbar.Add(finished?.Error ?? _lifecycle ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["ApplyOnDeviceDone"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ApplyOnDevice()
    {
        if (_project is null || _runtimeDeviceId is not { } deviceId || _userId == Guid.Empty) return;
        _busy = true;
        try
        {
            SetLifecycle(WorkstationCommandStatus.Pending, null);
            var applied = await ApplyAgentConfig.HandleAsync(new ApplyAgentConfigCommand(new ApplyAgentConfigRequest(
                _project.Id, deviceId, _userId, _mode, _solo, _planner, _actor, _review)));
            if (!applied.Success)
            {
                SetLifecycle(WorkstationCommandStatus.Failed, applied.Error);
                Snackbar.Add(applied.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            var finished = await WaitAsync(applied.Value!.Id);
            if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded)
            {
                Snackbar.Add(finished?.Error ?? _lifecycle ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["ApplyOnDeviceDone"].Value, Severity.Success);
            await ReloadAsync();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<WorkstationCommandDto?> WaitAsync(Guid commandId)
    {
        SetLifecycle(WorkstationCommandStatus.Pending, null);
        for (var i = 0; i < 40; i++)
        {
            var got = await GetCommand.HandleAsync(new GetCommandCommand(new GetCommandRequest(commandId, _userId)));
            if (!got.Success)
            {
                SetLifecycle(WorkstationCommandStatus.Failed, got.Error);
                return null;
            }
            SetLifecycle(got.Value!.Status, got.Value.Error);
            if (got.Value.Status is WorkstationCommandStatus.Succeeded or WorkstationCommandStatus.Failed or WorkstationCommandStatus.Cancelled)
                return got.Value;
            await Task.Delay(500);
        }
        _lifecycleState = "TimedOut";
        _lifecycle = L["CommandTimedOut"].Value;
        _lifecycleDetail = null;
        return null;
    }

    private ProjectRuntimeDto? SelectedRuntime => _runtimes.FirstOrDefault(r => r.DeviceId == _runtimeDeviceId);

    private string ModeLabel => _mode == AgentRunMode.Solo ? L["AgentModeSolo"].Value : L["AgentModePipeline"].Value;

    private string BackendName(Guid? id) =>
        id is { } backendId
            ? _backends.FirstOrDefault(b => b.Id == backendId)?.Name ?? L["Unbound"].Value
            : L["Unbound"].Value;

    private void NewTemplate()
    {
        _templateId = null;
        _templateName = string.Empty;
        _mode = AgentRunMode.Solo;
        _solo = _planner = _actor = _review = null;
    }

    private string StatusLabel(WorkstationCommandStatus status) => status switch
    {
        WorkstationCommandStatus.Pending => L["CommandQueued"].Value,
        WorkstationCommandStatus.Running => L["CommandRunning"].Value,
        WorkstationCommandStatus.Succeeded => L["CommandSucceeded"].Value,
        WorkstationCommandStatus.Failed => L["CommandFailed"].Value,
        WorkstationCommandStatus.Cancelled => L["CommandCancelled"].Value,
        _ => status.ToString()
    };

    private void SetLifecycle(WorkstationCommandStatus status, string? detail)
    {
        _lifecycleState = status switch
        {
            WorkstationCommandStatus.Pending => "Queued",
            WorkstationCommandStatus.Running => "Running",
            WorkstationCommandStatus.Succeeded => "Succeeded",
            WorkstationCommandStatus.Failed => "Failed",
            WorkstationCommandStatus.Cancelled => "Cancelled",
            _ => status.ToString()
        };
        _lifecycle = StatusLabel(status);
        _lifecycleDetail = detail;
    }
}
