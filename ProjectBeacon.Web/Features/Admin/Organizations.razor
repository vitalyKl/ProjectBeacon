@page "/admin/organizations"
@page "/admin/organizations/{OrganizationId:guid}"
@layout ControlLayout
@attribute [Authorize(AuthenticationSchemes = ControlAuthenticationDefaults.Scheme)]
@using System.Globalization
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Components.Web
@using ProjectBeacon.Application.Admin
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Billing
@using ProjectBeacon.Application.Entitlements
@using ProjectBeacon.Application.Organizations
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Authentication
@inject IConfiguration Configuration
@inject AuthenticationStateProvider Auth
@inject IAdminGate AdminGate
@inject IOrganizationAdminService OrganizationAdmin
@inject IEntitlementService Entitlements
@inject BillingPlanAdminService BillingPlanCatalog
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>Control — Organizations</PageTitle>

@if (!_blocked)
{
    @if (OrganizationId is null)
    {
        <PageHeader Title="Organizations" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Customer organizations, owner invitations, and Alpha access.
        </MudText>

        @if (!_authorized)
        {
            <MudAlert Severity="Severity.Error">You do not have permission to view organizations.</MudAlert>
        }
        else
        {
            @if (_canManageOrganizations)
            {
                <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4 mb-4">
                    <MudText Typo="Typo.h6" Class="mb-3">Create organization and invite its owner</MudText>
                    <MudGrid Spacing="2">
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="_newName" Label="Organization name"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" md="6">
                            <MudTextField T="string" @bind-Value="_ownerEmail" Label="Owner email"
                                          InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField T="string" @bind-Value="_newDescription" Label="Description (optional)"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateOrganization"
                                       Disabled="_saving">
                                @(_saving ? "Creating…" : "Create and invite owner")
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                    @if (_createdInvite is not null && OrganizationId is null)
                    {
                        <MudAlert Severity="Severity.Success" Class="mt-3">
                            Organization created. The invitation link is shown once here; copy and share it with the owner if email delivery is unavailable.
                            <MudTextField T="string" Value="@_createdInvite.InviteUrl" ReadOnly="true"
                                          Variant="Variant.Outlined" Margin="Margin.Dense" />
                            <MudButton Variant="Variant.Text" Href="@($"/admin/organizations/{_createdInvite.OrgId}")">
                                Open organization
                            </MudButton>
                        </MudAlert>
                    }
                </MudPaper>
            }

            <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4">
                <div class="d-flex align-center gap-2 mb-3">
                    <MudText Typo="Typo.h6">Customer organizations</MudText>
                    <MudSpacer />
                    <MudTextField T="string" @bind-Value="_search" Placeholder="Name or owner email"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Immediate="true"
                                  Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                                  OnKeyDown="SearchKeyDown" />
                    <MudButton Variant="Variant.Outlined" OnClick="Search" Disabled="_loading">Search</MudButton>
                </div>
                @if (_loading)
                {
                    <LoadingState />
                }
                else if (_organizations.Count == 0)
                {
                    <EmptyState>No organizations found.</EmptyState>
                }
                else
                {
                    <MudTable Items="_organizations" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Organization</MudTh>
                            <MudTh>Owner</MudTh>
                            <MudTh>Members</MudTh>
                            <MudTh>Projects</MudTh>
                            <MudTh>Pending invites</MudTh>
                            <MudTh>Lifecycle</MudTh>
                            <MudTh>Created</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Organization">
                                <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                                @if (!string.IsNullOrWhiteSpace(context.Description))
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Description</MudText>
                                }
                            </MudTd>
                            <MudTd DataLabel="Owner">
                                @(!_canReadUsers ? "Restricted"
                                    : !string.IsNullOrWhiteSpace(context.OwnerEmail) ? context.OwnerEmail : "Not assigned")
                            </MudTd>
                            <MudTd DataLabel="Members">@context.MemberCount</MudTd>
                            <MudTd DataLabel="Projects">@context.ProjectCount</MudTd>
                            <MudTd DataLabel="Pending invites">@context.PendingInviteCount</MudTd>
                            <MudTd DataLabel="Lifecycle">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.LifecycleStatus == OrganizationLifecycleStatus.Active ? Color.Success : context.LifecycleStatus == OrganizationLifecycleStatus.Suspended ? Color.Warning : Color.Error)">
                                    @context.LifecycleStatus
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Created"><LocalTime Value="context.CreatedAt" Format="d" /></MudTd>
                            <MudTd><MudButton Size="Size.Small" Variant="Variant.Text" Href="@($"/admin/organizations/{context.Id}")">Open</MudButton></MudTd>
                        </RowTemplate>
                    </MudTable>
                    <div class="d-flex align-center justify-space-between mt-3">
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">@_totalCount organizations</MudText>
                        <div class="d-flex gap-2">
                            <MudButton Variant="Variant.Text" Disabled="@(_page <= 1 || _loading)" OnClick="PreviousPage">Previous</MudButton>
                            <MudText Typo="Typo.caption" Class="align-self-center">Page @_page</MudText>
                            <MudButton Variant="Variant.Text" Disabled="@(_page * PageSize >= _totalCount || _loading)" OnClick="NextPage">Next</MudButton>
                        </div>
                    </div>
                }
            </MudPaper>
        }
    }
    else if (!_authorized)
    {
        <MudAlert Severity="Severity.Error">You do not have permission to view this organization.</MudAlert>
    }
    else if (_detail is null)
    {
        <LoadingState />
    }
    else
    {
        <MudButton Variant="Variant.Text" Href="/admin/organizations" StartIcon="@Icons.Material.Filled.ArrowBack">Organizations</MudButton>
        <PageHeader Title="@_detail.Organization.Name" />
        <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
            Customer information, owner invitations, and Alpha access.
        </MudText>

        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4 mb-4">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                <MudText Typo="Typo.subtitle1">Lifecycle</MudText>
                <MudChip T="string" Size="Size.Small"
                         Color="@(_detail.Organization.LifecycleStatus == OrganizationLifecycleStatus.Active ? Color.Success : _detail.Organization.LifecycleStatus == OrganizationLifecycleStatus.Suspended ? Color.Warning : Color.Error)">
                    @_detail.Organization.LifecycleStatus
                </MudChip>
            </MudStack>
            @if (_detail.Organization.LifecycleStatus == OrganizationLifecycleStatus.Suspended)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                    Tenant access and invitation redemption are blocked. Customer data is retained. This organization can be reactivated or closed.
                </MudAlert>
            }
            else if (_detail.Organization.LifecycleStatus == OrganizationLifecycleStatus.Closed)
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2">
                    This organization is permanently closed. Its projects, memberships, devices and data are retained; reactivation is not permitted.
                </MudAlert>
            }
            @if (_canManageOrganizations && _detail.Organization.LifecycleStatus != OrganizationLifecycleStatus.Closed)
            {
                <MudTextField T="string" @bind-Value="_lifecycleReason" Label="Reason for lifecycle change"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    @if (_detail.Organization.LifecycleStatus == OrganizationLifecycleStatus.Active)
                    {
                        <MudButton Color="Color.Warning" Variant="Variant.Outlined"
                                   Disabled="_saving" OnClick="@(() => ChangeLifecycleStatus(OrganizationLifecycleStatus.Suspended))">
                            Suspend access
                        </MudButton>
                    }
                    else
                    {
                        <MudButton Color="Color.Success" Variant="Variant.Outlined"
                                   Disabled="_saving" OnClick="@(() => ChangeLifecycleStatus(OrganizationLifecycleStatus.Active))">
                            Reactivate
                        </MudButton>
                        @if (_canCloseOrganizations)
                        {
                            <MudButton Color="Color.Error" Variant="Variant.Outlined"
                                       Disabled="_saving" OnClick="@(() => ChangeLifecycleStatus(OrganizationLifecycleStatus.Closed))">
                                Close permanently
                            </MudButton>
                        }
                    }
                </MudStack>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">
                    Every transition requires a current TOTP unlock. Closing is terminal and requires prior suspension.
                </MudText>
            }
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4 mb-4">
            <MudGrid Spacing="2">
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Organization ID</MudText>
                    <MudText Typo="Typo.body2">@_detail.Organization.Id</MudText>
                </MudItem>
                <MudItem xs="12" md="6">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Created</MudText>
                    <LocalTime Value="_detail.Organization.CreatedAt" Format="g" />
                </MudItem>
                <MudItem xs="12">
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Description</MudText>
                    <MudText Typo="Typo.body2">@(_detail.Organization.Description ?? "—")</MudText>
                </MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">Members</MudText><MudText>@_detail.Organization.MemberCount</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">Projects</MudText><MudText>@_detail.Organization.ProjectCount</MudText></MudItem>
                <MudItem xs="4"><MudText Typo="Typo.caption" Class="mud-text-secondary">Pending invites</MudText><MudText>@_detail.Organization.PendingInviteCount</MudText></MudItem>
            </MudGrid>
        </MudPaper>

        @if (!_canReadUsers)
        {
            <MudAlert Severity="Severity.Warning" Class="mb-4">You do not have permission to view organization members or invitation details.</MudAlert>
        }
        else
        {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-2">Members</MudText>
            @if (_canManageOrganizations)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-3">
                    Disabling an account affects the entire ProjectBeacon account across all organizations and invalidates its active sessions.
                    It is not limited to this organization.
                </MudAlert>
            }
            @if (_detail.Members.Count == 0)
            {
                <EmptyState>No members have joined this organization yet.</EmptyState>
            }
            else
            {
                <MudTable Items="_detail.Members" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent><MudTh>Login</MudTh><MudTh>Email</MudTh><MudTh>Role</MudTh><MudTh>Account</MudTh><MudTh>Joined</MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Login">@context.Login</MudTd>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Role">
                            @if (_canManageOrganizations && !context.IsPlatformAdmin)
                            {
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                    <MudSelect T="MemberRole" Dense="true" Margin="Margin.Dense"
                                               Value="@SelectedRole(context)"
                                               ValueChanged="@(role => _memberRoleSelections[context.UserId] = role)">
                                        <MudSelectItem Value="@MemberRole.Owner">Owner</MudSelectItem>
                                        <MudSelectItem Value="@MemberRole.Admin">Admin</MudSelectItem>
                                        <MudSelectItem Value="@MemberRole.Member">Member</MudSelectItem>
                                    </MudSelect>
                                    @if (SelectedRole(context) != Enum.Parse<MemberRole>(context.Role))
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                                   OnClick="@(() => SaveMemberRole(context.UserId))">Save</MudButton>
                                    }
                                </MudStack>
                            }
                            else
                            {
                                @context.Role
                            }
                        </MudTd>
                        <MudTd DataLabel="Account">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                                @(context.IsDisabled ? "Disabled" : "Enabled")
                                @if (_canManageOrganizations && !context.IsPlatformAdmin)
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               Color="@(context.IsDisabled ? Color.Success : Color.Error)"
                                               OnClick="@(() => SetAccountDisabled(context.UserId, !context.IsDisabled))">
                                        @(context.IsDisabled ? "Enable" : "Disable")
                                    </MudButton>
                                }
                                else if (context.IsPlatformAdmin)
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">Platform operator</MudText>
                                }
                            </MudStack>
                        </MudTd>
                        <MudTd DataLabel="Joined"><LocalTime Value="context.JoinedAt" Format="g" /></MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4 mb-4">
            <MudText Typo="Typo.h6" Class="mb-3">Owner invitations</MudText>
            @if (_canManageOrganizations)
            {
                <MudGrid Spacing="2">
                    <MudItem xs="12" md="8">
                        <MudTextField T="string" @bind-Value="_inviteEmail" Label="Owner email"
                                      InputType="InputType.Email" Variant="Variant.Outlined" Margin="Margin.Dense"
                                      Disabled="@(_detail.Organization.LifecycleStatus != OrganizationLifecycleStatus.Active)" />
                    </MudItem>
                    <MudItem xs="12" md="4">
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="InviteOwner"
                                   Disabled="@(_saving || _detail.Organization.LifecycleStatus != OrganizationLifecycleStatus.Active)">
                            Invite owner
                        </MudButton>
                    </MudItem>
                </MudGrid>
                @if (_createdInvite is not null && _createdInvite.OrgId == OrganizationId)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-3">
                        Invitation link (shown once):
                        <MudTextField T="string" Value="@_createdInvite.InviteUrl" ReadOnly="true"
                                      Variant="Variant.Outlined" Margin="Margin.Dense" />
                    </MudAlert>
                }
            }
            @if (_detail.Invites.Count > 0)
            {
                <MudTable Items="_detail.Invites" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Class="mt-3">
                    <HeaderContent><MudTh>Email</MudTh><MudTh>Status</MudTh><MudTh>Expires</MudTh><MudTh>Created</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Email">@context.Email</MudTd>
                        <MudTd DataLabel="Status">@context.Status</MudTd>
                        <MudTd DataLabel="Expires"><LocalTime Value="context.ExpiresAt" Format="g" /></MudTd>
                        <MudTd DataLabel="Created"><LocalTime Value="context.CreatedAt" Format="g" /></MudTd>
                        <MudTd>
                            @if (_canManageOrganizations && context.Status == "Pending")
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                           OnClick="@(() => RevokeInvite(context.Id))">Revoke</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        }

        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4 mb-4">
            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.h6">Projects</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    @_detail.Projects.Count of @_detail.ProjectCount shown
                </MudText>
            </div>
            @if (_detail.Projects.Count == 0)
            {
                <EmptyState>No projects have been created for this organization.</EmptyState>
            }
            else
            {
                <MudTable Items="_detail.Projects" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent>
                        <MudTh>Project</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Created</MudTh>
                        <MudTh>Updated</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Project">
                            <MudText Typo="Typo.body2" Class="font-weight-medium">@context.Name</MudText>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.Id</MudText>
                        </MudTd>
                        <MudTd DataLabel="Description">@(!string.IsNullOrWhiteSpace(context.Description) ? context.Description : "—")</MudTd>
                        <MudTd DataLabel="Created"><LocalTime Value="context.CreatedAt" Format="g" /></MudTd>
                        <MudTd DataLabel="Updated">
                            @if (context.UpdatedAt is { } updatedAt)
                            {
                                <LocalTime Value="updatedAt" Format="g" />
                            }
                            else
                            {
                                <text>—</text>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>

        @if (_canReadUsers)
        {
            <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4 mb-4">
                <div class="d-flex align-center justify-space-between mb-3">
                    <MudText Typo="Typo.h6">Workstations</MudText>
                    <MudText Typo="Typo.caption" Class="mud-text-secondary">
                        @_detail.Devices.Count of @_detail.DeviceCount shown
                    </MudText>
                </div>
                @if (_detail.Devices.Count == 0)
                {
                    <EmptyState>No workstation daemons are registered for this organization's members.</EmptyState>
                }
                else
                {
                    <MudTable Items="_detail.Devices" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Device</MudTh>
                            <MudTh>Account</MudTh>
                            <MudTh>Status</MudTh>
                            <MudTh>Last heartbeat</MudTh>
                            <MudTh>Registered</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Device">@context.Name</MudTd>
                            <MudTd DataLabel="Account">
                                @context.OwnerLogin
                                <MudText Typo="Typo.caption" Class="mud-text-secondary">@context.OwnerEmail</MudText>
                            </MudTd>
                            <MudTd DataLabel="Status">
                                <MudChip T="string" Size="Size.Small"
                                         Color="@(context.Status == "Online" ? Color.Success : context.Status == "Revoked" ? Color.Error : Color.Default)">
                                    @context.Status
                                </MudChip>
                            </MudTd>
                            <MudTd DataLabel="Last heartbeat">
                                @if (context.LastHeartbeatAt is { } heartbeat)
                                {
                                    <LocalTime Value="heartbeat" Format="g" />
                                }
                                else
                                {
                                    <text>Never</text>
                                }
                            </MudTd>
                            <MudTd DataLabel="Registered"><LocalTime Value="context.CreatedAt" Format="g" /></MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        }

        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4 mb-4">
            @if (!_canReadEntitlements)
            {
                <MudAlert Severity="Severity.Warning">You do not have permission to view entitlement history.</MudAlert>
            }
            else
            {
            <div class="d-flex align-center justify-space-between mb-3">
                <MudText Typo="Typo.h6">Alpha access</MudText>
                @if (_entitlements.Count > 0)
                {
                    <MudChip T="string" Size="Size.Small"
                             Color="@(_entitlements[0].Status == EntitlementStatus.Active ? Color.Success : Color.Default)">
                        @_entitlements[0].Status
                    </MudChip>
                }
            </div>
            @if (_entitlements.Count == 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true">No Alpha or operator entitlement has been issued.</MudAlert>
            }
            else
            {
                <MudTable Items="_entitlements" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                    <HeaderContent><MudTh>Source</MudTh><MudTh>Status</MudTh><MudTh>Starts</MudTh><MudTh>Ends</MudTh><MudTh>Features</MudTh><MudTh>Limits</MudTh><MudTh></MudTh></HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Source">@context.Source</MudTd>
                        <MudTd DataLabel="Status">@context.Status</MudTd>
                        <MudTd DataLabel="Starts"><LocalTime Value="context.StartsAtUtc.UtcDateTime" Format="g" /></MudTd>
                        <MudTd DataLabel="Ends">
                            @if (context.EndsAtUtc is null) { <text>No expiry</text> }
                            else { <LocalTime Value="context.EndsAtUtc.Value.UtcDateTime" Format="g" /> }
                        </MudTd>
                        <MudTd DataLabel="Features">@string.Join(", ", context.Features.OrderBy(x => x))</MudTd>
                        <MudTd DataLabel="Limits">@JsonSerializer.Serialize(context.Limits)</MudTd>
                        <MudTd>
                            @if (_canManageEntitlements && (context.Status is EntitlementStatus.Active or EntitlementStatus.Scheduled))
                            {
                                <MudButton Size="Size.Small" Color="Color.Error" Variant="Variant.Text"
                                           OnClick="@(() => RevokeEntitlement(context.Id))">Revoke</MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
            @if (_canManageEntitlements)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle1" Class="mb-2">Issue or renew Alpha access</MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">
                    A new grant replaces any active or scheduled grant; previous entries remain in history.
                    The required `core` feature enables tenant API access. Additional feature keys are reserved for product-specific gates.
                </MudText>
                <MudTextField T="string" @bind-Value="_features" Label="Feature keys (comma-separated)"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="_limitsJson" Label="Limits (JSON object)"
                              Variant="Variant.Outlined" Margin="Margin.Dense" Lines="3" />
                <MudTextField T="string" @bind-Value="_reason" Label="Operator reason"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField T="string" @bind-Value="_endsAt" Label="End time UTC (optional, ISO-8601)"
                              Placeholder="2026-12-31T23:59:59Z"
                              Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="GrantAlpha" Disabled="_saving">
                    Issue Alpha access
                </MudButton>
            }

            @if (_canConvertToProduction && _detail.Organization.LifecycleStatus == OrganizationLifecycleStatus.Active
                && EffectiveAlphaEntitlement is not null)
            {
                <MudDivider Class="my-4" />
                <MudText Typo="Typo.subtitle1" Class="mb-2">Convert Alpha to Production</MudText>
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    This preserves the organization and its data, replacing the current Alpha grant with a subscription entitlement.
                    The billing reference must identify an existing manual invoice or external payment confirmation.
                    ProjectBeacon does not independently verify that funds were received.
                </MudAlert>
                @if (_productionPlans.Count == 0)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">
                        There are no active production plans. Create or activate a plan in Billing plans before converting this organization.
                    </MudAlert>
                    <MudButton Variant="Variant.Outlined" Href="/admin/billing/plans">Open billing plans</MudButton>
                }
                else
                {
                    <MudSelect T="string" @bind-Value="_productionPlanKey" Label="Production plan"
                               Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_saving">
                        @foreach (var plan in _productionPlans)
                        {
                            <MudSelectItem T="string" Value="@plan.Key">@plan.Name (@plan.Cadence)</MudSelectItem>
                        }
                    </MudSelect>
                    <MudTextField T="string" @bind-Value="_billingReference" Label="Manual invoice / receipt reference"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_saving" />
                    <MudTextField T="string" @bind-Value="_productionEndsAt"
                                  Label="Current period end UTC (required for monthly/annual plans)"
                                  Placeholder="2027-11-12T00:00:00Z"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_saving" />
                    <MudTextField T="string" @bind-Value="_conversionReason" Label="Conversion reason"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="_saving" />
                    <MudButton Variant="Variant.Filled" Color="Color.Success" OnClick="ConvertToProduction"
                               Disabled="@(_saving || string.IsNullOrWhiteSpace(_productionPlanKey)
                                   || string.IsNullOrWhiteSpace(_billingReference)
                                   || string.IsNullOrWhiteSpace(_conversionReason))">
                        Convert to Production
                    </MudButton>
                }
            }
            }
        </MudPaper>
    }
}

@code {
    private const int PageSize = 25;
    [Parameter] public Guid? OrganizationId { get; set; }

    private bool _blocked;
    private bool _authorized;
    private bool _canManageOrganizations;
    private bool _canCloseOrganizations;
    private bool _canReadUsers;
    private bool _canReadEntitlements;
    private bool _canManageEntitlements;
    private bool _canConvertToProduction;
    private bool _loading;
    private bool _saving;
    private string _search = string.Empty;
    private int _page = 1;
    private long _totalCount;
    private List<OrganizationAdminListItem> _organizations = [];
    private OrganizationAdminDetails? _detail;
    private List<OrganizationEntitlement> _entitlements = [];
    private List<PlanDefinition> _productionPlans = [];
    private string _productionPlanKey = string.Empty;
    private string _billingReference = string.Empty;
    private string _productionEndsAt = string.Empty;
    private string _conversionReason = "alpha_to_production";
    private string _conversionIdempotencyKey = Guid.NewGuid().ToString("N");
    private Dictionary<Guid, MemberRole> _memberRoleSelections = [];
    private OperatorInviteCreated? _createdInvite;
    private string _newName = string.Empty;
    private string _newDescription = string.Empty;
    private string _ownerEmail = string.Empty;
    private string _inviteEmail = string.Empty;
    private string _lifecycleReason = string.Empty;
    private string _features = EntitlementFeatureKeys.Core;
    private string _limitsJson = "{}";
    private string _reason = "alpha_access";
    private string _endsAt = string.Empty;

    protected override async Task OnParametersSetAsync()
    {
        if (!ControlPlaneHostGuard.IsCurrentHost(Navigation, Configuration))
        {
            _blocked = true;
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }
        _authorized = await EnsurePermissionAsync(OperatorPermission.OrganizationsRead);
        if (!_authorized) return;
        _canManageOrganizations = await HasPermissionAsync(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage);
        _canCloseOrganizations = await HasPermissionAsync(OperatorPermission.SystemMaintenance);
        _canReadUsers = await HasPermissionAsync(OperatorPermission.UsersRead);
        _canReadEntitlements = await HasPermissionAsync(OperatorPermission.EntitlementsRead);
        _canManageEntitlements = await HasPermissionAsync(OperatorPermission.EntitlementsManage);
        _canConvertToProduction = await HasPermissionAsync(
            OperatorPermission.EntitlementsManage | OperatorPermission.BillingRead);

        if (OrganizationId is { } orgId)
        {
            var result = await OrganizationAdmin.GetAsync(await CurrentAdminActor(), orgId);
            if (!result.Success)
            {
                _detail = null;
                Snackbar.Add(result.Error ?? "Could not load organization.", Severity.Error);
                return;
            }
            _detail = result.Value;
            SyncMemberRoleSelections();
            await LoadEntitlements(orgId);
            if (_canConvertToProduction)
                await LoadProductionPlans();
        }
        else
        {
            _detail = null;
            await LoadList();
        }
    }

    private async Task Search()
    {
        _page = 1;
        await LoadList();
    }

    private async Task SearchKeyDown(KeyboardEventArgs args)
    {
        if (args.Key == "Enter") await Search();
    }

    private async Task PreviousPage() { _page--; await LoadList(); }
    private async Task NextPage() { _page++; await LoadList(); }

    private async Task LoadList()
    {
        if (!await EnsurePermissionAsync(OperatorPermission.OrganizationsRead)) return;
        _loading = true;
        try
        {
            var result = await OrganizationAdmin.ListAsync(await CurrentAdminActor(), _search, _page, PageSize);
            if (!result.Success) throw new InvalidOperationException(result.Error ?? "Could not load organizations.");
            _organizations = result.Value!.Items.ToList();
            _totalCount = result.Value.TotalCount;
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _loading = false; }
    }

    private async Task CreateOrganization()
    {
        if (!await EnsurePermissionAsync(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true)) return;
        _saving = true;
        try
        {
            var result = await OrganizationAdmin.CreateAsync(await CurrentAdminActor(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true),
                new CreateOrganizationWithOwnerRequest(_newName, _newDescription, _ownerEmail));
            if (!result.Success) throw new InvalidOperationException(result.Error ?? "Could not create organization.");
            _createdInvite = result.Value;
            _newName = _newDescription = _ownerEmail = string.Empty;
            Snackbar.Add("Organization and owner invitation created.", Severity.Success);
            await LoadList();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        finally { _saving = false; }
    }

    private async Task InviteOwner()
    {
        if (OrganizationId is not { } orgId
            || !await EnsurePermissionAsync(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true)) return;
        _saving = true;
        try
        {
            var result = await OrganizationAdmin.InviteOwnerAsync(await CurrentAdminActor(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true), orgId, _inviteEmail);
            if (!result.Success) throw new InvalidOperationException(result.Error ?? "Could not invite owner.");
            _createdInvite = result.Value;
            _inviteEmail = string.Empty;
            Snackbar.Add("Owner invitation created.", Severity.Success);
            await ReloadDetail();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        finally { _saving = false; }
    }

    private async Task RevokeInvite(Guid inviteId)
    {
        if (OrganizationId is not { } orgId
            || !await EnsurePermissionAsync(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true)) return;
        var result = await OrganizationAdmin.RevokeInviteAsync(await CurrentAdminActor(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true), orgId, inviteId);
        if (!result.Success) Snackbar.Add(result.Error ?? "Could not revoke invitation.", Severity.Error);
        else { Snackbar.Add("Invitation revoked.", Severity.Success); await ReloadDetail(); }
    }

    private MemberRole SelectedRole(OrganizationAdminMember member) =>
        _memberRoleSelections.TryGetValue(member.UserId, out var role)
            ? role
            : Enum.Parse<MemberRole>(member.Role);

    private void SyncMemberRoleSelections()
    {
        _memberRoleSelections = _detail?.Members.ToDictionary(
            member => member.UserId,
            member => Enum.Parse<MemberRole>(member.Role)) ?? [];
    }

    private async Task SaveMemberRole(Guid userId)
    {
        if (OrganizationId is not { } orgId
            || !_memberRoleSelections.TryGetValue(userId, out var role)
            || !await EnsurePermissionAsync(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true))
            return;

        _saving = true;
        try
        {
            var actor = await CurrentAdminActor(
                OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true);
            var result = await OrganizationAdmin.ChangeMemberRoleAsync(actor, orgId, userId, role);
            if (!result.Success)
                throw new InvalidOperationException(result.Error ?? "Could not change member role.");
            Snackbar.Add("Organization member role updated.", Severity.Success);
            await ReloadDetail();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        finally { _saving = false; }
    }

    private async Task SetAccountDisabled(Guid userId, bool disabled)
    {
        if (OrganizationId is not { } orgId
            || !await EnsurePermissionAsync(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true))
            return;

        var action = disabled ? "disable" : "enable";
        var impact = disabled
            ? "This disables the global user account, revokes its active sessions, and affects access to every organization. Every organization owned by this account must have another active owner."
            : "This re-enables the global user account and restores its ability to sign in to every organization it belongs to.";
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Change global account access",
            $"Are you sure you want to {action} this account?\n\n{impact}",
            yesText: disabled ? "Disable account" : "Enable account",
            cancelText: "Cancel");
        if (confirmed != true) return;

        _saving = true;
        try
        {
            var actor = await CurrentAdminActor(
                OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true);
            var result = await OrganizationAdmin.SetAccountDisabledAsync(actor, orgId, userId, disabled);
            if (!result.Success)
                throw new InvalidOperationException(result.Error ?? $"Could not {action} account.");
            Snackbar.Add(disabled ? "Global account disabled." : "Global account enabled.", Severity.Success);
            await ReloadDetail();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        finally { _saving = false; }
    }


    private async Task ChangeLifecycleStatus(OrganizationLifecycleStatus target)
    {
        if (OrganizationId is not { } orgId
            || !await EnsurePermissionAsync(OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true))
            return;

        var action = target switch
        {
            OrganizationLifecycleStatus.Suspended => "suspend",
            OrganizationLifecycleStatus.Active => "reactivate",
            OrganizationLifecycleStatus.Closed => "close permanently",
            _ => "change"
        };
        var reason = _lifecycleReason.Trim();
        if (reason.Length is < 3 or > 500)
        {
            Snackbar.Add("Enter a reason between 3 and 500 characters.", Severity.Warning);
            return;
        }

        var warning = target == OrganizationLifecycleStatus.Closed
            ? "Closing is permanent. The organization and its customer data will be retained, but access cannot be restored."
            : target == OrganizationLifecycleStatus.Suspended
                ? "All tenant API and application data access will be blocked. Other organizations belonging to the same users are not affected."
                : "Tenant access and invitation redemption will be restored.";
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            "Change organization lifecycle",
            $"Are you sure you want to {action} this organization?\n\n{warning}\n\nReason: {reason}",
            yesText: target == OrganizationLifecycleStatus.Closed ? "Close permanently" : action,
            cancelText: "Cancel");
        if (confirmed != true) return;

        _saving = true;
        try
        {
            var actor = await CurrentAdminActor(
                OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage, requireElevation: true);
            var result = await OrganizationAdmin.SetLifecycleStatusAsync(actor, orgId, target, reason);
            if (!result.Success)
                throw new InvalidOperationException(result.Error ?? "Could not change organization lifecycle.");
            _lifecycleReason = string.Empty;
            Snackbar.Add($"Organization lifecycle changed to {target}.", Severity.Success);
            await ReloadDetail();
            await LoadList();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        finally { _saving = false; }
    }

    private async Task LoadEntitlements(Guid orgId)
    {
        if (!await EnsurePermissionAsync(OperatorPermission.EntitlementsRead)) return;
        var result = await Entitlements.ListForOperatorAsync(await CurrentAdminActor(OperatorPermission.EntitlementsRead), orgId);
        if (!result.Success) throw new InvalidOperationException(result.Error ?? "Could not load Alpha access.");
        _entitlements = result.Value!.ToList();
    }

    private async Task GrantAlpha()
    {
        if (OrganizationId is not { } orgId
            || !await EnsurePermissionAsync(OperatorPermission.EntitlementsManage, requireElevation: true)) return;
        _saving = true;
        try
        {
            var limits = JsonSerializer.Deserialize<Dictionary<string, long>>(_limitsJson)
                ?? throw new ArgumentException("Limits must be a JSON object of non-negative integers.");
            if (limits.Values.Any(x => x < 0))
                throw new ArgumentException("Limits must be non-negative.");
            var features = _features.Split(',', StringSplitOptions.TrimEntries | StringSplitOptions.RemoveEmptyEntries)
                .ToHashSet(StringComparer.Ordinal);
            DateTimeOffset? ends = null;
            if (!string.IsNullOrWhiteSpace(_endsAt))
            {
                if (!DateTimeOffset.TryParse(_endsAt, CultureInfo.InvariantCulture,
                        DateTimeStyles.AssumeUniversal | DateTimeStyles.AdjustToUniversal, out var parsed))
                    throw new ArgumentException("End time must be a valid ISO-8601 UTC timestamp.");
                ends = parsed;
            }
            var request = new GrantOrganizationEntitlementRequest(
                orgId, OperatorEntitlementSource.AlphaProgram, DateTimeOffset.UtcNow,
                ends, limits, features, _reason);
            var result = await Entitlements.GrantAsync(request, await CurrentAdminActor(OperatorPermission.EntitlementsManage, requireElevation: true));
            if (!result.Success) throw new InvalidOperationException(result.Error ?? "Could not grant Alpha access.");
            Snackbar.Add("Alpha access granted.", Severity.Success);
            _reason = "alpha_access";
            _endsAt = string.Empty;
            await LoadEntitlements(orgId);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Warning); }
        finally { _saving = false; }
    }

    private OrganizationEntitlement? EffectiveAlphaEntitlement =>
        _entitlements.FirstOrDefault(item =>
            item.Source == EntitlementSource.AlphaProgram
            && item.IsEffectiveAt(DateTimeOffset.UtcNow));

    private async Task LoadProductionPlans()
    {
        try
        {
            var plans = await BillingPlanCatalog.ListAsync(
                await CurrentAdminActor(OperatorPermission.BillingRead));
            _productionPlans = plans
                .Where(plan => plan.IsActive)
                .OrderBy(plan => plan.Key, StringComparer.Ordinal)
                .ToList();
            if (_productionPlans.All(plan => plan.Key != _productionPlanKey))
                _productionPlanKey = _productionPlans.FirstOrDefault()?.Key ?? string.Empty;
        }
        catch (Exception ex)
        {
            _productionPlans = [];
            Snackbar.Add(ex.Message, Severity.Warning);
        }
    }

    private async Task ConvertToProduction()
    {
        if (OrganizationId is not { } orgId
            || !await EnsurePermissionAsync(
                OperatorPermission.EntitlementsManage | OperatorPermission.BillingRead,
                requireElevation: true))
            return;

        var plan = _productionPlans.FirstOrDefault(item =>
            item.IsActive && string.Equals(item.Key, _productionPlanKey, StringComparison.Ordinal));
        if (plan is null)
        {
            Snackbar.Add("Select an active production plan.", Severity.Warning);
            return;
        }

        DateTimeOffset? periodEnd = null;
        if (!string.IsNullOrWhiteSpace(_productionEndsAt))
        {
            if (!DateTimeOffset.TryParse(
                    _productionEndsAt,
                    CultureInfo.InvariantCulture,
                    DateTimeStyles.None,
                    out var parsedEnd)
                || parsedEnd.Offset != TimeSpan.Zero)
            {
                Snackbar.Add("Period end must be a valid ISO-8601 UTC timestamp ending in Z or +00:00.", Severity.Warning);
                return;
            }

            periodEnd = parsedEnd;
        }

        if (plan.Cadence is BillingCadence.Monthly or BillingCadence.Annual && periodEnd is null)
        {
            Snackbar.Add("Monthly and annual plans require an explicit current-period end.", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_billingReference) || _billingReference.Trim().Length > 128)
        {
            Snackbar.Add("Enter a manual invoice or receipt reference (1–128 characters).", Severity.Warning);
            return;
        }

        if (string.IsNullOrWhiteSpace(_conversionReason) || _conversionReason.Trim().Length > 500)
        {
            Snackbar.Add("Enter a conversion reason (1–500 characters).", Severity.Warning);
            return;
        }

        var confirmed = await Dialogs.ShowMessageBox(
            "Convert Alpha to Production",
            "The active Alpha entitlement will be replaced by the selected subscription plan. This operation preserves the organization and its data and cannot be used to create a second active subscription. Continue?",
            yesText: "Convert",
            cancelText: "Cancel");
        if (confirmed != true)
            return;

        _saving = true;
        try
        {
            var request = new ConvertAlphaToProductionRequest(
                orgId,
                plan.Key,
                _billingReference.Trim(),
                DateTimeOffset.UtcNow,
                periodEnd,
                _conversionReason.Trim(),
                _conversionIdempotencyKey);

            var result = await Entitlements.ConvertAlphaToProductionAsync(
                request,
                await CurrentAdminActor(
                    OperatorPermission.EntitlementsManage | OperatorPermission.BillingRead,
                    requireElevation: true));
            if (!result.Success)
                throw new InvalidOperationException(result.Error ?? "Could not convert Alpha access to Production.");

            Snackbar.Add("Organization converted to Production. Its identity and customer data were preserved.", Severity.Success);
            _billingReference = string.Empty;
            _productionEndsAt = string.Empty;
            _conversionReason = "alpha_to_production";
            _conversionIdempotencyKey = Guid.NewGuid().ToString("N");
            await LoadEntitlements(orgId);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RevokeEntitlement(Guid entitlementId)
    {
        if (!await EnsurePermissionAsync(OperatorPermission.EntitlementsManage, requireElevation: true)) return;
        var result = await Entitlements.RevokeAsync(entitlementId, "operator_revoked", await CurrentAdminActor(OperatorPermission.EntitlementsManage, requireElevation: true));
        if (!result.Success) Snackbar.Add(result.Error ?? "Could not revoke Alpha access.", Severity.Error);
        else { Snackbar.Add("Alpha access revoked.", Severity.Success); await LoadEntitlements(OrganizationId!.Value); }
    }

    private async Task ReloadDetail()
    {
        if (OrganizationId is not { } orgId) return;
        var result = await OrganizationAdmin.GetAsync(await CurrentAdminActor(), orgId);
        if (result.Success)
        {
            _detail = result.Value;
            SyncMemberRoleSelections();
        }
        await LoadEntitlements(orgId);
    }

    private async Task<AdminActor> CurrentAdminActor(
        OperatorPermission permission = OperatorPermission.OrganizationsRead, bool requireElevation = false)
    {
        var principal = (await Auth.GetAuthenticationStateAsync()).User;
        var result = await AdminGate.RequireAsync(
            ActorContextFactory.FromPrincipal(principal), permission, requireElevation);
        return result.Value ?? throw new UnauthorizedAccessException(result.Error ?? "Operator access is no longer available.");
    }

    private async Task<bool> HasPermissionAsync(OperatorPermission permission)
    {
        var principal = (await Auth.GetAuthenticationStateAsync()).User;
        return (await AdminGate.RequireAsync(ActorContextFactory.FromPrincipal(principal), permission)).Success;
    }

    private async Task<bool> EnsurePermissionAsync(OperatorPermission permission, bool requireElevation = false)
    {
        if (!ControlPlaneHostGuard.IsCurrentHost(Navigation, Configuration))
        {
            _blocked = true;
            Navigation.NavigateTo("/", forceLoad: true);
            return false;
        }
        var principal = (await Auth.GetAuthenticationStateAsync()).User;
        if (principal.Identity?.IsAuthenticated != true
            || !string.Equals(principal.FindFirst("control_plane")?.Value, "true", StringComparison.Ordinal))
        {
            _blocked = true;
            Navigation.NavigateTo("/control/login", forceLoad: true);
            return false;
        }
        var result = await AdminGate.RequireAsync(ActorContextFactory.FromPrincipal(principal), permission, requireElevation);
        if (result.Success) return true;
        if (requireElevation)
        {
            Snackbar.Add("Sensitive changes require an active TOTP unlock. Enter a current authenticator code in the top bar.", Severity.Warning);
            return false;
        }
        if (permission == OperatorPermission.OrganizationsRead)
            _authorized = false;
        if (permission == OperatorPermission.UsersRead)
            _canReadUsers = false;
        if (permission == OperatorPermission.EntitlementsRead)
            _canReadEntitlements = false;
        if (permission == (OperatorPermission.OrganizationsManage | OperatorPermission.UsersManage))
            _canManageOrganizations = false;
        if (permission == OperatorPermission.EntitlementsManage)
            _canManageEntitlements = false;
        Snackbar.Add("Operator permission is no longer available. Reload the Control Plane session.", Severity.Warning);
        return false;
    }
}
