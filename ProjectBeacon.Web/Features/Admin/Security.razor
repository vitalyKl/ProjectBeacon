@page "/control/security"
@layout ControlLayout
@attribute [Authorize(AuthenticationSchemes = ControlAuthenticationDefaults.Scheme)]
@using Microsoft.AspNetCore.Authorization
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Auth
@using ProjectBeacon.Application.Admin
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Web.Authentication
@using ProjectBeacon.Web.Features.Settings
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject AuthenticationStateProvider Auth
@inject IAdminGate AdminGate
@inject GetTotpStatusHandler TotpStatus
@inject BeginTotpHandler BeginTotp
@inject ConfirmTotpHandler ConfirmTotp
@inject RotateOperatorTotpRecoveryCodesHandler RotateRecoveryCodes
@inject RecoverOperatorTotpHandler RecoverTotp
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<PageTitle>Control — Security</PageTitle>

@if (!_blocked)
{
    <PageHeader Title="Operator security" />
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">
        Configure an authenticator for this operator account. Sensitive Control Plane changes require a fresh TOTP verification and are unlocked for ten minutes.
    </MudText>

    @if (!_authorized)
    {
        <MudAlert Severity="Severity.Error">You do not have permission to manage operator security.</MudAlert>
    }
    else if (_enabled)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4 mb-4">
            <MudChip T="string" Color="Color.Success" Size="Size.Small">Authenticator enabled</MudChip>
            <MudText Typo="Typo.body2" Class="mt-3">
                The authenticator is active. Enter its current six-digit code in the Control Plane top bar to unlock sensitive operations for ten minutes.
            </MudText>
            <MudDivider Class="my-4" />
            <MudText Typo="Typo.subtitle1">Recovery codes</MudText>
            @if (_recoveryCodes.Count > 0)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="my-2">
                    These codes are shown only once. Save them in a secure place. Each code can be used once and all remaining codes are revoked after recovery.
                </MudAlert>
                <MudTextField T="string" Value="@string.Join(Environment.NewLine, _recoveryCodes)"
                              ReadOnly="true" Lines="10" Variant="Variant.Outlined"
                              Class="font-monospace" />
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mud-text-secondary">
                    @_recoveryCodeCount recovery codes remain. Generate a new set to replace all existing codes.
                </MudText>
            }
            <MudTextField T="string" @bind-Value="_rotateCode" Label="Current six-digit authenticator code"
                          InputMode="InputMode.numeric" MaxLength="6" Variant="Variant.Outlined"
                          Margin="Margin.Dense" Class="mt-2" />
            <MudButton Variant="Variant.Outlined" OnClick="RotateRecoveryCodes" Disabled="_busy">
                Replace recovery codes
            </MudButton>
        </MudPaper>

        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4">
            <MudText Typo="Typo.subtitle1">Lost access to the authenticator?</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary my-2">
                Use one saved recovery code to disable this authenticator. All other recovery codes and every active session will be revoked. Sign in again and set up a new authenticator.
            </MudText>
            <MudTextField T="string" @bind-Value="_recoveryCode" Label="One-time recovery code"
                          Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Color="Color.Warning" Variant="Variant.Outlined" OnClick="RecoverAuthenticator" Disabled="_busy">
                Use recovery code and sign out
            </MudButton>
        </MudPaper>
    }
    else if (_pending)
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">Finish authenticator setup</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                Add this account to an authenticator app, then enter the six-digit code to confirm setup.
            </MudText>
            @if (!string.IsNullOrWhiteSpace(_otpUri))
            {
                <img src="@TotpQr.DataUrl(_otpUri)" alt="Authenticator QR code" width="192" height="192" />
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-3">Manual setup key</MudText>
            <MudText Class="font-monospace user-select-all">@_secret</MudText>
            <MudTextField T="string" @bind-Value="_code" Label="Authenticator code"
                          InputMode="InputMode.numeric" MaxLength="6" Variant="Variant.Outlined"
                          Margin="Margin.Dense" />
            <div class="d-flex flex-wrap gap-2 mt-2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Confirm" Disabled="_busy">
                    Confirm authenticator
                </MudButton>
                <MudButton Variant="Variant.Text" OnClick="StartSetup" Disabled="_busy">
                    Generate a new setup key
                </MudButton>
            </div>
        </MudPaper>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel pa-4">
            <MudText Typo="Typo.h6" Class="mb-2">Protect operator actions</MudText>
            <MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">
                TOTP is not enabled for this account. Set it up before creating organizations, sending invitations, changing Alpha access, or modifying SMTP settings.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="StartSetup" Disabled="_busy">
                Set up authenticator
            </MudButton>
        </MudPaper>
    }
}

@code {
    private bool _blocked;
    private bool _authorized;
    private bool _enabled;
    private bool _pending;
    private bool _busy;
    private Guid? _userId;
    private string _otpUri = string.Empty;
    private string _secret = string.Empty;
    private string _code = string.Empty;
    private string _rotateCode = string.Empty;
    private string _recoveryCode = string.Empty;
    private int _recoveryCodeCount;
    private List<string> _recoveryCodes = [];
    private AdminActor? _operatorActor;

    protected override async Task OnInitializedAsync()
    {
        if (!ControlPlaneHostGuard.IsCurrentHost(Navigation, Configuration))
        {
            _blocked = true;
            Navigation.NavigateTo("/", forceLoad: true);
            return;
        }

        var principal = (await Auth.GetAuthenticationStateAsync()).User;
        if (principal.Identity?.IsAuthenticated != true
            || !string.Equals(principal.FindFirst("control_plane")?.Value, "true", StringComparison.Ordinal))
        {
            _blocked = true;
            Navigation.NavigateTo("/control/login", forceLoad: true);
            return;
        }

        var actor = ActorContextFactory.FromPrincipal(principal);
        var access = await AdminGate.RequireAsync(actor, OperatorPermission.OrganizationsRead);
        if (!access.Success || actor.UserId is not { } userId)
        {
            _authorized = false;
            return;
        }

        _authorized = true;
        _operatorActor = access.Value;
        _userId = userId;
        await Reload();
    }

    private async Task Reload()
    {
        if (_userId is not { } userId)
            return;

        try
        {
            var result = await TotpStatus.HandleAsync(new GetTotpStatusCommand(userId));
            if (!result.Success || result.Value is null)
                throw new InvalidOperationException(result.Error ?? "Could not load authenticator status.");

            _enabled = result.Value.Enabled;
            _pending = result.Value.Pending;
            _recoveryCodeCount = result.Value.RecoveryCodeCount;
            _otpUri = result.Value.OtpAuthUri ?? string.Empty;
            _secret = result.Value.Secret ?? string.Empty;
            if (_enabled)
            {
                _otpUri = string.Empty;
                _secret = string.Empty;
            }
        }
        catch
        {
            Snackbar.Add("Could not load operator security settings.", Severity.Error);
        }
    }

    private async Task StartSetup()
    {
        if (_userId is not { } userId || !await RecheckOperatorAsync())
            return;

        _busy = true;
        try
        {
            var result = await BeginTotp.HandleAsync(new BeginTotpCommand(userId));
            if (!result.Success || string.IsNullOrWhiteSpace(result.Value))
                throw new InvalidOperationException(result.Error ?? "Could not start authenticator setup.");

            var parts = result.Value.Split('\n', 2, StringSplitOptions.None);
            if (parts.Length != 2 || string.IsNullOrWhiteSpace(parts[0]) || string.IsNullOrWhiteSpace(parts[1]))
                throw new InvalidOperationException("Authenticator setup returned an invalid provisioning payload.");

            _otpUri = parts[0];
            _secret = parts[1];
            _pending = true;
            _enabled = false;
            _code = string.Empty;
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Confirm()
    {
        if (_userId is not { } userId || !await RecheckOperatorAsync())
            return;

        if (_code.Length != 6 || _code.Any(c => !char.IsAsciiDigit(c)))
        {
            Snackbar.Add("Enter the six-digit authenticator code.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var result = await ConfirmTotp.HandleAsync(new ConfirmTotpCommand(new ConfirmTotpRequest(userId, _code)));
            if (!result.Success || result.Value is null)
                throw new InvalidOperationException(result.Error ?? "Authenticator code was not accepted.");

            _code = string.Empty;
            _recoveryCodes = result.Value.RecoveryCodes.ToList();
            Snackbar.Add("Authenticator enabled. Save the recovery codes now; they will not be shown again.", Severity.Success);
            await Reload();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RotateRecoveryCodes()
    {
        if (_operatorActor is null || !await RecheckOperatorAsync() || _operatorActor is null)
            return;
        if (_rotateCode.Length != 6 || _rotateCode.Any(character => !char.IsAsciiDigit(character)))
        {
            Snackbar.Add("Enter the current six-digit authenticator code.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var result = await RotateRecoveryCodes.HandleAsync(
                new RotateOperatorTotpRecoveryCodesCommand(_operatorActor, _rotateCode));
            if (!result.Success || result.Value is null)
                throw new InvalidOperationException(result.Error ?? "Could not replace recovery codes.");

            _rotateCode = string.Empty;
            _recoveryCodes = result.Value.RecoveryCodes.ToList();
            _recoveryCodeCount = _recoveryCodes.Count;
            Snackbar.Add("Recovery codes replaced. Save this new set now.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RecoverAuthenticator()
    {
        if (_operatorActor is null || !await RecheckOperatorAsync() || _operatorActor is null)
            return;
        if (string.IsNullOrWhiteSpace(_recoveryCode))
        {
            Snackbar.Add("Enter one of your saved recovery codes.", Severity.Warning);
            return;
        }

        _busy = true;
        try
        {
            var result = await RecoverTotp.HandleAsync(
                new RecoverOperatorTotpCommand(_operatorActor, _recoveryCode));
            if (!result.Success)
                throw new InvalidOperationException(result.Error ?? "Recovery code was not accepted.");

            _recoveryCode = string.Empty;
            Snackbar.Add("Authenticator disabled and sessions revoked. Sign in again to enroll a new authenticator.", Severity.Success);
            Navigation.NavigateTo("/control/login", forceLoad: true);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Warning);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<bool> RecheckOperatorAsync()
    {
        if (!ControlPlaneHostGuard.IsCurrentHost(Navigation, Configuration))
        {
            _blocked = true;
            Navigation.NavigateTo("/", forceLoad: true);
            return false;
        }

        var principal = (await Auth.GetAuthenticationStateAsync()).User;
        var actor = ActorContextFactory.FromPrincipal(principal);
        var result = await AdminGate.RequireAsync(actor, OperatorPermission.OrganizationsRead);
        if (principal.Identity?.IsAuthenticated == true
            && string.Equals(principal.FindFirst("control_plane")?.Value, "true", StringComparison.Ordinal)
            && result.Success && result.Value is not null && actor.UserId == _userId)
        {
            _operatorActor = result.Value;
            return true;
        }

        _authorized = false;
        Snackbar.Add("Operator access is no longer available. Sign in again.", Severity.Error);
        return false;
    }
}
