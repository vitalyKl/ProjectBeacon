@page "/decisions"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Decisions
@using ProjectBeacon.Application.Context
@using ProjectBeacon.Application.Persistence
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject CreateDecisionHandler CreateDecision
@inject ListDecisionsHandler ListDecisions
@inject AcceptDecisionHandler AcceptDecision
@inject DeprecateDecisionHandler DeprecateDecision
@inject SupersedeDecisionHandler SupersedeDecision
@inject ListContentVersionsHandler ContentVersions
@inject RestoreContentVersionHandler RestoreContentVersion
@inject ISnackbar Snackbar

<PageTitle>@L["Decisions"]</PageTitle>
<PageHeader Title="@L["Decisions"]" />

@if (_project is null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
}
else
{
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel">
        <MudTextField @bind-Value="_title" Label="@L["Title"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MarkdownEditor @bind-Value="_context" Label="@L["Context"]" Lines="3" Class="mt-2" />
        <MarkdownEditor @bind-Value="_body" Label="@L["Content"]" Lines="5" Class="mt-2" />
        <MarkdownEditor @bind-Value="_consequences" Label="@L["Consequences"]" Lines="3" Class="mt-2" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="Add">@L["Create"]</MudButton>
    </MudPaper>

    @if (_loading)
    {
        <LoadingState />
    }
    else if (_decisions.Count == 0)
    {
        <EmptyState>@L["NoDecisions"]</EmptyState>
    }
    else
    {
        <MudTable Items="_decisions" Hover="true" Dense="true" Class="mt-4" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@L["Title"]</MudTh>
                <MudTh>@L["Status"]</MudTh>
                <MudTh>@L["Context"]</MudTh>
                <MudTh>@L["Consequences"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Title"]">@context.Title</MudTd>
                <MudTd DataLabel="@L["Status"]">
                    <StatusChip Color="@ChipPalette.ForDecisionStatus(context.Status)" Label="@ChromeLabels.Decision(L, context.Status)" />
                </MudTd>
                <MudTd DataLabel="@L["Context"]">
                    <div class="beacon-table-cell-clamp"><MarkdownView Text="@context.Context" Inline="true" /></div>
                </MudTd>
                <MudTd DataLabel="@L["Consequences"]">
                    <div class="beacon-table-cell-clamp"><MarkdownView Text="@context.Consequences" Inline="true" /></div>
                </MudTd>
                <MudTd DataLabel="@L["Actions"]">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Select(context)">@L["Open"]</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
        <MudDialog @bind-Visible="_detailOpen" Options="_dialogOptions">
            <TitleContent>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                    <MudText Typo="Typo.h6">@_selected?.Title</MudText>
                    @if (_selected is not null)
                    {
                        <StatusChip Color="@ChipPalette.ForDecisionStatus(_selected.Status)" Label="@ChromeLabels.Decision(L, _selected.Status)" />
                    }
                </MudStack>
            </TitleContent>
            <DialogContent>
                @if (_selected is not null)
                {
                @if (!string.IsNullOrWhiteSpace(_selected.Context))
                {
                    <MarkdownView Text="@_selected.Context" MaxHeight="160" Class="mt-2" />
                }
                <MarkdownView Text="@_selected.DecisionBody" MaxHeight="320" Class="mt-3" />
                @if (!string.IsNullOrWhiteSpace(_selected.Consequences))
                {
                    <MudText Typo="Typo.subtitle2" Class="mt-3">@L["Consequences"]</MudText>
                    <MarkdownView Text="@_selected.Consequences" MaxHeight="220" />
                }
                @if (_selected.SupersededById is Guid replacementId)
                {
                    var replacement = _decisions.FirstOrDefault(d => d.Id == replacementId);
                    <MudButton Variant="Variant.Text" Class="mt-2" OnClick="() => Select(replacement)">
                        @L["Replacement"]: @(replacement?.Title ?? replacementId.ToString())
                    </MudButton>
                }
                @foreach (var earlier in _decisions.Where(d => d.SupersededById == _selected.Id))
                {
                    <MudButton Variant="Variant.Text" Class="mt-1" OnClick="() => Select(earlier)">
                        @L["Supersede"]: @earlier.Title
                    </MudButton>
                }
                <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-3">
                    <MudExpansionPanel Text="@($"{L["ContentHistory"]} ({_selectedHistory.Count})")">
                        @if (_selectedHistory.Count == 0)
                        {
                            <MudText Typo="Typo.caption">@L["NoHistory"]</MudText>
                        }
                        @foreach (var version in _selectedHistory)
                        {
                            <MudPaper @key="version.Id" Elevation="0" Outlined="true" Class="pa-2 mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Spacing="2">
                                    <MudText Typo="Typo.subtitle2">rev. @version.Revision</MudText>
                                    <MudText Typo="Typo.caption"><LocalTime Value="version.At" Format="g" /></MudText>
                                    <MudSpacer />
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               Disabled="_busy || version.Revision == _selected.Revision"
                                               OnClick="() => RestoreSelectedVersion(version)">@L["RestoreRevision"]</MudButton>
                                </MudStack>
                                <MudText Typo="Typo.caption">@version.ChangedByType · @version.ChangedById</MudText>
                                <MarkdownView Text="@DecisionSnapshotMarkdown(version.ContentJson)" MaxHeight="140" />
                            </MudPaper>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
                <MudStack Row="true" Spacing="1" Class="mt-3">
                    @if (_selected.Status == DecisionStatus.Proposed)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Accept(_selected)">@L["Accept"]</MudButton>
                    }
                    @if (_selected.Status is DecisionStatus.Proposed or DecisionStatus.Accepted)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Warning" OnClick="() => Deprecate(_selected)">@L["Deprecate"]</MudButton>
                    }
                    @if (_selected.Status == DecisionStatus.Accepted)
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => StartSupersede(_selected)">@L["Supersede"]</MudButton>
                    }
                </MudStack>
                }
            </DialogContent>
        </MudDialog>
        @if (_superseding is not null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
                <MudText Typo="Typo.subtitle2">@L["Supersede"]: @_superseding.Title</MudText>
                <MudSelect T="Guid?" @bind-Value="_replacementId" Label="@L["Replacement"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2">
                    @foreach (var other in _decisions.Where(d => d.Id != _superseding.Id))
                    {
                        <MudSelectItem Value="@((Guid?)other.Id)">@other.Title</MudSelectItem>
                    }
                </MudSelect>
                <MudStack Row="true" Spacing="2" Class="mt-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="ConfirmSupersede">@L["Save"]</MudButton>
                    <MudButton Variant="Variant.Text" OnClick="CancelSupersede">@L["Cancel"]</MudButton>
                </MudStack>
            </MudPaper>
        }
    }
}

@code {
    private ProjectDto? _project;
    private ActorContext _actor = ActorContext.Anonymous;
    private List<DecisionDto> _decisions = [];
    private string _title = string.Empty;
    private string _context = string.Empty;
    private string _body = string.Empty;
    private string _consequences = string.Empty;
    private DecisionDto? _selected;
    private List<ContentVersionDto> _selectedHistory = [];
    private DecisionDto? _superseding;
    private Guid? _replacementId;
    private bool _loading = true;
    private bool _busy;
    private bool _detailOpen;
    private readonly DialogOptions _dialogOptions = new() { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };

    protected override async Task OnInitializedAsync()
    {
        _actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        var current = await CurrentProject.HandleAsync(_actor);
        _project = current.Value;
        await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        if (_project is null)
        {
            _decisions = [];
            return;
        }
        var listed = await ListDecisions.HandleAsync(_project.Id);
        _decisions = listed.Success ? listed.Value!.ToList() : [];
        if (_selected is not null)
            _selected = _decisions.FirstOrDefault(d => d.Id == _selected.Id);
    }

    private async Task Add()
    {
        if (_project is null) return;
        var result = await CreateDecision.HandleAsync(new CreateDecisionRequest(
            _project.Id, _title, _context, _body, _consequences, _actor));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _title = _context = _body = _consequences = string.Empty;
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private async Task Accept(DecisionDto decision)
    {
        var result = await AcceptDecision.HandleAsync(decision.Id, _actor);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private async Task Deprecate(DecisionDto decision)
    {
        var result = await DeprecateDecision.HandleAsync(decision.Id, _actor);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }

    private async Task Select(DecisionDto? decision)
    {
        _selected = decision;
        _detailOpen = decision is not null;
        await LoadSelectedHistory();
    }

    private async Task LoadSelectedHistory()
    {
        if (_project is null || _selected is null)
        {
            _selectedHistory = [];
            return;
        }

        var history = await ContentVersions.HandleAsync(
            _project.Id, ContentTargetKind.Decision, _selected.Id, 50);
        _selectedHistory = history.Success ? history.Value!.ToList() : [];
        if (!history.Success)
            Snackbar.Add(history.Error ?? L["Error"].Value, Severity.Warning);
    }

    private async Task RestoreSelectedVersion(ContentVersionDto version)
    {
        if (_project is null || _selected is null)
            return;

        var decisionId = _selected.Id;
        _busy = true;
        try
        {
            var result = await RestoreContentVersion.HandleAsync(new RestoreContentVersionCommand(
                _project.Id, version.Id, _selected.Revision, _actor,
                ContentTargetKind.Decision, decisionId));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }

            await Reload();
            _selected = _decisions.FirstOrDefault(item => item.Id == decisionId);
            await LoadSelectedHistory();
            Snackbar.Add(L["RestoredRevision"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string DecisionSnapshotMarkdown(string json)
    {
        try
        {
            using var document = System.Text.Json.JsonDocument.Parse(json);
            var root = document.RootElement;
            var fields = new[] { "title", "context", "decisionBody", "consequences" };
            return string.Join(Environment.NewLine + Environment.NewLine,
                fields.Where(field => root.TryGetProperty(field, out _))
                    .Select(field => root.GetProperty(field).ValueKind == System.Text.Json.JsonValueKind.String
                        ? root.GetProperty(field).GetString()
                        : null)
                    .Where(value => !string.IsNullOrWhiteSpace(value)));
        }
        catch (System.Text.Json.JsonException)
        {
            return string.Empty;
        }
    }

    private void StartSupersede(DecisionDto decision)
    {
        _superseding = decision;
        _replacementId = _decisions.FirstOrDefault(d => d.Id != decision.Id)?.Id;
    }

    private void CancelSupersede()
    {
        _superseding = null;
        _replacementId = null;
    }

    private async Task ConfirmSupersede()
    {
        if (_superseding is null || _replacementId is null)
            return;
        var result = await SupersedeDecision.HandleAsync(_superseding.Id, _replacementId.Value, _actor);
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        CancelSupersede();
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }
}
