@page "/reports"
@layout MainLayout
@attribute [Authorize]
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Projects
@using System.Text.Json
@using ProjectBeacon.Application.Reports
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject ListReportsHandler ListReports
@inject GetReportHandler GetReport
@inject GenerateReportHandler GenerateReport
@inject ISnackbar Snackbar

<PageTitle>@L["Reports"]</PageTitle>
<PageHeader Title="@L["Reports"]">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Generate" Disabled="_project is null || _busy">
        @L["GenerateReport"]
    </MudButton>
</PageHeader>

@if (_project is null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
}
else
{
    @if (_loading)
    {
        <LoadingState />
    }
    else if (_reports.Count == 0)
    {
        <EmptyState>@L["NoReports"]</EmptyState>
    }
    else
    {
        <MudTable Items="_reports" Hover="true" Class="mt-4" Dense="true">
            <HeaderContent>
                <MudTh>@L["CreatedAt"]</MudTh>
                <MudTh>@L["Title"]</MudTh>
                <MudTh>@L["Scope"]</MudTh>
                <MudTh>@L["Status"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["CreatedAt"]">@context.CreatedAt.ToUniversalTime().ToString("u")</MudTd>
                <MudTd DataLabel="@L["Title"]">@context.Title</MudTd>
                <MudTd DataLabel="@L["Scope"]">@ScopeLabel(context)</MudTd>
                <MudTd DataLabel="@L["Status"]">@StatusLabel(context)</MudTd>
                <MudTd DataLabel="@L["Open"]">
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => Open(context)">@L["Open"]</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
        @if (_open is not null)
        {
            <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mt-4">
                <MudText Typo="Typo.h6">@_open.Title</MudText>
                <MudText Typo="Typo.caption">@ScopeLabel(_open) · @StatusLabel(_open)</MudText>
                <MudText Typo="Typo.body2" Class="mt-3 beacon-pre">@_open.BodyMarkdown</MudText>
                <ContextCostReport ProjectId="_project.Id" />
            </MudPaper>
        }
    }
}

@code {
    private ProjectDto? _project;
    private List<ReportDto> _reports = [];
    private ReportDto? _open;
    private bool _busy;
    private bool _loading = true;
    private static readonly JsonSerializerOptions SnapshotJson = new() { PropertyNameCaseInsensitive = true };

    protected override async Task OnInitializedAsync()
    {
        var current = await CurrentProject.HandleAsync((await Auth.GetAuthenticationStateAsync()).User);
        _project = current.Value;
        await Reload();
        _loading = false;
    }

    private async Task Reload()
    {
        if (_project is null)
            return;
        var listed = await ListReports.HandleAsync(new ListReportsRequest(_project.Id));
        _reports = listed.Success ? listed.Value!.ToList() : [];
    }

    private async Task Generate()
    {
        if (_project is null)
            return;
        _busy = true;
        var result = await GenerateReport.HandleAsync(new GenerateReportCommand(
            new GenerateReportRequest(_project.Id, "user", "web")));
        _busy = false;
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["AnErrorOccurred"], Severity.Error);
            return;
        }
        await Reload();
    }

    private async Task Open(ReportDto report)
    {
        if (_project is null)
            return;
        var result = await GetReport.HandleAsync(new GetReportRequest(_project.Id, report.Id));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["AnErrorOccurred"], Severity.Error);
            return;
        }
        _open = result.Value;
    }

    private string ScopeLabel(ReportDto report)
    {
        var snapshot = ReadSnapshot(report.SnapshotJson);
        return snapshot is null
            ? L["Project"].Value
            : string.Format(L["MilestoneCounts"].Value, snapshot.Milestones.Open, snapshot.Milestones.Closed);
    }

    private string StatusLabel(ReportDto report)
    {
        var snapshot = ReadSnapshot(report.SnapshotJson);
        var tasks = snapshot?.Tasks.Values.Sum() ?? 0;
        return string.Format(L["ReportTaskCount"].Value, tasks);
    }

    private static ReportSnapshot? ReadSnapshot(string json)
    {
        try
        {
            return JsonSerializer.Deserialize<ReportSnapshot>(json, SnapshotJson);
        }
        catch (JsonException)
        {
            return null;
        }
    }
}
