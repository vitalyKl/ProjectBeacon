@page "/forgot"
@layout AuthLayout
@attribute [AllowAnonymous]
@using System.Net.Http.Json
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject HttpClient Http

<PageTitle>@L["ForgotPassword"]</PageTitle>

<MudPaper Elevation="0" Outlined="true" Class="pa-8 auth-card">
    <MudText Typo="Typo.h4" Class="text-center mb-6">@L["ForgotPassword"]</MudText>
    <MudText Typo="Typo.body1" Class="mb-4">@L["ForgotDescription"]</MudText>

    @if (_sent)
    {
        <MudAlert Severity="Severity.Success" Class="mb-4">@L["ForgotSuccess"]</MudAlert>
        <MudButton Variant="Variant.Filled" Color="Color.Primary"
                   OnClick="@(() => Navigation.NavigateTo("/login"))"
                   Class="w-100">
            @L["GoToLogin"]
        </MudButton>
    }
    else
    {
        <MudTextField @bind-Value="_email" Label="@L["Email"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Submit" Disabled="_loading" Class="w-100">
            @(_loading ? L["Loading"] : L["ForgotPassword"])
        </MudButton>
    }

    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-4">@_error</MudAlert>
    }
</MudPaper>

@code {
    private string _email = string.Empty;
    private bool _sent;
    private bool _loading;
    private string? _error;

    private async Task Submit()
    {
        _error = null;
        _loading = true;
        try
        {
            var response = await Http.PostAsJsonAsync("/v1/auth/forgot-password", new { email = _email });
            if (!response.IsSuccessStatusCode)
            {
                _error = L["Error"].Value;
                return;
            }
            _sent = true;
        }
        catch (Exception ex)
        {
            _error = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }
}
