@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.WebUtilities
@using ProjectBeacon.Application.Auth
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<PageTitle>@L["Login"]</PageTitle>

<MudPaper Elevation="0" Outlined="true" Class="pa-8 auth-card">
    <MudText Typo="Typo.h4" Class="text-center mb-6">@L["Login"]</MudText>

    @if (_errorMessage is not null)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@_errorMessage</MudAlert>
    }

    <form method="post" action="/v1/auth/cookie-login">
        <input type="hidden" name="returnUrl" value="@_returnUrl" />
        <MudTextField T="string"
                      Label="@L["Username"]"
                      Required="true"
                      Margin="Margin.Dense"
                      Variant="Variant.Outlined"
                      UserAttributes="@LoginFieldAttrs" />
        <MudTextField T="string"
                      Label="@L["Password"]"
                      InputType="InputType.Password"
                      Required="true"
                      Margin="Margin.Dense"
                      Variant="Variant.Outlined"
                      UserAttributes="@PasswordFieldAttrs" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6 w-100">
            @L["Login"]
        </MudButton>
    </form>

    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-4 w-100"
               OnClick="@(() => Navigation.NavigateTo("/forgot"))">
        @L["ForgotPassword"]
    </MudButton>
    @if (!_inviteOnly)
    {
        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="w-100"
                   OnClick="@(() => Navigation.NavigateTo("/register"))">
            @L["Register"]
        </MudButton>
    }
    <MudButton Variant="Variant.Text" Color="Color.Default" Class="w-100"
               OnClick="@(() => Navigation.NavigateTo("/recover"))">
        @L["RecoverPassword"]
    </MudButton>
</MudPaper>

@code {
    private static readonly Dictionary<string, object> LoginFieldAttrs = new()
    {
        ["name"] = "login",
        ["autocomplete"] = "username"
    };
    private static readonly Dictionary<string, object> PasswordFieldAttrs = new()
    {
        ["name"] = "password",
        ["autocomplete"] = "current-password"
    };
    private string? _errorMessage;
    private bool _inviteOnly;
    private string _returnUrl = "/dashboard";

    private string LoginUnavailableMessage(string? diagnosticId)
    {
        return diagnosticId is { Length: 8 } && diagnosticId.All(char.IsAsciiHexDigit)
            ? Notifications.FormatDiagnosticMessage("LoginUnavailable", diagnosticId)
            : L["LoginUnavailable"].Value;
    }

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        if (query.TryGetValue("error", out var error))
        {
            _errorMessage = error.ToString() switch
            {
                "1" or "invalid_credentials" => L["InvalidCredentials"].Value,
                "unavailable" => LoginUnavailableMessage(query.TryGetValue("diagnosticId", out var diagnosticId) ? diagnosticId.ToString() : null),
                _ => L["InvalidCredentials"].Value
            };
        }

        _inviteOnly = LocalAuthOptions.InviteOnly(Config);
        if (query.TryGetValue("returnUrl", out var returnUrl))
            _returnUrl = returnUrl.ToString();
    }
}
