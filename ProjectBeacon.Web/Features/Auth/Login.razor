@page "/login"
@layout AuthLayout
@attribute [AllowAnonymous]
@using Microsoft.AspNetCore.WebUtilities
@using ProjectBeacon.Application.Auth
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject Microsoft.Extensions.Configuration.IConfiguration Config

<PageTitle>@L["Login"]</PageTitle>

<MudPaper Elevation="0" Outlined="true" Class="pa-8 auth-card">
    <MudText Typo="Typo.h4" Class="text-center mb-6">@L["Login"]</MudText>

    @if (_error)
    {
        <MudAlert Severity="Severity.Error" Class="mb-4">@L["InvalidCredentials"]</MudAlert>
    }

    <form method="post" action="/v1/auth/cookie-login">
        <input type="hidden" name="returnUrl" value="@_returnUrl" />
        <MudTextField T="string"
                      Label="@L["Username"]"
                      Required="true"
                      Margin="Margin.Dense"
                      Variant="Variant.Outlined"
                      UserAttributes="@LoginFieldAttrs" />
        <MudTextField T="string"
                      Label="@L["Password"]"
                      InputType="InputType.Password"
                      Required="true"
                      Margin="Margin.Dense"
                      Variant="Variant.Outlined"
                      UserAttributes="@PasswordFieldAttrs" />
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6 w-100">
            @L["Login"]
        </MudButton>
    </form>

    <MudButton Variant="Variant.Text" Color="Color.Primary" Class="mt-4 w-100"
               OnClick="@(() => Navigation.NavigateTo("/forgot"))">
        @L["ForgotPassword"]
    </MudButton>
    @if (!_inviteOnly)
    {
        <MudButton Variant="Variant.Text" Color="Color.Primary" Class="w-100"
                   OnClick="@(() => Navigation.NavigateTo("/register"))">
            @L["Register"]
        </MudButton>
    }
    <MudButton Variant="Variant.Text" Color="Color.Default" Class="w-100"
               OnClick="@(() => Navigation.NavigateTo("/recover"))">
        @L["RecoverPassword"]
    </MudButton>
</MudPaper>

@code {
    private static readonly Dictionary<string, object> LoginFieldAttrs = new()
    {
        ["name"] = "login",
        ["autocomplete"] = "username"
    };
    private static readonly Dictionary<string, object> PasswordFieldAttrs = new()
    {
        ["name"] = "password",
        ["autocomplete"] = "current-password"
    };
    private bool _error;
    private bool _inviteOnly;
    private string _returnUrl = "/dashboard";

    protected override void OnInitialized()
    {
        var query = QueryHelpers.ParseQuery(Navigation.ToAbsoluteUri(Navigation.Uri).Query);
        _error = query.ContainsKey("error");
        _inviteOnly = LocalAuthOptions.InviteOnly(Config);
        if (query.TryGetValue("returnUrl", out var returnUrl))
            _returnUrl = returnUrl.ToString();
    }
}
