@page "/dashboard"
@layout MainLayout
@attribute [Authorize]
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject GetDashboardCountsHandler DashboardCounts

<PageTitle>@L["Dashboard"]</PageTitle>

<MudText Typo="Typo.h4">@L["Dashboard"]</MudText>

<MudDivider Class="mt-4 mb-4" />

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 text-center">
            <MudText Typo="Typo.h5">@L["Projects"]</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">@projectsCount</MudChip>
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 text-center">
            <MudText Typo="Typo.h5">@L["Tasks"]</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">@tasksCount</MudChip>
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 text-center">
            <MudText Typo="Typo.h5">@L["InProgress"]</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("InProgress")" Variant="Variant.Filled">@inProgressCount</MudChip>
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 text-center">
            <MudText Typo="Typo.h5">@L["Completed"]</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("Done")" Variant="Variant.Filled">@doneCount</MudChip>
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudButton Variant="Variant.Filled" Color="Color.Primary"
          OnClick="@(() => Navigation.NavigateTo("/board"))"
          Class="mt-6">
    @L["GoToBoard"]
</MudButton>

@code {
    private int projectsCount;
    private int tasksCount;
    private int inProgressCount;
    private int doneCount;

    protected override async Task OnInitializedAsync()
    {
        await LoadDashboardData();
    }

    private async Task LoadDashboardData()
    {
        var counts = await DashboardCounts.HandleAsync();
        if (!counts.Success || counts.Value is null)
            return;
        projectsCount = counts.Value.Projects;
        tasksCount = counts.Value.Tasks;
        inProgressCount = counts.Value.InProgress;
        doneCount = counts.Value.Done;
    }
}
