@page "/dashboard"
@layout MainLayout
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Agents
@using ProjectBeacon.Application.Devices
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Infrastructure.LlamaSwap
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
@inject GetProjectPulseHandler Pulse
@inject GetProxyStatusHandler Proxy
@inject ListHostSamplesHandler HostSamples

<PageTitle>@L["Dashboard"]</PageTitle>

<PageHeader Title="@L["Dashboard"]">
    @if (_pulse is not null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/board">
            @L["GoToBoard"]
        </MudButton>
    }
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@L["AnErrorOccurred"]</MudAlert>
}
else if (_pulse is null)
{
    <MudAlert Severity="Severity.Info" Class="mt-4">@L["NoProjectAvailable"]</MudAlert>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" Href="/projects/new">@L["CreateProject"]</MudButton>
}
else
{
    <MudStack Spacing="1" Class="mb-6">
        <MudText Typo="Typo.h6">@_pulse.Name</MudText>
        @if (!string.IsNullOrWhiteSpace(_pulse.Description))
        {
            <MudText Typo="Typo.body2">@_pulse.Description</MudText>
        }
    </MudStack>

    <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
        <MudText Typo="Typo.subtitle1">@L["ProjectBrief"]</MudText>
        <MudButton Variant="Variant.Text" Size="Size.Small" Href="/context">@L["EditInContext"]</MudButton>
    </MudStack>
    @if (_pulse.BriefSections.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mb-6">@L["NoBrief"]</MudAlert>
    }
    else
    {
        <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 mb-6">
            @foreach (var section in _pulse.BriefSections)
            {
                <MudText Typo="Typo.caption" Class="mb-1">@ChromeLabels.Section(L, section.SectionId)</MudText>
                <MudText Typo="Typo.body2" Class="mb-3 beacon-pre">@section.BodyMarkdown</MudText>
            }
        </MudPaper>
    }

    <MudGrid Spacing="3">
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 h-100">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudText Typo="Typo.subtitle1">@L["Queue"]</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Href="/board">@L["GoToBoard"]</MudButton>
                </MudStack>
                <MudStack Row="true" Wrap="Wrap.Wrap" Class="mb-3">
                    <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("Todo")" Variant="Variant.Filled">@L["Todo"]: @_pulse.Todo</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("InProgress")" Variant="Variant.Filled">@L["InProgress"]: @_pulse.InProgress</MudChip>
                    <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("Done")" Variant="Variant.Filled">@L["Done"]: @_pulse.Done</MudChip>
                </MudStack>
                @if (_pulse.ReadyPeek.Count == 0)
                {
                    <MudText Typo="Typo.body2">@L["NoReadyTasks"]</MudText>
                }
                else
                {
                    <MudList T="string" Dense="true">
                        @foreach (var t in _pulse.ReadyPeek)
                        {
                            <MudListItem T="string" OnClick="@(() => Navigation.NavigateTo($"/task/{t.Id}"))">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap">
                                    <MudText Typo="Typo.body2" Class="grow beacon-ellipsis">@t.Title</MudText>
                                    <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForPriority(t.Priority)" Variant="Variant.Filled">@ChromeLabels.Priority(L, t.Priority)</MudChip>
                                </MudStack>
                            </MudListItem>
                        }
                    </MudList>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 h-100">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudText Typo="Typo.subtitle1">@L["Milestone"]</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Href="/roadmap">@L["Roadmap"]</MudButton>
                </MudStack>
                @if (_pulse.OpenMilestones == 0)
                {
                    <MudText Typo="Typo.body2">@L["NoOpenMilestones"]</MudText>
                }
                else
                {
                    <MudButton Variant="Variant.Text" Href="/roadmap">@L["OpenMilestones", _pulse.OpenMilestones]</MudButton>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 h-100">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudText Typo="Typo.subtitle1">@L["Agents"]</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Href="/agents">@L["Agents"]</MudButton>
                </MudStack>
                  <MudText Typo="Typo.body2">@L["AgentsActive", _pulse.ActiveSessions]</MudText>
                  @if (_pulse.ActiveSessions == 0)
                  {
                      <MudText Typo="Typo.caption" Class="mt-2">@L["NoAgentSessionsHint"]</MudText>
                  }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6">
            <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 h-100">
                <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
                    <MudText Typo="Typo.subtitle1">@L["WorkstationLoad"]</MudText>
                    <MudButton Variant="Variant.Text" Size="Size.Small" Href="/agents">@L["Agents"]</MudButton>
                </MudStack>
                @if (_status is null || (!_status.Available && _status.Host is null))
                {
                    <MudAlert Severity="Severity.Info">@L["StartClientHint"]</MudAlert>
                }
                else
                {
                    @if (!string.IsNullOrWhiteSpace(_status.DeviceName))
                    {
                        <MudText Typo="Typo.caption" Class="mb-1">@_status.DeviceName</MudText>
                    }
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="@ProxyColor">@ProxyText</MudChip>
                    <HostLoadView Status="_status" />
                }
            </MudPaper>
        </MudItem>
        @if (_cpuSeries.Count > 0)
        {
            <MudItem xs="12">
                <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-3">@L["CpuHistory"]</MudText>
                    <MudChart ChartType="ChartType.Line" ChartSeries="_cpuSeries" ChartLabels="_xLabels" Width="100%" Height="180px" />
                    @if (_ramSeries.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-3">@L["RamHistory"]</MudText>
                        <MudChart ChartType="ChartType.Line" ChartSeries="_ramSeries" ChartLabels="_xLabels" Width="100%" Height="180px" />
                    }
                    @if (_gpuSeries.Count > 0)
                    {
                        <MudText Typo="Typo.subtitle1" Class="mt-4 mb-3">@L["GpuHistory"]</MudText>
                        <MudChart ChartType="ChartType.Line" ChartSeries="_gpuSeries" ChartLabels="_xLabels" Width="100%" Height="180px" />
                    }
                </MudPaper>
            </MudItem>
        }
    </MudGrid>
}

@code {
    private ProjectPulseDto? _pulse;
    private LlamaSwapStatusDto? _status;
    private bool _loading = true;
    private bool _error;
    private Guid _userId;
    private CancellationTokenSource? _poll;
    private List<ChartSeries<double>> _cpuSeries = [];
    private List<ChartSeries<double>> _ramSeries = [];
    private List<ChartSeries<double>> _gpuSeries = [];
    private string[] _xLabels = [];

    private Color ProxyColor =>
        _status is null ? Color.Default
        : _status.Available && _status.Healthy ? Color.Success
        : _status.Available ? Color.Warning
        : _status.Host is not null ? Color.Info
        : Color.Default;

    private string ProxyText =>
        _status is null ? L["Unavailable"].Value
        : _status.Available && _status.Healthy ? L["Healthy"].Value
        : _status.Available ? L["Unhealthy"].Value
        : _status.Host is not null ? L["DeviceOnline"].Value
        : L["Unavailable"].Value;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true
            || !Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid))
        {
            _loading = false;
            return;
        }
        _userId = uid;

        Guid? preferred = Guid.TryParse(user.FindFirst("project_id")?.Value, out var active) ? active : null;
        var isAdmin = bool.TryParse(user.FindFirst("isAdmin")?.Value, out var flag) && flag;
        var result = await Pulse.HandleAsync(uid, isAdmin, preferred);
        if (!result.Success)
        {
            _error = true;
            _loading = false;
            return;
        }

        _pulse = result.Value;
        await RefreshHost();
        _loading = false;
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        _poll = new CancellationTokenSource();
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_poll.Token))
            {
                await RefreshHost();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task RefreshHost()
    {
        var proxy = await Proxy.HandleAsync(new GetProxyStatusCommand());
        if (proxy.Success)
            _status = proxy.Value;
        if (_userId == Guid.Empty)
            return;
        var samples = await HostSamples.HandleAsync(new ListHostSamplesCommand(new ListHostSamplesRequest(_userId)));
        if (!samples.Success || samples.Value is null || samples.Value.Count == 0)
            return;
        var rows = samples.Value.ToList();
        _xLabels = rows.Select(s => s.SampledAt.ToLocalTime().ToString("HH:mm")).ToArray();
        _cpuSeries = [new ChartSeries<double> { Name = L["Cpu"].Value, Data = new ChartData<double>(rows.Select(s => s.CpuPercent ?? 0).ToList()) }];
        if (rows.Any(s => s.RamTotalBytes is > 0))
        {
            _ramSeries =
            [
                new ChartSeries<double>
                {
                    Name = L["Ram"].Value,
                    Data = new ChartData<double>(rows.Select(s => s.RamTotalBytes is > 0 && s.RamUsedBytes is { } used
                        ? 100d * used / s.RamTotalBytes.Value
                        : 0d).ToList())
                }
            ];
        }
        if (rows.Any(s => s.GpuUtilizationPercent is not null))
        {
            _gpuSeries =
            [
                new ChartSeries<double>
                {
                    Name = L["Gpu"].Value,
                    Data = new ChartData<double>(rows.Select(s => s.GpuUtilizationPercent ?? 0).ToList())
                }
            ];
        }
    }

    public void Dispose()
    {
        _poll?.Cancel();
        _poll?.Dispose();
    }
}
