@page "/dashboard"
@layout MainLayout
@attribute [Authorize]
@implements IDisposable
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Agents
@using ProjectBeacon.Application.Devices
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Tasks
@using ProjectBeacon.Infrastructure.LlamaSwap
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
@inject GetProjectPulseHandler Pulse
@inject GetProxyStatusHandler Proxy
@inject ListHostSamplesHandler HostSamples
@inject ListDevicesHandler Devices
@inject ListTasksByStatusHandler TasksByStatus
@inject ListMyProjectsHandler MyProjects

<PageTitle>@L["Dashboard"]</PageTitle>

<PageHeader Title="@L["Dashboard"]">
    @if (_pulse is not null)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/board">
            @L["GoToBoard"]
        </MudButton>
    }
</PageHeader>

@if (_loading)
{
    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-4" />
}
else if (_error)
{
    <MudAlert Severity="Severity.Error" Class="mt-4">@L["AnErrorOccurred"]</MudAlert>
}
else if (_pulse is null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
}
else
{
    @if (_attention.Count > 0)
    {
        <div class="beacon-attention-banner">
            <div>
                <strong>@string.Format(L["AttentionCount"].Value, _attention.Count)</strong>
                <span>@_attention[0].Detail</span>
            </div>
            <MudButton Variant="Variant.Outlined" Href="@_attention[0].Href">@L["Open"]</MudButton>
        </div>
    }

    <div class="beacon-metric-strip">
        <PbMetric Label="@L["InProgress"]" Value="@_pulse.InProgress.ToString()" Note="@L["AgentsActive", _pulse.ActiveSessions]" />
        <PbMetric Label="@L["Todo"]" Value="@_pulse.Todo.ToString()" Note="@L["Queue"]" />
        <PbMetric Label="@L["Done"]" Value="@_pulse.Done.ToString()" />
        <PbMetric Label="@L["Workstations"]" Value="@_devices.Count(d => d.Online).ToString()" Note="@string.Format(L["FleetCounts"].Value, _devices.Count, _devices.Count(d => d.Online))" />
    </div>

    <div class="beacon-ops-grid">
        <PbPanel Class="span-2" Title="@L["CurrentlyRunning"]" Subtitle="@_pulse.Name">
            <Actions>
                <MudButton Variant="Variant.Text" Size="Size.Small" Href="/board">@L["GoToBoard"]</MudButton>
            </Actions>
            <ChildContent>
                @if (_running.Count == 0)
                {
                    <p class="beacon-ops-empty">@L["NoRunningWork"]</p>
                }
                else
                {
                    @foreach (var task in _running)
                    {
                        <a class="beacon-run-row" href="@($"/task/{task.Id}")">
                            <PbAvatar Text="@Initials(task.Title)" />
                            <span>
                                <strong>@task.Title</strong>
                                <span>@ChromeLabels.Status(L, task.Status)</span>
                            </span>
                            <PbProgress Value="@(task.SubStage is { } stage ? SubStageToPercent(stage) : 0)" />
                            <StatusChip Color="@ChipPalette.ForPriority(task.Priority)" Label="@ChromeLabels.Priority(L, task.Priority)" />
                        </a>
                    }
                }
            </ChildContent>
        </PbPanel>
        <PbPanel Title="@L["NeedsAttention"]">
            <ChildContent>
                @if (_attention.Count == 0)
                {
                    <p class="beacon-ops-empty">@L["NoAttention"]</p>
                }
                else
                {
                    @foreach (var item in _attention)
                    {
                        <a class="beacon-attention-item" href="@item.Href">
                            <span class="beacon-severity @item.Tone"></span>
                            <span>
                                <strong>@item.Title</strong>
                                <span>@item.Detail</span>
                            </span>
                        </a>
                    }
                }
            </ChildContent>
        </PbPanel>
        <PbPanel Class="span-2" Title="@L["FleetHealth"]">
            <Actions>
                <MudButton Variant="Variant.Text" Size="Size.Small" Href="/settings/workstations">@L["Workstations"]</MudButton>
            </Actions>
            <ChildContent>
                @if (_devices.Count == 0)
                {
                    <p class="beacon-ops-empty">@L["StartClientHint"]</p>
                }
                else
                {
                    @foreach (var device in _devices)
                    {
                        <div class="beacon-health-row">
                            <span class="beacon-node-dot @(device.Online ? "" : "is-offline")"></span>
                            <span>
                                <strong>@device.Name</strong>
                                <span>@(device.Online ? L["DeviceOnline"] : L["RuntimeOffline"])</span>
                            </span>
                            @if (device.Online && _status?.DeviceName == device.Name && _status.Host?.CpuPercent is { } cpu)
                            {
                                <PbProgress Value="cpu" />
                            }
                        </div>
                    }
                }
                @if (_status is not null && (_status.Available || _status.Host is not null))
                {
                    <div class="beacon-ops-pad">
                        <StatusChip Color="@ChipPalette.ForRuntime(ProxyState)" Label="@ProxyText" />
                        <HostLoadView Status="_status" />
                        @if (_loadSeries.Count > 0)
                        {
                            <MudChart ChartType="ChartType.Line" ChartSeries="_loadSeries" ChartLabels="_xLabels" ChartOptions="_loadChartOptions" Width="100%" Height="160px" Class="mt-3" />
                        }
                    </div>
                }
            </ChildContent>
        </PbPanel>
        <PbPanel Title="@L["RecentActivity"]">
            <ChildContent>
                @if (_recent.Count == 0)
                {
                    <p class="beacon-ops-empty">@L["NoRecentActivity"]</p>
                }
                else
                {
                    @foreach (var task in _recent)
                    {
                        <a class="beacon-activity-row" href="@($"/task/{task.Id}")">
                            <StatusChip Color="@ChipPalette.ForStatus(task.Status.ToString())" Label="@ChromeLabels.Status(L, task.Status)" />
                            <span>@task.Title</span>
                            <time>@task.ActivityAt.ToLocalTime().ToString("g")</time>
                        </a>
                    }
                }
            </ChildContent>
        </PbPanel>
        <PbPanel Class="span-3" Title="@L["ProjectBrief"]">
            <Actions>
                <MudButton Variant="Variant.Text" Size="Size.Small" Href="/context">@L["EditInContext"]</MudButton>
            </Actions>
            <ChildContent>
                @if (_pulse.BriefSections.Count == 0)
                {
                    <p class="beacon-ops-empty">@L["NoBrief"]</p>
                }
                else
                {
                    <div class="beacon-ops-pad">
                        @foreach (var section in _pulse.BriefSections)
                        {
                            <MudText Typo="Typo.caption">@ChromeLabels.Section(L, section.SectionId)</MudText>
                            <MudText Typo="Typo.body2" Class="mb-3 beacon-pre">@section.BodyMarkdown</MudText>
                        }
                    </div>
                }
                <div class="beacon-ops-pad">
                    @if (_pulse.OpenMilestones == 0)
                    {
                        <MudText Typo="Typo.body2">@L["NoOpenMilestones"]</MudText>
                    }
                    else
                    {
                        <MudButton Variant="Variant.Text" Href="/roadmap">@L["OpenMilestones", _pulse.OpenMilestones]</MudButton>
                    }
                </div>
            </ChildContent>
        </PbPanel>
    </div>
}

@code {
    private sealed record AttentionItem(string Title, string Detail, string Href, string Tone);

    private ProjectPulseDto? _pulse;
    private LlamaSwapStatusDto? _status;
    private List<TaskItemDto> _running = [];
    private List<DaemonDeviceDto> _devices = [];
    private List<RecentTaskDto> _recent = [];
    private List<AttentionItem> _attention = [];
    private bool _loading = true;
    private bool _error;
    private Guid _userId;
    private CancellationTokenSource? _poll;
    private List<ChartSeries<double>> _loadSeries = [];
    private string[] _xLabels = [];
    private readonly LineChartOptions _loadChartOptions = new()
    {
        YAxisTicks = 50,
        YAxisSuggestedMax = 100,
        YAxisRequireZeroPoint = true,
        MaxNumYAxisTicks = 3
    };

    private string ProxyState => RuntimeHealth.ForDashboard(_status);

    private string ProxyText => ProxyState switch
    {
        "Online" => L["DeviceOnline"].Value,
        "Starting" => L["RuntimeStarting"].Value,
        "Ready" => L["RuntimeReady"].Value,
        "Busy" => L["RuntimeBusy"].Value,
        "Degraded" => L["RuntimeDegraded"].Value,
        "Stopping" => L["RuntimeStopping"].Value,
        "Failed" => L["RuntimeFailed"].Value,
        _ => L["RuntimeOffline"].Value
    };

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true
            || !Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid))
        {
            _loading = false;
            return;
        }
        _userId = uid;

        Guid? preferred = Guid.TryParse(user.FindFirst("project_id")?.Value, out var active) ? active : null;
        var isAdmin = bool.TryParse(user.FindFirst("isAdmin")?.Value, out var flag) && flag;
        var result = await Pulse.HandleAsync(uid, isAdmin, preferred);
        if (!result.Success)
        {
            _error = true;
            _loading = false;
            return;
        }

        _pulse = result.Value;
        await LoadOps(isAdmin);
        await RefreshHost();
        _loading = false;
        _ = PollAsync();
    }

    private async Task PollAsync()
    {
        _poll = new CancellationTokenSource();
        using var timer = new PeriodicTimer(TimeSpan.FromSeconds(5));
        try
        {
            while (await timer.WaitForNextTickAsync(_poll.Token))
            {
                await RefreshHost();
                await InvokeAsync(StateHasChanged);
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private async Task LoadOps(bool isAdmin)
    {
        if (_pulse is null)
            return;

        var running = await TasksByStatus.HandleAsync(
            new ListTasksByStatusCommand(new ListTasksByStatusRequest(_pulse.ProjectId, "InProgress")));
        _running = running.Success && running.Value is not null ? running.Value.Take(6).ToList() : [];

        var devices = await Devices.HandleAsync(new ListDevicesCommand(new ListDevicesRequest(_userId)));
        _devices = devices.Success && devices.Value is not null ? devices.Value.ToList() : [];

        var mine = await MyProjects.HandleAsync(_userId, isAdmin);
        _recent = mine.Success && mine.Value is not null
            ? mine.Value.RecentTasks.Where(t => t.ProjectId == _pulse.ProjectId).Take(6).ToList()
            : [];

        var attention = new List<AttentionItem>();
        var offline = _devices.Count(d => !d.Online);
        if (offline > 0)
        {
            attention.Add(new AttentionItem(
                L["RuntimeOffline"].Value,
                string.Format(L["FleetCounts"].Value, _devices.Count, _devices.Count(d => d.Online)),
                "/settings/workstations",
                "is-danger"));
        }

        foreach (var task in _pulse.ReadyPeek.Where(t => t.Priority is TaskPriority.High or TaskPriority.Critical))
        {
            attention.Add(new AttentionItem(
                task.Title,
                ChromeLabels.Priority(L, task.Priority),
                $"/task/{task.Id}",
                task.Priority == TaskPriority.Critical ? "is-danger" : "is-warning"));
        }

        if (_pulse.InProgress > 0 && _pulse.ActiveSessions == 0)
        {
            attention.Add(new AttentionItem(
                L["InProgress"].Value,
                L["NoAgentSessionsHint"].Value,
                "/board",
                "is-warning"));
        }

        _attention = attention;
    }

    private static string Initials(string title)
    {
        var trimmed = title.Trim();
        return trimmed.Length == 0 ? "?" : char.ToUpperInvariant(trimmed[0]).ToString();
    }

    private static int SubStageToPercent(TaskSubStage stage) => stage switch
    {
        TaskSubStage.RequirementGathering => 10,
        TaskSubStage.Estimation => 20,
        TaskSubStage.IntermediateResult => 40,
        TaskSubStage.Review => 60,
        TaskSubStage.Corrections => 75,
        TaskSubStage.ReviewCorrections => 90,
        TaskSubStage.Complete => 100,
        _ => 0
    };

    private async Task RefreshHost()
    {
        var proxy = await Proxy.HandleAsync(new GetProxyStatusCommand());
        if (proxy.Success)
            _status = proxy.Value;
        if (_userId == Guid.Empty)
            return;
        var samples = await HostSamples.HandleAsync(new ListHostSamplesCommand(new ListHostSamplesRequest(_userId)));
        if (!samples.Success || samples.Value is null || samples.Value.Count == 0)
            return;
        var rows = samples.Value.ToList();
        _xLabels = SparseTimes(rows);
        var series = new List<ChartSeries<double>>
        {
            new() { Name = L["Cpu"].Value, Data = new ChartData<double>(rows.Select(s => s.CpuPercent ?? 0).ToList()) }
        };
        if (rows.Any(s => s.RamTotalBytes is > 0))
        {
            series.Add(new ChartSeries<double>
            {
                Name = L["Ram"].Value,
                Data = new ChartData<double>(rows.Select(s => s.RamTotalBytes is > 0 && s.RamUsedBytes is { } used
                    ? 100d * used / s.RamTotalBytes.Value
                    : 0d).ToList())
            });
        }
        if (rows.Any(s => s.GpuUtilizationPercent is not null))
        {
            series.Add(new ChartSeries<double>
            {
                Name = L["Gpu"].Value,
                Data = new ChartData<double>(rows.Select(s => s.GpuUtilizationPercent ?? 0).ToList())
            });
        }
        _loadSeries = series;
    }

    private static string[] SparseTimes(IReadOnlyList<DeviceHostSampleDto> rows)
    {
        var labels = new string[rows.Count];
        Array.Fill(labels, string.Empty);
        if (rows.Count == 0)
            return labels;
        labels[0] = rows[0].SampledAt.ToLocalTime().ToString("HH:mm");
        if (rows.Count > 2)
            labels[rows.Count / 2] = rows[rows.Count / 2].SampledAt.ToLocalTime().ToString("HH:mm");
        if (rows.Count > 1)
            labels[^1] = rows[^1].SampledAt.ToLocalTime().ToString("HH:mm");
        return labels;
    }

    public void Dispose()
    {
        _poll?.Cancel();
        _poll?.Dispose();
    }
}
