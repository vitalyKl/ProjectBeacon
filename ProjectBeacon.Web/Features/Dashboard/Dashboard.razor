@page "/dashboard"
@layout MainLayout
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject AuthenticationStateProvider Auth
@inject ListMyProjectsHandler MyProjects

<PageTitle>@L["Dashboard"]</PageTitle>

<MudText Typo="Typo.h4">@L["Dashboard"]</MudText>

<MudDivider Class="mt-4 mb-4" />

<MudGrid>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 text-center">
            <MudText Typo="Typo.h5">@L["Projects"]</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">@(_data?.TotalProjects ?? 0)</MudChip>
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 text-center">
            <MudText Typo="Typo.h5">@L["Tasks"]</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">@(_data?.TotalTasks ?? 0)</MudChip>
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 text-center">
            <MudText Typo="Typo.h5">@L["InProgress"]</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("InProgress")" Variant="Variant.Filled">@(_data?.InProgress ?? 0)</MudChip>
            </MudText>
        </MudPaper>
    </MudItem>
    <MudItem xs="12" sm="6" md="3">
        <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 text-center">
            <MudText Typo="Typo.h5">@L["Completed"]</MudText>
            <MudText Typo="Typo.body1" Class="mt-2">
                <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("Done")" Variant="Variant.Filled">@(_data?.Done ?? 0)</MudChip>
            </MudText>
        </MudPaper>
    </MudItem>
</MudGrid>

<MudGrid Spacing="3" Class="mt-2">
    <MudItem xs="12" md="8">
        <MudText Typo="Typo.h6" Class="mb-3">@L["MyProjects"]</MudText>
        @if (_data is null || _data.Projects.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L["NoProjectsYet"]</MudAlert>
        }
        else
        {
            <MudGrid Spacing="3">
                @foreach (var p in _data.Projects)
                {
                    <MudItem xs="12" sm="6">
                        <MudPaper Elevation="0" Outlined="true" Class="beacon-card pa-4 h-100 beacon-card-interactive"
                                  @onclick="@(() => SwitchProject(p.Id))">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap">
                                <MudText Typo="Typo.h6" Class="grow beacon-ellipsis">@p.Name</MudText>
                                @if (p.Id == _activeProjectId)
                                {
                                    <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled">@L["Active"]</MudChip>
                                }
                            </MudStack>
                            @if (!string.IsNullOrWhiteSpace(p.Description))
                            {
                                <MudText Typo="Typo.body2" Class="mt-1 beacon-ellipsis">@p.Description</MudText>
                            }
                            <MudStack Row="true" Class="mt-3" Wrap="Wrap.Wrap">
                                <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("Todo")" Variant="Variant.Filled">@L["Todo"]: @p.Todo</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("InProgress")" Variant="Variant.Filled">@L["InProgress"]: @p.InProgress</MudChip>
                                <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus("Done")" Variant="Variant.Filled">@L["Done"]: @p.Done</MudChip>
                            </MudStack>
                            <MudText Typo="Typo.caption" Class="mt-2">@L["LastActivity"]: @p.LastActivity.ToString("dd.MM.yyyy")</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </MudItem>
    <MudItem xs="12" md="4">
        <MudText Typo="Typo.h6" Class="mb-3">@L["RecentActivity"]</MudText>
        @if (_data is null || _data.RecentTasks.Count == 0)
        {
            <MudText Typo="Typo.body2">@L["NoRecentActivity"]</MudText>
        }
        else
        {
            <MudPaper Elevation="0" Outlined="true" Class="beacon-card">
                <MudList T="string" Dense="true">
                    @foreach (var t in _data.RecentTasks)
                    {
                        <MudListItem T="string">
                            <MudStack Row="true" AlignItems="AlignItems.Center" Wrap="Wrap.NoWrap">
                                <MudText Typo="Typo.body2" Class="grow beacon-ellipsis">@t.Title</MudText>
                                <MudChip T="string" Size="Size.Small" Color="@ChipPalette.ForStatus(t.Status.ToString())" Variant="Variant.Filled">@StatusText(t.Status)</MudChip>
                            </MudStack>
                            <MudText Typo="Typo.caption">@t.ProjectName · @t.ActivityAt.ToString("dd.MM HH:mm")</MudText>
                        </MudListItem>
                    }
                </MudList>
            </MudPaper>
        }
    </MudItem>
</MudGrid>

<MudButton Variant="Variant.Filled" Color="Color.Primary"
          OnClick="@(() => Navigation.NavigateTo("/board"))"
          Class="mt-6">
    @L["GoToBoard"]
</MudButton>

@code {
    private ListMyProjectsDto? _data;
    private Guid? _activeProjectId;

    protected override async Task OnInitializedAsync()
    {
        var state = await Auth.GetAuthenticationStateAsync();
        var user = state.User;
        if (user.Identity?.IsAuthenticated != true
            || !Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var uid))
            return;

        if (Guid.TryParse(user.FindFirst("project_id")?.Value, out var active))
            _activeProjectId = active;

        var isAdmin = bool.TryParse(user.FindFirst("isAdmin")?.Value, out var flag) && flag;
        var result = await MyProjects.HandleAsync(uid, isAdmin);
        if (result.Success)
            _data = result.Value;
    }

    private string StatusText(TaskItemStatus status) => status switch
    {
        TaskItemStatus.InProgress => L["InProgress"].Value,
        TaskItemStatus.Done => L["Done"].Value,
        _ => L["Todo"].Value
    };

    private void SwitchProject(Guid projectId) =>
        Navigation.NavigateTo($"/project/switch?projectId={projectId}&returnUrl=/dashboard", forceLoad: true);
}
