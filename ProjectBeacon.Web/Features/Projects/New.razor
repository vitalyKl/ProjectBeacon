@page "/projects/new"
@layout MainLayout
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Devices
@using ProjectBeacon.Application.Identity
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject CreateOrgHandler CreateOrg
@inject CreateProjectHandler CreateProject
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ListDevicesHandler ListDevices
@inject EnqueueCommandHandler EnqueueCommand
@inject GetCommandHandler GetCommand
@inject AttachRuntimeHandler AttachRuntime

<PageHeader Title="@L["CreateProject"]" />

<MudPaper Elevation="0" Outlined="true" Class="beacon-panel beacon-form">
    <MudText Typo="Typo.subtitle2">1. @L["CreateProjectStepNames"]</MudText>
    <MudTextField @bind-Value="_projectName" Label="@L["ProjectName"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
    <MudTextField @bind-Value="_orgName" Label="@L["OrgName"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" HelperText="@L["OrgNameHint"]" />
    <MudTextField @bind-Value="_description" Label="@L["Description"]" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />

    <MudText Typo="Typo.subtitle2" Class="mt-6">2. @L["CreateProjectStepDevice"]</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["RuntimeDeviceHint"]</MudText>
    @if (_devices.Count == 0)
    {
        <MudAlert Severity="Severity.Info" Class="mt-2">
            @L["NoDeviceForProject"]
            <MudButton Variant="Variant.Text" Size="Size.Small" Href="/settings">@L["Settings"]</MudButton>
        </MudAlert>
    }
    else
    {
        <MudSelect T="Guid?" Value="_deviceId" ValueChanged="OnDeviceChanged" Label="@L["RuntimeDevice"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" Clearable="true">
            @foreach (var device in _devices)
            {
                <MudSelectItem Value="@((Guid?)device.Id)">@device.Name (@(device.Online ? L["DeviceOnline"].Value : L["DeviceOffline"].Value))</MudSelectItem>
            }
        </MudSelect>
        @if (SelectedDevice is { Online: false })
        {
            <MudAlert Severity="Severity.Warning" Class="mt-2">@L["DeviceOfflineHint"]</MudAlert>
        }
    }

    <MudText Typo="Typo.subtitle2" Class="mt-6">3. @L["CreateProjectStepFolder"]</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["BrowseOnDeviceHint"]</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["FolderOptionalHint"]</MudText>
    <div class="mt-2">
        <FolderPicker DeviceId="_deviceId" UserId="_userId" Path="_localRoot" PathChanged="OnPathChanged"
                      Disabled="_saving || SelectedDevice is not { Online: true }" Label="@L["ProjectDirectory"]" />
    </div>
    <MudCheckBox @bind-Value="_initOnDevice" Label="@L["InitializeOnDevice"]" Class="mt-2" />
    <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["InitializeOnDeviceHint"]</MudText>

    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="Create" Disabled="_saving">
        @L["Create"]
    </MudButton>
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
    }
</MudPaper>

@code {
    private string _orgName = string.Empty;
    private string _projectName = string.Empty;
    private string? _description;
    private string? _error;
    private bool _saving;
    private Guid _userId;
    private Guid? _deviceId;
    private string _localRoot = string.Empty;
    private bool _initOnDevice = true;
    private List<DaemonDeviceDto> _devices = [];

    private DaemonDeviceDto? SelectedDevice => _devices.FirstOrDefault(d => d.Id == _deviceId);

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            _userId = id;
        if (_userId == Guid.Empty) return;
        var listed = await ListDevices.HandleAsync(new ListDevicesCommand(new ListDevicesRequest(_userId)));
        _devices = listed.Success ? listed.Value!.ToList() : [];
        var online = _devices.FirstOrDefault(d => d.Online);
        if (online is not null)
            await OnDeviceChanged(online.Id);
    }

    private Task OnPathChanged(string path)
    {
        _localRoot = path;
        return Task.CompletedTask;
    }

    private Task OnDeviceChanged(Guid? id)
    {
        _deviceId = id;
        if (string.IsNullOrWhiteSpace(_localRoot) && id is { } deviceId)
        {
            var root = ProjectsRootOf(_devices.FirstOrDefault(d => d.Id == deviceId));
            if (!string.IsNullOrWhiteSpace(root))
                _localRoot = root;
        }
        return Task.CompletedTask;
    }

    private static string ProjectsRootOf(DaemonDeviceDto? device)
    {
        if (device is null || string.IsNullOrWhiteSpace(device.WorkstationJson))
            return "";
        try
        {
            using var doc = JsonDocument.Parse(device.WorkstationJson);
            return doc.RootElement.TryGetProperty("projectsRoot", out var p) && p.ValueKind == JsonValueKind.String
                ? p.GetString() ?? ""
                : "";
        }
        catch (JsonException)
        {
            return "";
        }
    }

    private async Task Create()
    {
        _error = null;
        _saving = true;
        try
        {
            var orgName = string.IsNullOrWhiteSpace(_orgName) ? _projectName : _orgName;
            var org = await CreateOrg.HandleAsync(new CreateOrgCommand(new CreateOrgRequest(orgName, null, _userId)));
            if (!org.Success)
            {
                _error = org.Error;
                return;
            }

            var project = await CreateProject.HandleAsync(new CreateProjectCommand(new CreateProjectRequest(
                _projectName, _description, org.Value.Id, _userId)));
            if (!project.Success)
            {
                _error = project.Error;
                return;
            }

            if (_deviceId is { } deviceId && !string.IsNullOrWhiteSpace(_localRoot))
            {
                var attached = await AttachRuntime.HandleAsync(new AttachRuntimeCommand(
                    new AttachRuntimeRequest(project.Value.Id, deviceId, _userId, _localRoot)));
                if (!attached.Success)
                {
                    _error = attached.Error;
                    return;
                }
                if (_initOnDevice)
                {
                    var payload = JsonSerializer.Serialize(new
                    {
                        path = _localRoot,
                        createGit = true,
                        historyInProject = true,
                        mcp = new Dictionary<string, object>
                        {
                            ["beacon"] = new
                            {
                                type = "local",
                                command = new[] { "beacon", "mcp", "--root", _localRoot },
                                enabled = true
                            }
                        }
                    });
                    var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
                        new EnqueueCommandRequest(deviceId, _userId, WorkstationCommandKind.InitProject, payload, project.Value.Id)));
                    if (!queued.Success)
                    {
                        _error = queued.Error;
                        return;
                    }
                    var finished = await WaitAsync(queued.Value!.Id);
                    if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded)
                    {
                        _error = finished?.Error ?? L["Error"].Value;
                        return;
                    }
                }
            }

            Snackbar.Add(L["ProjectCreated"].Value, Severity.Success);
            Navigation.NavigateTo($"/project/switch?projectId={project.Value.Id}&returnUrl={Uri.EscapeDataString("/board")}", forceLoad: true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task<WorkstationCommandDto?> WaitAsync(Guid commandId)
    {
        for (var i = 0; i < 40; i++)
        {
            var got = await GetCommand.HandleAsync(new GetCommandCommand(new GetCommandRequest(commandId, _userId)));
            if (!got.Success)
                return null;
            if (got.Value!.Status is WorkstationCommandStatus.Succeeded or WorkstationCommandStatus.Failed or WorkstationCommandStatus.Cancelled)
                return got.Value;
            await Task.Delay(500);
        }
        return null;
    }
}
