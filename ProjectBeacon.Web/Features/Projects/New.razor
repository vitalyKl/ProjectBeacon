@page "/projects/new"
@layout MainLayout
@attribute [Authorize]
@using ProjectBeacon.Application.Identity
@using ProjectBeacon.Application.Projects
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject CreateOrgHandler CreateOrg
@inject CreateProjectHandler CreateProject
@inject NavigationManager Navigation
@inject ISnackbar Snackbar

<MudText Typo="Typo.h4">@L["CreateProject"]</MudText>

<MudPaper Class="pa-6 mt-4" Elevation="0" Outlined="true" Style="max-width: 520px;">
    <MudTextField @bind-Value="_orgName" Label="@L["OrgName"]" Required="true" />
    <MudTextField @bind-Value="_projectName" Label="@L["ProjectName"]" Required="true" Class="mt-2" />
    <MudTextField @bind-Value="_description" Label="@L["Description"]" Lines="3" Class="mt-2" />
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="Create" Disabled="_saving">
        @L["Create"]
    </MudButton>
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
    }
</MudPaper>

@code {
    private string _orgName = string.Empty;
    private string _projectName = string.Empty;
    private string? _description;
    private string? _error;
    private bool _saving;

    private async Task Create()
    {
        _error = null;
        _saving = true;
        try
        {
            var org = await CreateOrg.HandleAsync(new CreateOrgCommand(new CreateOrgRequest(_orgName, null)));
            if (!org.Success)
            {
                _error = org.Error;
                return;
            }

            var project = await CreateProject.HandleAsync(new CreateProjectCommand(new CreateProjectRequest(
                _projectName, _description, org.Value.Id)));
            if (!project.Success)
            {
                _error = project.Error;
                return;
            }

            Snackbar.Add(L["ProjectCreated"].Value, Severity.Success);
            Navigation.NavigateTo("/board");
        }
        finally
        {
            _saving = false;
        }
    }
}
