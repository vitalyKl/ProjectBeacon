@page "/projects/new"
@layout MainLayout
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Devices
@using ProjectBeacon.Application.Identity
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject CreateOrgHandler CreateOrg
@inject CreateProjectHandler CreateProject
@inject AuthenticationStateProvider Auth
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject ListDevicesHandler ListDevices
@inject EnqueueCommandHandler EnqueueCommand
@inject GetCommandHandler GetCommand
@inject AttachRuntimeHandler AttachRuntime

<PageHeader Title="@L["CreateProject"]" />

<MudPaper Elevation="0" Outlined="true" Class="beacon-panel beacon-form">
    <MudTextField @bind-Value="_orgName" Label="@L["OrgName"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
    <MudTextField @bind-Value="_projectName" Label="@L["ProjectName"]" Required="true" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
    <MudTextField @bind-Value="_description" Label="@L["Description"]" Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
    <MudSelect T="Guid?" @bind-Value="_deviceId" Label="@L["RuntimeDevice"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" Clearable="true">
        @foreach (var device in _devices)
        {
            <MudSelectItem Value="@((Guid?)device.Id)">@device.Name (@(device.Online ? L["DeviceOnline"].Value : L["DeviceOffline"].Value))</MudSelectItem>
        }
    </MudSelect>
    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mt-2">
        <MudTextField @bind-Value="_localRoot" Label="@L["ProjectDirectory"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1" />
        <MudButton Variant="Variant.Outlined" OnClick="Browse" Disabled="_saving || SelectedDevice is not { Online: true }">@L["Browse"]</MudButton>
    </MudStack>
    <MudCheckBox @bind-Value="_initOnDevice" Label="@L["InitializeOnDevice"]" Class="mt-2" />
    @if (_browse is not null)
    {
        <MudPaper Outlined="true" Class="mt-3 pa-3">
            <MudText Typo="Typo.caption">@_browse.Path</MudText>
            <MudStack Row="true" Spacing="2" Class="mt-2">
                <MudButton Size="Size.Small" OnClick="BrowseParent" Disabled="string.IsNullOrEmpty(_browse.Parent)">@L["ParentDirectory"]</MudButton>
                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="SelectBrowseFolder">@L["SelectFolder"]</MudButton>
            </MudStack>
            <MudList T="string" Dense="true" Class="mt-2">
                @foreach (var entry in _browse.Entries.Where(e => e.IsDirectory))
                {
                    <MudListItem T="string" OnClick="() => BrowseTo(entry.Path)">@entry.Name</MudListItem>
                }
            </MudList>
        </MudPaper>
    }
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="Create" Disabled="_saving">
        @L["Create"]
    </MudButton>
    @if (!string.IsNullOrEmpty(_error))
    {
        <MudAlert Severity="Severity.Error" Class="mt-2">@_error</MudAlert>
    }
</MudPaper>

@code {
    private string _orgName = string.Empty;
    private string _projectName = string.Empty;
    private string? _description;
    private string? _error;
    private bool _saving;
    private Guid _userId;
    private Guid? _deviceId;
    private string _localRoot = string.Empty;
    private bool _initOnDevice = true;
    private List<DaemonDeviceDto> _devices = [];
    private DirListing? _browse;

    private DaemonDeviceDto? SelectedDevice => _devices.FirstOrDefault(d => d.Id == _deviceId);

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            _userId = id;
        if (_userId == Guid.Empty) return;
        var listed = await ListDevices.HandleAsync(new ListDevicesCommand(new ListDevicesRequest(_userId)));
        _devices = listed.Success ? listed.Value!.ToList() : [];
        var online = _devices.FirstOrDefault(d => d.Online);
        if (online is not null)
            _deviceId = online.Id;
    }

    private async Task Create()
    {
        _error = null;
        _saving = true;
        try
        {
            var org = await CreateOrg.HandleAsync(new CreateOrgCommand(new CreateOrgRequest(_orgName, null, _userId)));
            if (!org.Success)
            {
                _error = org.Error;
                return;
            }

            var project = await CreateProject.HandleAsync(new CreateProjectCommand(new CreateProjectRequest(
                _projectName, _description, org.Value.Id, _userId)));
            if (!project.Success)
            {
                _error = project.Error;
                return;
            }

            if (_deviceId is { } deviceId && !string.IsNullOrWhiteSpace(_localRoot))
            {
                var attached = await AttachRuntime.HandleAsync(new AttachRuntimeCommand(
                    new AttachRuntimeRequest(project.Value.Id, deviceId, _userId, _localRoot)));
                if (!attached.Success)
                {
                    _error = attached.Error;
                    return;
                }
                if (_initOnDevice)
                {
                    var payload = JsonSerializer.Serialize(new
                    {
                        path = _localRoot,
                        createGit = true,
                        historyInProject = true,
                        mcp = new Dictionary<string, object>
                        {
                            ["beacon"] = new
                            {
                                type = "local",
                                command = new[] { "beacon", "mcp", "--root", _localRoot },
                                enabled = true
                            }
                        }
                    });
                    var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
                        new EnqueueCommandRequest(deviceId, _userId, WorkstationCommandKind.InitProject, payload, project.Value.Id)));
                    if (!queued.Success)
                    {
                        _error = queued.Error;
                        return;
                    }
                    var finished = await WaitAsync(queued.Value!.Id);
                    if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded)
                    {
                        _error = finished?.Error ?? L["Error"].Value;
                        return;
                    }
                }
            }

            Snackbar.Add(L["ProjectCreated"].Value, Severity.Success);
            Navigation.NavigateTo("/board", forceLoad: true);
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task Browse()
    {
        await BrowseTo(_localRoot);
    }

    private Task BrowseParent() => BrowseTo(_browse?.Parent);

    private Task SelectBrowseFolder()
    {
        if (_browse is not null)
            _localRoot = _browse.Path;
        return Task.CompletedTask;
    }

    private async Task BrowseTo(string? path)
    {
        _error = null;
        if (_deviceId is not { } deviceId)
        {
            _error = L["DeviceRequiredForBrowse"].Value;
            return;
        }
        var payload = JsonSerializer.Serialize(new { path = path ?? "" });
        var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
            new EnqueueCommandRequest(deviceId, _userId, WorkstationCommandKind.ListDir, payload, null)));
        if (!queued.Success)
        {
            _error = queued.Error;
            return;
        }
        var finished = await WaitAsync(queued.Value!.Id);
        if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded || string.IsNullOrEmpty(finished.ResultJson))
        {
            _error = finished?.Error ?? L["Error"].Value;
            return;
        }
        _browse = JsonSerializer.Deserialize<DirListing>(finished.ResultJson, new JsonSerializerOptions { PropertyNameCaseInsensitive = true });
    }

    private async Task<WorkstationCommandDto?> WaitAsync(Guid commandId)
    {
        for (var i = 0; i < 40; i++)
        {
            var got = await GetCommand.HandleAsync(new GetCommandCommand(new GetCommandRequest(commandId, _userId)));
            if (!got.Success)
                return null;
            if (got.Value!.Status is WorkstationCommandStatus.Succeeded or WorkstationCommandStatus.Failed or WorkstationCommandStatus.Cancelled)
                return got.Value;
            await Task.Delay(500);
        }
        return null;
    }

    private sealed class DirListing
    {
        public string Path { get; set; } = "";
        public string? Parent { get; set; }
        public List<DirEntry> Entries { get; set; } = [];
    }

    private sealed class DirEntry
    {
        public string Name { get; set; } = "";
        public string Path { get; set; } = "";
        public bool IsDirectory { get; set; }
    }
}
