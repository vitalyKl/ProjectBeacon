@page "/project/settings"
@layout MainLayout
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Context
@using ProjectBeacon.Application.Devices
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Proposals
@using ProjectBeacon.Application.Persistence
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject AuthenticationStateProvider Auth
@inject GetCurrentProjectHandler CurrentProject
@inject ListDevicesHandler ListDevices
@inject ListRuntimesHandler ListRuntimes
@inject GetRuntimeDiagnosticsHandler GetDiagnostics
@inject AttachRuntimeHandler AttachRuntime
@inject ListMyProjectsHandler MyProjects
@inject UpdateProjectHandler UpdateProject
@inject ListContentVersionsHandler ContentVersions
@inject RestoreContentVersionHandler RestoreContentVersion
@inject ListProposalPoliciesHandler ListProposalPolicies
@inject SetProposalPolicyHandler SetProposalPolicy
@inject ProjectBeacon.Application.Authorization.IAuthorizationService Authorization
@inject IBeaconDbFactory DbFactory
@inject DeleteProjectHandler DeleteProject
@inject EnqueueProjectGitSyncHandler EnqueueGitSync
@inject GetProjectGitSyncCommandHandler GetGitSyncCommand
@inject ISnackbar Snackbar
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>@L["ProjectSettings"]</PageTitle>
<PageHeader Title="@L["ProjectSettings"]" />

<MudText Typo="Typo.h6" Class="mb-1">@L["Projects"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["ProjectManageLead"]</MudText>
<MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mb-4" Href="/projects/new">@L["CreateProject"]</MudButton>

@if (_projects.Count > 0)
{
    <MudTable Items="_projects" Dense="true" Hover="true" Class="mb-4">
        <HeaderContent>
            <MudTh>@L["ProjectName"]</MudTh>
            <MudTh>@L["Description"]</MudTh>
            <MudTh></MudTh>
        </HeaderContent>
        <RowTemplate>
            <MudTd DataLabel="@L["ProjectName"]">
                @context.Name
                @if (context.Id == _projectId)
                {
                    <span class="beacon-state is-info ml-2">@L["CurrentProject"]</span>
                }
            </MudTd>
            <MudTd DataLabel="@L["Description"]">
                @if (string.IsNullOrWhiteSpace(context.Description))
                {
                    <MudText Typo="Typo.caption">—</MudText>
                }
                else
                {
                    <MarkdownView Text="@context.Description" MaxHeight="96" />
                }
            </MudTd>
            <MudTd>
                @if (context.Id != _projectId)
                {
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="@(() => OpenProject(context.Id))">@L["OpenProject"]</MudButton>
                }
                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="@(() => RemoveProject(context.Id, context.Name))">@L["Delete"]</MudButton>
            </MudTd>
        </RowTemplate>
    </MudTable>
}

@if (_projectId is null)
{
    <MudText Typo="Typo.body2" Class="mud-text-secondary mb-4">@L["NoProjectsYet"]</MudText>
}
else
{
    <MudText Typo="Typo.h6" Class="mb-3">@L["ThisProject"]</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <div class="beacon-form">
            <MudTextField @bind-Value="_projectName" InputId="project-name" Label="@L["ProjectName"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" />
            <MarkdownEditor @bind-Value="_projectDescription" Label="@L["Description"]" Lines="5" Class="mt-3" />
            <MudButton Size="Size.Small" Variant="Variant.Text" StartIcon="@Icons.Material.Filled.History"
                       OnClick="LoadProjectDescriptionHistory" Disabled="_busy">
                @L["ContentHistory"]
            </MudButton>
            @if (_showProjectDescriptionHistory)
            {
                <MudExpansionPanels Elevation="0" Outlined="true" Class="mt-2">
                    <MudExpansionPanel Text="@($"{L["ContentHistory"]} ({_projectDescriptionHistory.Count})")" Expanded="true">
                        @if (_projectDescriptionHistory.Count == 0)
                        {
                            <MudText Typo="Typo.caption">@L["NoHistory"]</MudText>
                        }
                        @foreach (var version in _projectDescriptionHistory)
                        {
                            <MudPaper @key="version.Id" Elevation="0" Outlined="true" Class="pa-2 mb-2">
                                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2">
                                    <MudText Typo="Typo.subtitle2">rev. @version.Revision</MudText>
                                    <MudSpacer />
                                    <LocalTime Value="version.At" Format="g" />
                                </MudStack>
                                <MarkdownView Text="@ProjectDescriptionSnapshotMarkdown(version.ContentJson)" MaxHeight="140" />
                                <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                           data-testid="@($"restore-project-description-revision-{version.Revision}")"
                                           Disabled="_busy || version.Revision == _projectRevision"
                                           OnClick="() => RestoreProjectDescriptionVersion(version)">
                                    @L["RestoreRevision"]
                                </MudButton>
                            </MudPaper>
                        }
                    </MudExpansionPanel>
                </MudExpansionPanels>
            }
            <div class="beacon-field-row">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveProject" Disabled="_busy">@L["Save"]</MudButton>
                <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => RemoveProject(_projectId.Value, _projectName))" Disabled="_busy">@L["DeleteProject"]</MudButton>
            </div>
        </div>
    </MudPaper>

    <MudText Typo="Typo.subtitle1" Class="mb-1">@L["ProposalPoliciesTitle"]</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">@L["ProposalPoliciesHelp"]</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        @if (_proposalPolicies.Count == 0)
        {
            <MudText Typo="Typo.body2" Color="Color.Secondary">@L["ProposalPoliciesUnavailable"]</MudText>
        }
        else
        {
            <MudTable Items="_proposalPolicies" Dense="true" Hover="true" Elevation="0">
                <HeaderContent>
                    <MudTh>@L["TargetKind"]</MudTh>
                    <MudTh>@L["Operation"]</MudTh>
                    <MudTh>@L["DecisionMode"]</MudTh>
                    <MudTh>@L["PolicyRestriction"]</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["TargetKind"]">@context.TargetKind</MudTd>
                    <MudTd DataLabel="@L["Operation"]">@context.Operation</MudTd>
                    <MudTd DataLabel="@L["DecisionMode"]">
                        <MudSelect T="ProposalDecisionMode"
                                   Value="@GetProposalPolicyMode(context)"
                                   ValueChanged="@(mode => SetProposalPolicyMode(context, mode))"
                                   Disabled="@(!_canEditProposalPolicies || !context.AutoAllowed || _proposalPolicyBusy)"
                                   Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined">
                            <MudSelectItem T="ProposalDecisionMode" Value="ProposalDecisionMode.Manual">@L["Manual"]</MudSelectItem>
                            @if (context.AutoAllowed)
                            {
                                <MudSelectItem T="ProposalDecisionMode" Value="ProposalDecisionMode.Auto">@L["Auto"]</MudSelectItem>
                            }
                        </MudSelect>
                    </MudTd>
                    <MudTd DataLabel="@L["PolicyRestriction"]">
                        @if (!string.IsNullOrWhiteSpace(context.RestrictionReason))
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.RestrictionReason</MudText>
                        }
                        else if (!_canEditProposalPolicies)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@L["GovernanceOwnerAdminOnly"]</MudText>
                        }
                    </MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Primary"
                                   Disabled="@(!_canEditProposalPolicies || !context.Supported || !context.AutoAllowed || _proposalPolicyBusy || GetProposalPolicyMode(context) == context.Mode)"
                                   OnClick="@(() => SaveProposalPolicy(context))">
                            @L["Save"]
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
            @if (!_canEditProposalPolicies)
            {
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-2">@L["ProposalPoliciesOwnerAdminHint"]</MudText>
            }
        }
    </MudPaper>

    <MudText Typo="Typo.subtitle1" Class="mb-1">@L["ProjectFolder"]</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">@L["ScopeProjectHint"]</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["BrowseOnDeviceHint"]</MudText>
        @if (_runtimes.Count > 0)
        {
            @if (_primaryLocalRoot is not null)
            {
                <MudText Typo="Typo.body2" Class="mb-2">@_runtimes[0].DeviceName: @_primaryLocalRoot</MudText>
            }
            else
            {
                <MudText Typo="Typo.body2" Class="mb-2">@_runtimes[0].DeviceName</MudText>
            }
        }
        <div class="beacon-form">
            <MudSelect T="Guid?" @bind-Value="_folderDeviceId" Label="@L["RuntimeDevice"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var device in _devices)
                {
                    <MudSelectItem Value="@((Guid?)device.Id)">@device.Name (@(device.Online ? L["DeviceOnline"].Value : L["DeviceOffline"].Value))</MudSelectItem>
                }
            </MudSelect>
            <div class="mt-2">
                <FolderPicker DeviceId="_folderDeviceId" UserId="_userId" Path="@_folderPath" PathChanged="OnFolderPathChanged"
                              AdvancedPath="true" Disabled="_busy || FolderDevice is not { Online: true }" Label="@L["ProjectDirectory"]" />
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveProjectFolder"
                       Disabled="_busy || _folderDeviceId is null || string.IsNullOrWhiteSpace(_folderPath)">
                @L["AttachFolder"]
            </MudButton>
        </div>
    </MudPaper>


    <MudText Typo="Typo.subtitle1" Class="mb-1">@L["GitSyncTitle"]</MudText>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">@L["GitSyncHelp"]</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <div class="beacon-field-row">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="@(() => RunGitSync(GitSyncMode.Status))"
                       Disabled="@(_gitSyncBusy || !HasGitSyncWorkstation)">
                @L["GitSyncCheck"]
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => RunGitSync(GitSyncMode.PullFastForward))"
                       Disabled="@(_gitSyncBusy || !HasGitSyncWorkstation)">
                @L["GitSyncNow"]
            </MudButton>
        </div>
        @if (_gitSyncBusy)
        {
            <MudProgressLinear Indeterminate="true" Class="mt-3" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@L["GitSyncWorking"]</MudText>
        }
        @if (_gitSyncResult is not null)
        {
            <MudAlert Severity="@GitSyncSeverity" Dense="true" Class="mt-3">
                <MudText Typo="Typo.body2"><b>@L["GitSyncBranch"]:</b> @(_gitSyncResult.Branch ?? "—")</MudText>
                <MudText Typo="Typo.body2"><b>@L["GitSyncUpstream"]:</b> @(_gitSyncResult.Upstream ?? "—")</MudText>
                <MudText Typo="Typo.body2">
                    @L["GitSyncAhead"]: @_gitSyncResult.Ahead · @L["GitSyncBehind"]: @_gitSyncResult.Behind
                </MudText>
                <MudText Typo="Typo.body2">@( _gitSyncResult.Clean ? L["GitSyncClean"] : L["GitSyncDirty"] )</MudText>
                <MudText Typo="Typo.body2">@GitSyncOutcomeText</MudText>
                @if (_gitSyncResult.ReasonCode is { } reason)
                {
                    <MudText Typo="Typo.body2" Class="mt-1">@GitSyncReasonText(reason)</MudText>
                }
                @if (!string.IsNullOrWhiteSpace(_gitSyncResult.Stderr))
                {
                    <MudText Typo="Typo.caption" Class="mt-1">@_gitSyncResult.Stderr</MudText>
                }
            </MudAlert>
        }
        @if (_gitSyncCommandPending)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@L["GitSyncStillRunning"]</MudText>
        }
        @if (!HasGitSyncWorkstation)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@L["GitSyncNoCompatibleDevice"]</MudText>
        }
    </MudPaper>

    <ProjectMembersPanel ProjectId="_projectId" UserId="_userId" Actor="_actor" @bind-Busy="_busy" />
    <ProjectLabelsPanel ProjectId="_projectId" @bind-Busy="_busy" />
}

@code {
    private List<DaemonDeviceDto> _devices = [];
    private List<RuntimeSummary> _runtimes = [];
    private string? _primaryLocalRoot;
    private Guid? _projectId;
    private Guid _userId;
    private bool _isAdmin;
    private ActorContext _actor = ActorContext.Anonymous;
    private bool _busy;
    private bool _canEditProposalPolicies;
    private bool _proposalPolicyBusy;
    private List<ProposalPolicyDto> _proposalPolicies = [];
    private readonly Dictionary<string, ProposalDecisionMode> _proposalPolicyEdits = new(StringComparer.Ordinal);
    private List<ProjectSummaryDto> _projects = [];
    private string _projectName = string.Empty;
    private string _projectDescription = string.Empty;
    private int _projectRevision;
    private bool _showProjectDescriptionHistory;
    private List<ContentVersionDto> _projectDescriptionHistory = [];
    private Guid? _folderDeviceId;
    private string _folderPath = string.Empty;
    private GitSyncResultDto? _gitSyncResult;
    private bool _gitSyncBusy;
    private bool _gitSyncCommandPending;

    private bool HasGitSyncWorkstation =>
        _runtimes.Any(runtime => runtime.DeviceOnline && runtime.GitSyncSupported);

    private Severity GitSyncSeverity => _gitSyncResult?.Outcome switch
    {
        GitSyncOutcome.Failed => Severity.Error,
        GitSyncOutcome.Refused => Severity.Warning,
        GitSyncOutcome.FastForwarded => Severity.Success,
        _ => Severity.Info
    };

    private string GitSyncOutcomeText => _gitSyncResult?.Outcome switch
    {
        GitSyncOutcome.FastForwarded => L["GitSyncOutcomeFastForwarded"].Value,
        GitSyncOutcome.Refused => L["GitSyncOutcomeRefused"].Value,
        GitSyncOutcome.Failed => L["GitSyncOutcomeFailed"].Value,
        _ => L["GitSyncOutcomeUpToDate"].Value
    };

    private string GitSyncReasonText(GitSyncRefusalCode reason) =>
        L["GitSyncReason" + reason].Value;

    private DaemonDeviceDto? FolderDevice => _devices.FirstOrDefault(d => d.Id == _folderDeviceId);

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        _actor = ActorContextFactory.FromPrincipal(user);
        if (Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            _userId = id;
        _isAdmin = bool.TryParse(user.FindFirst("isAdmin")?.Value, out var adminFlag) && adminFlag;
        if (_userId != Guid.Empty)
        {
            var listed = await ListDevices.HandleAsync(new ListDevicesCommand(new ListDevicesRequest(_userId)));
            _devices = listed.Success ? listed.Value!.ToList() : [];
        }
        await ReloadProjects();
        var current = await CurrentProject.HandleAsync(_actor);
        if (current.Value is null)
            return;
        _projectId = current.Value.Id;
        _projectName = current.Value.Name;
        _projectDescription = current.Value.Description ?? string.Empty;
        _projectRevision = current.Value.Revision;
        await ReloadRuntimes();
        await ReloadProposalPolicies();
    }

    private async Task ReloadProposalPolicies()
    {
        _proposalPolicies = [];
        _proposalPolicyEdits.Clear();
        _canEditProposalPolicies = false;
        if (_projectId is not { } projectId)
            return;

        var result = await ListProposalPolicies.HandleAsync(projectId, _actor);
        if (!result.Success || result.Value is null)
        {
            Snackbar.Add(result.Error ?? L["ProposalPoliciesUnavailable"].Value, Severity.Warning);
            return;
        }

        _proposalPolicies = result.Value.ToList();
        foreach (var policy in _proposalPolicies)
            _proposalPolicyEdits[ProposalPolicyKey(policy)] = policy.Mode;

        await using var db = DbFactory.CreateDbContext();
        var permission = await Authorization.CanAsync(
            db, _actor, ResourceType.Project, AuthAction.Administer, projectId: projectId);
        _canEditProposalPolicies = permission.Success;
    }

    private static string ProposalPolicyKey(ProposalPolicyDto policy) =>
        $"{policy.TargetKind}:{policy.Operation}";

    private ProposalDecisionMode GetProposalPolicyMode(ProposalPolicyDto policy) =>
        _proposalPolicyEdits.TryGetValue(ProposalPolicyKey(policy), out var mode) ? mode : policy.Mode;

    private void SetProposalPolicyMode(ProposalPolicyDto policy, ProposalDecisionMode mode)
    {
        if (policy.AutoAllowed && _canEditProposalPolicies)
            _proposalPolicyEdits[ProposalPolicyKey(policy)] = mode;
    }

    private async Task SaveProposalPolicy(ProposalPolicyDto policy)
    {
        if (_projectId is not { } projectId || !_canEditProposalPolicies || _proposalPolicyBusy)
            return;
        var selected = GetProposalPolicyMode(policy);
        if (selected == policy.Mode)
            return;

        _proposalPolicyBusy = true;
        try
        {
            var saved = await SetProposalPolicy.HandleAsync(new SetProposalPolicyCommand(
                projectId, policy.TargetKind, policy.Operation, selected, policy.PolicyRevision, _actor));
            if (!saved.Success)
            {
                Snackbar.Add(saved.Error ?? L["Error"].Value, Severity.Error);
                await ReloadProposalPolicies();
                return;
            }

            Snackbar.Add(L["ProposalPolicySaved"].Value, Severity.Success);
            await ReloadProposalPolicies();
        }
        finally
        {
            _proposalPolicyBusy = false;
        }
    }

    private async Task ReloadProjects()
    {
        if (_userId == Guid.Empty)
            return;
        var listed = await MyProjects.HandleAsync(_userId, _isAdmin);
        _projects = listed.Success ? listed.Value!.Projects.ToList() : [];
    }

    private void OpenProject(Guid projectId)
    {
        Navigation.NavigateTo($"/project/switch?projectId={projectId}&returnUrl={Uri.EscapeDataString("/project/settings")}", forceLoad: true);
    }

    private async Task LoadProjectDescriptionHistory()
    {
        if (_projectId is not { } projectId)
            return;

        _showProjectDescriptionHistory = true;
        var history = await ContentVersions.HandleAsync(
            projectId, ContentTargetKind.ProjectDescription, projectId, _actor, 50);
        _projectDescriptionHistory = history.Success ? history.Value!.ToList() : [];
        if (!history.Success)
            Snackbar.Add(history.Error ?? L["Error"].Value, Severity.Warning);
    }

    private async Task RestoreProjectDescriptionVersion(ContentVersionDto version)
    {
        if (_projectId is not { } projectId || _busy)
            return;

        _busy = true;
        try
        {
            var restored = await RestoreContentVersion.HandleAsync(new RestoreContentVersionCommand(
                projectId,
                version.Id,
                _projectRevision,
                _actor,
                ContentTargetKind.ProjectDescription,
                projectId));
            if (!restored.Success)
            {
                Snackbar.Add(restored.Error ?? L["Error"].Value, Severity.Error);
                return;
            }

            var current = await CurrentProject.HandleAsync(_actor);
            if (!current.Success || current.Value is null)
            {
                Snackbar.Add(current.Error ?? L["Error"].Value, Severity.Error);
                return;
            }

            _projectName = current.Value.Name;
            _projectDescription = current.Value.Description ?? string.Empty;
            _projectRevision = current.Value.Revision;
            await LoadProjectDescriptionHistory();
            Snackbar.Add(L["RestoredRevision"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private static string ProjectDescriptionSnapshotMarkdown(string json)
    {
        try
        {
            using var document = JsonDocument.Parse(json);
            if (document.RootElement.TryGetProperty("description", out var description)
                && description.ValueKind == JsonValueKind.String)
                return description.GetString() ?? string.Empty;
            return string.Empty;
        }
        catch (JsonException)
        {
            return string.Empty;
        }
    }

    private async Task SaveProject()
    {
        if (_projectId is not { } projectId || _busy)
            return;
        if (string.IsNullOrWhiteSpace(_projectName))
        {
            Snackbar.Add(L["ProjectNameRequired"].Value, Severity.Error);
            return;
        }
        _busy = true;
        try
        {
            var saved = await UpdateProject.HandleAsync(new UpdateProjectCommand(
                new UpdateProjectRequest(projectId, _projectName.Trim(), _projectDescription, null, _projectRevision), _actor));
            if (!saved.Success)
            {
                Snackbar.Add(saved.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _projectName = saved.Value!.Name;
            _projectDescription = saved.Value.Description ?? string.Empty;
            _projectRevision = saved.Value.Revision;
            Snackbar.Add(L["ProjectRenamed"].Value, Severity.Success);
            await ReloadProjects();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveProject(Guid projectId, string name)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value,
            string.Format(L["DeleteProjectConfirm"].Value, name),
            yesText: L["Delete"].Value,
            cancelText: L["Cancel"].Value);
        if (confirmed != true || _busy)
            return;
        _busy = true;
        try
        {
            var deleted = await DeleteProject.HandleAsync(new DeleteProjectCommand(projectId, _actor));
            if (!deleted.Success)
            {
                Snackbar.Add(deleted.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            var next = _projects.FirstOrDefault(p => p.Id != projectId);
            if (projectId == _projectId && next is not null)
            {
                OpenProject(next.Id);
                return;
            }
            if (projectId == _projectId)
            {
                Navigation.NavigateTo("/projects/new", forceLoad: true);
                return;
            }
            Snackbar.Add(L["ProjectDeleted"].Value, Severity.Success);
            await ReloadProjects();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task OnFolderPathChanged(string path)
    {
        _folderPath = path;
        return Task.CompletedTask;
    }

    private async Task RunGitSync(GitSyncMode mode)
    {
        if (_projectId is not { } projectId || _userId == Guid.Empty || _gitSyncBusy)
            return;

        _gitSyncBusy = true;
        _gitSyncCommandPending = false;
        _gitSyncResult = null;
        try
        {
            var queued = await EnqueueGitSync.HandleAsync(projectId, _actor, mode);
            if (!queued.Success || queued.Value is null)
            {
                Snackbar.Add(queued.Error ?? L["Error"].Value, Severity.Error);
                return;
            }

            var commandId = queued.Value.Id;
            var deadline = DateTime.UtcNow.AddSeconds(65);
            while (DateTime.UtcNow < deadline)
            {
                await Task.Delay(TimeSpan.FromSeconds(1));
                var current = await GetGitSyncCommand.HandleAsync(projectId, commandId, _actor);
                if (!current.Success || current.Value is null)
                {
                    Snackbar.Add(current.Error ?? L["Error"].Value, Severity.Error);
                    return;
                }

                if (current.Value.Status == WorkstationCommandStatus.Failed)
                {
                    Snackbar.Add(current.Value.Error ?? L["Error"].Value, Severity.Error);
                    return;
                }

                if (current.Value.Status == WorkstationCommandStatus.Succeeded)
                {
                    if (!string.IsNullOrWhiteSpace(current.Value.ResultJson))
                    {
                        _gitSyncResult = JsonSerializer.Deserialize<GitSyncResultDto>(
                            current.Value.ResultJson, new JsonSerializerOptions(JsonSerializerDefaults.Web));
                    }
                    if (_gitSyncResult is null)
                    {
                        Snackbar.Add(L["Error"].Value, Severity.Error);
                        return;
                    }
                    if (_gitSyncResult.Outcome == GitSyncOutcome.FastForwarded)
                        Snackbar.Add(L["GitSyncOutcomeFastForwarded"].Value, Severity.Success);
                    else if (_gitSyncResult.Outcome is GitSyncOutcome.Refused or GitSyncOutcome.Failed)
                        Snackbar.Add(GitSyncReasonText(_gitSyncResult.ReasonCode ?? GitSyncRefusalCode.FetchFailed), Severity.Warning);
                    return;
                }
            }

            _gitSyncCommandPending = true;
            Snackbar.Add(L["GitSyncStillRunning"].Value, Severity.Info);
        }
        catch (JsonException)
        {
            Snackbar.Add(L["Error"].Value, Severity.Error);
        }
        finally
        {
            _gitSyncBusy = false;
        }
    }

    private async Task ReloadRuntimes()
    {
        _runtimes = [];
        if (_projectId is not { } projectId || _userId == Guid.Empty)
            return;
        var listed = await ListRuntimes.HandleAsync(new ListRuntimesCommand(new ListRuntimesRequest(projectId, _userId)));
        if (!listed.Success)
            return;
        _runtimes = listed.Value!.ToList();
        var current = _runtimes.FirstOrDefault();
        _primaryLocalRoot = null;
        if (current is not null)
        {
            _folderDeviceId ??= current.DeviceId;
            var diag = await GetDiagnostics.HandleAsync(new GetRuntimeDiagnosticsCommand(new GetRuntimeDiagnosticsRequest(current.Id, _userId)));
            if (diag.Success)
            {
                _primaryLocalRoot = diag.Value!.LocalRoot;
                if (string.IsNullOrWhiteSpace(_folderPath))
                    _folderPath = _primaryLocalRoot;
            }
        }
        _folderDeviceId ??= _devices.FirstOrDefault(d => d.Online)?.Id ?? _devices.FirstOrDefault()?.Id;
    }

    private async Task SaveProjectFolder()
    {
        if (_projectId is not { } projectId || _folderDeviceId is not { } deviceId || string.IsNullOrWhiteSpace(_folderPath) || _userId == Guid.Empty)
            return;
        _busy = true;
        try
        {
            var attached = await AttachRuntime.HandleAsync(new AttachRuntimeCommand(
                new AttachRuntimeRequest(projectId, deviceId, _userId, _folderPath)));
            if (!attached.Success)
            {
                Snackbar.Add(attached.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["ProjectFolderSaved"].Value, Severity.Success);
            await ReloadRuntimes();
        }
        finally
        {
            _busy = false;
        }
    }
}
