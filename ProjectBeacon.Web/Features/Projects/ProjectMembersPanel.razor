@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Identity
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetProjectMembersHandler ListMembers
@inject CreateProjectInviteHandler CreateInvite
@inject ListProjectInvitesHandler ListInvites
@inject RevokeProjectInviteHandler RevokeInvite
@inject IDialogService Dialogs
@inject ISnackbar Snackbar

<MudText Typo="Typo.subtitle1" Class="mb-3">@L["Members"]</MudText>
<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
    <div class="beacon-form">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Class="mb-3">
            <MudTextField @bind-Value="_inviteEmail" Label="@L["Email"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudSelect T="MemberRole" @bind-Value="_inviteRole" Label="@L["Role"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                <MudSelectItem Value="@MemberRole.Member">@L["RoleMember"]</MudSelectItem>
                <MudSelectItem Value="@MemberRole.Admin">@L["RoleAdmin"]</MudSelectItem>
                <MudSelectItem Value="@MemberRole.Owner">@L["RoleOwner"]</MudSelectItem>
            </MudSelect>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendInvite" Disabled="Busy">@L["InviteMember"]</MudButton>
        </MudStack>
    </div>
    @if (!string.IsNullOrEmpty(_inviteUrl))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">@L["InviteSent"] @_inviteUrl</MudAlert>
    }
    @if (_members.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L["NoMembersYet"]</MudAlert>
    }
    else
    {
        <MudTable Items="_members" Dense="true" Hover="true" Class="mb-3">
            <HeaderContent>
                <MudTh>@L["Username"]</MudTh>
                <MudTh>@L["Email"]</MudTh>
                <MudTh>@L["Role"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Username"]">@context.Login</MudTd>
                <MudTd DataLabel="@L["Email"]">@context.Email</MudTd>
                <MudTd DataLabel="@L["Role"]">@ChromeLabels.Role(L, context.Role)</MudTd>
            </RowTemplate>
        </MudTable>
    }
    @if (_invites.Count > 0)
    {
        <MudText Typo="Typo.subtitle2" Class="mb-2">@L["PendingInvites"]</MudText>
        <MudTable Items="_invites" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L["Email"]</MudTh>
                <MudTh>@L["Role"]</MudTh>
                <MudTh>@L["Status"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Email"]">@context.Email</MudTd>
                <MudTd DataLabel="@L["Role"]">@ChromeLabels.Role(L, context.Role)</MudTd>
                <MudTd DataLabel="@L["Status"]">@ChromeLabels.Invite(L, context.Status)</MudTd>
                <MudTd>
                    @if (context.Status == "Pending")
                    {
                        <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => Revoke(context)">@L["RevokeInvite"]</MudButton>
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    [Parameter] public Guid? ProjectId { get; set; }
    [Parameter] public Guid UserId { get; set; }
    [Parameter] public ActorContext Actor { get; set; } = ActorContext.Anonymous;
    [Parameter] public bool Busy { get; set; }
    [Parameter] public EventCallback<bool> BusyChanged { get; set; }

    private List<ProjectMemberDto> _members = [];
    private List<InviteListDto> _invites = [];
    private string _inviteEmail = string.Empty;
    private MemberRole _inviteRole = MemberRole.Member;
    private string? _inviteUrl;
    private Guid? _loadedFor;

    protected override async Task OnParametersSetAsync()
    {
        if (ProjectId == _loadedFor)
            return;
        _loadedFor = ProjectId;
        await Reload();
    }

    private async Task Reload()
    {
        if (ProjectId is not { } projectId || UserId == Guid.Empty)
            return;
        var listed = await ListMembers.HandleAsync(new GetProjectMembersCommand(new GetProjectMembersRequest(projectId)));
        _members = listed.Success ? listed.Value!.ToList() : [];
        var invites = await ListInvites.HandleAsync(new ListInvitesRequest(projectId, Actor));
        _invites = invites.Success ? invites.Value!.ToList() : [];
    }

    private async Task SendInvite()
    {
        if (ProjectId is not { } projectId || string.IsNullOrWhiteSpace(_inviteEmail) || Busy)
            return;
        await BusyChanged.InvokeAsync(true);
        try
        {
            var created = await CreateInvite.HandleAsync(new CreateProjectInviteRequest(
                projectId, _inviteEmail.Trim(), _inviteRole, Actor));
            if (!created.Success)
            {
                Snackbar.Add(created.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _inviteUrl = created.Value!.Url;
            _inviteEmail = string.Empty;
            Snackbar.Add(L["InviteSent"].Value, Severity.Success);
            await Reload();
        }
        finally
        {
            await BusyChanged.InvokeAsync(false);
        }
    }

    private async Task Revoke(InviteListDto invite)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, L["RevokeInvite"].Value,
            yesText: L["Delete"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true) return;
        var result = await RevokeInvite.HandleAsync(new RevokeInviteRequest(invite.Id, Actor));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await Reload();
    }
}
