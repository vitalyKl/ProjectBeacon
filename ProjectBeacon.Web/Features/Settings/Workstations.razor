    }

    private async Task SaveWorkstation()
    {
        if (_wsDeviceId is not { } deviceId || _userId == Guid.Empty) return;
        _busy = true;
        try
        {
            var payload = JsonSerializer.Serialize(new
            {
                revision = _wsRevision,
                modelsRoot = _modelsRoot,
                agentDataDir = _agentDataDir,
                projectsRoot = _projectsRoot,
                commandPolicy = _commandPolicy,
                pipelineTurnTimeoutMinutes = _pipelineTurnTimeoutMinutes,
                pipelineIdleTimeoutMinutes = _pipelineIdleTimeoutMinutes,
                contextResponseReserveTokens = _contextResponseReserveTokens,
                autoPullMode = _autoPullMode,
                autoSyncIntervalMinutes = Math.Clamp(_autoSyncIntervalMinutes, 2, 120),
                llamaSwapBin = _llamaSwapBin,
                llamaCppBin = _llamaCppBin
            });
            var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
                new EnqueueCommandRequest(deviceId, _userId, WorkstationCommandKind.SaveWorkstation, payload, null)));
            if (!queued.Success)
            {
                Notifications.Failure(queued, L["Workstations"].Value, L["Save"].Value);
                return;
            }
            var finished = await WaitAsync(queued.Value!.Id, operationLabel: L["Save"].Value);
            if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded)
            {
                NotifyCommandFailure(finished, L["Save"].Value, deviceId, queued.Value.Id);
                return;
            }
            Notifications.Add(L["WorkstationSaved"].Value, Severity.Success);
            // The next heartbeat reports the workstation's new settings. Refresh diagnostics
            // now, but do not overwrite the just-saved form with the previous heartbeat snapshot.
            await ReloadDevices(loadWorkstationSettings: false);
        }
        catch (Exception exception)
        {
            Notifications.ReportException(exception, "WorkstationCommandFailed", "save workstation settings", new { DeviceId = deviceId });
        }
        finally
        {
            _busy = false;
        }
    }

