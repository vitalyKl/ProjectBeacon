    private async Task CheckClientUpdate()
    {
        if (_wsDeviceId is not { } deviceId || _userId == Guid.Empty || _busy) return;
        _busy = true;
        try
        {
            var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
                new EnqueueCommandRequest(deviceId, _userId, WorkstationCommandKind.CheckClientUpdate, "{}", null)));
            if (!queued.Success)
            {
                Notifications.Failure(queued, L["Workstations"].Value, L["Check"].Value);
                return;
            }
            var finished = await WaitAsync(queued.Value!.Id, operationLabel: L["Check"].Value);
            if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded)
            {
                NotifyCommandFailure(finished, L["Check"].Value, deviceId, queued.Value.Id);
                return;
            }
            using var result = JsonDocument.Parse(string.IsNullOrWhiteSpace(finished.ResultJson) ? "{}" : finished.ResultJson);
            var root = result.RootElement;
            _clientCurrentVersion = JsonValue(root, "CurrentVersion", "currentVersion");
            _clientLatestVersion = JsonValue(root, "LatestVersion", "latestVersion");
            _clientUpdateAvailable = JsonBoolean(root, "UpdateAvailable", "updateAvailable");
            Notifications.Add(_clientUpdateAvailable == true ? L["DaemonUpdateAvailable"].Value : L["DaemonUpToDate"].Value,
                _clientUpdateAvailable == true ? Severity.Info : Severity.Success);
        }
        catch (Exception ex)
        {
            Notifications.ReportException(ex, "WorkstationCheckUpdateFailed", "check workstation update availability", new { DeviceId = deviceId });
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task UpdateClient()
    {
        if (_wsDeviceId is not { } deviceId || _userId == Guid.Empty || _busy || _clientUpdateAvailable != true) return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, string.Format(L["UpdateDaemonConfirm"].Value, _clientLatestVersion),
            yesText: L["UpdateDaemonNow"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true) return;
        var previousHeartbeat = _devices.FirstOrDefault(d => d.Id == deviceId)?.LastHeartbeatAt;
        var expectedVersion = _clientLatestVersion;
        _busy = true;
        _clientUpdateActive = true;
        _clientUpdatePercent = null;
        _clientUpdateMessage = L["CommandQueued"].Value;
        try
        {
            var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
                new EnqueueCommandRequest(deviceId, _userId, WorkstationCommandKind.UpdateClient, "{}", null)));
            if (!queued.Success)
            {
                Notifications.Failure(queued, L["Workstations"].Value, L["Update"].Value);
                return;
            }
            var finished = await WaitAsync(queued.Value!.Id, 660, L["Update"].Value);
            if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded)
            {
                NotifyCommandFailure(finished, L["Update"].Value, deviceId, queued.Value.Id);
                return;
            }
            _clientUpdateAvailable = null;
            _clientUpdateActive = true;
            _clientUpdatePercent = null;
            _clientUpdateMessage = L["WorkstationUpdateProgress"].Value;
            var restarted = await WaitForUpdatedClientAsync(deviceId, previousHeartbeat, expectedVersion);
            if (restarted)
                Notifications.Add(L["DaemonUpdateScheduled"].Value, Severity.Success);
            else
                Notifications.Add(L["WorkstationUpdatePending"].Value, Severity.Warning);
        }
        catch (Exception ex)
        {
            Notifications.ReportException(ex, "WorkstationUpdateFailed", "update workstation daemon", new { DeviceId = deviceId });
        }
        finally
        {
            _clientUpdateActive = false;
            _busy = false;
        }
    }

    private async Task<bool> WaitForUpdatedClientAsync(Guid deviceId, DateTime? previousHeartbeat, string expectedVersion)
    {
        string? lastReadError = null;
        string? lastReadErrorCode = null;
        for (var attempt = 0; attempt < 60; attempt++)
        {
            var listed = await ListDevices.HandleAsync(new ListDevicesCommand(new ListDevicesRequest(_userId)));
            if (listed.Success)
            {
                lastReadError = null;
                lastReadErrorCode = null;
                _devices = listed.Value!.ToList();
                var device = _devices.FirstOrDefault(d => d.Id == deviceId);
                var reportedVersion = device is null ? null : ReadClientVersion(device.ProbeJson);
                if (device?.LastHeartbeatAt is { } heartbeat
                    && (previousHeartbeat is null || heartbeat > previousHeartbeat.Value)
                    && reportedVersion is not null
                    && IsClientVersionAtLeast(reportedVersion, expectedVersion))
                {
                    _clientCurrentVersion = reportedVersion;
                    _clientUpdateMessage = string.Format(L["WorkstationUpdateReportedVersion"].Value, reportedVersion);
                    await InvokeAsync(StateHasChanged);
                    return true;
                }
            }

           else
            {
                lastReadError = listed.Error;
                lastReadErrorCode = listed.ErrorCode;
            }

 await InvokeAsync(StateHasChanged);
            await Task.Delay(1000);
        }

        _clientUpdateActive = false;
        _clientUpdateMessage = string.IsNullOrWhiteSpace(lastReadError)
            ? L["WorkstationUpdatePending"].Value
            : Notifications.FormatFailure(lastReadError, L["Workstations"].Value,
                lastReadErrorCode, L["Read"].Value, new { DeviceId = deviceId });
        await InvokeAsync(StateHasChanged);
        return false;
    }

    private static string? ReadClientVersion(string? probeJson)
    {
        using var document = JsonDocument.Parse(string.IsNullOrWhiteSpace(probeJson) ? "{}" : probeJson);
        return document.RootElement.TryGetProperty("clientVersion", out var version)
            && version.ValueKind == JsonValueKind.String
                ? version.GetString()
                : null;
    }

    private static bool IsClientVersionAtLeast(string installedVersion, string expectedVersion)
    {
        static Version? Parse(string value)
        {
            var component = value.Split(['-', '+'], StringSplitOptions.RemoveEmptyEntries).FirstOrDefault()?.TrimStart('v', 'V');
            if (component is null || !Version.TryParse(component, out var parsed))
                return null;
            return new Version(parsed.Major, Math.Max(0, parsed.Minor), Math.Max(0, parsed.Build), Math.Max(0, parsed.Revision));
        }

        var installed = Parse(installedVersion);
        var expected = Parse(expectedVersion);
        return installed is not null && expected is not null && installed >= expected;
    }

    private static string JsonValue(JsonElement root, string primary, string fallback) =>
        root.TryGetProperty(primary, out var value) && value.ValueKind == JsonValueKind.String
            ? value.GetString() ?? "-"
            : root.TryGetProperty(fallback, out value) && value.ValueKind == JsonValueKind.String
                ? value.GetString() ?? "-"
                : "-";

    private static bool? JsonBoolean(JsonElement root, string primary, string fallback) =>
        root.TryGetProperty(primary, out var value) && value.ValueKind is JsonValueKind.True or JsonValueKind.False
            ? value.GetBoolean()
            : root.TryGetProperty(fallback, out value) && value.ValueKind is JsonValueKind.True or JsonValueKind.False
                ? value.GetBoolean()
                : null;

    private async Task<WorkstationCommandDto?> WaitAsync(Guid commandId, int maxAttempts = 80, string? operationLabel = null)
    {
        SetLifecycle(WorkstationCommandStatus.Pending, null);
        for (var i = 0; i < maxAttempts; i++)
        {
            var got = await GetCommand.HandleAsync(new GetCommandCommand(new GetCommandRequest(commandId, _userId)));
            if (!got.Success)
            {
                SetLifecycle(
                    WorkstationCommandStatus.Failed,
                    Notifications.FormatFailure(got, L["Workstations"].Value, L["Read"].Value),
                    detailAlreadyFormatted: true);
                return null;
            }
            SetLifecycle(got.Value!.Status, got.Value.Error, operationLabel, new { DeviceId = _wsDeviceId, CommandId = commandId });
            ApplyClientUpdateProgress(got.Value);
            await InvokeAsync(StateHasChanged);
            if (got.Value.Status is WorkstationCommandStatus.Succeeded or WorkstationCommandStatus.Failed or WorkstationCommandStatus.Cancelled)
                return got.Value;
            await Task.Delay(500);
        }
        _lifecycleState = "TimedOut";
        _lifecycle = L["CommandTimedOut"].Value;
        _lifecycleDetail = null;
        _clientUpdateActive = false;
        return null;
    }

    private void NotifyCommandFailure(WorkstationCommandDto? command, string operationLabel, Guid deviceId, Guid commandId)
    {
        if (command?.Status == WorkstationCommandStatus.Cancelled)
        {
            Notifications.Warning(L["WorkstationCommandCancelled", operationLabel].Value);
            return;
        }

        if (!string.IsNullOrWhiteSpace(_lifecycleDetail))
        {
            Notifications.Error(_lifecycleDetail);
            return;
        }

        var errorCode = _lifecycleState == "TimedOut" ? ErrorCodes.Unavailable : ErrorCodes.InternalError;
        Notifications.Failure(
            command?.Error ?? _lifecycle,
            L["Workstations"].Value,
            errorCode,
            operationLabel,
            new { DeviceId = deviceId, CommandId = commandId });
    }

    private void ApplyClientUpdateProgress(WorkstationCommandDto command)
    {
        if (command.Kind != WorkstationCommandKind.UpdateClient)
            return;

        _clientUpdateActive = command.Status is WorkstationCommandStatus.Pending or WorkstationCommandStatus.Running;
        if (string.IsNullOrWhiteSpace(command.ResultJson))
            return;

        try
        {
            using var document = JsonDocument.Parse(command.ResultJson);
            var root = document.RootElement;
            var message = JsonValue(root, "Message", "message");
            if (message != "-")
                _clientUpdateMessage = message;
            if (root.TryGetProperty("Percent", out var percent)
                || root.TryGetProperty("percent", out percent))
            {
                if (percent.ValueKind == JsonValueKind.Number)
                    _clientUpdatePercent = Math.Clamp(percent.GetDouble(), 0d, 100d);
            }
        }
        catch (JsonException)
        {
            // Completion replaces the progress snapshot with the final UpdateInfo object.
        }
    }

    private void SetLifecycle(WorkstationCommandStatus status, string? detail, string? operationLabel = null, object? context = null, bool detailAlreadyFormatted = false)
    {
        _lifecycleState = status switch
        {
            WorkstationCommandStatus.Pending => "Queued",
            WorkstationCommandStatus.Running => "Running",
            WorkstationCommandStatus.Succeeded => "Succeeded",
            WorkstationCommandStatus.Failed => "Failed",
            WorkstationCommandStatus.Cancelled => "Cancelled",
            _ => status.ToString()
        };
        _lifecycle = StatusLabel(status);
        _lifecycleDetail = status == WorkstationCommandStatus.Failed
            && !string.IsNullOrWhiteSpace(detail)
            && !detailAlreadyFormatted
                ? Notifications.FormatFailure(detail, L["Workstations"].Value, ErrorCodes.InternalError,
                    operationLabel ?? L["Execute"].Value, context)
                : detail;
    }
