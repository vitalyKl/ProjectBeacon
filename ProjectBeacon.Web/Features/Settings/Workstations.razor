@page "/settings/workstations"
@implements IAsyncDisposable
@layout MainLayout
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.Extensions.Logging
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Devices
@using ProjectBeacon.Application.Common
@using ProjectBeacon.Application.Auth
@using ProjectBeacon.Domain.Enums
@using ProjectBeacon.Web.Shared
@using ProjectBeacon.Web.Theme
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject AuthenticationStateProvider Auth
@inject ListDevicesHandler ListDevices
@inject CreateDeviceHandler CreateDevice
@inject RevokeDeviceHandler RevokeDevice
@inject EnqueueCommandHandler EnqueueCommand
@inject GetCommandHandler GetCommand
@inject ListCommandsHandler ListCommands
@inject GetTotpStatusHandler GetTotp
@inject IDialogService Dialogs
@inject NavigationManager Navigation

<PageTitle>@L["Workstations"]</PageTitle>
<PageHeader Title="@L["Workstations"]" />
@if (_devices.Count > 0)
{
    <div class="beacon-metric-strip mb-4">
        <PbMetric Label="@L["Workstations"]" Value="@_devices.Count.ToString()" />
        <PbMetric Label="@L["DeviceOnline"]" Value="@_devices.Count(d => d.Online).ToString()" />
        <PbMetric Label="@L["DeviceOffline"]" Value="@_devices.Count(d => !d.Online).ToString()" />
    </div>
}

<MudText Typo="Typo.h6" Class="mb-3">@L["Devices"]</MudText>
<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
    <div class="beacon-form">
        <div class="beacon-field-row mb-3">
            <MudTextField @bind-Value="_deviceName" InputId="device-name" Label="@L["DeviceName"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" />
            @if (_totpEnabled)
            {
                <MudTextField @bind-Value="_deviceTotp" InputId="device-totp" Label="@L["AuthenticatorCode"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" />
            }
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddDevice" Disabled="_busy || !_totpEnabled">@L["AddDevice"]</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ReloadDevices" Disabled="_busy">@L["Refresh"]</MudButton>
        </div>
    </div>
    @if (!string.IsNullOrEmpty(_deviceToken))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">@string.Format(L["DeviceTokenOnce"].Value, Navigation.BaseUri.TrimEnd('/'), _deviceToken)</MudAlert>
    }
    @if (_devices.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L["NoDevicesYet"]</MudAlert>
    }
    else
    {
        <MudTable Items="_devices" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@L["DeviceName"]</MudTh>
                <MudTh>@L["Status"]</MudTh>
                <MudTh>@L["LastSeen"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["DeviceName"]">@context.Name</MudTd>
                <MudTd DataLabel="@L["Status"]">
                    <StatusChip Color="@ChipPalette.ForRuntime(context.Online ? "Online" : "Offline")" Label="@(context.Online ? L["DeviceOnline"].Value : L["DeviceOffline"].Value)" />
                </MudTd>
                <MudTd DataLabel="@L["LastSeen"]"><LocalTime Value="context.LastHeartbeatAt" /></MudTd>
                <MudTd DataLabel="@L["Actions"]">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => Revoke(context)">@L["Delete"]</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@if (_devices.Count > 0 && _wsDeviceId is not null)
{
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <MudSelect T="Guid?" InputId="runtime-device" Value="_wsDeviceId" ValueChanged="OnWorkstationDeviceChanged" Label="@L["RuntimeDevice"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mb-3">
            @foreach (var device in _devices)
            {
                <MudSelectItem Value="@((Guid?)device.Id)">@device.Name</MudSelectItem>
            }
        </MudSelect>
        <CommandLifecycle State="@_lifecycleState" Label="@_lifecycle" Detail="@_lifecycleDetail" />
        <MudTabs Rounded="true" ApplyEffectsToContainer="true" PanelClass="pa-4">
            <MudTabPanel Text="@L["Workstation"]">
                <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3">@L["ScopeWorkstationHint"]</MudText>
                <div class="beacon-form">
<MudText Typo="Typo.subtitle2" Class="mt-4">@L["ModelsLocation"]</MudText>
            <FolderPicker DeviceId="_wsDeviceId" UserId="_userId" RootKind="models" AdvancedPath="true"
                          Path="@_modelsRoot" PathChanged="OnModelsRootChanged" Label="@L["ModelsLocation"]"
                          Disabled="_busy || !WorkstationOnline" />
            <MudText Typo="Typo.subtitle2" Class="mt-4">@L["ProjectsLocation"]</MudText>
            <FolderPicker DeviceId="_wsDeviceId" UserId="_userId" RootKind="projects" AdvancedPath="true"
                          Path="@_projectsRoot" PathChanged="OnProjectsRootChanged" Label="@L["ProjectsLocation"]"
                          Disabled="_busy || !WorkstationOnline" />
            <MudSelect T="string" @bind-Value="_commandPolicy" Label="@L["CommandPolicy"]" Variant="Variant.Outlined"
                       Margin="Margin.Dense" ShrinkLabel="true" Class="mt-3" Disabled="_busy">
                <MudSelectItem T="string" Value="@("off")">@L["CommandPolicyOff"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("ask")">@L["CommandPolicyAsk"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("auto")">@L["CommandPolicyAuto"]</MudSelectItem>
            </MudSelect>
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["CommandPolicyHelp"]</MudText>
            <MudSelect T="string" @bind-Value="_autoPullMode" Label="@L["AutoPullMode"]" Variant="Variant.Outlined"
                       Margin="Margin.Dense" ShrinkLabel="true" Class="mt-3" Disabled="_busy">
                <MudSelectItem T="string" Value="@("Off")">@L["AutoPullModeOff"]</MudSelectItem>
                <MudSelectItem T="string" Value="@("WhenSafe")">@L["AutoPullModeWhenSafe"]</MudSelectItem>
            </MudSelect>
            <MudNumericField T="int" @bind-Value="_autoSyncIntervalMinutes"
                             Label="@L["AutoSyncIntervalMinutes"]" Min="2" Max="120" Step="1"
                             Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["AutoSyncHelp"]</MudText>
            <MudNumericField T="int" @bind-Value="_pipelineTurnTimeoutMinutes"
                             Label="@L["PipelineTurnTimeout"]" Min="15" Max="60" Step="5"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
            <MudNumericField T="int" @bind-Value="_pipelineIdleTimeoutMinutes"
                             Label="@L["PipelineIdleTimeout"]" Min="1" Max="30" Step="1"
                             Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["PipelineTimeoutHelp"]</MudText>
            <MudNumericField T="int" @bind-Value="_contextResponseReserveTokens"
                             Label="@L["ContextResponseReserveTokens"]" Min="0" Max="1000000" Step="1024"
                             Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-3" />
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["ContextResponseReserveTokensHelp"]</MudText>
                        <MudExpansionPanels Elevation="0" Class="beacon-expand mt-2">
                <MudExpansionPanel Text="@L["AdvancedDiagnostics"]">
                    <MudTextField @bind-Value="_agentDataDir" InputId="agent-data" Label="@L["AgentDataLocation"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" />
                    <MudTextField @bind-Value="_llamaSwapBin" InputId="runtime-executable" Label="@L["RuntimeExecutable"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mt-2" />
                    <MudTextField @bind-Value="_llamaCppBin" InputId="llamacpp-bin" Label="@L["LlamaCppBin"]" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Class="mt-2" />
                </MudExpansionPanel>
            </MudExpansionPanels>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveWorkstation" Disabled="_busy || _wsDeviceId is null">@L["SaveWorkstation"]</MudButton>
                </div>
            </MudTabPanel>
            <MudTabPanel Text="@L["Probe"]">
        <MudText Typo="Typo.body2" Class="mt-2">@L["AgentRuntimeActive"]: @L["AgentRuntimeNative"]</MudText>
            @if (_probeAgentRuntimeHealthy == false && !string.IsNullOrWhiteSpace(_probeAgentRuntimeError))
            {
                <MudAlert Severity="Severity.Error" Dense="true" Class="mt-2"><span class="beacon-diagnostic-output">@_probeAgentRuntimeError</span></MudAlert>
            }
        <MudText Typo="Typo.subtitle2" Class="mt-4">@L["Probe"]</MudText>
        <MudText Typo="Typo.body2">@L["ProbeGit"]: @(_probeGit ?? "-")</MudText>
        <MudText Typo="Typo.body2">@L["ProbeNode"]: @(_probeNode ?? "-")</MudText>
        <MudText Typo="Typo.body2">@L["ProbeDocker"]: @(_probeDocker ?? "-")</MudText>
        <MudText Typo="Typo.body2">@L["ProbeLlamaSwap"]: @(_probeLlamaSwap ?? "-")</MudText>
        <MudText Typo="Typo.subtitle2" Class="mt-4">@L["RepositorySync"]</MudText>
        @if (_repoSyncRows.Count == 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["RepositorySyncNotReported"]</MudText>
        }
        else
        {
            <MudTable Items="_repoSyncRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                <HeaderContent>
                    <MudTh>@L["Project"]</MudTh>
                    <MudTh>@L["Branch"]</MudTh>
                    <MudTh>@L["Status"]</MudTh>
                    <MudTh>@L["Updated"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@L["Project"]"><span title="@context.ProjectId">@context.ProjectId.ToString("N")[..8]</span></MudTd>
                    <MudTd DataLabel="@L["Branch"]">@(context.Branch ?? "-")</MudTd>
                    <MudTd DataLabel="@L["Status"]">
                        <StatusChip Color="@(context.LastErrorCode is not null || context.Diverged ? Color.Error : context.Behind > 0 || context.BlockedReason is not null || !context.Clean || context.Detached || !context.HasUpstream ? Color.Warning : Color.Success)"
                                    Label="@RepoSyncStatusLabel(context)" />
                    </MudTd>
                    <MudTd DataLabel="@L["Updated"]">
                        @if (context.CheckedAt is { } checkedAt)
                        {
                            @RepoSyncUpdatedLabel(checkedAt)
                        }
                        else
                        {
                            @("-")
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        <MudStack Row="true" Spacing="2" Class="mt-2">
            @if (string.IsNullOrWhiteSpace(_probeGit))
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="InstallGit">@string.Format(L["InstallPackage"].Value, "git")</MudButton>
            }
            @if (string.IsNullOrWhiteSpace(_probeNode))
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="InstallNode">@string.Format(L["InstallPackage"].Value, "node")</MudButton>
            }
            @if (string.IsNullOrWhiteSpace(_probeDocker))
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="InstallDocker">@string.Format(L["InstallPackage"].Value, "docker")</MudButton>
            }
        </MudStack>
            </MudTabPanel>
            <MudTabPanel Text="@L["DaemonUpdates"]">
        <MudText Typo="Typo.body2">@L["DaemonUpdateDescription"]</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.Center" Class="mt-3">
            <MudText Typo="Typo.body2">@L["DaemonInstalledVersion"]: @_clientCurrentVersion</MudText>
            <MudText Typo="Typo.body2">@L["DaemonLatestVersion"]: @_clientLatestVersion</MudText>
            @if (_clientUpdateAvailable == true)
            {
                <StatusChip Color="Color.Warning" Label="@L["DaemonUpdateAvailable"]" />
            }
            else if (_clientUpdateAvailable == false)
            {
                <StatusChip Color="Color.Success" Label="@L["DaemonUpToDate"]" />
            }
        </MudStack>
        <MudStack Row="true" Spacing="2" Class="mt-3">
            <MudButton Variant="Variant.Outlined" OnClick="CheckClientUpdate" Disabled="_busy || !WorkstationOnline">
                @L["CheckDaemonUpdates"]
            </MudButton>
            @if (_clientUpdateAvailable == true)
            {
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="UpdateClient" Disabled="_busy || !WorkstationOnline">
                    @L["UpdateDaemonNow"]
                </MudButton>
            }
        </MudStack>
        @if (!WorkstationOnline)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary mt-2">@L["DaemonUpdateRequiresOnline"]</MudText>
        }

        @if (_clientUpdateActive || _clientUpdateMessage is not null)
        {
            <MudProgressLinear Color="Color.Primary" Value="@(_clientUpdatePercent ?? 0d)"
                               Indeterminate="@(_clientUpdateActive && _clientUpdatePercent is null)" Class="mt-2" />
            <MudText Typo="Typo.caption" Class="mt-1">
                @_clientUpdateMessage @(_clientUpdatePercent is { } percent ? $"· {percent:0}%" : string.Empty)
            </MudText>
        }
            </MudTabPanel>
            <MudTabPanel Text="@L["Commands"]">
        <MudTable Items="_commands" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
            <HeaderContent>
                <MudTh>@L["Kind"]</MudTh>
                <MudTh>@L["Status"]</MudTh>
                <MudTh>@L["Created"]</MudTh>
                <MudTh>@L["Completed"]</MudTh>
                <MudTh>@L["Error"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@L["Kind"]">@ChromeLabels.CommandKind(L, context.Kind)</MudTd>
                <MudTd DataLabel="@L["Status"]">
                    <StatusChip Color="@ChipPalette.ForCommandStatus(context.Status)" Label="@StatusLabel(context.Status)" />
                </MudTd>
                <MudTd DataLabel="@L["Created"]"><LocalTime Value="context.CreatedAt" /></MudTd>
                <MudTd DataLabel="@L["Completed"]"><LocalTime Value="context.CompletedAt" /></MudTd>
                <MudTd DataLabel="@L["Error"]">
                    <span class="beacon-diagnostic-output" title="@CommandErrorMessage(context)">@CommandErrorMessage(context)</span>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>@L["NoCommands"]</NoRecordsContent>
        </MudTable>
            </MudTabPanel>
        </MudTabs>
    </MudPaper>
}
@code {
    private List<DaemonDeviceDto> _devices = [];
    private string _deviceName = string.Empty;
    private string? _deviceToken;
    private bool _busy;
    private Guid _userId;
    private bool _totpEnabled;
    private string _deviceTotp = string.Empty;
    private Guid? _wsDeviceId;
    private string _modelsRoot = string.Empty;
    private string _agentDataDir = string.Empty;
    private string _projectsRoot = string.Empty;
    private string _commandPolicy = "ask";
    private string _autoPullMode = "WhenSafe";
    private int _autoSyncIntervalMinutes = 10;
    private List<RepoSyncUiRow> _repoSyncRows = [];
    private CancellationTokenSource? _refreshCts;
    private Task? _refreshTask;
    private sealed record RepoSyncUiRow(Guid ProjectId, string? Branch, int Ahead, int Behind, bool Clean, bool Detached, bool HasUpstream, bool Diverged, DateTimeOffset? CheckedAt, int? LastAutoPullCommits, string? BlockedReason, string? LastErrorCode);
    private int _pipelineTurnTimeoutMinutes = 60;
    private int _pipelineIdleTimeoutMinutes = 15;
    private int _contextResponseReserveTokens;
    private string _llamaSwapBin = string.Empty;
    private string _llamaCppBin = string.Empty;
    private long _wsRevision;
    private string? _probeGit;
    private string? _probeNode;
    private string? _probeDocker;
    private string? _probeLlamaSwap;
    private string? _probeAgentRuntime;
    private bool? _probeAgentRuntimeHealthy;
    private string? _probeAgentRuntimeError;
    private string? _probeAgentRuntimeErrorCacheKey;
    private string? _probeAgentRuntimeErrorCacheValue;
    private List<WorkstationCommandDto> _commands = [];
    private readonly Dictionary<Guid, (string Error, string Culture, string Message)> _commandErrorMessages = [];
    private string _clientCurrentVersion = "-";
    private string _clientLatestVersion = "-";
    private bool? _clientUpdateAvailable;
    private bool _clientUpdateActive;
    private double? _clientUpdatePercent;
    private string? _clientUpdateMessage;
    private string? _lifecycle;
    private string? _lifecycleDetail;
    private string? _lifecycleState;

    private bool WorkstationOnline => _devices.FirstOrDefault(d => d.Id == _wsDeviceId)?.Online == true;

    private Task OnModelsRootChanged(string value)
    {
        _modelsRoot = value ?? "";
        return Task.CompletedTask;
    }

    private Task OnProjectsRootChanged(string value)
    {
        _projectsRoot = value ?? "";
        return Task.CompletedTask;
    }

    private string StatusLabel(WorkstationCommandStatus status) => status switch
    {
        WorkstationCommandStatus.Pending => L["CommandQueued"].Value,
        WorkstationCommandStatus.Running => L["CommandRunning"].Value,
        WorkstationCommandStatus.Succeeded => L["CommandSucceeded"].Value,
        WorkstationCommandStatus.Failed => L["CommandFailed"].Value,
        WorkstationCommandStatus.Cancelled => L["CommandCancelled"].Value,
        _ => status.ToString()
    };

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            _userId = id;
        if (_userId != Guid.Empty)
        {
            var totp = await GetTotp.HandleAsync(new GetTotpStatusCommand(_userId));
            if (!totp.Success)
                Notifications.Failure(totp, L["Workstations"].Value, L["Check"].Value);
            _totpEnabled = totp.Success && totp.Value?.Enabled == true;
        }
        await ReloadDevices();
        _refreshCts = new CancellationTokenSource();
        _refreshTask = RefreshHeartbeatLoopAsync(_refreshCts.Token);
    }

    private async Task RefreshHeartbeatLoopAsync(CancellationToken ct)
    {
        try
        {
            while (!ct.IsCancellationRequested)
            {
                await Task.Delay(TimeSpan.FromSeconds(15), ct);
                var listed = await ListDevices.HandleAsync(new ListDevicesCommand(new ListDevicesRequest(_userId)), ct);
                if (listed.Success)
                {
                    _devices = listed.Value!.ToList();
                    if (_wsDeviceId is { } selected && _devices.Any(device => device.Id == selected))
                        LoadWorkstation(selected, loadSettings: false);
                    await InvokeAsync(StateHasChanged);
                }
            }
        }
        catch (OperationCanceledException) when (ct.IsCancellationRequested)
        {
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_refreshCts is null)
            return;
        await _refreshCts.CancelAsync();
        if (_refreshTask is not null)
        {
            try { await _refreshTask; }
            catch (OperationCanceledException) { }
        }
        _refreshCts.Dispose();
    }

    private Task ReloadDevices() => ReloadDevices(loadWorkstationSettings: true);

    private async Task ReloadDevices(bool loadWorkstationSettings)
    {
        if (_userId == Guid.Empty) return;
        var listed = await ListDevices.HandleAsync(new ListDevicesCommand(new ListDevicesRequest(_userId)));
        if (!listed.Success)
        {
            _devices = [];
            _wsDeviceId = null;
            Notifications.Failure(listed, L["Workstations"].Value, L["Load"].Value);
            return;
        }
        _devices = listed.Value?.ToList() ?? [];
        if (_wsDeviceId is not { } selectedId || _devices.All(d => d.Id != selectedId))
            _wsDeviceId = _devices.FirstOrDefault(d => d.Online)?.Id ?? _devices.FirstOrDefault()?.Id;
        if (_wsDeviceId is { } id)
        {
            LoadWorkstation(id, loadWorkstationSettings);
            await LoadCommands(id);
        }
        else
        {
            _commands = [];
            _commandErrorMessages.Clear();
        }
    }

    private async Task OnWorkstationDeviceChanged(Guid? id)
    {
        _wsDeviceId = id;
        _clientCurrentVersion = _clientLatestVersion = "-";
        _clientUpdateAvailable = null;
        _clientUpdateActive = false;
        _clientUpdatePercent = null;
        _clientUpdateMessage = null;
        _commands = [];
        _commandErrorMessages.Clear();
        if (id is { } deviceId)
        {
            LoadWorkstation(deviceId);
            await LoadCommands(deviceId);
        }
    }

    private async Task LoadCommands(Guid deviceId)
    {
        try
        {
            var result = await ListCommands.HandleAsync(
                new ListCommandsCommand(new ListCommandsRequest(deviceId, _userId)), CancellationToken.None);
            if (!result.Success)
            {
                _commands = [];
                _commandErrorMessages.Clear();
                Notifications.Failure(result, L["Workstations"].Value, L["Load"].Value);
                return;
            }

            _commands = result.Value?.ToList() ?? [];
            _commandErrorMessages.Clear();
        }
        catch (Exception exception)
        {
            _commands = [];
            _commandErrorMessages.Clear();
            Notifications.ReportException(
                exception, "WorkstationCommandsLoadFailed", "load workstation command history", new { DeviceId = deviceId });
        }
    }

    private string CommandErrorMessage(WorkstationCommandDto command)
    {
        if (string.IsNullOrWhiteSpace(command.Error))
            return "-";

        var culture = System.Globalization.CultureInfo.CurrentUICulture.Name;
        if (_commandErrorMessages.TryGetValue(command.Id, out var cached)
            && string.Equals(cached.Error, command.Error, StringComparison.Ordinal)
            && string.Equals(cached.Culture, culture, StringComparison.Ordinal))
            return cached.Message;

        var message = Notifications.FormatFailure(
            command.Error,
            L["Workstations"].Value,
            ErrorCodes.InternalError,
            ChromeLabels.CommandKind(L, command.Kind),
            new { DeviceId = _wsDeviceId, CommandId = command.Id, CommandKind = command.Kind });
        _commandErrorMessages[command.Id] = (command.Error, culture, message);
        return message;
    }

    private void LoadWorkstation(Guid deviceId, bool loadSettings = true)
    {
        var device = _devices.FirstOrDefault(d => d.Id == deviceId);
        if (device is null) return;
        _wsRevision = device.DesiredRevision;
        FillProbe(device.ProbeJson, device.Id);
        if (!loadSettings) return;
        try
        {
            using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(device.WorkstationJson) ? "{}" : device.WorkstationJson);
            var root = doc.RootElement;
            _modelsRoot = Str(root, "modelsRoot");
            _agentDataDir = Str(root, "agentDataDir");
            if (string.IsNullOrWhiteSpace(_agentDataDir))
                _agentDataDir = Str(root, "opencodeDataDir");
            _projectsRoot = Str(root, "projectsRoot");
            _commandPolicy = root.TryGetProperty("commandPolicy", out var commandPolicy)
                && commandPolicy.ValueKind == JsonValueKind.String
                    ? commandPolicy.GetString()?.Trim().ToLowerInvariant() is "off" or "auto" or "ask" ? commandPolicy.GetString()!.Trim().ToLowerInvariant() : "ask"
                    : "ask";
            _llamaSwapBin = Str(root, "llamaSwapBin");
            _llamaCppBin = Str(root, "llamaCppBin");
            _pipelineTurnTimeoutMinutes = root.TryGetProperty("pipelineTurnTimeoutMinutes", out var pipelineMax)
                && pipelineMax.TryGetInt32(out var maxMinutes) ? Math.Clamp(maxMinutes, 15, 60) : 60;
            _pipelineIdleTimeoutMinutes = root.TryGetProperty("pipelineIdleTimeoutMinutes", out var pipelineIdle)
                && pipelineIdle.TryGetInt32(out var idleMinutes) ? Math.Clamp(idleMinutes, 1, 30) : 15;
            _contextResponseReserveTokens = root.TryGetProperty("contextResponseReserveTokens", out var reserve)
                && reserve.TryGetInt32(out var reserveTokens) ? Math.Clamp(reserveTokens, 0, 1_000_000) : 0;
        }
        catch (JsonException exception)
        {
            Notifications.ReportException(exception, "WorkstationSettingsInvalid", "read workstation settings", new { DeviceId = deviceId });
        }
    }

    private static string Str(JsonElement root, string name) =>
        root.TryGetProperty(name, out var p) && p.ValueKind == JsonValueKind.String ? p.GetString() ?? "" : "";

    private void FillProbe(string probeJson, Guid deviceId)
    {
        _probeGit = _probeNode = _probeDocker = _probeLlamaSwap = null;
        _probeAgentRuntime = null;
        _probeAgentRuntimeHealthy = null;
        _probeAgentRuntimeError = null;
        _repoSyncRows = [];
        try
        {
            using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(probeJson) ? "{}" : probeJson);
            _probeGit = Tool(doc.RootElement, "git");
            _probeNode = Tool(doc.RootElement, "node");
            _probeDocker = Tool(doc.RootElement, "docker");
            _probeLlamaSwap = Tool(doc.RootElement, "llamaSwap");
            var root = doc.RootElement;
            if (root.TryGetProperty("repoSync", out var repoSync) && repoSync.ValueKind == JsonValueKind.Array)
            {
                foreach (var item in repoSync.EnumerateArray())
                {
                    if (item.ValueKind != JsonValueKind.Object
                        || !item.TryGetProperty("projectId", out var projectIdElement)
                        || projectIdElement.ValueKind != JsonValueKind.String
                        || !Guid.TryParse(projectIdElement.GetString(), out var projectId))
                        continue;
                    DateTimeOffset? checkedAt = item.TryGetProperty("checkedAt", out var checkedAtElement)
                        && checkedAtElement.ValueKind == JsonValueKind.String
                        && DateTimeOffset.TryParse(checkedAtElement.GetString(),
                            System.Globalization.CultureInfo.InvariantCulture,
                            System.Globalization.DateTimeStyles.AssumeUniversal
                                | System.Globalization.DateTimeStyles.AdjustToUniversal,
                            out var parsedAt)
                                ? parsedAt : null;
                    int? lastPullCommits = null;
                    if (item.TryGetProperty("lastAutoPull", out var lastPull)
                        && lastPull.ValueKind == JsonValueKind.Object
                        && lastPull.TryGetProperty("commits", out var commits)
                        && commits.TryGetInt32(out var parsedCommits))
                        lastPullCommits = parsedCommits;
                    var branch = item.TryGetProperty("branch", out var branchElement)
                        && branchElement.ValueKind == JsonValueKind.String ? branchElement.GetString() : null;
                    var ahead = item.TryGetProperty("ahead", out var aheadElement) && aheadElement.TryGetInt32(out var aheadValue) ? aheadValue : 0;
                    var behind = item.TryGetProperty("behind", out var behindElement) && behindElement.TryGetInt32(out var behindValue) ? behindValue : 0;
                    var clean = item.TryGetProperty("clean", out var cleanElement) && cleanElement.ValueKind == JsonValueKind.True;
                    var detached = item.TryGetProperty("detached", out var detachedElement) && detachedElement.ValueKind == JsonValueKind.True;
                    var hasUpstream = item.TryGetProperty("hasUpstream", out var upstreamElement) && upstreamElement.ValueKind == JsonValueKind.True;
                    var diverged = item.TryGetProperty("diverged", out var divergedElement) && divergedElement.ValueKind == JsonValueKind.True;
                    var blocked = item.TryGetProperty("autoPullBlockedReason", out var blockedElement)
                        && blockedElement.ValueKind == JsonValueKind.String ? blockedElement.GetString() : null;
                    var errorCode = item.TryGetProperty("lastError", out var lastError)
                        && lastError.ValueKind == JsonValueKind.Object
                        && lastError.TryGetProperty("code", out var codeElement)
                        && codeElement.ValueKind == JsonValueKind.String ? codeElement.GetString() : null;
                    _repoSyncRows.Add(new RepoSyncUiRow(projectId, branch, ahead, behind, clean, detached,
                        hasUpstream, diverged, checkedAt, lastPullCommits, blocked, errorCode));
                }
            }
            if (root.TryGetProperty("agentRuntime", out var runtimeStatus))
            {
                if (runtimeStatus.ValueKind == JsonValueKind.Object)
                {
                    _probeAgentRuntime = Str(runtimeStatus, "runtime");
                    if (string.IsNullOrWhiteSpace(_probeAgentRuntime))
                        _probeAgentRuntime = "native";
                    if (runtimeStatus.TryGetProperty("healthy", out var healthy)
                        && healthy.ValueKind is JsonValueKind.True or JsonValueKind.False)
                        _probeAgentRuntimeHealthy = healthy.GetBoolean();
                    var rawRuntimeError = Str(runtimeStatus, "error");
                    if (!string.IsNullOrWhiteSpace(rawRuntimeError))
                    {
                        var cacheKey = $"{System.Globalization.CultureInfo.CurrentUICulture.Name}:{deviceId:N}:{rawRuntimeError}";
                        if (!string.Equals(cacheKey, _probeAgentRuntimeErrorCacheKey, StringComparison.Ordinal))
                        {
                            _probeAgentRuntimeErrorCacheKey = cacheKey;
                            _probeAgentRuntimeErrorCacheValue = Notifications.FormatFailure(
                                rawRuntimeError, L["Workstations"].Value, ErrorCodes.InternalError,
                                L["Check"].Value, new { DeviceId = deviceId });
                        }
                        _probeAgentRuntimeError = _probeAgentRuntimeErrorCacheValue;
                    }
                }
            }
        }
        catch (JsonException exception)
        {
            Notifications.ReportException(exception, "WorkstationProbeInvalid", "read workstation diagnostics", new { DeviceId = _wsDeviceId });
        }
    }

    private static string? Tool(JsonElement root, string name)
    {
        if (!root.TryGetProperty(name, out var p) || p.ValueKind != JsonValueKind.String)
            return null;
        var value = p.GetString();
        return string.IsNullOrWhiteSpace(value) ? null : value;
    }

    private string RepoSyncStatusLabel(RepoSyncUiRow row)
    {
        if (row.BlockedReason == "NotGitRepository")
            return L["RepoSyncNotGit"].Value;
        if (row.BlockedReason is "ManualGitSyncActive" or "GitSyncBusy")
            return L["RepoSyncGitSyncBusy"].Value;
        if (!string.IsNullOrWhiteSpace(row.LastErrorCode))
            return RepoSyncErrorMessage(row.LastErrorCode);
        if (row.Diverged || row.BlockedReason == "Diverged")
            return L["RepoSyncDiverged"].Value;
        if (row.Detached)
            return L["RepoSyncDetached"].Value;
        if (!row.HasUpstream)
            return L["RepoSyncNoUpstream"].Value;
        if (!row.Clean || row.BlockedReason == "DirtyWorkingTree")
            return L["RepoSyncDirty"].Value;
        if (row.BlockedReason == "ActiveSessions")
            return L["RepoSyncActiveSessions"].Value;
        if (row.BlockedReason == "GitLandActive")
            return L["RepoSyncGitLandActive"].Value;
        if (row.BlockedReason == "CheckoutBusy")
            return L["RepoSyncCheckoutBusy"].Value;
        if (row.BlockedReason == "CheckoutMutationActive")
            return L["RepoSyncCheckoutMutationActive"].Value;
        if (row.BlockedReason == "GitSyncBusy")
            return L["RepoSyncGitSyncBusy"].Value;
        if (row.LastAutoPullCommits is { } commits && commits > 0 && row.Behind == 0)
            return string.Format(L["RepoSyncPulled"].Value, commits);
        return row.Behind > 0
            ? string.Format(L["RepoSyncBehind"].Value, row.Behind)
            : L["RepoSyncUpToDate"].Value;
    }

    private string RepoSyncErrorMessage(string code) => code switch
    {
        "AuthenticationFailed" => L["RepoSyncAuthenticationFailed"].Value,
        "FetchFailed" => L["RepoSyncFetchFailed"].Value,
        "Timeout" => L["RepoSyncTimeout"].Value,
        "RuntimeDiscoveryUnavailable" => L["RepoSyncDiscoveryFailed"].Value,
        "ProjectDirectoryUnavailable" => L["RepoSyncDirectoryUnavailable"].Value,
        _ => string.Format(L["RepoSyncError"].Value, code)
    };

    private string RepoSyncUpdatedLabel(DateTimeOffset checkedAt)
    {
        var minutes = Math.Max(0, (DateTimeOffset.UtcNow - checkedAt.ToUniversalTime()).TotalMinutes);
        return minutes < 1
            ? L["RepoSyncJustNow"].Value
            : string.Format(L["RepoSyncUpdatedMinutes"].Value, (int)Math.Floor(minutes));
    }

    private async Task AddDevice()
    {
        if (_userId == Guid.Empty || _busy) return;
        _busy = true;
        try
        {
            var name = string.IsNullOrWhiteSpace(_deviceName) ? Environment.MachineName : _deviceName.Trim();
            var result = await CreateDevice.HandleAsync(new CreateDeviceCommand(
                new CreateDeviceRequest(name, "web-" + Guid.NewGuid().ToString("N"), _userId, _deviceTotp)));
            if (!result.Success)
            {
                Notifications.Failure(result, L["Workstations"].Value, L["Create"].Value);
                return;
            }
            _deviceToken = result.Value!.Token;
            _deviceName = string.Empty;
            Notifications.Add(L["DeviceCreated"].Value, Severity.Success);
            await ReloadDevices();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Revoke(DaemonDeviceDto device)
    {
