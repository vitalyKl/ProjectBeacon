@page "/settings"
@layout MainLayout
@attribute [Authorize]
@using System.Security.Claims
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Auth
@using ProjectBeacon.Application.Agents
@using ProjectBeacon.Application.Organizations
@using ProjectBeacon.Web.Authentication
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject AuthenticationStateProvider Auth
@inject ChangePasswordHandler ChangePassword
@inject GetModelRegistryHandler GetRegistry
@inject GetChatModelHandler GetChatModel
@inject SetChatModelHandler SetChatModel
@inject NudgeModelsHandler NudgeModels
@inject IOrganizationDataExportService OrganizationDataExport
@inject GetTotpStatusHandler GetTotp
@inject BeginTotpHandler BeginTotp
@inject ConfirmTotpHandler ConfirmTotp
@inject DisableTotpHandler DisableTotp
@inject ISnackbar Snackbar
@inject BeaconThemeState Theme
@inject IJSRuntime Js

<PageTitle>@L["Settings"]</PageTitle>
<div class="beacon-settings">
<PageHeader Title="@L["Settings"]" />
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-6">@L["SettingsLead"]</MudText>

<MudText Typo="Typo.h6" Class="mb-3">@L["Appearance"]</MudText>
<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
    <div class="beacon-appearance" role="radiogroup" aria-label="@L["Appearance"]">
        <button type="button" role="radio" aria-checked="@(Theme.Preference == ThemePreference.Dark)" class="beacon-appearance-option @(Theme.Preference == ThemePreference.Dark ? "is-selected" : null)" @onclick="() => SetTheme(ThemePreference.Dark)">@L["ThemeDark"]</button>
        <button type="button" role="radio" aria-checked="@(Theme.Preference == ThemePreference.Light)" class="beacon-appearance-option @(Theme.Preference == ThemePreference.Light ? "is-selected" : null)" @onclick="() => SetTheme(ThemePreference.Light)">@L["ThemeLight"]</button>
        <button type="button" role="radio" aria-checked="@(Theme.Preference == ThemePreference.System)" class="beacon-appearance-option @(Theme.Preference == ThemePreference.System ? "is-selected" : null)" @onclick="() => SetTheme(ThemePreference.System)">@L["ThemeSystem"]</button>
    </div>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-3">@L["TimeZone"]</MudText>
<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
    <div class="beacon-form">
        <MudSelect T="string" Value="_timeZone" ValueChanged="SaveTimeZone" Label="@L["TimeZone"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
            <MudSelectItem Value="@string.Empty">@L["TimeZoneSystem"] (@_systemTimeZone)</MudSelectItem>
            @foreach (var zone in _timeZones)
            {
                <MudSelectItem Value="@zone">@zone</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["TimeZoneHint"]</MudText>
    </div>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-3">@L["Account"]</MudText>
<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
    <div class="beacon-form">
        <MudTextField @bind-Value="_currentPassword" Label="@L["CurrentPassword"]" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_newPassword" Label="@L["NewPassword"]" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SavePassword" Disabled="_busy">@L["ChangePassword"]</MudButton>
        <MudSelect T="Guid?" @bind-Value="_chatModelId" Label="@L["ChatModel"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-4" Clearable="true">
            <MudSelectItem Value="@((Guid?)null)">@L["Unbound"]</MudSelectItem>
            @foreach (var backend in _chatModels)
            {
                <MudSelectItem Value="@((Guid?)backend.Id)">@backend.Name</MudSelectItem>
            }
        </MudSelect>
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["ChatModelHint"]</MudText>
        <MudButton Variant="Variant.Outlined" Class="mt-2" OnClick="SaveChatModel" Disabled="_busy">@L["Save"]</MudButton>
    </div>
</MudPaper>

@if (_canExportOrganization)
{
    <MudText Typo="Typo.h6" Class="mb-3">@L["OrganizationData"]</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <div class="beacon-form">
            <MudText Typo="Typo.body2" Class="mud-text-secondary">@L["OrganizationDataExportLead"]</MudText>
            <MudButton Href="@($"/v1/orgs/{_organizationId:D}/export.zip")"
                       Variant="Variant.Outlined" Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.Download"
                       download="projectbeacon-organization-export.zip"
                       data-enhance-nav="false">
                @L["DownloadOrganizationExport"]
            </MudButton>
        </div>
    </MudPaper>
}

<MudText Typo="Typo.h6" Class="mb-1">@L["DangerZone"]</MudText>
<MudText Typo="Typo.body2" Class="mud-text-secondary mb-3">@L["DangerZoneLead"]</MudText>
<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
    <MudText Typo="Typo.subtitle1" Class="mb-2">@L["Authenticator"]</MudText>
    @if (_totpEnabled)
    {
        <MudText Typo="Typo.body2" Class="mb-2">@L["AuthenticatorOn"]</MudText>
        <MudTextField @bind-Value="_totpCode" Label="@L["AuthenticatorCode"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudButton Variant="Variant.Text" Color="Color.Error" Class="mt-2" OnClick="TurnOffTotp" Disabled="_busy">@L["TurnOffAuthenticator"]</MudButton>
    }
    else if (!string.IsNullOrEmpty(_totpUri))
    {
        <MudText Typo="Typo.body2" Class="mb-3">@L["AuthenticatorScan"]</MudText>
        <img src="@_totpQr" alt="@L["AuthenticatorQr"]" class="beacon-qr-code mb-3" />
        <MudText Typo="Typo.caption" Class="mud-text-secondary">@L["AuthenticatorManual"]</MudText>
        <MudText Typo="Typo.body2" Class="beacon-pre mb-3">@_totpSecret</MudText>
        <MudTextField @bind-Value="_totpCode" Label="@L["AuthenticatorCode"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-2" OnClick="ConfirmAuthenticator" Disabled="_busy">@L["Confirm"]</MudButton>
    }
    else
    {
        <MudText Typo="Typo.body2" Class="mb-2">@L["AuthenticatorOff"]</MudText>
        <MudButton Variant="Variant.Outlined" OnClick="StartAuthenticator" Disabled="_busy">@L["TurnOnAuthenticator"]</MudButton>
    }
    </MudPaper>
</div>

@code {
    private bool _busy;
    private string _timeZone = string.Empty;
    private string _systemTimeZone = "UTC";
    private readonly List<string> _timeZones = TimeZoneInfo.GetSystemTimeZones()
        .Select(zone => TimeZoneInfo.TryConvertWindowsIdToIanaId(zone.Id, out var iana) ? iana : zone.Id)
        .Distinct(StringComparer.OrdinalIgnoreCase)
        .OrderBy(zone => zone, StringComparer.OrdinalIgnoreCase)
        .ToList();
    private Guid _userId;
    private Guid _organizationId;
    private bool _canExportOrganization;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private List<LocalModelBackendDto> _chatModels = [];
    private Guid? _chatModelId;
    private bool _totpEnabled;
    private string _totpUri = string.Empty;
    private string _totpQr = string.Empty;
    private string _totpSecret = string.Empty;
    private string _totpCode = string.Empty;

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            _userId = id;
        if (Guid.TryParse(user.FindFirst("org_id")?.Value, out var orgId))
        {
            _organizationId = orgId;
            _canExportOrganization = await OrganizationDataExport.CanExportAsync(
                orgId, ActorContextFactory.FromPrincipal(user));
        }
        await ReloadChatModel();
        await ReloadTotp();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        try
        {
            _systemTimeZone = await Js.InvokeAsync<string>("beaconTimeZone.getSystem") ?? "UTC";
            _timeZone = await Js.InvokeAsync<string>("beaconTimeZone.getPreference") ?? string.Empty;
            await InvokeAsync(StateHasChanged);
        }
        catch (JSException)
        {
            Snackbar.Add(L["TimeZoneLoadFailed"].Value, Severity.Warning);
        }
    }

    private async Task SaveTimeZone(string value)
    {
        try
        {
            await Js.InvokeAsync<string>("beaconTimeZone.setPreference", value);
            _timeZone = value;
            Snackbar.Add(L["TimeZoneSaved"].Value, Severity.Success);
        }
        catch (JSException)
        {
            Snackbar.Add(L["TimeZoneInvalid"].Value, Severity.Error);
        }
    }

    private async Task ReloadTotp()
    {
        if (_userId == Guid.Empty)
            return;
        var status = await GetTotp.HandleAsync(new GetTotpStatusCommand(_userId));
        _totpEnabled = status.Success && status.Value!.Enabled;
        if (status.Success && status.Value!.Pending && !string.IsNullOrEmpty(status.Value.OtpAuthUri))
            ShowSetup(status.Value.OtpAuthUri, status.Value.Secret ?? string.Empty);
        else if (_totpEnabled)
            ClearSetup();
    }

    private void ShowSetup(string uri, string secret)
    {
        _totpUri = uri;
        _totpSecret = secret;
        _totpQr = TotpQr.DataUrl(uri);
    }

    private void ClearSetup()
    {
        _totpUri = string.Empty;
        _totpSecret = string.Empty;
        _totpQr = string.Empty;
    }

    private async Task StartAuthenticator()
    {
        if (_userId == Guid.Empty)
            return;
        var begun = await BeginTotp.HandleAsync(new BeginTotpCommand(_userId));
        if (!begun.Success)
        {
            Snackbar.Add(begun.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        await ReloadTotp();
    }

    private async Task ConfirmAuthenticator()
    {
        var confirmed = await ConfirmTotp.HandleAsync(new ConfirmTotpCommand(new ConfirmTotpRequest(_userId, _totpCode)));
        if (!confirmed.Success)
        {
            Snackbar.Add(confirmed.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _totpCode = string.Empty;
        ClearSetup();
        await ReloadTotp();
    }

    private async Task TurnOffTotp()
    {
        var disabled = await DisableTotp.HandleAsync(new DisableTotpCommand(new DisableTotpRequest(_userId, _totpCode)));
        if (!disabled.Success)
        {
            Snackbar.Add(disabled.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _totpCode = string.Empty;
        await ReloadTotp();
    }

    private async Task ReloadChatModel()
    {
        if (_userId == Guid.Empty)
            return;
        var registry = await GetRegistry.HandleAsync(new GetModelRegistryCommand(_userId));
        _chatModels = registry.Success ? registry.Value!.Backends.ToList() : [];
        var current = await GetChatModel.HandleAsync(new GetChatModelCommand(_userId));
        _chatModelId = current.Success ? current.Value : null;
    }

    private async Task SaveChatModel()
    {
        if (_userId == Guid.Empty || _busy)
            return;
        _busy = true;
        try
        {
            var saved = await SetChatModel.HandleAsync(new SetChatModelCommand(new SetChatModelRequest(_userId, _chatModelId)));
            if (!saved.Success)
            {
                Snackbar.Add(saved.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["ChatModelSaved"].Value, Severity.Success);
            await NudgeModels.HandleAsync(new NudgeModelsCommand(_userId));
        }
        finally
        {
            _busy = false;
        }
    }

    private Task SetTheme(ThemePreference preference) => Theme.SetPreferenceAsync(preference);

    private async Task SavePassword()
    {
        if (_userId == Guid.Empty || _busy) return;
        _busy = true;
        try
        {
            var result = await ChangePassword.HandleAsync(new ChangePasswordRequest(_userId, _currentPassword, _newPassword));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            Snackbar.Add(L["PasswordChanged"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }
}
