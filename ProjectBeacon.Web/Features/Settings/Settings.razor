@page "/settings"
@layout MainLayout
@attribute [Authorize]
@using System.Security.Claims
@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Auth
@using ProjectBeacon.Application.Devices
@using ProjectBeacon.Application.Identity
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject GetCurrentProjectHandler CurrentProject
@inject AuthenticationStateProvider Auth
@inject GetProjectMembersHandler ListMembers
@inject CreateProjectInviteHandler CreateInvite
@inject ListProjectInvitesHandler ListInvites
@inject RevokeProjectInviteHandler RevokeInvite
@inject ChangePasswordHandler ChangePassword
@inject ListLabelsHandler ListLabels
@inject CreateLabelHandler CreateLabel
@inject UpdateLabelHandler UpdateLabel
@inject DeleteLabelHandler DeleteLabel
@inject ListDevicesHandler ListDevices
@inject CreateDeviceHandler CreateDevice
@inject RevokeDeviceHandler RevokeDevice
@inject EnqueueCommandHandler EnqueueCommand
@inject GetCommandHandler GetCommand
@inject ListRuntimesHandler ListRuntimes
@inject AttachRuntimeHandler AttachRuntime
@inject NavigationManager Navigation
@inject ISnackbar Snackbar
@inject IDialogService Dialogs

<PageTitle>@L["Settings"]</PageTitle>
<PageHeader Title="@L["Settings"]">
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Href="/projects/new">
        @L["CreateProject"]
    </MudButton>
</PageHeader>

<MudText Typo="Typo.h6" Class="mb-3">@L["Devices"]</MudText>
<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
    <div class="beacon-form">
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Class="mb-3">
            <MudTextField @bind-Value="_deviceName" Label="@L["DeviceName"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="AddDevice" Disabled="_busy">@L["AddDevice"]</MudButton>
            <MudButton Variant="Variant.Outlined" OnClick="ReloadDevices" Disabled="_busy">@L["Refresh"]</MudButton>
        </MudStack>
    </div>
    @if (!string.IsNullOrEmpty(_deviceToken))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-3">@string.Format(L["DeviceTokenOnce"].Value, Navigation.BaseUri.TrimEnd('/'), _deviceToken)</MudAlert>
    }
    @if (_devices.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L["NoDevicesYet"]</MudAlert>
    }
    else
    {
        <MudTable Items="_devices" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L["DeviceName"]</MudTh>
                <MudTh>@L["Status"]</MudTh>
                <MudTh>@L["LastSeen"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="@(context.Online ? Color.Success : Color.Default)">
                        @(context.Online ? L["DeviceOnline"].Value : L["DeviceOffline"].Value)
                    </MudChip>
                </MudTd>
                <MudTd>@(context.LastHeartbeatAt?.ToLocalTime().ToString("g") ?? "-")</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => Revoke(context)">@L["Delete"]</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    </MudPaper>

@if (_devices.Count > 0)
{
    <MudText Typo="Typo.h6" Class="mb-3">@L["Workstation"]</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <div class="beacon-form">
            <MudSelect T="Guid?" Value="_wsDeviceId" ValueChanged="OnWorkstationDeviceChanged" Label="@L["RuntimeDevice"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var device in _devices)
                {
                    <MudSelectItem Value="@((Guid?)device.Id)">@device.Name</MudSelectItem>
                }
            </MudSelect>
            <MudTextField @bind-Value="_modelsRoot" Label="@L["ModelsRoot"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            <MudTextField @bind-Value="_historyDir" Label="@L["HistoryDir"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            <MudTextField @bind-Value="_projectsRoot" Label="@L["ProjectsRoot"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            <MudTextField @bind-Value="_llamaSwapBin" Label="@L["LlamaSwapBin"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            <MudTextField @bind-Value="_llamaCppBin" Label="@L["LlamaCppBin"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveWorkstation" Disabled="_busy || _wsDeviceId is null">@L["SaveWorkstation"]</MudButton>
        </div>
        <MudText Typo="Typo.subtitle2" Class="mt-4">@L["Probe"]</MudText>
        <MudText Typo="Typo.body2">@L["ProbeGit"]: @_probeGit</MudText>
        <MudText Typo="Typo.body2">@L["ProbeOpencode"]: @_probeOpencode</MudText>
        <MudText Typo="Typo.body2">@L["ProbeNode"]: @_probeNode</MudText>
        <MudText Typo="Typo.body2">@L["ProbeDocker"]: @_probeDocker</MudText>
        <MudText Typo="Typo.body2">@L["ProbeLlamaSwap"]: @_probeLlamaSwap</MudText>
        <MudStack Row="true" Spacing="2" Class="mt-2">
            @if (_probeGit == "-")
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="InstallGit">@L["Install"] git</MudButton>
            }
            @if (_probeNode == "-")
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="InstallNode">@L["Install"] node</MudButton>
            }
            @if (_probeDocker == "-")
            {
                <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="InstallDocker">@L["Install"] docker</MudButton>
            }
        </MudStack>
    </MudPaper>
}

@if (!_projectMissing && _projectId is { })
{
    <MudText Typo="Typo.h6" Class="mb-3">@L["ProjectFolder"]</MudText>
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">@L["BrowseOnDeviceHint"]</MudText>
        @if (_runtimes.Count > 0)
        {
            <MudText Typo="Typo.body2" Class="mb-2">@_runtimes[0].DeviceName: @_runtimes[0].LocalRoot</MudText>
        }
        <div class="beacon-form">
            <MudSelect T="Guid?" @bind-Value="_folderDeviceId" Label="@L["RuntimeDevice"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                @foreach (var device in _devices)
                {
                    <MudSelectItem Value="@((Guid?)device.Id)">@device.Name (@(device.Online ? L["DeviceOnline"].Value : L["DeviceOffline"].Value))</MudSelectItem>
                }
            </MudSelect>
            <div class="mt-2">
                <FolderPicker DeviceId="_folderDeviceId" UserId="_userId" Path="_folderPath" PathChanged="OnFolderPathChanged"
                              Disabled="_busy || FolderDevice is not { Online: true }" Label="@L["ProjectDirectory"]" />
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SaveProjectFolder"
                       Disabled="_busy || _folderDeviceId is null || string.IsNullOrWhiteSpace(_folderPath)">
                @L["AttachFolder"]
            </MudButton>
        </div>
    </MudPaper>
}

<MudText Typo="Typo.h6" Class="mb-3">@L["Members"]</MudText>
@if (_projectMissing)
{
    <MudAlert Severity="Severity.Info" Class="mb-4">@L["NoProjectAvailable"]</MudAlert>
}
else
{
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <div class="beacon-form">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap" Class="mb-3">
                <MudTextField @bind-Value="_inviteEmail" Label="@L["Email"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudSelect T="MemberRole" @bind-Value="_inviteRole" Label="@L["Role"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@MemberRole.Member">@L["RoleMember"]</MudSelectItem>
                    <MudSelectItem Value="@MemberRole.Admin">@L["RoleAdmin"]</MudSelectItem>
                    <MudSelectItem Value="@MemberRole.Owner">@L["RoleOwner"]</MudSelectItem>
                </MudSelect>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SendInvite" Disabled="_busy">@L["InviteMember"]</MudButton>
            </MudStack>
        </div>
        @if (!string.IsNullOrEmpty(_inviteUrl))
        {
            <MudAlert Severity="Severity.Warning" Class="mb-3">@L["InviteSent"] @_inviteUrl</MudAlert>
        }
        @if (_members.Count == 0)
        {
            <MudAlert Severity="Severity.Info">@L["NoMembersYet"]</MudAlert>
        }
        else
        {
            <MudTable Items="_members" Dense="true" Hover="true" Class="mb-3">
                <HeaderContent>
                    <MudTh>@L["Username"]</MudTh>
                    <MudTh>@L["Email"]</MudTh>
                    <MudTh>@L["Role"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Login</MudTd>
                    <MudTd>@context.Email</MudTd>
                    <MudTd>@context.Role</MudTd>
                </RowTemplate>
            </MudTable>
        }
        @if (_invites.Count > 0)
        {
            <MudText Typo="Typo.subtitle2" Class="mb-2">@L["PendingInvites"]</MudText>
            <MudTable Items="_invites" Dense="true" Hover="true">
                <HeaderContent>
                    <MudTh>@L["Email"]</MudTh>
                    <MudTh>@L["Role"]</MudTh>
                    <MudTh>@L["Status"]</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Email</MudTd>
                    <MudTd>@context.Role</MudTd>
                    <MudTd>@context.Status</MudTd>
                    <MudTd>
                        @if (context.Status == "Pending")
                        {
                            <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => Revoke(context)">@L["RevokeInvite"]</MudButton>
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>
}

<MudText Typo="Typo.h6" Class="mb-3">@L["ChangePassword"]</MudText>
<MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
    <div class="beacon-form">
        <MudTextField @bind-Value="_currentPassword" Label="@L["CurrentPassword"]" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" />
        <MudTextField @bind-Value="_newPassword" Label="@L["NewPassword"]" InputType="InputType.Password" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-2" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" OnClick="SavePassword" Disabled="_busy">@L["ChangePassword"]</MudButton>
    </div>
</MudPaper>

<MudText Typo="Typo.h6" Class="mb-3">@L["Labels"]</MudText>
@if (_projectMissing)
{
    <MudAlert Severity="Severity.Info">@L["NoProjectAvailable"]</MudAlert>
}
else
{
    <MudPaper Elevation="0" Outlined="true" Class="beacon-panel mb-4">
        <div class="beacon-form">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End" Wrap="Wrap.Wrap">
                <MudTextField @bind-Value="_labelName" Label="@L["Title"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_labelPrefix" Label="@L["PathPrefix"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="SaveLabel" Disabled="_busy">
                    @(_editingLabelId is null ? L["Create"] : L["Save"])
                </MudButton>
                @if (_editingLabelId is not null)
                {
                    <MudButton Variant="Variant.Text" OnClick="CancelLabelEdit">@L["Cancel"]</MudButton>
                }
            </MudStack>
        </div>
    </MudPaper>
    @if (_labels.Count == 0)
    {
        <MudAlert Severity="Severity.Info">@L["NoLabelsYet"]</MudAlert>
    }
    else
    {
        <MudTable Items="_labels" Dense="true" Hover="true">
            <HeaderContent>
                <MudTh>@L["Title"]</MudTh>
                <MudTh>@L["PathPrefix"]</MudTh>
                <MudTh></MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.PathPrefix</MudTd>
                <MudTd>
                    <MudButton Size="Size.Small" Variant="Variant.Text" OnClick="() => StartLabelEdit(context)">@L["Edit"]</MudButton>
                    <MudButton Size="Size.Small" Variant="Variant.Text" Color="Color.Error" OnClick="() => RemoveLabel(context)">@L["Delete"]</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
}

@code {
    private List<LabelDto> _labels = [];
    private List<ProjectMemberDto> _members = [];
    private List<InviteListDto> _invites = [];
    private List<DaemonDeviceDto> _devices = [];
    private bool _projectMissing;
    private Guid? _projectId;
    private string _labelName = string.Empty;
    private string _labelPrefix = string.Empty;
    private Guid? _editingLabelId;
    private string _deviceName = string.Empty;
    private string? _deviceToken;
    private bool _busy;
    private Guid _userId;
    private bool _isAdmin;
    private string _inviteEmail = string.Empty;
    private MemberRole _inviteRole = MemberRole.Member;
    private string? _inviteUrl;
    private string _currentPassword = string.Empty;
    private string _newPassword = string.Empty;
    private Guid? _wsDeviceId;
    private string _modelsRoot = string.Empty;
    private string _historyDir = string.Empty;
    private string _projectsRoot = string.Empty;
    private string _llamaSwapBin = string.Empty;
    private string _llamaCppBin = string.Empty;
    private string _probeGit = "-";
    private string _probeOpencode = "-";
    private string _probeNode = "-";
    private string _probeDocker = "-";
    private string _probeLlamaSwap = "-";
    private List<ProjectRuntimeDto> _runtimes = [];
    private Guid? _folderDeviceId;
    private string _folderPath = string.Empty;

    private DaemonDeviceDto? FolderDevice => _devices.FirstOrDefault(d => d.Id == _folderDeviceId);

    protected override async Task OnInitializedAsync()
    {
        var user = (await Auth.GetAuthenticationStateAsync()).User;
        if (Guid.TryParse(user.FindFirst(ClaimTypes.NameIdentifier)?.Value, out var id))
            _userId = id;
        _isAdmin = bool.TryParse(user.FindFirst("isAdmin")?.Value, out var adminFlag) && adminFlag;
        var current = await CurrentProject.HandleAsync(user);
        if (current.Value is null)
            _projectMissing = true;
        else
        {
            _projectId = current.Value.Id;
            await ReloadLabels();
            await ReloadMembers();
        }
        await ReloadDevices();
        await ReloadRuntimes();
    }

    private async Task ReloadDevices()
    {
        if (_userId == Guid.Empty) return;
        var listed = await ListDevices.HandleAsync(new ListDevicesCommand(new ListDevicesRequest(_userId)));
        _devices = listed.Success ? listed.Value!.ToList() : [];
        _wsDeviceId ??= _devices.FirstOrDefault(d => d.Online)?.Id ?? _devices.FirstOrDefault()?.Id;
        if (_wsDeviceId is { } id)
            LoadWorkstation(id);
    }

    private Task OnWorkstationDeviceChanged(Guid? id)
    {
        _wsDeviceId = id;
        if (id is { } deviceId)
            LoadWorkstation(deviceId);
        return Task.CompletedTask;
    }

    private void LoadWorkstation(Guid deviceId)
    {
        var device = _devices.FirstOrDefault(d => d.Id == deviceId);
        if (device is null) return;
        FillProbe(device.ProbeJson);
        try
        {
            using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(device.WorkstationJson) ? "{}" : device.WorkstationJson);
            var root = doc.RootElement;
            _modelsRoot = Str(root, "modelsRoot");
            _historyDir = Str(root, "opencodeDataDir");
            _projectsRoot = Str(root, "projectsRoot");
            _llamaSwapBin = Str(root, "llamaSwapBin");
            _llamaCppBin = Str(root, "llamaCppBin");
        }
        catch (JsonException)
        {
        }
    }

    private static string Str(JsonElement root, string name) =>
        root.TryGetProperty(name, out var p) && p.ValueKind == JsonValueKind.String ? p.GetString() ?? "" : "";

    private Task OnFolderPathChanged(string path)
    {
        _folderPath = path;
        return Task.CompletedTask;
    }

    private async Task ReloadRuntimes()
    {
        _runtimes = [];
        if (_projectId is not { } projectId || _userId == Guid.Empty)
            return;
        var listed = await ListRuntimes.HandleAsync(new ListRuntimesCommand(new ListRuntimesRequest(projectId, _userId)));
        if (!listed.Success)
            return;
        _runtimes = listed.Value!.ToList();
        var current = _runtimes.FirstOrDefault();
        if (current is not null)
        {
            _folderDeviceId ??= current.DeviceId;
            if (string.IsNullOrWhiteSpace(_folderPath))
                _folderPath = current.LocalRoot;
        }
        _folderDeviceId ??= _devices.FirstOrDefault(d => d.Online)?.Id ?? _devices.FirstOrDefault()?.Id;
    }

    private async Task SaveProjectFolder()
    {
        if (_projectId is not { } projectId || _folderDeviceId is not { } deviceId || string.IsNullOrWhiteSpace(_folderPath) || _userId == Guid.Empty)
            return;
        _busy = true;
        try
        {
            var attached = await AttachRuntime.HandleAsync(new AttachRuntimeCommand(
                new AttachRuntimeRequest(projectId, deviceId, _userId, _folderPath)));
            if (!attached.Success)
            {
                Snackbar.Add(attached.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["ProjectFolderSaved"].Value, Severity.Success);
            await ReloadRuntimes();
        }
        finally
        {
            _busy = false;
        }
    }

    private void FillProbe(string probeJson)
    {
        _probeGit = _probeOpencode = _probeNode = _probeDocker = _probeLlamaSwap = "-";
        try
        {
            using var doc = JsonDocument.Parse(string.IsNullOrWhiteSpace(probeJson) ? "{}" : probeJson);
            _probeGit = Tool(doc.RootElement, "git");
            _probeOpencode = Tool(doc.RootElement, "opencode");
            _probeNode = Tool(doc.RootElement, "node");
            _probeDocker = Tool(doc.RootElement, "docker");
            _probeLlamaSwap = Tool(doc.RootElement, "llamaSwap");
        }
        catch (JsonException)
        {
        }
    }

    private static string Tool(JsonElement root, string name)
    {
        if (!root.TryGetProperty(name, out var p) || p.ValueKind != JsonValueKind.String)
            return "-";
        var value = p.GetString();
        return string.IsNullOrWhiteSpace(value) ? "-" : value;
    }

    private async Task SaveWorkstation()
    {
        if (_wsDeviceId is not { } deviceId || _userId == Guid.Empty) return;
        _busy = true;
        try
        {
            var payload = JsonSerializer.Serialize(new
            {
                modelsRoot = _modelsRoot,
                opencodeDataDir = _historyDir,
                projectsRoot = _projectsRoot,
                llamaSwapBin = _llamaSwapBin,
                llamaCppBin = _llamaCppBin
            });
            var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
                new EnqueueCommandRequest(deviceId, _userId, WorkstationCommandKind.SaveWorkstation, payload, null)));
            if (!queued.Success)
            {
                Snackbar.Add(queued.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            var finished = await WaitAsync(queued.Value!.Id);
            if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded)
            {
                Snackbar.Add(finished?.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["WorkstationSaved"].Value, Severity.Success);
            await ReloadDevices();
        }
        finally
        {
            _busy = false;
        }
    }

    private Task InstallGit() => Install("git");
    private Task InstallNode() => Install("node");
    private Task InstallDocker() => Install("docker");

    private async Task Install(string id)
    {
        if (_wsDeviceId is not { } deviceId || _userId == Guid.Empty) return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, string.Format(L["InstallConfirm"].Value, id),
            yesText: L["Install"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true) return;
        _busy = true;
        try
        {
            var queued = await EnqueueCommand.HandleAsync(new EnqueueCommandCommand(
                new EnqueueCommandRequest(deviceId, _userId, WorkstationCommandKind.Install, JsonSerializer.Serialize(new { id }), null)));
            if (!queued.Success)
            {
                Snackbar.Add(queued.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            var finished = await WaitAsync(queued.Value!.Id);
            if (finished is null || finished.Status != WorkstationCommandStatus.Succeeded)
            {
                Snackbar.Add(finished?.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            Snackbar.Add(L["InstallQueued"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task<WorkstationCommandDto?> WaitAsync(Guid commandId)
    {
        for (var i = 0; i < 80; i++)
        {
            var got = await GetCommand.HandleAsync(new GetCommandCommand(new GetCommandRequest(commandId, _userId)));
            if (!got.Success) return null;
            if (got.Value!.Status is WorkstationCommandStatus.Succeeded or WorkstationCommandStatus.Failed or WorkstationCommandStatus.Cancelled)
                return got.Value;
            await Task.Delay(500);
        }
        return null;
    }

    private async Task ReloadMembers()
    {
        if (_projectId is not { } projectId || _userId == Guid.Empty)
            return;
        var listed = await ListMembers.HandleAsync(new GetProjectMembersCommand(new GetProjectMembersRequest(projectId)));
        _members = listed.Success ? listed.Value!.ToList() : [];
        var invites = await ListInvites.HandleAsync(new ListInvitesRequest(projectId, _userId, _isAdmin));
        _invites = invites.Success ? invites.Value!.ToList() : [];
    }

    private async Task SendInvite()
    {
        if (_projectId is not { } projectId || string.IsNullOrWhiteSpace(_inviteEmail) || _busy)
            return;
        _busy = true;
        try
        {
            var created = await CreateInvite.HandleAsync(new CreateProjectInviteRequest(
                projectId, _inviteEmail.Trim(), _inviteRole, _userId, _isAdmin));
            if (!created.Success)
            {
                Snackbar.Add(created.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _inviteUrl = created.Value!.Url;
            _inviteEmail = string.Empty;
            Snackbar.Add(L["InviteSent"].Value, Severity.Success);
            await ReloadMembers();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Revoke(InviteListDto invite)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, L["RevokeInvite"].Value,
            yesText: L["Delete"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true) return;
        var result = await RevokeInvite.HandleAsync(new RevokeInviteRequest(invite.Id, _userId, _isAdmin));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await ReloadMembers();
    }

    private async Task SavePassword()
    {
        if (_userId == Guid.Empty || _busy) return;
        _busy = true;
        try
        {
            var result = await ChangePassword.HandleAsync(new ChangePasswordRequest(_userId, _currentPassword, _newPassword));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _currentPassword = string.Empty;
            _newPassword = string.Empty;
            Snackbar.Add(L["PasswordChanged"].Value, Severity.Success);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task ReloadLabels()
    {
        if (_projectId is not { } projectId)
            return;
        var listed = await ListLabels.HandleAsync(new ListLabelsRequest(projectId));
        _labels = listed.Success ? listed.Value!.ToList() : [];
    }

    private void StartLabelEdit(LabelDto label)
    {
        _editingLabelId = label.Id;
        _labelName = label.Name;
        _labelPrefix = label.PathPrefix;
    }

    private void CancelLabelEdit()
    {
        _editingLabelId = null;
        _labelName = string.Empty;
        _labelPrefix = string.Empty;
    }

    private async Task SaveLabel()
    {
        if (_projectId is not { } projectId || string.IsNullOrWhiteSpace(_labelName) || _busy)
            return;
        _busy = true;
        try
        {
            if (_editingLabelId is { } id)
            {
                var updated = await UpdateLabel.HandleAsync(new UpdateLabelRequest(
                    projectId, id, _labelName.Trim(), null, _labelPrefix));
                if (!updated.Success)
                {
                    Snackbar.Add(updated.Error ?? L["Error"].Value, Severity.Error);
                    return;
                }
            }
            else
            {
                var created = await CreateLabel.HandleAsync(new CreateLabelRequest(
                    projectId, _labelName.Trim(), null, _labelPrefix));
                if (!created.Success)
                {
                    Snackbar.Add(created.Error ?? L["Error"].Value, Severity.Error);
                    return;
                }
            }
            CancelLabelEdit();
            Snackbar.Add(L["Saved"].Value, Severity.Success);
            await ReloadLabels();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task RemoveLabel(LabelDto label)
    {
        if (_projectId is not { } projectId)
            return;
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, L["DeleteLabelConfirm"].Value,
            yesText: L["Delete"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true) return;
        var result = await DeleteLabel.HandleAsync(new DeleteLabelRequest(projectId, label.Id));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        if (_editingLabelId == label.Id)
            CancelLabelEdit();
        Snackbar.Add(L["Saved"].Value, Severity.Success);
        await ReloadLabels();
    }

    private async Task AddDevice()
    {
        if (_userId == Guid.Empty || _busy) return;
        _busy = true;
        try
        {
            var name = string.IsNullOrWhiteSpace(_deviceName) ? Environment.MachineName : _deviceName.Trim();
            var result = await CreateDevice.HandleAsync(new CreateDeviceCommand(
                new CreateDeviceRequest(name, "web-" + Guid.NewGuid().ToString("N"), _userId)));
            if (!result.Success)
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _deviceToken = result.Value!.Token;
            _deviceName = string.Empty;
            Snackbar.Add(L["DeviceCreated"].Value, Severity.Success);
            await ReloadDevices();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Revoke(DaemonDeviceDto device)
    {
        var confirmed = await Dialogs.ShowMessageBoxAsync(
            L["Confirm"].Value, L["RevokeDeviceConfirm"].Value,
            yesText: L["Delete"].Value, cancelText: L["Cancel"].Value);
        if (confirmed != true) return;
        var result = await RevokeDevice.HandleAsync(new RevokeDeviceCommand(new RevokeDeviceRequest(device.Id, _userId)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(L["DeviceRevoked"].Value, Severity.Success);
        await ReloadDevices();
    }
}
