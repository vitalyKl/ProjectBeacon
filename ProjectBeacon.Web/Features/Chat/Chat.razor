@page "/chat"
@layout MainLayout
@attribute [Authorize]
@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Agents
@using ProjectBeacon.Application.Chat
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject AuthenticationStateProvider Auth
@inject GetCurrentProjectHandler CurrentProject
@inject CreateChatSessionHandler CreateSession
@inject ListChatSessionsHandler ListSessions
@inject ListChatPartsHandler ListParts
@inject GetChatSessionHandler GetSession
@inject SendChatPromptHandler SendPrompt
@inject AbortChatHandler AbortChat
@inject RenameChatSessionHandler RenameSession
@inject ArchiveChatSessionHandler ArchiveSession
@inject GetModelRegistryHandler GetRegistry
@inject GetChatModelHandler GetChatModel
@inject ChatEventSignal Events
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<Chat> Logger

<PageTitle>@L["Chat"]</PageTitle>
<PageHeader Title="@L["Chat"]" />

@if (_project is null)
{
    <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" Href="/projects/new">@L["CreateProject"]</MudButton>
}
else
{
    <div class="beacon-chat-page">
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel beacon-chat-sessions">
            <MudText Typo="Typo.caption" Class="beacon-chat-project">@_project.Name</MudText>
            <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="NewChat" Disabled="_busy" Class="beacon-new-chat">@L["NewChat"]</MudButton>
            @if (_sessions.Count == 0)
            {
                <MudDivider/>
                <MudText Typo="Typo.caption">@L["NoChatsYet"]</MudText>
            }
            @foreach (var session in _sessions)
            {
                <div class="beacon-session-item @SessionClass(session)">
                    <div class="beacon-session-main" @onclick="() => Select(session)">
                        <MudText Typo="Typo.body2" Class="beacon-ellipsis">@session.Title</MudText>
                        <MudText Typo="Typo.caption">@session.CreatedAt.ToLocalTime().ToString("g")</MudText>
                        @if (session.Status == ChatSessionStatus.Streaming)
                        {
                            <StatusChip Color="Color.Info" Label="@L["ChatBusy"]" />
                        }
                    </div>
                    <div @onclick:stopPropagation="true">
                        <MudIconButton Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Edit" OnClick="() => Rename(session)" title="@L["ChatRename"].Value" aria-label="@L["ChatRename"].Value" />
                        <MudIconButton Size="Size.Small" Variant="Variant.Text" Icon="@Icons.Material.Filled.Archive" OnClick="() => Archive(session)" title="@L["ChatArchive"].Value" aria-label="@L["ChatArchive"].Value" />
                    </div>
                </div>
            }
        </MudPaper>
        <MudPaper Elevation="0" Outlined="true" Class="beacon-panel beacon-chat-pane">
            @if (_block == "folder")
            {
                <MudAlert Severity="Severity.Info">@L["ChatNeedsFolder"]</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-3" Href="/dashboard">@L["Dashboard"]</MudButton>
            }
            else if (_block == "client")
            {
                <MudAlert Severity="Severity.Info">@L["ChatNeedsClient"]</MudAlert>
            }
            else if (_selected is null)
            {
                <MudAlert Severity="Severity.Info">@L["ChatEmptyHint"]</MudAlert>
            }
            else
            {
                <ChatPane
                    Session="_selected"
                    ShowSessionHead
                    Parts="_parts"
                    Phase="Phase"
                    PhaseLabel="PhaseLabel"
                    PhaseColor="PhaseColor"
                    ShowModelSelect
                    Models="_models"
                    @bind-Model="_model"
                    @bind-Draft="_draft"
                    DraftLabel="@L["Message"]"
                    Busy="_busy"
                    CanAbort="_selected.Status == ChatSessionStatus.Streaming"
                    CanRetry="CanRetry"
                    Send="Send"
                    Abort="Abort"
                    Retry="Retry" />
            }
        </MudPaper>
    </div>
}

@code {
    private Guid _userId;
    private string? _block;
    private ProjectDto? _project;
    private List<ChatSessionDto> _sessions = [];
    private ChatSessionDto? _selected;
    private List<ChatPartDto> _parts = [];
    private List<string> _models = [];
    private string? _model;
    private string _draft = string.Empty;
    private bool _busy;
    private bool _failed;
    private CancellationTokenSource? _poll;

    protected override async Task OnInitializedAsync()
    {
        var actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        if (actor.UserId is not null)
            _userId = actor.UserId.Value;
        var current = await CurrentProject.HandleAsync(actor);
        _project = current.Value;
        if (_project is null)
            return;
        var registry = await GetRegistry.HandleAsync(new GetModelRegistryCommand(_userId));
        if (registry.Success)
        {
            _models = registry.Value!.Backends.Select(b => b.Name).ToList();
            var preferred = await GetChatModel.HandleAsync(new GetChatModelCommand(_userId));
            if (preferred.Success && preferred.Value is Guid backendId)
            {
                var chosen = registry.Value.Backends.FirstOrDefault(b => b.Id == backendId);
                if (chosen is not null)
                    _model = OpencodePayload.OpenCodeId(chosen);
            }
        }
        await ReloadSessions();
        if (_sessions.Count > 0)
            await Select(_sessions[0]);
        _ = PollAsync();
    }

    private async Task ReloadSessions()
    {
        var listed = await ListSessions.HandleAsync(new ListChatSessionsCommand(new ListChatSessionsRequest(_userId)));
        _sessions = listed.Success ? listed.Value!.ToList() : [];
    }

    private async Task Select(ChatSessionDto session)
    {
        _selected = session;
        var parts = await ListParts.HandleAsync(new ListChatPartsCommand(new ListChatPartsRequest(session.Id, _userId)));
        // The user may have switched sessions while the fetch was in flight; never apply stale parts.
        if (_selected?.Id != session.Id)
            return;
        _parts = parts.Success ? parts.Value!.ToList() : [];
    }

    private async Task NewChat()
    {
        _busy = true;
        try
        {
            var created = await CreateSession.HandleAsync(new CreateChatSessionCommand(new CreateChatSessionRequest(_userId, L["Chat"].Value)));
            if (!created.Success)
            {
                _block = created.Error switch
                {
                    CreateChatSessionHandler.ProjectFolderRequired => "folder",
                    CreateChatSessionHandler.ClientRequired => "client",
                    _ => null
                };
                if (_block is null)
                    Snackbar.Add(created.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _block = null;
            await ReloadSessions();
            await Select(created.Value!);
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Rename(ChatSessionDto session)
    {
        var parameters = new DialogParameters { ["Session"] = session };
        await DialogService.ShowAsync(typeof(RenameChatSessionDialog), L["ChatRename"].Value, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var selectedId = _selected?.Id;
        await ReloadSessions();
        _selected = selectedId is not null ? _sessions.FirstOrDefault(s => s.Id == selectedId.Value) : _selected;
    }

    private async Task Archive(ChatSessionDto session)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(L["ChatArchive"].Value, session.Title, L["Confirm"].Value, L["Cancel"].Value);
        if (confirmed != true)
            return;
        var result = await ArchiveSession.HandleAsync(new ArchiveChatSessionCommand(new ArchiveChatSessionRequest(session.Id, _userId)));
        if (!result.Success)
        {
            Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            return;
        }
        _sessions.RemoveAll(s => s.Id == session.Id);
        if (_selected?.Id == session.Id)
        {
            _selected = null;
            _parts = [];
        }
    }

    private async Task Send()
    {
        if (_selected is null || string.IsNullOrWhiteSpace(_draft))
            return;
        _busy = true;
        _failed = false;
        try
        {
            var sent = await SendPrompt.HandleAsync(new SendChatPromptCommand(new SendChatPromptRequest(_selected.Id, _userId, _draft, _model)));
            if (!sent.Success)
            {
                _failed = true;
                Snackbar.Add(sent.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _draft = string.Empty;
            if (sent.Value is { } selected)
            {
                _selected = selected;
                await Select(selected);
            }
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Abort()
    {
        if (_selected is null)
            return;
        var result = await AbortChat.HandleAsync(new AbortChatCommand(new AbortChatRequest(_selected.Id, _userId)));
        if (result.Success)
            _selected = result.Value;
    }

    // Two-stage live update: the in-process ChatEventSignal wakes this loop the moment a part is
    // appended or the session status changes (writer and readers share the Web process in
    // self-hosted deployments). The 5-second safety net stays because the signal is in-memory
    // only: it is lost on a Blazor circuit reconnect, when a part is written by another
    // replica, or when it fires before this loop starts waiting. The timer guarantees the UI
    // converges within 5 seconds regardless.
    [Parameter] public TimeSpan PollSafetyNet { get; set; } = TimeSpan.FromSeconds(5);

    private async Task PollAsync()
    {
        _poll = new CancellationTokenSource();
        try
        {
            while (!_poll.Token.IsCancellationRequested)
            {
                try
                {
                    if (_selected is null)
                    {
                        await Task.Delay(PollSafetyNet, _poll.Token);
                        continue;
                    }
                    // Capture the id before the waits and fetches: a session switch in flight must
                    // not apply stale results to the newer selection.
                    var sessionId = _selected.Id;
                    await Events.WaitAsync(sessionId, PollSafetyNet, _poll.Token);
                    if (_selected?.Id != sessionId)
                        continue;
                    var session = await GetSession.HandleAsync(new GetChatSessionCommand(new GetChatSessionRequest(sessionId, _userId)));
                    if (session.Success && session.Value!.Id == sessionId && _selected?.Id == sessionId)
                        _selected = session.Value;
                    var parts = await ListParts.HandleAsync(new ListChatPartsCommand(new ListChatPartsRequest(sessionId, _userId)));
                    if (parts.Success && _selected?.Id == sessionId)
                        _parts = parts.Value!.ToList();
                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException) when (_poll.Token.IsCancellationRequested)
                {
                    break;
                }
                catch (Exception ex)
                {
                    // Transient failures (a DB timeout surfaces as a TaskCanceledException) must not
                    // kill the loop: back off and retry.
                    Logger.LogWarning(ex, "Chat poll iteration failed; retrying in {Delay}s.", (int)PollSafetyNet.TotalSeconds);
                    try
                    {
                        await Task.Delay(PollSafetyNet, _poll.Token);
                    }
                    catch (OperationCanceledException)
                    {
                        break;
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private string? LastKind => _parts.LastOrDefault()?.Kind;

    private string Phase => ChatPhase.Resolve(_selected?.Status, LastKind, _failed, _parts.Count);

    private string PhaseLabel => L[ChatPhase.LabelKey(Phase)].Value;

    private Color PhaseColor => Phase switch
    {
        "Failed" or "Aborted" => Color.Error,
        "Completed" => Color.Success,
        "Generating" or "UsingTool" or "Waiting" => Color.Info,
        _ => Color.Default
    };

    private bool CanRetry => Phase is "Failed" or "Aborted"
        && _parts.Any(p => string.Equals(p.Role, "user", StringComparison.OrdinalIgnoreCase));

    private async Task Retry()
    {
        var last = _parts.LastOrDefault(p => string.Equals(p.Role, "user", StringComparison.OrdinalIgnoreCase));
        if (last is null || string.IsNullOrWhiteSpace(last.Body))
            return;
        _draft = last.Body;
        await Send();
    }

    private string SessionClass(ChatSessionDto session) => _selected?.Id == session.Id ? "beacon-session-active" : "";

    public void Dispose()
    {
        _poll?.Cancel();
        _poll?.Dispose();
    }
}
