@using System.Text.Json
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Agents
@using ProjectBeacon.Application.Chat
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject IJSRuntime Js
@inject AuthenticationStateProvider Auth
@inject SwitchChatAgentHandler SwitchAgent
@inject ISnackbar Snackbar
@inject IDialogService DialogService

@if (ShowSessionHead && Session is not null)
{
    <div class="beacon-chat-session-head">
        <div class="beacon-chat-session-title">
            <strong>@Session.Title</strong>
            @if (!string.IsNullOrEmpty(Phase))
            {
                <StatusChip Color="@PhaseColor" Label="@PhaseLabel" />
            }
        </div>

    </div>
}
<div class="beacon-chat-log" @ref="_log">
    @foreach (var part in Parts)
    {
        <ChatPartView Part="part" ModelName="@ModelName" />
    }
</div>
@if (_showJump)
{
    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.ArrowDownward" OnClick="JumpToLatest" Class="beacon-chat-jump">@L["ChatJumpToLatest"]</MudButton>
}
@if (_pendingQuestions.Count > 0)
{
    <div class="beacon-chat-question-tabs d-flex flex-wrap gap-1 mt-2">
        @foreach (var q in _pendingQuestions)
        {
            <MudButton Class="beacon-chat-question-tab" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Help" OnClick="() => ScrollToQuestion(q.Id)">@q.Title</MudButton>
        }
    </div>
}
@if (!string.IsNullOrEmpty(Phase))
{
    <MudText Typo="Typo.caption" Class="mt-2">@PhaseLabel</MudText>
    @if (Phase is "Generating" or "UsingTool" or "Waiting")
    {
        <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="my-2" />
    }
}
@if (Phase is "Failed" or "Aborted")
{
    <MudAlert Severity="Severity.Error" Class="mt-2">@PhaseLabel</MudAlert>
}

@if (ShowModelSelect)
{
    <div class="beacon-chat-model-bar">
        <MudButton Variant="Variant.Outlined"
                   StartIcon="@Icons.Material.Filled.Tune"
                   Class="beacon-chat-config-button"
                   OnClick="ConfigureModel"
                   title="@L["ChatModelSettings"].Value">
            @ModelSummary
        </MudButton>
        @if (!string.IsNullOrEmpty(ModelStatus))
        {
            @if (ModelStatus == "switching")
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Info" Class="beacon-chat-model-progress" />
            }
            <MudText Typo="Typo.caption" Class="beacon-chat-model-status">@ModelStatusLabel</MudText>
        }
    </div>
}
@if (UsageLabel is { } usage)
{
    <MudText Typo="Typo.caption" Class="beacon-chat-usage mt-2">@usage</MudText>
}
<form class="beacon-chat-compose-form" @onsubmit="OnSendSubmit" @onsubmit:preventDefault="true">
    <MudStack Row="true" AlignItems="AlignItems.End" Spacing="2" Class="mt-2 beacon-chat-compose">
        @if (ShowModelSelect)
        {
            <MudButton Variant="Variant.Outlined"
                       Color="@(_agent == "plan" ? Color.Secondary : Color.Default)"
                       Size="Size.Medium"
                       Class="beacon-chat-mode-toggle"
                       OnClick="ToggleAgent"
                       Disabled="@(_switchingAgent || Busy)"
                       title="@ModeShortcutTitle">
                @(_agent == "plan" ? L["ChatAgentPlan"] : L["ChatAgentAct"])
            </MudButton>
        }
        <MudTextField T="string" Value="@Draft" ValueChanged="OnDraftChanged" Label="@DraftLabel" Variant="Variant.Outlined" Margin="Margin.Dense" Class="flex-grow-1"
                      OnKeyDown="e => OnKey(e)" Disabled="@Busy" />
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="Send" Disabled="@(Busy || string.IsNullOrWhiteSpace(Draft))">@L["Send"]</MudButton>
        @if (CanAbort)
        {
            <MudButton Variant="Variant.Outlined" OnClick="OnAbortClicked" Disabled="@_aborting">@L["Abort"]</MudButton>
        }
        @if (CanRetry)
        {
            <MudButton Variant="Variant.Outlined" OnClick="Retry" Disabled="@Busy">@L["Retry"]</MudButton>
        }
    </MudStack>
</form>

@code {
    // Presentation shared by the full /chat page and the global ChatDock. The hosts own the
    // state, polling, and send/abort/retry operations; they push data and the resolved phase
    // in and receive composer events out.
    [Parameter] public ChatSessionDto? Session { get; set; }
    [Parameter] public bool ShowSessionHead { get; set; }
    [Parameter] public IEnumerable<ChatPartDto> Parts { get; set; } = [];
    [Parameter] public string? Phase { get; set; }
    [Parameter] public string? PhaseLabel { get; set; }
    [Parameter] public Color PhaseColor { get; set; }
    [Parameter] public bool ShowModelSelect { get; set; }
    [Parameter] public List<LocalModelBackendDto> Models { get; set; } = [];
    [Parameter] public string? Model { get; set; }
    [Parameter] public string? ReasoningEffort { get; set; }
    [Parameter] public EventCallback<string?> ReasoningEffortChanged { get; set; }
    [Parameter] public string? ModelStatus { get; set; }
    [Parameter] public string ModelStatusLabel { get; set; } = string.Empty;
    [Parameter] public EventCallback<string?> ModelChanged { get; set; }
    [Parameter] public string Draft { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> DraftChanged { get; set; }
    [Parameter] public string? DraftLabel { get; set; }
    [Parameter] public bool Busy { get; set; }
    [Parameter] public bool CanAbort { get; set; }
    [Parameter] public bool CanRetry { get; set; }
    [Parameter] public string? ModelName { get; set; }
    [Parameter] public int? SelectedContextLimit { get; set; }

    // Session totals reported by the device: prompt tokens, the model's context limit, and cost.
    private string? UsageLabel
    {
        get
        {
            if (Session is not { PromptTokens: not null, TotalCost: not null })
                return null;
            var prompt = Session.PromptTokens!.Value;
            var currentLimit = Model is null ? Session.ContextLimit : SelectedContextLimit;
            var tokens = currentLimit is { } limit ? $"{prompt:N0} / {limit:N0}" : $"{prompt:N0}";
            var label = string.Format(L["ChatUsage"].Value, tokens, "$" + Session.TotalCost!.Value.ToString("0.####"));
            if (Session is { CompletionTokens: not null, GenerationSeconds: { } seconds } && seconds > 0)
                label += "  \u2022  " + string.Format(L["ChatUsageSpeed"].Value, Math.Round(Session.CompletionTokens!.Value / seconds, 1));
            return label;
        }
    }
    [Parameter] public EventCallback<MouseEventArgs> Send { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> Abort { get; set; }
    [Parameter] public EventCallback<MouseEventArgs> Retry { get; set; }

    private ElementReference _log;
    private bool _showJump;
    private bool _followPending;
    private List<(Guid Id, string Title)> _pendingQuestions = [];
    private Guid _sessionId;
    private Guid _lastPartId;
    private int _lastPartLength;
    private bool _attached;
    private Guid _userId;
    private string _agent = "build";
    private bool _switchingAgent;
    private bool _aborting;

    protected override async Task OnInitializedAsync()
    {
        var actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        _userId = actor.UserId ?? Guid.Empty;
    }

    protected override void OnParametersSet()
    {
        RefreshPendingQuestions();
        var sessionId = Session?.Id ?? Guid.Empty;
        var lastPart = Parts.LastOrDefault();
        var lastPartId = lastPart?.Id ?? Guid.Empty;
        var lastPartLength = lastPart?.Body?.Length ?? 0;
        if (!_attached)
        {
            // The first render only records the baseline; it must not scroll the pane open
            // or pin a restored conversation to its newest part.
            _sessionId = sessionId;
            _lastPartId = lastPartId;
            _lastPartLength = lastPartLength;
            _agent = string.Equals(Session?.AgentMode, "plan", StringComparison.OrdinalIgnoreCase) ? "plan" : "build";
            _attached = true;
            return;
        }
        // Agent mode is persisted with the chat session, so switching conversations restores
        // the correct Plan/Act selection instead of silently resetting it to Act.
        if (sessionId != _sessionId)
            _agent = string.Equals(Session?.AgentMode, "plan", StringComparison.OrdinalIgnoreCase) ? "plan" : "build";
        // The hosts push a sliding window of the latest parts, and streaming upserts reuse
        // the same part id while its body grows: follow on the newest part id or its size.
        if (sessionId != _sessionId || lastPartId != _lastPartId || lastPartLength != _lastPartLength)
        {
            _sessionId = sessionId;
            _lastPartId = lastPartId;
            _lastPartLength = lastPartLength;
            // The DOM still holds the previous parts at this point; the follow must measure
            // scrollHeight after this render commits, so it is deferred to OnAfterRenderAsync.
            _followPending = true;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_followPending)
            return;
        _followPending = false;
        await ScrollFollowAsync();
    }

    private Task OnDraftChanged(string value)
    {
        Draft = value ?? string.Empty;
        return DraftChanged.InvokeAsync(Draft);
    }

    private async Task OnModelChanged(string? value)
    {
        Model = value;
        await ModelChanged.InvokeAsync(value);
    }

    private Task OnEffortChanged(string? value)
    {
        ReasoningEffort = value;
        return ReasoningEffortChanged.InvokeAsync(value);
    }

    private LocalModelBackendDto? SelectedBackend =>
        Models.FirstOrDefault(backend =>
            string.Equals(OpencodePayload.OpenCodeId(backend), Model, StringComparison.Ordinal));

    private string ModelSummary
    {
        get
        {
            var modelName = SelectedBackend?.Name
                ?? (string.IsNullOrWhiteSpace(Model) ? L["Unbound"].Value : Model);
            var effortName = ReasoningEffort switch
            {
                "low" => L["ChatEffortLow"].Value,
                "medium" => L["ChatEffortMedium"].Value,
                "high" => L["ChatEffortHigh"].Value,
                "xhigh" => L["ChatEffortXhigh"].Value,
                _ => L["ChatEffortDefault"].Value
            };
            return $"{modelName} · {effortName}";
        }
    }

    private string ModeShortcutTitle =>
        $"{L["ChatAgent"].Value}: {L[_agent == "plan" ? "ChatAgentPlan" : "ChatAgentAct"].Value} (Ctrl+Shift+M)";

    private async Task ConfigureModel()
    {
        var parameters = new DialogParameters
        {
            ["Models"] = Models,
            ["Model"] = Model,
            ["ReasoningEffort"] = ReasoningEffort
        };
        var dialog = await DialogService.ShowAsync<ChatModelSettingsDialog>(
            L["ChatModelSettings"].Value,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is not { Canceled: false, Data: ChatModelSettingsSelection selection })
            return;

        await OnModelChanged(selection.Model);
        await OnEffortChanged(selection.ReasoningEffort);
    }

    private Task ToggleAgent() => OnAgentChanged(_agent == "plan" ? "build" : "plan");

    private async Task OnAbortClicked(MouseEventArgs e)
    {
        if (_aborting)
            return;
        _aborting = true;
        try { await Abort.InvokeAsync(e); }
        finally { _aborting = false; }
    }

    private async Task OnAgentChanged(string value)
    {
        if (value is not ("build" or "plan") || value == _agent || _switchingAgent)
            return;
        if (Session is not { } session || session.Id == Guid.Empty || _userId == Guid.Empty)
            return;

        _switchingAgent = true;
        try
        {
            var result = await SwitchAgent.HandleAsync(
                new SwitchChatAgentCommand(new SwitchChatAgentRequest(session.Id, _userId, value)));
            if (result.Success)
            {
                _agent = value;
                Snackbar.Add(L["ChatAgentSwitching"].Value, Severity.Info);
            }
            else
            {
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
            }
        }
        finally
        {
            _switchingAgent = false;
        }
    }


    // Enter handling: KeyboardEventArgs has no PreventDefault, so on one Enter both the
    // keydown handler and the native form submit fire. SendOnce serializes them into a
    // single send; _shiftEnter keeps Shift+Enter from sending via the implicit submit.
    private bool _sending;
    private bool _shiftEnter;

    private async Task OnKey(KeyboardEventArgs e)
    {
        if (e.CtrlKey && e.ShiftKey && string.Equals(e.Key, "m", StringComparison.OrdinalIgnoreCase))
        {
            await ToggleAgent();
            return;
        }
        if (e.Key != "Enter")
            return;
        _shiftEnter = e.ShiftKey;
        if (!e.ShiftKey)
            await SendOnce();
    }

    private Task OnSendSubmit()
    {
        if (_shiftEnter)
        {
            _shiftEnter = false;
            return Task.CompletedTask;
        }
        return SendOnce();
    }

    private async Task SendOnce()
    {
        if (_sending)
            return;
        _sending = true;
        try
        {
            await Send.InvokeAsync();
        }
        finally
        {
            _sending = false;
        }
    }

    private async Task JumpToLatest()
    {
        _showJump = false;
        await Js.InvokeVoidAsync("BeaconChat.jumpToLatest", _log);
    }

    // Interleaved follow calls must not let a stale scroll answer from an earlier refresh
    // overwrite the jump-button state decided by a newer one.
    private int _followGeneration;

    private async Task ScrollFollowAsync()
    {
        var generation = ++_followGeneration;
        // One atomic JS call: the proximity check and the snap-to-latest happen together,
        // so a user scroll cannot land between the check and the snap.
        var nearBottom = await Js.InvokeAsync<bool>("BeaconChat.followLatest", _log);
        if (generation != _followGeneration)
            return;
        _showJump = !nearBottom;
        StateHasChanged();
    }

    // Open questions waiting for the answer: one tab per question so the user can jump
    // straight to the form. Answered questions drop off the bar on the next refresh.
    private void RefreshPendingQuestions()
    {
        _pendingQuestions = [];
        foreach (var part in Parts)
        {
            if (!string.Equals(part.Kind, "question", StringComparison.OrdinalIgnoreCase))
                continue;
            var (title, answered) = ReadQuestionState(part.Body);
            if (!answered && title is not null)
                _pendingQuestions.Add((part.Id, title));
        }
    }

    private static (string? Title, bool Answered) ReadQuestionState(string body)
    {
        try
        {
            using var doc = JsonDocument.Parse(body);
            var root = doc.RootElement;
            if (root.ValueKind is not JsonValueKind.Object)
                return (null, false);
            var title = root.TryGetProperty("title", out var t) && t.ValueKind == JsonValueKind.String ? t.GetString() : null;
            var answered = root.TryGetProperty("answer", out var a) && a.ValueKind == JsonValueKind.Object;
            return (string.IsNullOrWhiteSpace(title) ? null : title, answered);
        }
        catch (JsonException)
        {
            return (null, false);
        }
    }

    private async Task ScrollToQuestion(Guid partId)
    {
        await Js.InvokeVoidAsync("BeaconChat.scrollToPart", _log, partId.ToString());
    }
}
