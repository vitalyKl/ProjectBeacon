@implements IDisposable
@using Microsoft.AspNetCore.Components.Authorization
@using ProjectBeacon.Application.Authorization
@using ProjectBeacon.Application.Agents
@using ProjectBeacon.Application.Chat
@using ProjectBeacon.Application.Projects
@using ProjectBeacon.Application.Runtime
@using ProjectBeacon.Domain.Enums
@inject Microsoft.Extensions.Localization.IStringLocalizer<Web> L
@inject NavigationManager Navigation
@inject GetCurrentProjectHandler CurrentProject
@inject ListChatSessionsHandler ListSessions
@inject ListChatPartsHandler ListParts
@inject GetChatSessionHandler GetSession
@inject GetModelRegistryHandler GetRegistry
@inject GetChatModelHandler GetChatModel
@inject GetProxyStatusHandler GetStatus
@inject SendChatPromptHandler SendPrompt
@inject AbortChatHandler AbortChat
@inject CreateChatSessionHandler CreateSession
@inject ChatEventSignal Events
@inject ISnackbar Snackbar
@inject Microsoft.Extensions.Logging.ILogger<ChatDock> Logger
@inject AuthenticationStateProvider Auth

@if (_visible)
{
    @if (_open)
    {
        <MudPaper Elevation="8" Class="beacon-chat-dock">
            <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-2">
                <MudText Typo="Typo.subtitle2">@L["Chat"]</MudText>
                <MudStack Row="true" Spacing="1">
                    <MudButton Size="Size.Small" Variant="Variant.Text" Href="/chat">@L["ChatOpenFull"]</MudButton>
                    <MudIconButton
                        Size="Size.Small"
                        Icon="@Icons.Material.Filled.Close"
                        OnClick="() => _open = false"
                        title="@L["Close"].Value"
                        aria-label="@L["Close"].Value" />
                </MudStack>
            </MudStack>
            @if (_block == "folder")
            {
                <MudAlert Severity="Severity.Info" Dense="true">@L["ChatNeedsFolder"]</MudAlert>
                <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Class="mt-2" Href="/dashboard">@L["Dashboard"]</MudButton>
            }
            else if (_block == "client")
            {
                <MudAlert Severity="Severity.Info" Dense="true">@L["ChatNeedsClient"]</MudAlert>
            }
            else
            {
                <ChatPane
                    Session="_session"
                    ModelName="@SelectedBackendName"
                    SelectedContextLimit="@SelectedContextLimit"
                    ShowModelSelect
                    Models="_models"
                    @bind-Model="_model"
                    @bind-Model:after="OnModelBound"
                    @bind-ReasoningEffort="_effort"
                    ModelStatus="@ModelStatus"
                    ModelStatusLabel="@ModelStatusLabel"
                    Parts="DockParts"
                    Phase="@Phase"
                    PhaseLabel="@PhaseLabel"
                    @bind-Draft="_draft"
                    Busy="_busy"
                    CanAbort="_session?.Status == ChatSessionStatus.Streaming"
                    Send="Send"
                    Abort="Abort" />
            }
        </MudPaper>
    }
    else
    {
        <MudFab Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Chat" Class="beacon-chat-fab" OnClick="Open" title="@L["Chat"]" aria-label="@L["Chat"]" />
    }
}

@code {
    private bool _visible;
    private bool _open;
    private string? _block;
    private Guid _userId;
    private ChatSessionDto? _session;
    private List<ChatPartDto> _parts = [];
    private List<LocalModelBackendDto> _models = [];
    private string? _model;
    private string? _effort;
    private LlamaSwapStatusDto? _proxy;
    private string _draft = string.Empty;
    private bool _busy;
    private bool _aborting;
    private bool _failed;
    private CancellationTokenSource? _poll;

    protected override async Task OnInitializedAsync()
    {
        Navigation.LocationChanged += OnLocation;
        UpdateVisible();
        var actor = ActorContextFactory.FromPrincipal((await Auth.GetAuthenticationStateAsync()).User);
        if (actor.UserId is not null)
            _userId = actor.UserId.Value;
        var current = await CurrentProject.HandleAsync(actor);
        if (current.Value is null || _userId == Guid.Empty)
            return;
        var registry = await GetRegistry.HandleAsync(new GetModelRegistryCommand(_userId));
        if (registry.Success)
        {
            _models = registry.Value!.Backends.ToList();
            var preferred = await GetChatModel.HandleAsync(new GetChatModelCommand(_userId));
            if (preferred.Success && preferred.Value is Guid backendId)
            {
                var chosen = registry.Value.Backends.FirstOrDefault(b => b.Id == backendId);
                if (chosen is not null)
                    _model = OpencodePayload.OpenCodeId(chosen);
            }
        }
        var listed = await ListSessions.HandleAsync(new ListChatSessionsCommand(new ListChatSessionsRequest(_userId)));
        if (listed.Success && listed.Value!.Count > 0)
        {
            _session = listed.Value[0];
            await ReloadParts();
        }
        _ = PollAsync();
    }

    private void OnLocation(object? sender, LocationChangedEventArgs e)
    {
        UpdateVisible();
        _ = InvokeAsync(StateHasChanged);
    }

    private void UpdateVisible()
    {
        var path = Navigation.ToBaseRelativePath(Navigation.Uri).Split('?', '#')[0].Trim('/');
        _visible = path is not ("chat" or "login" or "register" or "forgot" or "reset" or "bootstrap" or "");
        if (path.StartsWith("chat", StringComparison.OrdinalIgnoreCase))
            _visible = false;
    }

    private async Task Open()
    {
        _open = true;
        if (_session is null)
        {
            var created = await CreateSession.HandleAsync(new CreateChatSessionCommand(new CreateChatSessionRequest(_userId, L["Chat"].Value)));
            if (!created.Success)
            {
                _block = created.Error switch
                {
                    CreateChatSessionHandler.ProjectFolderRequired => "folder",
                    CreateChatSessionHandler.ClientRequired => "client",
                    _ => null
                };
                if (_block is null)
                {
                    Snackbar.Add(created.Error ?? L["Error"].Value, Severity.Error);
                    _open = false;
                }
                return;
            }
            _block = null;
            _session = created.Value;
        }
        await ReloadParts();
    }

    private async Task Send()
    {
        if (_session is null || string.IsNullOrWhiteSpace(_draft))
            return;
        _busy = true;
        _failed = false;
        try
        {
            var sent = await SendPrompt.HandleAsync(new SendChatPromptCommand(new SendChatPromptRequest(_session.Id, _userId, _draft, _model, _effort)));
            if (!sent.Success)
            {
                _failed = true;
                Snackbar.Add(sent.Error ?? L["Error"].Value, Severity.Error);
                return;
            }
            _draft = string.Empty;
            _session = sent.Value;
            await ReloadParts();
        }
        finally
        {
            _busy = false;
        }
    }

    private async Task Abort()
    {
        if (_session is null || _aborting)
            return;
        _aborting = true;
        try
        {
            var result = await AbortChat.HandleAsync(
                new AbortChatCommand(new AbortChatRequest(_session.Id, _userId)));
            if (result.Success)
                _session = result.Value;
            else
                Snackbar.Add(result.Error ?? L["Error"].Value, Severity.Error);
        }
        finally
        {
            _aborting = false;
        }
    }

    private async Task ReloadParts()
    {
        if (_session is null)
            return;
        var parts = await ListParts.HandleAsync(new ListChatPartsCommand(new ListChatPartsRequest(_session.Id, _userId)));
        _parts = parts.Success ? parts.Value!.ToList() : [];
    }

    // Two-stage live update, same as Chat.razor: the in-process ChatEventSignal wakes this loop the
    // moment a part is appended or the session status changes. The 5-second safety net stays because
    // the signal is in-memory only: it is lost on a Blazor circuit reconnect, when a part is written
    // by another replica, or when it fires before this loop starts waiting. The timer guarantees the
    // UI converges within 5 seconds regardless.
    [Parameter] public TimeSpan PollSafetyNet { get; set; } = TimeSpan.FromSeconds(5);

    private async Task PollAsync()
    {
        _poll = new CancellationTokenSource();
        try
        {
            while (!_poll.Token.IsCancellationRequested)
            {
                try
                {
                    if (!_open || _session is null)
                    {
                        await Task.Delay(PollSafetyNet, _poll.Token);
                        continue;
                    }
                    var sessionId = _session.Id;
                    await Events.WaitAsync(sessionId, PollSafetyNet, _poll.Token);
                    if (!_open || _session?.Id != sessionId)
                        continue;
                    var session = await GetSession.HandleAsync(new GetChatSessionCommand(new GetChatSessionRequest(sessionId, _userId)));
                    if (session.Success && _session?.Id == sessionId)
                        _session = session.Value;
                    if (_session?.Id != sessionId)
                        continue;
                    await LoadProxyStatus();
                    await ReloadParts();
                    await InvokeAsync(StateHasChanged);
                }
                catch (OperationCanceledException) when (_poll.Token.IsCancellationRequested)
                {
                    break;
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Chat dock poll iteration failed; retrying in {Delay}s.", (int)PollSafetyNet.TotalSeconds);
                    try
                    {
                        await Task.Delay(PollSafetyNet, _poll.Token);
                    }
                    catch (OperationCanceledException)
                    {
                        break;
                    }
                }
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    private IEnumerable<ChatPartDto> DockParts => _parts.TakeLast(2);

    private string Phase => ChatPhase.Resolve(_session?.Status, _parts.LastOrDefault()?.Kind, _failed, _parts.Count);

    private string PhaseLabel => L[ChatPhase.LabelKey(Phase)].Value;

    private async Task LoadProxyStatus()
    {
        var status = await GetStatus.HandleAsync(new GetProxyStatusCommand());
        if (status.Success)
            _proxy = status.Value;
    }

    private async Task OnModelBound()
    {
        await LoadProxyStatus();
    }

    private LocalModelBackendDto? SelectedBackend =>
        _models.FirstOrDefault(backend =>
            string.Equals(OpencodePayload.OpenCodeId(backend), _model, StringComparison.Ordinal));

    private string? SelectedBackendName => SelectedBackend?.Name;

    private int? SelectedContextLimit => SelectedBackend?.ContextSize is > 0
        ? SelectedBackend.ContextSize
        : null;

    private string? ModelStatus
    {
        get
        {
            var name = SelectedBackendName;
            if (name is null)
                return null;
            var loaded = _proxy?.LoadedModel;
            if (string.Equals(loaded, name, StringComparison.OrdinalIgnoreCase))
                return "ready";
            return _session?.Status == ChatSessionStatus.Streaming ? "switching" : "pending";
        }
    }

    private string ModelStatusLabel
    {
        get
        {
            var name = SelectedBackendName;
            if (name is null)
                return string.Empty;
            return ModelStatus switch
            {
                "ready" => string.Format(L["ChatModelReady"].Value, name),
                "switching" => string.Format(L["ChatModelSwitching"].Value, name),
                _ => string.Format(L["ChatModelNotLoaded"].Value, name)
            };
        }
    }

    public void Dispose()
    {
        Navigation.LocationChanged -= OnLocation;
        _poll?.Cancel();
        _poll?.Dispose();
    }
}
