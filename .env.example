# Required. Copy this file to .env and set values. Never commit .env.
# PostgreSQL — DockerPostgresHelper uses POSTGRES_PASSWORD; Web/API also accept ConnectionStrings__Default.
POSTGRES_PASSWORD=
ConnectionStrings__Default=Host=localhost;Port=5432;Database=beacon;Username=beacon;
BOOTSTRAP_ADMIN_TOKEN=
BEACON_PUBLIC_URL=http://localhost:5083
AUTH_LOCAL=true
AUTH_LOCAL_INVITE_ONLY=true

# JWT signing key (must be >= 32 chars)
JWT__Secret=ProjectBeacon-JWT-Secret-Key-Must-Be-At-Least-32-Characters-Long

# Deploy-time worker bearer. Treated as project admin on every project. Do not print.
BEACON_WORKER_TOKEN=

# Optional. llama-swap supervisor (model orchestration). When set, Web supervises the
# external llama-swap binary and regenerates its config.yaml from the project model registry.
# BEACON_LLAMASWAP_BIN=C:\tools\llama-swap\llama-swap.exe
# BEACON_LLAMASWAP_PORT=8080
# BEACON_LLAMASWAP_CONFIG=
# BEACON_PROJECT_ID=
