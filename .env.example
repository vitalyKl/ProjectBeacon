# Required. Copy this file to .env and set values. Never commit .env.
# PostgreSQL — the application connects as beacon_app (non-superuser, RLS-bound).
# Migrations run as the superuser (beacon): set ConnectionStrings__Migration for a separate
# superuser login, or leave it unset and the default string's username is overridden to the
# superuser with POSTGRES_PASSWORD.
POSTGRES_PASSWORD=
ConnectionStrings__Default=Host=localhost;Port=5432;Database=beacon;Username=beacon_app;
# Optional. Superuser connection used by Web startup, the k8s migrate Job, and dotnet-ef.
# ConnectionStrings__Migration=Host=localhost;Port=5432;Database=beacon;Username=beacon;
BOOTSTRAP_ADMIN_TOKEN=
BEACON_PUBLIC_URL=http://localhost:5083
AUTH_LOCAL=true
AUTH_LOCAL_INVITE_ONLY=true

# SMTP for invites and password-reset links. If unset, Development logs the link.
MAIL__Host=
MAIL__Port=587
MAIL__User=
MAIL__Password=
MAIL__From=beacon@localhost

# JWT signing secret. Signs auth tokens only; it is never used as the data-encryption key.
# Production (and any env that is not Development/Testing) requires a random string of at least
# 32 characters, e.g. `openssl rand -base64 48`. Development/Testing fall back to a fixed dev key
# only when this is blank. Never commit .env or log this value.
JWT__Secret=

# Data-encryption key for stored secrets (TOTP, OpenCode API keys). Writes produce v2
# AES-GCM blobs keyed by HKDF-SHA256 of this value; old v1 blobs are read with the legacy key.
# Required in non-Development/Testing environments: a random string of at least 32 characters,
# e.g. `openssl rand -base64 48`. Development/Testing fall back to a fixed dev key only when
# blank. Never commit .env or log this value. Rotating it makes v2 ciphertexts unreadable
# (keep the old value as DATA_PROTECTION_LEGACY_KEY and re-encrypt).
DATA_PROTECTION_KEY=

# Optional. Key material for reading v1 ciphertexts. Without it, existing v1 rows cannot be
# read or migrated and the startup report says so. During a rotation, set this to the previous
# DATA_PROTECTION_KEY, run the migration pass, then remove it. While it is absent, v1 rows are
# readable through JWT:Secret as a temporary bridge (logged as a warning).
# DATA_PROTECTION_LEGACY_KEY=

# Optional, default off. Set to true so new writes use the v2 format. Fresh installs should set
# it; during a rotation keep it off until the v1-to-v2 migration pass has finished.
# DATA_PROTECTION_WRITE_V2=true

# ActorId string for finish_work and pipeline force-close. Not a bearer token. Do not print.
BEACON_WORKER_TOKEN=

# Optional leftover. Web no longer supervises llama-swap. The workstation client
# (`beacon client`) starts the binary from workstation.json / PATH and pulls
# config.yaml from GET /v1/devices/me/llamaswap-config.
# BEACON_LLAMASWAP_BIN=
# BEACON_LLAMASWAP_PORT=8080
# BEACON_LLAMASWAP_CONFIG=
# BEACON_PROJECT_ID=
