# Required. Copy this file to .env and set a password. Never commit .env.
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_TOKEN=
BEACON_PUBLIC_URL=http://localhost:3000
AUTH_LOCAL=true
AUTH_LOCAL_INVITE_ONLY=true
AUTH_GITHUB=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Deploy-time worker bearer. API accepts it as an admin actor for any project.
# Not a user-facing PAT; never listed on GET /v1/projects/:id/tokens.
BEACON_WORKER_TOKEN=
# Optional bind-mount root for local detect (POSIX paths relative to this).
# BEACON_WORKSPACE=./workspace
FF_HOSTED_CLONE=false
FF_SIDECAR_TUNNEL=false
# Optional default project for HTTP MCP initialize when the client omits ?project_id=.
BEACON_PROJECT_ID=
