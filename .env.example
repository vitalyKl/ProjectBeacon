# Required. Copy this file to .env and set a password. Never commit .env.
POSTGRES_PASSWORD=
BOOTSTRAP_ADMIN_TOKEN=
BEACON_PUBLIC_URL=http://localhost:3000
AUTH_LOCAL=true
AUTH_LOCAL_INVITE_ONLY=true
AUTH_GITHUB=false
GITHUB_OAUTH_CLIENT_ID=
GITHUB_OAUTH_CLIENT_SECRET=

# Unused. Outbound sidecar WSS is not shipped.
# BEACON_HOST=

# Deploy-time worker bearer. API accepts it as an admin actor for any project.
# Not a user-facing PAT; never listed on GET /v1/projects/:id/tokens.
BEACON_WORKER_TOKEN=

# Shared API↔worker secret for Compose-internal index HTTP (port 7744, not published).
INDEX_RPC_TOKEN=

# Optional GitHub App for hosted clone (Settings opt-in; hidden unless FF_HOSTED_CLONE=true).
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
FF_HOSTED_CLONE=false
# BEACON_CLONE_DIR=/var/lib/beacon/clones

# Optional bind-mount root for local detect (POSIX paths relative to this).
# BEACON_WORKSPACE=./workspace
FF_HOSTED_CLONE=false
# Inbound /v1/sidecar WebSocket upgrade gate on the API. Not a sidecar dialer.
FF_SIDECAR_TUNNEL=false
# Optional default project for HTTP MCP initialize when the client omits ?project_id=.
BEACON_PROJECT_ID=

# GitHub App (optional). Required for issue import / webhooks, not for OAuth login.
# GITHUB_APP_ID=
# GITHUB_APP_PRIVATE_KEY=
# GITHUB_APP_WEBHOOK_SECRET=
# FF_GITHUB_TWO_WAY=false
# Optional SaaS scrape endpoint on the API (GET /metrics). Off unless set.
# BEACON_METRICS=true

# Optional JSON span logs on stderr (not OTLP). Off unless set.
# OTEL_TRACES_ENABLED=true
# OTEL_SERVICE_NAME=beacon-api
# OTEL_TRACES_SAMPLER_ARG=0.1
